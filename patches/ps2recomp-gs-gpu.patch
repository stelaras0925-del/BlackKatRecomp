+void GSCpuBackend::DecodeTextureRgba(const GSDrawState &state, uint32_t width, uint32_t height, uint32_t *out)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_texturePageCache.Invalidate();
+    const auto &tex = state.context.tex0;
+    for (uint32_t y = 0; y < height; ++y)
+    {
+        for (uint32_t x = 0; x < width; ++x)
+        {
+            const u32 raw = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, x, y);
+            uint32_t c = 0xFFFF00FFu;
+            switch (tex.psm)
+            {
+            case GS_PSM_CT32:
+            case GS_PSM_Z32:
+            case GS_PSM_CT24:
+            case GS_PSM_Z24:
+                c = applyTexa(state.texa, tex.psm, raw);
+                break;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+            case GS_PSM_Z16:
+            case GS_PSM_Z16S:
+                c = applyTexa(state.texa, tex.psm, Rgba5551ToRgba8888(static_cast<u16>(raw)));
+                break;
+            case GS_PSM_T8:
+            case GS_PSM_T8H:
+            case GS_PSM_T4:
+            case GS_PSM_T4HL:
+            case GS_PSM_T4HH:
+                c = LookupCLUT(state, static_cast<u8>(raw), tex.cpsm, tex.csm, tex.csa, tex.psm);
+                break;
+            default:
+                break;
+            }
+            out[y * width + x] = c;
+        }
+    }
+}
+
+uint64_t GSCpuBackend::ClutHash() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    uint64_t h = 1469598103934665603ull;
+    for (uint16_t v : m_clut)
+    {
+        h ^= v;
+        h *= 1099511628211ull;
+    }
+    return h;
+}
