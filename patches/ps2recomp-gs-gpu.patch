+constexpr int kDim = 1024;     // render target / depth texture size
+constexpr uint32_t kPages = 512; // 4 MiB / 8 KiB
+constexpr int kFloatsPerVertex = 12;
+
+struct PageRange
+{
+    uint32_t first = 0;
+    uint32_t last = 0; // exclusive
+    bool empty() const { return last <= first; }
+    bool overlaps(const PageRange &o) const { return first < o.last && o.first < last; }
+};
+
+inline void pageDims(uint32_t psm, uint32_t &pw, uint32_t &ph)
+{
+    switch (psm)
+    {
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+    case GS_PSM_Z16:
+    case GS_PSM_Z16S:
+        pw = 64; ph = 64; break;
+    case GS_PSM_T8:
+        pw = 128; ph = 64; break;
+    case GS_PSM_T4:
+        pw = 128; ph = 128; break;
+    default: // 32-bit layouts, incl. T8H/T4HL/T4HH
+        pw = 64; ph = 32; break;
+    }
+}
+
+// Conservative set of 8KB pages touched by a rectangle [0,width) x [0,rows) of a buffer.
+inline PageRange pageSpan(uint32_t bpBlocks, uint32_t bw, uint32_t psm, uint32_t width, uint32_t rows)
+{
+    uint32_t pw, ph;
+    pageDims(psm, pw, ph);
+    uint32_t wpx = std::max<uint32_t>(bw * 64u, width);
+    if (wpx == 0)
+        wpx = 64;
+    const uint32_t pagesWide = (wpx + pw - 1u) / pw;
+    const uint32_t pagesHigh = (std::max<uint32_t>(rows, 1u) + ph - 1u) / ph;
+    PageRange r;
+    r.first = (bpBlocks >> 5u) & (kPages - 1u);
+    r.last = r.first + std::min<uint32_t>(kPages, pagesWide * pagesHigh + ((bpBlocks & 31u) ? 1u : 0u));
+    return r;
+}
+
+inline bool envFlag(const char *name)
+{
+    const char *e = std::getenv(name);
+    return e && e[0] == '1';
+}
+
+struct Rect
+{
+    int x0 = 0, y0 = 0, x1 = -1, y1 = -1; // inclusive
+    bool empty() const { return x1 < x0 || y1 < y0; }
+    void add(const Rect &o)
+    {
+        if (o.empty()) return;
+        if (empty()) { *this = o; return; }
+        x0 = std::min(x0, o.x0); y0 = std::min(y0, o.y0);
+        x1 = std::max(x1, o.x1); y1 = std::max(y1, o.y1);
+    }
+};
+
+struct Target
+{
+    uint32_t fbp = 0;
+    uint32_t fbw = 1;
+    uint8_t psm = 0;
+    GLuint tex = 0;
+    uint32_t rows = 0;     // rows [0,rows) are valid on the GPU
+    bool stale = true;     // VRAM is newer than the GPU copy
+    bool gpuDirty = false; // GPU is newer than VRAM inside 'dirty'
+    Rect dirty;
+    PageRange range() const { return pageSpan(fbp << 5u, fbw, psm, 0, std::max<uint32_t>(rows, 1u)); }
+};
+
+struct TexKey
+{
+    uint32_t tbp0 = 0;
+    uint8_t tbw = 0, psm = 0, cpsm = 0, csm = 0, csa = 0, ta0 = 0, ta1 = 0, aem = 0;
+    uint16_t w = 0, h = 0;
+    uint64_t clutHash = 0;
+    bool operator==(const TexKey &o) const
+    {
+        return tbp0 == o.tbp0 && tbw == o.tbw && psm == o.psm && cpsm == o.cpsm && csm == o.csm && csa == o.csa &&
+               ta0 == o.ta0 && ta1 == o.ta1 && aem == o.aem && w == o.w && h == o.h && clutHash == o.clutHash;
+    }
+};
+struct TexKeyHash
+{
+    size_t operator()(const TexKey &k) const
+    {
+        uint64_t h = k.clutHash * 0x9E3779B97F4A7C15ull;
+        auto mix = [&](uint64_t v) { h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2); };
+        mix(k.tbp0); mix((uint64_t(k.tbw) << 8) | k.psm); mix((uint64_t(k.cpsm) << 16) | (uint64_t(k.csm) << 8) | k.csa);
+        mix((uint64_t(k.ta0) << 16) | (uint64_t(k.ta1) << 8) | k.aem); mix((uint64_t(k.w) << 16) | k.h);
+        return static_cast<size_t>(h);
+    }
+};
+struct TexEntry
+{
