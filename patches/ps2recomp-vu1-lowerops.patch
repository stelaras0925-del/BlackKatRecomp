+    // PS2X_IOP_FASTPATH=0 disables the IOP per-instruction fast checks (import pre-check,
+    // DMA-start flag check, DMA-interrupt due-cycle guard).
+    bool iopFastPath()
+    {
+        static const bool on = []() {
+            const char *e = std::getenv("PS2X_IOP_FASTPATH");
+            return !(e && e[0] == '0');
+        }();
+        return on;
+    }
+    // PS2X_IOP_PCSTATS=1 (diagnostic): hottest IOP PCs and slice lengths.
+    bool iopPcStats()
+    {
+        static const bool on = []() {
+            const char *e = std::getenv("PS2X_IOP_PCSTATS");
+            return e && e[0] == '1';
+        }();
+        return on;
+    }
+    std::vector<uint32_t> g_iopPcHist;
+    uint64_t g_iopSlices = 0, g_iopSliceInstr = 0, g_iopIdleSkips = 0, g_iopStatInstr = 0;
+    void iopPcStatNote(uint32_t pc)
+    {
+        if (g_iopPcHist.empty())
+            g_iopPcHist.assign(1u << 19, 0u);
+        ++g_iopPcHist[(pc & 0x1FFFFFu) >> 2];
+        if ((++g_iopStatInstr & ((1ull << 25) - 1u)) != 0u)
+            return;
+        std::vector<std::pair<uint32_t, uint32_t>> v;
+        for (uint32_t i = 0; i < g_iopPcHist.size(); ++i)
+            if (g_iopPcHist[i])
+                v.push_back({g_iopPcHist[i], i << 2});
+        std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.first > b.first; });
+        std::fprintf(stderr, "[iop:pc] instr=%llu slices=%llu avgSlice=%.1f idle=%llu top:",
+                     (unsigned long long)g_iopStatInstr, (unsigned long long)g_iopSlices,
+                     g_iopSlices ? double(g_iopSliceInstr) / double(g_iopSlices) : 0.0,
+                     (unsigned long long)g_iopIdleSkips);
+        for (size_t i = 0; i < v.size() && i < 24u; ++i)
+            std::fprintf(stderr, " %05x=%.2f%%", v[i].second, 100.0 * v[i].first / double(g_iopStatInstr));
+        std::fprintf(stderr, "\n");
+    }
+}
 
