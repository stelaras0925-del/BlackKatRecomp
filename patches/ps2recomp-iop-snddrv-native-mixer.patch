+                    mem.w16(dst, stU);
+                    const int32_t x0 = add(lh(src), lw(P) >> 7);
+                    mem.w16(dst + 2u, sat(add(lh(s), x3(x0)) >> 2));
+                    const int32_t p1 = lw(P + 4u);
+                    mem.w32(P, 0u);
+                    const int32_t x1 = add(lh(src + 2u), p1 >> 7);
+                    mem.w16(dst + 4u, sat(add(x0, x1) >> 1));
+                    int32_t t = x3(x1);
+                    mem.w32(P + 4u, 0u);
+                    t = add(t, lh(src + 4u));
+                    t = add(t, lw(P + 8u) >> 7);
