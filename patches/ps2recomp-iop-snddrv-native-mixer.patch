+                        const int32_t xb = add(lh(q + 2u), pb >> 7);
+                        mem.w16(d + 2u, sat(add(xa, x3(xb)) >> 2));
+                        const int32_t pc = lw(p + 8u);
+                        mem.w32(p + 4u, 0u);
+                        const int32_t xc = add(lh(q + 4u), pc >> 7);
+                        mem.w16(d + 4u, sat(add(xb, xc) >> 1));
+                        int32_t u = x3(xc);
+                        mem.w32(p + 8u, 0u);
+                        u = add(u, lh(q + 6u));
+                        u = add(u, lw(p + 12u) >> 7);
+                        mem.w16(d + 6u, sat(u >> 2));
