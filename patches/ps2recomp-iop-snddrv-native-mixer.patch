+            auto sat = [](int32_t v) -> uint16_t {
+                if (v < -32768) v = -32768;
+                else if (v > 32767) v = 32767;
+                return static_cast<uint16_t>(v);
+            };
+            auto add = [](int32_t x, int32_t y) -> int32_t { return static_cast<int32_t>(static_cast<uint32_t>(x) + static_cast<uint32_t>(y)); };
+            auto x3 = [&](int32_t x) -> int32_t { return add(add(x, x), x); };
+            const uint32_t nj = (sndStateEnd - sndState + 1u) / 2u;
+            uint32_t dst = a1;
+            for (uint32_t k = 0; k < 2u; ++k)
+            {
+                for (uint32_t j = 0; j < nj; ++j, dst += 0x200u)
+                {
+                    const uint32_t s = sndState + j * 2u;
+                    const int32_t A = lh(sndTblA + k * 4u + j * 2u);
+                    const int32_t B = lh(sndTblB + k * 4u + j * 2u);
+                    const uint16_t stU = mem.r16(s);
