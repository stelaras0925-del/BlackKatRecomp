+    void pdM(uint8_t op, int x, int base, int32_t d) { sseRM(0x66, op, x, base, d); }
+    // ---- a few more GPR forms ----
+    void addRaxI32(uint32_t imm) { b(0x48); b(0x05); d32(imm); }
+    void andEaxI32(uint32_t imm) { b(0x25); d32(imm); }
+    void movEdxEax() { b(0x89); b(0xC2); }
+    void orM0Eax(int base) { rex(false, 0, base); b(0x09); b(static_cast<uint8_t>(base & 7)); } // or dword [base], eax
+    void lockIncM0(int base) { b(0xF0); rex(true, 0, base); b(0xFF); b(static_cast<uint8_t>(base & 7)); } // lock inc qword [base]
+    void movRM32(int reg, int base, int32_t disp) { rex(false, reg, base); b(0x8B); mem(reg, base, disp); }
+    void movMR32(int base, int32_t disp, int reg) { rex(false, reg, base); b(0x89); mem(reg, base, disp); }
+    void aluRM32(uint8_t op, int reg, int base, int32_t disp) { rex(false, reg, base); b(op); mem(reg, base, disp); } // 03 add, 23 and, 0B or
+    void addEaxI32(uint32_t imm) { b(0x05); d32(imm); }
+    void subEaxI32(uint32_t imm) { b(0x2D); d32(imm); }
+    void movsxEaxAx() { b(0x0F); b(0xBF); b(0xC0); }
+    void movzxEaxAx() { b(0x0F); b(0xB7); b(0xC0); }
+    void shlEaxI(uint8_t n) { b(0xC1); b(0xE0); b(n); }
+    void addRcxRax() { b(0x48); b(0x01); b(0xC1); }
+    void movsxRM16(int reg, int base, int32_t disp) { rex(false, reg, base); b(0x0F); b(0xBF); mem(reg, base, disp); }
+    void testMI32(int base, int32_t disp, uint32_t imm) { rex(false, 0, base); b(0xF7); mem(0, base, disp); d32(imm); }
+    void setneAl() { b(0x0F); b(0x95); b(0xC0); }
+    void movzxEaxAl() { b(0x0F); b(0xB6); b(0xC0); }
+    void cmpAxCx() { b(0x66); b(0x39); b(0xC8); }
+    void xorRR32(int r) { rex(false, r, r); b(0x31); b(static_cast<uint8_t>(0xC0 | ((r & 7) << 3) | (r & 7))); }
+    void movdFromEax(int x) { sseRR(0x66, 0x6E, x, kRax); }
+    void psM(uint8_t op, int x, int base, int32_t d) { sseRM(0, op, x, base, d); }
+    enum : uint8_t { kCvtdq2ps = 0x5B, kMinps = 0x5D, kDivps = 0x5E, kMaxps = 0x5F };
+    void cvttpd2dq(int x, int y) { sseRR(0x66, 0xE6, x, y); }
+    void punpcklqdq(int x, int y) { sseRR(0x66, 0x6C, x, y); }
+    void movM0R(int base, int reg) { rex(true, reg, base); b(0x89); b(static_cast<uint8_t>(((reg & 7) << 3) | (base & 7))); }
+    void movM0I32(int base, uint32_t imm) { rex(false, 0, base); b(0xC7); b(static_cast<uint8_t>(base & 7)); d32(imm); }
+    void shlEdxI(uint8_t n) { b(0xC1); b(0xE2); b(n); }
+    void orEdxI32(uint32_t imm) { b(0x81); b(0xCA); d32(imm); }
+    void movRRd(int dst, int src) { rex(false, src, dst); b(0x89); b(static_cast<uint8_t>(0xC0 | ((src & 7) << 3) | (dst & 7))); }
+    void patch(uint8_t *after, const uint8_t *target)
+    {
+        if (overflow || !after)
+            return;
+        const int32_t rel = static_cast<int32_t>(target - after);
+        std::memcpy(after - 4, &rel, 4);
+    }
+};
