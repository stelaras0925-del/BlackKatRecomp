+// Constant pool for the native FMAC code (r13 points here; SSE memory operands need 16-byte alignment).
+struct alignas(16) Vu1NativePool
+{
+    uint32_t sign[4], ff[4], maxv[4], c3[4], c252[4], one[4], abs[4], ones[4];
+    double k20[2];
+    uint32_t zero[4];
+    float itofDiv[4][4];   // 1, 16, 4096, 32768
+    double ftoiMul[4][2];  // 1, 16, 4096, 32768
+    double two31[2];
+    uint32_t dm[16][4]; // dest masks, lane0 = x (dest bit 8)
+};
+inline const Vu1NativePool &vu1NativePool()
+{
+    static const Vu1NativePool pool = []() {
+        Vu1NativePool p{};
+        for (int c = 0; c < 4; ++c)
+        {
+            p.sign[c] = 0x80000000u; p.ff[c] = 0xFFu; p.maxv[c] = 0x7F7FFFFFu; p.c3[c] = 3u; p.c252[c] = 252u;
+            p.one[c] = 1u; p.abs[c] = 0x7FFFFFFFu; p.ones[c] = 0xFFFFFFFFu; p.zero[c] = 0u;
+        }
+        p.k20[0] = p.k20[1] = 1048576.0;
+        {
+            static constexpr float sc[4] = {1.0f, 16.0f, 4096.0f, 32768.0f};
+            for (int k = 0; k < 4; ++k)
+            {
+                for (int c = 0; c < 4; ++c)
+                    p.itofDiv[k][c] = sc[k];
+                p.ftoiMul[k][0] = p.ftoiMul[k][1] = static_cast<double>(sc[k]);
+            }
+            p.two31[0] = p.two31[1] = 2147483648.0;
+        }
+        for (int d = 0; d < 16; ++d)
+        {
+            p.dm[d][0] = (d & 8) ? ~0u : 0u;
+            p.dm[d][1] = (d & 4) ? ~0u : 0u;
+            p.dm[d][2] = (d & 2) ? ~0u : 0u;
+            p.dm[d][3] = (d & 1) ? ~0u : 0u;
+        }
+        return p;
+    }();
+    return pool;
+}
+enum : int32_t
+{
+    kPoolSign = offsetof(Vu1NativePool, sign), kPoolFF = offsetof(Vu1NativePool, ff), kPoolMaxv = offsetof(Vu1NativePool, maxv),
+    kPoolC3 = offsetof(Vu1NativePool, c3), kPoolC252 = offsetof(Vu1NativePool, c252), kPoolOne = offsetof(Vu1NativePool, one),
+    kPoolAbs = offsetof(Vu1NativePool, abs), kPoolOnes = offsetof(Vu1NativePool, ones), kPoolK20 = offsetof(Vu1NativePool, k20),
+    kPoolDm = offsetof(Vu1NativePool, dm), kPoolItof = offsetof(Vu1NativePool, itofDiv),
+    kPoolFtoi = offsetof(Vu1NativePool, ftoiMul), kPoolTwo31 = offsetof(Vu1NativePool, two31)
+};
+
+// vu1NormPs(x) in place; t1..t4 are scratch (all distinct from x).
+inline void vu1EmitNormPs(Vu1Emit &e, int x, int t1, int t2, int t3, int t4)
+{
+    e.movaps(t1, x); e.piM(Vu1Emit::kPand, t1, kR13, kPoolSign);            // sign
+    e.movaps(t2, x); e.psrld(t2, 23); e.piM(Vu1Emit::kPand, t2, kR13, kPoolFF); // e
+    e.pi(Vu1Emit::kPxor, t3, t3); e.pi(Vu1Emit::kPcmpeqd, t3, t2);           // isZ
+    e.piM(Vu1Emit::kPcmpeqd, t2, kR13, kPoolFF);                           // isM
+    e.movaps(t4, t3); e.pi(Vu1Emit::kPor, t4, t2); e.pi(Vu1Emit::kPandn, t4, x); // ~(isZ|isM) & b
+    e.pi(Vu1Emit::kPand, t3, t1);                                          // isZ & sign
+    e.pi(Vu1Emit::kPor, t4, t3);
+    e.piM(Vu1Emit::kPor, t1, kR13, kPoolMaxv);                             // sign | 0x7F7FFFFF
+    e.pi(Vu1Emit::kPand, t2, t1);                                          // isM & maxv
+    e.pi(Vu1Emit::kPor, t4, t2);
+    e.movaps(x, t4);
+}
+// vu1ExpOut(r) -> out (lanes with exponent < 3 or > 252); t is scratch.
+inline void vu1EmitExpOut(Vu1Emit &e, int out, int r, int t)
+{
+    e.movaps(out, r); e.psrld(out, 23); e.piM(Vu1Emit::kPand, out, kR13, kPoolFF);
+    e.movapsLoad(t, kR13, kPoolC3); e.pi(Vu1Emit::kPcmpgtd, t, out); // 3 > e
+    e.piM(Vu1Emit::kPcmpgtd, out, kR13, kPoolC252);                  // e > 252
+    e.pi(Vu1Emit::kPor, out, t);
+}
