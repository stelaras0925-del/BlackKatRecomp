+    uint16_t readGamepadPressed(int gp)
+    {
+        uint16_t p = 0;
+        auto chk = [&](int button, uint16_t mask)
+        {
+            if (IsGamepadButtonDown(gp, button))
+                p |= mask;
+        };
+        chk(GAMEPAD_BUTTON_LEFT_FACE_UP, PAD_UP);
+        chk(GAMEPAD_BUTTON_LEFT_FACE_DOWN, PAD_DOWN);
+        chk(GAMEPAD_BUTTON_LEFT_FACE_LEFT, PAD_LEFT);
+        chk(GAMEPAD_BUTTON_LEFT_FACE_RIGHT, PAD_RIGHT);
+        chk(GAMEPAD_BUTTON_RIGHT_FACE_DOWN, PAD_CROSS);
+        chk(GAMEPAD_BUTTON_RIGHT_FACE_RIGHT, PAD_CIRCLE);
+        chk(GAMEPAD_BUTTON_RIGHT_FACE_LEFT, PAD_SQUARE);
+        chk(GAMEPAD_BUTTON_RIGHT_FACE_UP, PAD_TRIANGLE);
+        chk(GAMEPAD_BUTTON_LEFT_TRIGGER_1, PAD_L1);
+        chk(GAMEPAD_BUTTON_RIGHT_TRIGGER_1, PAD_R1);
+        chk(GAMEPAD_BUTTON_LEFT_TRIGGER_2, PAD_L2);
+        chk(GAMEPAD_BUTTON_RIGHT_TRIGGER_2, PAD_R2);
+        chk(GAMEPAD_BUTTON_MIDDLE_RIGHT, PAD_START);
+        chk(GAMEPAD_BUTTON_MIDDLE_LEFT, PAD_SELECT);
+        chk(GAMEPAD_BUTTON_LEFT_THUMB, PAD_L3);
+        chk(GAMEPAD_BUTTON_RIGHT_THUMB, PAD_R3);
+        return p;
+    }
+
+    uint16_t readKeyboardPressed()
+    {
+        uint16_t p = 0;
+        auto chk = [&](bool down, uint16_t mask)
+        {
+            if (down)
+                p |= mask;
+        };
+        chk(IsKeyDown(KEY_UP) || IsKeyDown(KEY_W), PAD_UP);
+        chk(IsKeyDown(KEY_DOWN) || IsKeyDown(KEY_S), PAD_DOWN);
+        chk(IsKeyDown(KEY_LEFT) || IsKeyDown(KEY_A), PAD_LEFT);
+        chk(IsKeyDown(KEY_RIGHT) || IsKeyDown(KEY_D), PAD_RIGHT);
+        chk(IsKeyDown(KEY_X) || IsKeyDown(KEY_SPACE), PAD_CROSS);
+        chk(IsKeyDown(KEY_C) || IsKeyDown(KEY_ESCAPE), PAD_CIRCLE);
+        chk(IsKeyDown(KEY_Z) || IsKeyDown(KEY_KP_0), PAD_SQUARE);
+        chk(IsKeyDown(KEY_V) || IsKeyDown(KEY_KP_1), PAD_TRIANGLE);
+        chk(IsKeyDown(KEY_Q), PAD_L1);
+        chk(IsKeyDown(KEY_E), PAD_R1);
+        chk(IsKeyDown(KEY_LEFT_SHIFT), PAD_L2);
+        chk(IsKeyDown(KEY_RIGHT_SHIFT), PAD_R2);
+        chk(IsKeyDown(KEY_ENTER) || IsKeyDown(KEY_KP_ENTER), PAD_START);
+        chk(IsKeyDown(KEY_TAB), PAD_SELECT);
+        return p;
+    }
+
+    struct PadLogState
+    {
+        bool valid = false;
+        uint16_t kb = 0;
+        uint16_t gp = 0;
+        uint8_t sticks[4] = {0, 0, 0, 0};
+    };
