+    uint8_t axisToByte(float v)
+    {
+        if (std::fabs(v) < kStickDeadzone)
+            return kPadStickCenter;
+        float b = 128.0f + v * 127.0f;
+        if (b < 0.0f)
+            b = 0.0f;
+        if (b > 255.0f)
+            b = 255.0f;
+        return static_cast<uint8_t>(b);
+    }
