+                envTick(x, ((a1 >> 4) & 0xF) << 2, -8, true, true);
+                if (x.env <= sl) { x.phase = 3; x.envCounter = 0; }
+                break;
+            }
+            case 3:
+            {
+                const int rate = (a2 >> 6) & 0x7F;
+                const bool dec = (a2 & 0x4000u) != 0;
+                envTick(x, rate, dec ? -8 + (rate & 3) : 7 - (rate & 3), (a2 & 0x8000u) != 0, dec);
+                break;
+            }
+            case 4:
+            {
+                envTick(x, (a2 & 0x1F) << 2, -8, (a2 & 0x20u) != 0, true);
+                if (x.env <= 0) { x.env = 0; x.phase = 0; x.active = false; }
+                break;
+            }
+            default:
+                break;
+            }
+        }
