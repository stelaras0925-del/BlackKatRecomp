+        static void envTick(Voice &x, int rate, int step, bool expo, bool decrease)
+        {
+            rate = std::clamp(rate, 0, 127);
+            const int shift = rate >> 2;
+            int32_t stepv = step * (1 << std::max(0, 11 - shift));
+            uint32_t inc = 0x8000u >> std::max(0, shift - 11);
+            if (expo && !decrease && x.env > 0x6000)
+            {
+                // exponential increase: 4x slower above 0x6000
+                inc >>= 2;
+            }
+            if (expo && decrease)
+                stepv = (stepv * x.env) >> 15;
+            if (rate == 127) { inc = 0; }
+            x.envCounter += inc;
+            if (x.envCounter >= 0x8000u)
+            {
+                x.envCounter = 0;
+                x.env = std::clamp(x.env + stepv, 0, 0x7FFF);
+            }
+        }
