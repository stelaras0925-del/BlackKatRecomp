+        void decodeBlock(Voice &x)
+        {
+            static const int32_t f0[5] = {0, 60, 115, 98, 122}, f1[5] = {0, 0, -52, -55, -60};
+            const uint16_t h = ram[x.addr];
+            const int shift = h & 0xF, filt = std::min((h >> 4) & 0xF, 4);
+            x.flags = (uint8_t)(h >> 8);
+            if ((x.flags & 4u) && !x.lsaSet)
