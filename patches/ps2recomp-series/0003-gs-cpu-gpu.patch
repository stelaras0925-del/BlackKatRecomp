+    bool m_presentLazy = envOn("PS2X_GS_PRESENT_LAZY");
+    // PS2X_GS_SCALE: internal resolution multiplier (see the header comment).
+    int m_scale = []() {
+        const char *e = std::getenv("PS2X_GS_SCALE");
+        const int v = e ? std::atoi(e) : 1;
+        return v < 1 ? 1 : (v > 4 ? 4 : v);
+    }();
+    bool m_resolveNearest = []() { const char *e = std::getenv("PS2X_GS_SCALE_RESOLVE"); return e && (e[0] == 'n' || e[0] == 'N'); }();
+    GLuint m_nativeFbo = 0, m_nativeTex = 0;
+    // PS2X_GS_SCALE_RTT (default on when PS2X_GS_SCALE > 1; =0 off, =force also at 1x)
+    bool m_rtt = [this]() {
+        const char *e = std::getenv("PS2X_GS_SCALE_RTT");
+        if (e && e[0] == 'f')
+            return true;
+        return m_scale > 1 && !(e && e[0] == '0');
+    }();
+    bool m_rttRowsLoose = envFlag("PS2X_GS_SCALE_RTT_LOOSE");
+    uint64_t m_rttCount[7] = {0, 0, 0, 0, 0, 0, 0};
+    uint64_t m_rttNextLog = 0;
+    int m_rttLog = 0, m_rttHitLog = 0;
+    PresentationFrame m_scaledFrame[2];
+    bool m_scaledValid[2] = {false, false};
+    std::vector<uint8_t> m_scaledRead;
+    uint64_t m_scaledPresents = 0, m_scaledFallbacks = 0;
+    int m_rctx = 0;
+    uint32_t m_bumpTag = 0;
+    int m_presentDiag = 0;
+    std::array<uint32_t, kPages> m_pageBumpTag{};
+    std::array<uint64_t, kPages> m_lastPageGenSnap{};
+    int m_resolveLog = 0;
+    bool m_presentCtxLazy = envOn("PS2X_GS_PRESENT_CTXLAZY");
+    bool m_presentCheck = envFlag("PS2X_GS_PRESENT_CHECK");
+    uint64_t m_presentMismatchTotal = 0;
+    // one cached converted frame per field parity (interlaced field mode alternates them)
+    bool m_pcValid[2] = {false, false};
+    uint64_t m_pcGen[2] = {0, 0};
+    GSPresentationRequest m_pcReq[2]{};
+    PresentationFrame m_pcFrame[2]{};
+
+    // pending batch
+    bool m_haveKey = false;
+    DrawKey m_key{};
+    GSDrawState m_state{};
+    std::vector<float> m_verts;
+    Rect m_bbox;
+
+    // scratch
+    std::vector<float> m_readback, m_upload;
+    std::vector<uint32_t> m_texels;
+    std::unordered_map<uint64_t, int> m_logged;
+    Stats m_stats;
+    bool m_statsOn = false;
+    std::chrono::steady_clock::time_point m_lastStats{};
+};
+} // namespace gsgpu
+
+std::unique_ptr<GSRasterBackend> createGsGpuBackend()
+{
+    auto be = std::make_unique<gsgpu::GSGpuBackend>();
+    if (!be->start())
+        return nullptr;
+    return be;
+}
+
+bool isGsGpuBackend(const GSRasterBackend *backend)
+{
+    return dynamic_cast<const gsgpu::GSGpuBackend *>(backend) != nullptr;
+}
