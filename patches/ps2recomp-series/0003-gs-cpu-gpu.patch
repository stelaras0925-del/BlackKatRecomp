+struct Target
+{
+    uint32_t fbp = 0;
+    uint32_t fbw = 1;
+    uint8_t psm = 0;
+    GLuint tex = 0;
+    uint32_t rows = 0;     // rows [0,rows) are valid on the GPU
+    bool stale = true;     // VRAM is newer than the GPU copy
+    bool gpuDirty = false; // GPU is newer than VRAM inside 'dirty'
+    Rect dirty;
+    PageRange range() const { return pageSpan(fbp << 5u, fbw, psm, 0, std::max<uint32_t>(rows, 1u)); }
+};
