+            m_written.clear();
+            return r;
+        }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override { drain(5); return m_workers[0].be->ConsumeLocalToHostBytes(dst, maxBytes); }
+        uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override
+        {
+            drain(6);
+            return m_workers[0].be->ReadVram(psm, base, bw, x, y);
+        }
+        void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+        {
