+        }
+
+        void Initialize(uint8_t *vram, uint32_t vramSize) override
+        {
+            drain(0);
+            for (auto &w : m_workers)
+                w.be->Initialize(vram, vramSize);
+        }
+        void Reset() override
+        {
+            drain(0);
+            for (auto &w : m_workers)
+                w.be->Reset();
+            m_written.clear();
+        }
+
+        void Submit(const GSPrimitiveBatch &batch) override
+        {
+            if (m_n > 1)
+                trackDraw(batch);
+            Cmd c;
+            c.type = Cmd::SubmitT;
+            c.batch = batch;
+            pushAll(std::move(c));
+        }
+        void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override
+        {
+            if (m_n > 1 && overlapsWritten(static_cast<uint64_t>(tex0.cbp) * 256u, 1024u))
