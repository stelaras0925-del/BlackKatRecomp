+{
+    // Multi-worker banded rasterizer. Worker k owns framebuffer rows y with
+    // (y / kBandRows) % N == k and draws each primitive only inside its bands
+    // (by narrowing the scissor; interpolation uses unclipped vertex data, so
+    // pixels are identical). Every worker has its own GSCpuBackend (texture
+    // page cache, CLUT) on the shared VRAM and sees the same ordered command
+    // stream. VRAM-mutating non-draw ops (transfers, uploads, WriteVram) are
+    // barriers: all workers arrive, the last executes on worker 0's backend
+    // and flushes every texture cache. A draw that samples (or a CLUT load
+    // that reads) memory written by draws since the last barrier also gets a
+    // barrier first, so cross-band render-to-texture stays ordered.
+    class GSThreadedBackend final : public GSRasterBackend
+    {
+    public:
+        static constexpr int kBandRows = 16;
+
+        GSThreadedBackend(std::unique_ptr<GSRasterBackend> inner, int threads)
+        {
+            m_n = std::max(1, std::min(threads, 16));
+            m_workers.resize(static_cast<size_t>(m_n));
+            m_workers[0].be = std::move(inner);
+            for (int i = 1; i < m_n; ++i)
+                m_workers[i].be = std::make_unique<GSCpuBackend>();
+            for (int i = 0; i < m_n; ++i)
