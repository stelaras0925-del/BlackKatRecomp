+        }
+        void flush()
+        {
+            if (!open) return;
+            std::fprintf(stderr, "[gs:draw] #%llu n=%u adc=%u %s bbox=(%.0f,%.0f)-(%.0f,%.0f) z=%.0f..%.0f maxArea=%.0f rgba0=%08x st=(%g..%g,%g..%g) q=%g..%g\n",
