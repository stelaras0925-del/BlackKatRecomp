+                    r.second = std::max(r.second, hi);
+                    return;
+                }
+            m_written.emplace_back(lo, hi);
+        }
+        void trackDraw(const GSPrimitiveBatch &batch)
+        {
+            const GSDrawState &st = batch.state;
+            const GSContext &ctx = st.context;
+            if (st.prim.tme)
+            {
+                const GSTex0Reg &t = ctx.tex0;
+                uint64_t lo, hi;
+                const uint32_t tw = 1u << std::min<uint32_t>(t.tw, 10u);
+                const uint32_t th = 1u << std::min<uint32_t>(t.th, 10u);
