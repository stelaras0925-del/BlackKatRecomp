+            if (px.size() < pstride * h) return;
+            // shift history
+            std::memmove(g[0], g[1], sizeof(g[0])); std::memmove(g[1], g[2], sizeof(g[0]));
+            small[0].swap(small[1]); small[1].swap(small[2]);
+            float *c = g[2]; float cnt[GW * GH]{};
+            for (int i = 0; i < GW * GH; ++i) c[i] = 0;
+            const uint32_t step = std::max<uint32_t>(1u, w / 320u);
+            for (uint32_t y = 0; y < h; y += step)
+            {
+                const uint8_t *row = px.data() + y * pstride;
+                const int cy = static_cast<int>(static_cast<uint64_t>(y) * GH / h);
+                for (uint32_t x = 0; x < w; x += step)
