+            c.type = Cmd::ClutT;
+            c.tex0 = tex0;
+            c.clut = texclut;
+            pushAll(std::move(c));
+        }
+        void BeginTransfer(const GSTransferCommand &command) override
+        {
+            auto op = std::make_shared<Barrier>();
+            op->kind = BarrierKind::Transfer;
+            op->transfer = command;
+            pushBarrierOp(std::move(op));
+        }
+        void UploadImage(const uint8_t *data, uint32_t sizeBytes) override
+        {
+            if (!data || sizeBytes == 0u)
+                return;
+            auto op = std::make_shared<Barrier>();
+            op->kind = BarrierKind::Upload;
+            op->data.assign(data, data + sizeBytes);
+            pushBarrierOp(std::move(op));
+        }
+        void Flush() override { drain(1); m_workers[0].be->Flush(); }
+        void Sync(GSSyncReason reason) override { drain(2); m_workers[0].be->Sync(reason); }
+        void TextureFlush() override
+        {
+            Cmd c;
+            c.type = Cmd::TexFlushT;
+            pushAll(std::move(c));
+        }
+        PresentationFrame Present(const GSPresentationRequest &request) override { drain(3); return m_workers[0].be->Present(request); }
+        bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override
+        {
+            drain(4);
