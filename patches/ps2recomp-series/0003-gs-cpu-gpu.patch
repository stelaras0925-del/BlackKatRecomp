+        if (m_presentLazy)
+            std::fprintf(stderr, "[gs:gpu:present] pmode=%llx dispfb1=%llx display1=%llx dispfb2=%llx display2=%llx ctx0=%u/%u/%u ctx1=%u/%u/%u pref=%d %u/%u/%u dest=%u\n",
+                         (unsigned long long)m_pcReq[0].pmode, (unsigned long long)m_pcReq[0].dispfb1, (unsigned long long)m_pcReq[0].display1,
+                         (unsigned long long)m_pcReq[0].dispfb2, (unsigned long long)m_pcReq[0].display2,
+                         m_pcReq[0].contextFrames[0].fbp, m_pcReq[0].contextFrames[0].fbw, m_pcReq[0].contextFrames[0].psm,
+                         m_pcReq[0].contextFrames[1].fbp, m_pcReq[0].contextFrames[1].fbw, m_pcReq[0].contextFrames[1].psm,
+                         m_pcReq[0].hasPreferredSource ? 1 : 0, m_pcReq[0].preferredSource.fbp, m_pcReq[0].preferredSource.fbw,
+                         m_pcReq[0].preferredSource.psm, m_pcReq[0].preferredDestFbp);
+        m_stats = Stats{};
+    }
+
+    struct Uniforms
+    {
+        GLint uInvSize = -1, uTex = -1, uDst = -1, uIip = -1, uTme = -1, uTfx = -1, uTcc = -1, uFge = -1, uFogCol = -1,
+              uAte = -1, uAtst = -1, uAref = -1, uAtInv = -1, uDate = -1, uDatm = -1, uFba = -1, uAMsb = -1, uCt16 = -1,
+              uZmax = -1, uRtt = -1, uRttScale = -1, uRttEdge = -1, uRttWrap = -1, uRttCt24 = -1, uRttTa0 = -1, uRttAem = -1;
+    };
+
+    static constexpr size_t kMaxQueue = 16384;
+    static constexpr size_t kMaxBatchFloats = static_cast<size_t>(kFloatsPerVertex) * 6u * 20000u;
+
+    // queue
+    std::thread m_thread;
+    std::thread::id m_threadId{};
