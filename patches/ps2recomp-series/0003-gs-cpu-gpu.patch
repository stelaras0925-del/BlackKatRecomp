+                     "l2l=%llu dstCopies=%llu targets=%zu textures=%zu | tc2=%d texHashes=%llu pageHashes=%llu texMB=%llu checks=%llu mismatches=%llu (total %llu) evicts=%llu | lazyPresent=%d convert=%llu reuse=%llu pchecks=%llu pmismatches=%llu (total %llu) ctxRedo=%llu\n",
+                     (unsigned long long)m_stats.prims, (unsigned long long)m_stats.batches,
