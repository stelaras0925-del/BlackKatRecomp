+        static uint64_t hashBytes(uint64_t h, const void *p, size_t n)
+        {
+            const uint8_t *b = static_cast<const uint8_t *>(p);
+            for (size_t i = 0; i < n; ++i)
+                h = (h ^ b[i]) * 0x100000001B3ull;
+            return h;
+        }
+        static uint64_t hashPrim(uint64_t h, const GSDrawState &st, const GSVertex *v, uint8_t n)
+        {
+            const StateKey k = canon(st);
+            h = hashBytes(h, k.data(), sizeof(k));
+            h = hashBytes(h, &n, 1);
+            for (uint8_t i = 0; i < n; ++i)
+            {
+                // fields only (GSVertex has padding)
+                const GSVertex &x = v[i];
+                h = hashBytes(h, &x.x, sizeof(x.x)); h = hashBytes(h, &x.y, sizeof(x.y)); h = hashBytes(h, &x.z, sizeof(x.z));
+                const uint8_t c[4] = {x.r, x.g, x.b, x.a};
