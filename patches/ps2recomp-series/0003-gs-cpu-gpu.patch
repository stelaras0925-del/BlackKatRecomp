+        // Canonical (padding-free) image of every GSDrawState member; compare/hash this, never raw struct bytes.
+        using StateKey = std::array<uint64_t, 20>;
+        static StateKey canon(const GSDrawState &st)
+        {
+            const GSContext &c = st.context;
+            const GSPrimReg &p = st.prim;
+            StateKey k{};
+            k[0] = (uint64_t)c.frame.fbp | ((uint64_t)c.frame.fbw << 32);
+            k[1] = (uint64_t)c.frame.psm | ((uint64_t)c.frame.fbmsk << 32);
+            k[2] = (uint64_t)c.scissor.x0 | ((uint64_t)c.scissor.x1 << 16) | ((uint64_t)c.scissor.y0 << 32) | ((uint64_t)c.scissor.y1 << 48);
+            k[3] = (uint64_t)c.tex0.tbp0 | ((uint64_t)c.tex0.tbw << 32) | ((uint64_t)c.tex0.psm << 40) | ((uint64_t)c.tex0.tw << 48) | ((uint64_t)c.tex0.th << 56);
+            k[4] = (uint64_t)c.tex0.tcc | ((uint64_t)c.tex0.tfx << 8) | ((uint64_t)c.tex0.cpsm << 16) | ((uint64_t)c.tex0.csm << 24) |
+                   ((uint64_t)c.tex0.csa << 32) | ((uint64_t)c.tex0.cld << 40);
+            k[5] = (uint64_t)c.tex0.cbp | ((uint64_t)c.xyoffset.ofx << 32) | ((uint64_t)c.xyoffset.ofy << 48);
+            k[6] = (uint64_t)c.zbuf.zbp | ((uint64_t)c.zbuf.psm << 32) | ((uint64_t)(c.zbuf.zmask ? 1 : 0) << 40);
+            k[7] = c.tex1; k[8] = c.miptbp1; k[9] = c.miptbp2; k[10] = c.clamp; k[11] = c.alpha; k[12] = c.test; k[13] = c.fba;
+            k[14] = (uint64_t)p.type | ((uint64_t)p.iip << 8) | ((uint64_t)p.tme << 9) | ((uint64_t)p.fge << 10) | ((uint64_t)p.abe << 11) |
+                    ((uint64_t)p.aa1 << 12) | ((uint64_t)p.fst << 13) | ((uint64_t)p.ctxt << 14) | ((uint64_t)p.fix << 15) |
+                    ((uint64_t)st.texa.ta0 << 16) | ((uint64_t)(st.texa.aem ? 1 : 0) << 24) | ((uint64_t)st.texa.ta1 << 32) |
+                    ((uint64_t)(st.pabe ? 1 : 0) << 40) | ((uint64_t)(st.linearFilter ? 1 : 0) << 41);
+            k[15] = (uint64_t)st.texclut.cbw | ((uint64_t)st.texclut.cou << 8) | ((uint64_t)st.texclut.cov << 16) |
+                    ((uint64_t)st.fogR << 32) | ((uint64_t)st.fogG << 40) | ((uint64_t)st.fogB << 48);
