+    std::unique_ptr<GSRasterBackend> maybeWrapDrawList(std::unique_ptr<GSRasterBackend> b)
+    {
+        const char *e = std::getenv("PS2X_DRAWLIST");
+        if (!b || ((!e || e[0] != '2') && b->Kind() != GSBackendKind::Vulkan) || (e && e[0] == '0'))
+            return b;
+        std::fprintf(stderr, "[gs] draw list path on (PS2X_DRAWLIST=2) in front of the %s backend\n", b->Name());
+        return std::make_unique<GSListBackend>(std::move(b));
+    }
