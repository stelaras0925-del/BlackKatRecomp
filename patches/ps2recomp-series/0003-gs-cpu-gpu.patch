+void GSCpuBackend::DecodeTextureRgba(const GSDrawState &state, uint32_t width, uint32_t height, uint32_t *out)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_texturePageCache.Invalidate();
