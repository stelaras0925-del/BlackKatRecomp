+
+    private:
+        enum class BarrierKind : uint8_t { Hazard, Transfer, Upload, Write };
+        struct Barrier
+        {
+            BarrierKind kind = BarrierKind::Hazard;
+            GSTransferCommand transfer{};
+            std::vector<uint8_t> data;
+            uint32_t w[6] = {};
+            int arrived = 0;
+            bool done = false;
+        };
+        struct Cmd
+        {
+            enum Type : uint8_t { SubmitT, ClutT, TexFlushT, BarrierT } type = SubmitT;
+            GSPrimitiveBatch batch{};
+            GSTex0Reg tex0{};
+            GSTexClutReg clut{};
+            std::shared_ptr<Barrier> barrier;
+        };
+        struct Worker
+        {
+            std::unique_ptr<GSRasterBackend> be;
+            std::deque<Cmd> q;
+            uint64_t submitted = 0;
+            uint64_t completed = 0;
+            bool idle = false;
+            std::condition_variable cv;
+            std::thread th;
+        };
+
+        static uint32_t psmBits(uint32_t psm)
+        {
+            switch (psm & 0x3Fu)
+            {
+            case 0x02: case 0x0A: case 0x32: case 0x3A: return 16u;
+            case 0x13: return 8u;
+            case 0x14: return 4u;
+            default: return 32u;
+            }
+        }
+        // Conservative byte range of a buffer: base bytes + width x height at
+        // psm depth, rounded up to whole 8 KiB pages plus one page of slack.
+        static void bufRange(uint64_t baseBytes, uint32_t widthPx, uint32_t heightPx, uint32_t psm, uint64_t &lo, uint64_t &hi)
+        {
+            const uint64_t bytes = (static_cast<uint64_t>(widthPx) * heightPx * psmBits(psm) + 7u) / 8u;
+            lo = baseBytes;
+            hi = baseBytes + ((bytes + 8191u) / 8192u + 1u) * 8192u;
+        }
+        bool overlapsWritten(uint64_t lo, uint64_t len) const
+        {
+            const uint64_t hi = lo + len;
+            for (const auto &r : m_written)
