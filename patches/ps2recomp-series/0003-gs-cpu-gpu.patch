diff --git a/ps2xRuntime/src/lib/gs/gs_texrep.inl b/ps2xRuntime/src/lib/gs/gs_texrep.inl
new file mode 100644
index 0000000000000000000000000000000000000000..02b63fb9dc5d8410871f70ab8ed6b21c0edc9a4a
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_texrep.inl
@@ -0,0 +1,117 @@
+// Host->local texture upload hook (included by gs_frontend.cpp).
+// Debug: PS2X_TEXREP_LOG=1 logs small single-packet CT16/CT32 uploads (<=128x128) with their hash64;
+// PS2X_TEXREP_DUMP=<dir> also writes each distinct one as <dir>/<hash>_<dbp>_<w>x<h>_psm<p>.raw.
+#include <unordered_set>
+#include <unordered_map>
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <vector>
+namespace ps2x_texrep
+{
+    // Fast 64-bit hash of upload bytes (8 bytes per step). Replacement tables key on this value.
+    inline uint64_t hash64(const uint8_t *p, size_t n)
+    {
+        uint64_t h = 0xcbf29ce484222325ull ^ static_cast<uint64_t>(n);
+        size_t i = 0;
+        for (; i + 8 <= n; i += 8)
+        {
+            uint64_t w;
+            std::memcpy(&w, p + i, 8);
+            h ^= w;
+            h *= 0x100000001b3ull;
+            h ^= h >> 29;
+        }
+        for (; i < n; ++i) { h ^= p[i]; h *= 0x100000001b3ull; }
+        return h;
+    }
+    inline uint32_t bytesPerPixel(uint8_t psm)
+    {
+        switch (psm) { case 0x00: return 4u; case 0x02: case 0x0A: return 2u; default: return 0u; }
+    }
+    struct Debug
+    {
+        bool log = false;
+        std::string dumpDir;
+        std::unordered_set<uint64_t> seen;
+        std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+        Debug()
+        {
+            log = std::getenv("PS2X_TEXREP_LOG") && std::getenv("PS2X_TEXREP_LOG")[0] == '1';
+            if (const char *d = std::getenv("PS2X_TEXREP_DUMP")) { dumpDir = d; log = true; }
+        }
+    };
+    inline Debug &debug() { static Debug d; return d; }
+
+    // Replacement table: original-data hash -> replacement bytes (same size/format). Filled at startup by
+    // game overrides through ps2xTexRepAdd() (e.g. Black Kat's Xbox-style button prompts).
+    struct Table
+    {
+        std::mutex m;
+        std::unordered_map<uint64_t, std::pair<std::string, std::vector<uint8_t>>> map;
+        std::atomic<uint64_t> sizeMask{0}; // bit (size>>8)&63 set for every registered byte size (cheap prefilter)
+        std::atomic<bool> any{false};
+        std::atomic<uint32_t> hits{0};
+    };
+    inline Table &table() { static Table *t = new Table(); return *t; }
+
+    // Returns replacement pixels (same size) or nullptr.
+    inline const uint8_t *onUpload(const GSBitBltBuf &bb, const GSTrxPos &pos, const GSTrxReg &reg, const uint8_t *data, uint32_t size)
+    {
+        Table &tab = table();
+        if (!tab.any.load(std::memory_order_relaxed) && !debug().log)
+            return nullptr;
+        const uint32_t bpp = bytesPerPixel(bb.dpsm);
+        if (!bpp || reg.rrw == 0 || reg.rrh == 0 || reg.rrw > 128 || reg.rrh > 128)
+            return nullptr;
+        if (size != static_cast<uint32_t>(reg.rrw) * reg.rrh * bpp)
+            return nullptr; // only complete single-packet uploads
+        Debug &dbg = debug();
+        if (!dbg.log && !(tab.sizeMask.load(std::memory_order_relaxed) & (1ull << ((size >> 8) & 63u))))
+            return nullptr;
+        const uint64_t h = hash64(data, size);
+        const uint8_t *rep = nullptr;
+        if (tab.any.load(std::memory_order_relaxed))
+        {
+            std::lock_guard<std::mutex> lk(tab.m);
+            auto it = tab.map.find(h);
+            if (it != tab.map.end() && it->second.second.size() == size)
+            {
+                rep = it->second.second.data(); // stable: entries are never erased
+                tab.hits.fetch_add(1);
+                static std::unordered_set<uint64_t> s_logged; // first replacement of each texture (or all with PS2X_TEXREP_LOG)
+                if (dbg.log || s_logged.insert(h).second)
+                    std::fprintf(stderr, "[texrep] replaced upload dbp=%x %ux%u psm=%x hash=%016llx -> %s\n", bb.dbp, reg.rrw, reg.rrh,
+                                 bb.dpsm, (unsigned long long)h, it->second.first.c_str());
+            }
+        }
+        if (!dbg.log)
+            return rep;
+        if (dbg.seen.insert(h).second)
+        {
+            std::fprintf(stderr, "[texrep] t=%.3f upload dbp=%x dbw=%u pos=(%u,%u) %ux%u psm=%x hash=%016llx\n",
+                         std::chrono::duration<double>(std::chrono::steady_clock::now() - dbg.t0).count(), bb.dbp, bb.dbw,
+                         pos.dsax, pos.dsay, reg.rrw, reg.rrh, bb.dpsm, (unsigned long long)h);
+            if (!dbg.dumpDir.empty())
+            {
+                char name[512];
+                std::snprintf(name, sizeof(name), "%s/%016llx_%x_%ux%u_psm%x.raw", dbg.dumpDir.c_str(), (unsigned long long)h, bb.dbp,
+                              reg.rrw, reg.rrh, bb.dpsm);
+                if (FILE *f = std::fopen(name, "wb")) { std::fwrite(data, 1, size, f); std::fclose(f); }
+            }
+        }
+        return rep;
+    }
+}
+
+// Register a texture replacement: uploads whose data hashes to origHash (hash64 over the raw upload
+// bytes, ps2x_texrep::hash64; see PS2X_TEXREP_LOG) get `data` written instead. Must be the same size and pixel format.
+void ps2xTexRepAdd(uint64_t origHash, const void *data, uint32_t size, const char *name)
+{
+    auto &tab = ps2x_texrep::table();
+    std::lock_guard<std::mutex> lk(tab.m);
+    const auto *b = static_cast<const uint8_t *>(data);
+    tab.map[origHash] = {name ? name : "?", std::vector<uint8_t>(b, b + size)};
+    tab.sizeMask.fetch_or(1ull << ((size >> 8) & 63u));
+    tab.any.store(true);
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_drawtag.inl b/ps2xRuntime/src/lib/gs/gs_drawtag.inl
new file mode 100644
index 0000000000000000000000000000000000000000..4b4349b20667c701c9e54d6ec909a9a6905f296a
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_drawtag.inl
@@ -0,0 +1,235 @@
+// Phase 0a draw tagging, GS side (PS2X_DRAWTAG=1; diagnostic, default off). #included at the end of gs_frontend.cpp.
+// Aggregates every GS primitive by (GIF path, draw tag, prim, texture format, frame buffer, Z test) and prints
+// a table every PS2X_DRAWTAG_SEC seconds (default 10) as [drawtag] lines on stderr. The tag (g_ps2xDrawTag, set by
+// GifArbiter::drain) carries the VU1 program start and the emitter id (see ps2_vif1_interpreter.cpp).
+//   PS2X_DRAWTAG_SEQ=sec   : print every draw run, in order, for PS2X_DRAWTAG_SEQN (default 8) presents after t=sec
+//                            ([drawtag:seq] lines; presents are host frames, the game may draw every 2nd/4th one)
+//   PS2X_DRAWTAG_SKIP=list : drop draws, comma list of tokens: 0x2c18 (program byte address), e12 (emitter id),
+//                            d (VIF DIRECT), u (untagged path1), p2 / p3 (all path2 / path3)
+#include <set>
+#include <map>
+extern uint32_t g_ps2xDrawTag;
+extern "C" void ps2xDrawTagVifReport(FILE *f);
+namespace ps2x_drawtag
+{
+    namespace
+    {
+        struct Val
+        {
+            uint64_t runs = 0, prims = 0, verts = 0, constZ = 0;
+            float x0 = 1e9f, y0 = 1e9f, x1 = -1e9f, y1 = -1e9f;
+            double z0 = 1e18, z1 = -1e18;
+            double sdx = 0.0; // sum over prims of |centre x - 320| (projection checks)
+            std::set<uint32_t> tbp;
+        };
+        std::mutex g_m;
+        std::map<std::pair<uint64_t, uint64_t>, Val> g_agg;
+        std::pair<uint64_t, uint64_t> g_lastKey{~0ull, ~0ull};
+        std::string g_names[256];
+        uint64_t g_presents = 0, g_intervalPresents = 0;
+        std::chrono::steady_clock::time_point g_t0, g_lastDump;
+        bool g_started = false;
+        // SEQ dump state
+        int g_seqState = 0; // 0 idle, 1 wait frame start, 2 dumping, 3 done
+        uint64_t g_seqPresent = 0;
+        struct Run { std::pair<uint64_t, uint64_t> key{~0ull, ~0ull}; uint64_t prims = 0; float x0 = 1e9f, y0 = 1e9f, x1 = -1e9f, y1 = -1e9f; double z0 = 1e18, z1 = -1e18; uint32_t tbp = 0; } g_run;
+        uint64_t g_seqN = 0;
+
+        double secs() { return std::chrono::duration<double>(std::chrono::steady_clock::now() - g_t0).count(); }
+        const char *primName(unsigned t)
+        {
+            static const char *n[8] = {"point", "line", "lstrip", "tri", "tristrip", "trifan", "sprite", "?7"};
+            return n[t & 7];
+        }
+        std::string tagDesc(uint32_t tag, int path)
+        {
+            char b[96];
+            if (!(tag & 0x80000000u))
+            {
+                std::snprintf(b, sizeof(b), "path%d untagged", path);
+                return b;
+            }
+            const uint32_t prog = tag & 0x7FFu, em = (tag >> 11) & 0xFFu;
+            const char *emn = em == 0 ? "noaddr" : em == 0xFF ? "other" : (g_names[em].empty() ? "?" : g_names[em].c_str());
+            if (prog == 0x7FFu)
+                std::snprintf(b, sizeof(b), "path%d DIRECT em=%s(%u)", path, emn, em);
+            else
+                std::snprintf(b, sizeof(b), "path%d prog=0x%04x em=%s(%u)", path, prog * 8u, emn, em);
+            return b;
+        }
+        std::string keyDesc(const std::pair<uint64_t, uint64_t> &k)
+        {
+            const int path = static_cast<int>(k.first & 0xF) - 1;
+            const uint32_t tag = static_cast<uint32_t>(k.first >> 32);
+            const uint64_t b = k.second;
+            char s[200];
+            std::snprintf(s, sizeof(s), "%s %s tme%u fst%u abe%u ctx%u fb=%x/psm%x tex=psm%x/%ux%u zte%u ztst%u",
+                          tagDesc(tag, path).c_str(), primName(b & 7), (unsigned)((b >> 3) & 1), (unsigned)((b >> 4) & 1),
+                          (unsigned)((b >> 5) & 1), (unsigned)((b >> 6) & 1), (unsigned)((b >> 8) & 0x1FF), (unsigned)((b >> 17) & 0x3F),
+                          (unsigned)((b >> 23) & 0x3F), 1u << ((b >> 29) & 0xF), 1u << ((b >> 33) & 0xF), (unsigned)((b >> 37) & 1),
+                          (unsigned)((b >> 38) & 3));
+            return s;
+        }
+        struct Skip { std::vector<uint32_t> progs, ems; bool direct = false, untagged = false, p2 = false, p3 = false; };
+        const Skip &skip()
+        {
+            static const Skip s = []() {
+                Skip k;
+                const char *e = std::getenv("PS2X_DRAWTAG_SKIP");
+                if (!e)
+                    return k;
+                std::string str(e);
+                size_t i = 0;
+                while (i <= str.size())
+                {
+                    size_t j = str.find(',', i);
+                    if (j == std::string::npos) j = str.size();
+                    std::string t = str.substr(i, j - i);
+                    if (t == "d") k.direct = true;
+                    else if (t == "u") k.untagged = true;
+                    else if (t == "p2") k.p2 = true;
+                    else if (t == "p3") k.p3 = true;
+                    else if (!t.empty() && t[0] == 'e') k.ems.push_back((uint32_t)std::strtoul(t.c_str() + 1, nullptr, 10));
+                    else if (!t.empty()) k.progs.push_back((uint32_t)std::strtoul(t.c_str(), nullptr, 16) / 8u);
+                    i = j + 1;
+                }
+                std::fprintf(stderr, "[drawtag] skip list: %s\n", e);
+                return k;
+            }();
+            return s;
+        }
+        void dumpLocked(double t)
+        {
+            const double dt = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_lastDump).count();
+            std::fprintf(stderr, "[drawtag] ==== t=%.1f interval=%.1fs frames(presents)=%llu keys=%zu\n", t, dt,
+                         (unsigned long long)g_intervalPresents, g_agg.size());
+            std::vector<std::pair<std::pair<uint64_t, uint64_t>, Val *>> v;
+            for (auto &kv : g_agg)
+                v.emplace_back(kv.first, &kv.second);
+            std::sort(v.begin(), v.end(), [](const auto &a, const auto &b) { return a.second->prims > b.second->prims; });
+            for (auto &e : v)
+            {
+                const Val &x = *e.second;
+                std::fprintf(stderr, "[drawtag] %s | runs=%llu prims=%llu verts=%llu constZ=%llu ntex=%zu bbox=(%.0f,%.0f)-(%.0f,%.0f) z=%.0f..%.0f mdx=%.1f\n",
+                             keyDesc(e.first).c_str(), (unsigned long long)x.runs, (unsigned long long)x.prims, (unsigned long long)x.verts,
+                             (unsigned long long)x.constZ, x.tbp.size(), x.x0, x.y0, x.x1, x.y1, x.z0, x.z1, x.prims ? x.sdx / (double)x.prims : 0.0);
+            }
+            ps2xDrawTagVifReport(stderr);
+            g_agg.clear();
+            g_lastKey = {~0ull, ~0ull};
+            g_intervalPresents = 0;
+            g_lastDump = std::chrono::steady_clock::now();
+        }
+        void flushRunLocked()
+        {
+            if (g_seqState == 2 && g_run.prims)
+                std::fprintf(stderr, "[drawtag:seq] #%llu %s | prims=%llu tbp=%x bbox=(%.0f,%.0f)-(%.0f,%.0f) z=%.0f..%.0f\n", (unsigned long long)++g_seqN,
+                             keyDesc(g_run.key).c_str(), (unsigned long long)g_run.prims, g_run.tbp, g_run.x0, g_run.y0, g_run.x1, g_run.y1, g_run.z0, g_run.z1);
+            g_run = Run{};
+        }
+    }
+
+    bool on()
+    {
+        static const bool v = []() { const char *e = std::getenv("PS2X_DRAWTAG"); return e && e[0] == '1'; }();
+        return v;
+    }
+
+    // Returns true when the primitive must be dropped (PS2X_DRAWTAG_SKIP).
+    bool onPrim(const GSPrimitiveBatch &batch, int path)
+    {
+        const uint32_t tag = g_ps2xDrawTag;
+        const GSContext &c = batch.state.context;
+        const auto &pr = batch.state.prim;
+        const uint64_t k1 = (uint64_t)(path + 1) | ((uint64_t)tag << 32);
+        const uint64_t k2 = (uint64_t)(pr.type & 7) | ((uint64_t)(pr.tme & 1) << 3) | ((uint64_t)(pr.fst & 1) << 4) | ((uint64_t)(pr.abe & 1) << 5) |
+                            ((uint64_t)(pr.ctxt & 1) << 6) | ((uint64_t)(c.frame.fbp & 0x1FF) << 8) | ((uint64_t)(c.frame.psm & 0x3F) << 17) |
+                            ((uint64_t)(pr.tme ? (c.tex0.psm & 0x3F) : 0) << 23) | ((uint64_t)(pr.tme ? (c.tex0.tw & 0xF) : 0) << 29) |
+                            ((uint64_t)(pr.tme ? (c.tex0.th & 0xF) : 0) << 33) | ((uint64_t)((c.test >> 16) & 1) << 37) | ((uint64_t)((c.test >> 17) & 3) << 38);
+        const std::pair<uint64_t, uint64_t> key{k1, k2};
+        const float ofx = static_cast<float>(c.xyoffset.ofx >> 4), ofy = static_cast<float>(c.xyoffset.ofy >> 4);
+        {
+            std::lock_guard<std::mutex> lk(g_m);
+            if (!g_started)
+            {
+                g_started = true;
+                g_t0 = g_lastDump = std::chrono::steady_clock::now();
+            }
+            Val &v = g_agg[key];
+            if (key != g_lastKey)
+            {
+                ++v.runs;
+                g_lastKey = key;
+                flushRunLocked();
+                g_run.key = key;
+                g_run.tbp = pr.tme ? c.tex0.tbp0 : 0u;
+            }
+            ++v.prims;
+            ++g_run.prims;
+            v.verts += batch.vertexCount;
+            if (pr.tme)
+                v.tbp.insert(c.tex0.tbp0);
+            bool cz = true;
+            for (int i = 0; i < batch.vertexCount; ++i)
+            {
+                const auto &vx = batch.vertices[i];
+                const float sx = vx.x - ofx, sy = vx.y - ofy;
+                v.x0 = std::min(v.x0, sx); v.x1 = std::max(v.x1, sx); v.y0 = std::min(v.y0, sy); v.y1 = std::max(v.y1, sy);
+                v.z0 = std::min<double>(v.z0, vx.z); v.z1 = std::max<double>(v.z1, vx.z);
+                g_run.x0 = std::min(g_run.x0, sx); g_run.x1 = std::max(g_run.x1, sx); g_run.y0 = std::min(g_run.y0, sy); g_run.y1 = std::max(g_run.y1, sy);
+                g_run.z0 = std::min<double>(g_run.z0, vx.z); g_run.z1 = std::max<double>(g_run.z1, vx.z);
+                if (i && vx.z != batch.vertices[0].z)
+                    cz = false;
+            }
+            if (batch.vertexCount > 0)
+            {
+                float cx = 0.0f;
+                for (int i = 0; i < batch.vertexCount; ++i)
+                    cx += batch.vertices[i].x - ofx;
+                v.sdx += std::fabs(cx / (float)batch.vertexCount - 320.0f);
+            }
+            if (cz)
+                ++v.constZ;
+        }
+        const Skip &s = skip();
+        if (s.p2 && path == 2) return true;
+        if (s.p3 && path == 3) return true;
+        if (!(tag & 0x80000000u))
+            return s.untagged && path == 1;
+        const uint32_t prog = tag & 0x7FFu, em = (tag >> 11) & 0xFFu;
+        if (prog == 0x7FFu && s.direct) return true;
+        for (uint32_t p : s.progs) if (p == prog) return true;
+        for (uint32_t e : s.ems) if (e == em) return true;
+        return false;
+    }
+
+    void onPresent()
+    {
+        static const double s_interval = []() { const char *e = std::getenv("PS2X_DRAWTAG_SEC"); const double v = e ? std::atof(e) : 0.0; return v > 0.0 ? v : 10.0; }();
+        static const uint64_t s_seqN = []() { const char *e = std::getenv("PS2X_DRAWTAG_SEQN"); const long v = e ? std::atol(e) : 0; return static_cast<uint64_t>(v > 0 ? v : 8); }();
+        static const double s_seqAt = []() { const char *e = std::getenv("PS2X_DRAWTAG_SEQ"); return e ? std::atof(e) : -1.0; }();
+        std::lock_guard<std::mutex> lk(g_m);
+        if (!g_started)
+            return;
+        ++g_presents;
+        ++g_intervalPresents;
+        const double t = secs();
+        if (s_seqAt >= 0.0)
+        {
+            if (g_seqState == 0 && t >= s_seqAt) { g_seqState = 1; }
+            else if (g_seqState == 1) { flushRunLocked(); g_run = Run{}; g_lastKey = {~0ull, ~0ull}; g_seqState = 2; g_seqPresent = g_presents; std::fprintf(stderr, "[drawtag:seq] ---- frame start t=%.2f present=%llu\n", t, (unsigned long long)g_presents); }
+            else if (g_seqState == 2 && g_presents >= g_seqPresent + s_seqN) { flushRunLocked(); g_seqState = 3; std::fprintf(stderr, "[drawtag:seq] ---- end (%llu presents)\n", (unsigned long long)s_seqN); }
+            else if (g_seqState == 2) { std::fprintf(stderr, "[drawtag:seq] ---- present %llu\n", (unsigned long long)g_presents); }
+        }
+        if (std::chrono::duration<double>(std::chrono::steady_clock::now() - g_lastDump).count() >= s_interval)
+            dumpLocked(t);
+    }
+}
+extern "C" void ps2xDrawTagSetName(uint32_t id, const char *name)
+{
+    if (id < 256u && name)
+    {
+        std::lock_guard<std::mutex> lk(ps2x_drawtag::g_m);
+        ps2x_drawtag::g_names[id] = name;
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_wshud.inl b/ps2xRuntime/src/lib/gs/gs_wshud.inl
new file mode 100644
index 0000000000000000000000000000000000000000..1f61c59250090a9a5da734afc58fb0e492afb701
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_wshud.inl
@@ -0,0 +1,257 @@
+// Widescreen HUD fix-up (PS2X_WS_HUD_SCALE=<s>, e.g. 0.75 for 4:3 content in a 16:9 picture; default off).
+// #included at the end of gs_frontend.cpp. Set by the game overrides (BLACKKAT_WIDESCREEN=1, BLACKKAT_WS_HUD!=0).
+// With a stretched 16:9 present the 3D uses a hor+ projection, but 2D HUD elements are drawn for 4:3 and would be
+// stretched by 1/s. This squeezes HUD primitives horizontally by s around an anchor (left edge, centre or right
+// edge, picked per element), so they keep their 4:3 proportions and stay pinned to the screen edges.
+//   HUD = (a) PATH2 (VIF DIRECT) primitives with Z test off/ALWAYS on the main frame buffer, not full-screen;
+//         (b) PATH1 (VU1) primitives on the main frame buffer after the end-of-frame marker: a full-screen untextured
+//             PATH2 sprite with constant Z > 0 (Black Kat: Z=16384), until the next PATH3 primitive (display blit).
+// Frames without any PATH1 (VU1 3D) draws for ~0.5 s (menus, loading text, FMVs) are presented at 4:3 with
+// pillarbox instead (g_ps2xPresentAspectDyn, read by the host present).
+//   PS2X_WS_HUD_LOG=1 : print a [wshud] line every 10 s (modes, markers, frames).
+#include <atomic>
+std::atomic<float> g_ps2xPresentAspectDyn{0.0f}; // 0 = use the static PS2X_PRESENT_ASPECT
+namespace ps2x_wshud
+{
+    namespace
+    {
+        std::atomic<uint64_t> g_p1Prims{0}, g_otherActivity{0};
+        std::atomic<bool> g_wide{true};
+        std::atomic<bool> g_seen3D{false};
+        std::atomic<uint64_t> g_fullCopies{0};
+        // stats
+        std::atomic<uint64_t> g_totalMarkers{0};
+        std::atomic<uint64_t> g_statMarkers{0}, g_statHud{0}, g_statBlits{0}, g_statP1Frames{0};
+        // GS-thread state
+        bool s_after = false, s_haveMain = false, s_inRun = false;
+        uint32_t s_mainFbp = 0;
+        int s_runPath = 0;
+        uint64_t s_runKey = 0;
+        float s_anchor = 0.0f;
+        float s_pb[4] = {0, 0, 0, 0};
+        bool s_p1SinceBlit = false;
+        float s_screenW = 640.0f, s_screenH = 448.0f;
+        // menu panels (shop, save, status): a HUD frame with a big panel is laid out as one 4:3 screen, so all of
+        // its elements are squeezed around the centre instead of each one snapping to the nearest edge (the shop
+        // panel used to stay at the left while its text went to the centre). Decided from the previous frame,
+        // whose marker ended it; PS2X_WS_HUD_PANEL=0 turns it off.
+        bool s_panelCur = false, s_panelPrev = false;
+    }
+
+    float scale()
+    {
+        static const float s = []() {
+            const char *e = std::getenv("PS2X_WS_HUD_SCALE");
+            const float v = e ? std::strtof(e, nullptr) : 0.0f;
+            if (v > 0.2f && v < 1.0f)
+                std::fprintf(stderr, "[wshud] widescreen HUD fix-up on, x-scale %.4f (PS2X_WS_HUD_SCALE)\n", v);
+            return (v > 0.2f && v < 1.0f) ? v : 0.0f;
+        }();
+        return s;
+    }
+    bool on() { return scale() > 0.0f; }
+
+    void onImage() { g_otherActivity.fetch_add(1, std::memory_order_relaxed); }
+    // A full-screen (>= 640x448) local->local GS copy: Black Kat's full-screen 2D menus (page map, world map, save)
+    // restore their 4:3 background picture into the frame buffer this way every frame.
+    void onFullCopy() { g_fullCopies.fetch_add(1, std::memory_order_relaxed); }
+
+    void onPrim(GSPrimitiveBatch &b, int path)
+    {
+        const GSContext &c = b.state.context;
+        const auto &pr = b.state.prim;
+        const float ofx = static_cast<float>(c.xyoffset.ofx >> 4), ofy = static_cast<float>(c.xyoffset.ofy >> 4);
+        const int n = b.vertexCount;
+        if (n <= 0)
+            return;
+        float x0 = 1e9f, y0 = 1e9f, x1 = -1e9f, y1 = -1e9f;
+        bool constZ = true;
+        for (int i = 0; i < n; ++i)
+        {
+            const float sx = b.vertices[i].x - ofx, sy = b.vertices[i].y - ofy;
+            x0 = std::min(x0, sx); x1 = std::max(x1, sx); y0 = std::min(y0, sy); y1 = std::max(y1, sy);
+            if (b.vertices[i].z != b.vertices[0].z)
+                constZ = false;
+        }
+        const bool full = x0 <= 1.0f && y0 <= 1.0f && x1 >= 639.0f && y1 >= 447.0f;
+        {
+            // PS2X_WS_HUD_MLOG=<n>: print the first n primitives drawn while presenting 4:3 (2D-only frames)
+            static const int s_mlog = []() { const char *e = std::getenv("PS2X_WS_HUD_MLOG"); return e ? std::atoi(e) : 0; }();
+            static int s_mn = 0;
+            static const long s_mfb = []() { const char *e = std::getenv("PS2X_WS_HUD_MLOGFB"); return e ? std::strtol(e, nullptr, 16) : -1L; }();
+            static const double s_mt = []() { const char *e = std::getenv("PS2X_WS_HUD_MLOGT"); return e ? std::atof(e) : 0.0; }();
+            static const auto s_mt0 = std::chrono::steady_clock::now();
+            if (s_mlog > 0 && g_seen3D.load(std::memory_order_relaxed) && s_mn < s_mlog &&
+                std::chrono::duration<double>(std::chrono::steady_clock::now() - s_mt0).count() >= s_mt &&
+                (s_mfb >= 0 ? (long)c.frame.fbp == s_mfb : !g_wide.load(std::memory_order_relaxed)))
+            {
+                ++s_mn;
+                std::fprintf(stderr, "[wsm] g%d p%d t%d tme%d fbp=%x tbp=%x psm=%x tw=%d z=%u zt=%u n=%d (%.0f,%.0f)-(%.0f,%.0f) uv0=(%u,%u) uv1=(%u,%u)\n",
+                             g_wide.load() ? 1 : 0, path, (int)pr.type, (int)pr.tme, (unsigned)c.frame.fbp, (unsigned)c.tex0.tbp0, (unsigned)c.tex0.psm,
+                             (int)c.tex0.tw, (unsigned)b.vertices[0].z, (unsigned)((c.test >> 16) & 7u), n, x0, y0, x1, y1,
+                             (unsigned)b.vertices[0].u, (unsigned)b.vertices[0].v, (unsigned)b.vertices[n - 1].u, (unsigned)b.vertices[n - 1].v);
+            }
+        }
+        if (path == 1)
+        {
+            g_p1Prims.fetch_add(1, std::memory_order_relaxed);
+            s_p1SinceBlit = true;
+        }
+        else
+            g_otherActivity.fetch_add(1, std::memory_order_relaxed);
+        if (path == 3)
+        {
+            if (full && c.frame.fbp != s_mainFbp && s_p1SinceBlit)
+            {
+                g_statBlits.fetch_add(1, std::memory_order_relaxed);
+                s_p1SinceBlit = false;
+            }
+            s_after = false;
+            s_inRun = false;
+            return;
+        }
+        if (path == 2 && pr.type == GS_PRIM_SPRITE && full)
+        {
+            if (!pr.tme && constZ && b.vertices[0].z > 0.0)
+            {
+                s_after = true;
+                s_panelPrev = s_panelCur; s_panelCur = false;
+                s_mainFbp = c.frame.fbp;
+                s_screenW = x1;
+                s_screenH = y1;
+                s_haveMain = true;
+                g_statMarkers.fetch_add(1, std::memory_order_relaxed);
+                g_totalMarkers.fetch_add(1, std::memory_order_relaxed);
+            }
+            else if (constZ && b.vertices[0].z == 0.0)
+                s_after = false;
+            s_inRun = false;
+            return;
+        }
+        if (!g_wide.load(std::memory_order_relaxed))
+        {
+            s_inRun = false;
+            return;
+        }
+        bool hud = false;
+        if (path == 2)
+        {
+            const bool zte = ((c.test >> 16) & 1u) != 0u;
+            const unsigned ztst = static_cast<unsigned>((c.test >> 17) & 3u);
+            hud = (!zte || ztst == 1u) && s_haveMain && c.frame.fbp == s_mainFbp && (x1 - x0) < 600.0f;
+        }
+        else if (path == 1)
+            hud = s_after && s_haveMain && c.frame.fbp == s_mainFbp;
+        // Primitives outside the visible picture (the marker's rectangle, e.g. 640x448) must stay invisible: Black Kat
+        // draws mirrored text glyphs off-screen (x > 640) that a squeeze would pull into view.
+        if (hud && (x1 > s_screenW + 1.0f || x0 < -1.0f || y1 > s_screenH + 1.0f || y0 < -1.0f))
+            hud = false;
+        // Untextured sprites anchored in the top-left corner (e.g. two 256x256 rects after the HUD) are render-target
+        // maintenance for the water reflection, not HUD; squeezing them leaves stale HUD pixels that show up mirrored.
+        if (hud && path == 2 && !pr.tme && x0 <= 0.5f && y0 <= 0.5f && (x1 - x0) >= 64.0f && (y1 - y0) >= 64.0f)
+            hud = false;
+        if (!hud)
+        {
+            s_inRun = false;
+            return;
+        }
+        g_statHud.fetch_add(1, std::memory_order_relaxed);
+        {
+            // PS2X_WS_HUD_PROGLOG=1 (with PS2X_DRAWTAG=1): count HUD primitives per VU1 program, printed every 4000
+            static const bool s_pl = []() { const char *e = std::getenv("PS2X_WS_HUD_PROGLOG"); return e && e[0] == '1'; }();
+            if (s_pl && path == 1)
+            {
+                static std::map<uint32_t, uint64_t> s_m;
+                static uint64_t s_n = 0;
+                ++s_m[(g_ps2xDrawTag & 0x7FFu) * 8u];
+                if (++s_n % 4000u == 0u)
+                {
+                    std::string o;
+                    for (const auto &kv : s_m) { char b[40]; std::snprintf(b, sizeof(b), " %x:%llu", kv.first, (unsigned long long)kv.second); o += b; }
+                    std::fprintf(stderr, "[wshud] hud path1 prims by program:%s\n", o.c_str());
+                }
+            }
+        }
+        static const bool s_panelOn = []() { const char *e = std::getenv("PS2X_WS_HUD_PANEL"); return !(e && e[0] == '0'); }();
+        if (s_panelOn && (x1 - x0) >= 360.0f && (y1 - y0) >= 200.0f)
+            s_panelCur = true;
+        const bool panel = s_panelOn && (s_panelCur || s_panelPrev);
+        const uint64_t key = (uint64_t)path | ((uint64_t)pr.type << 4) | ((uint64_t)pr.tme << 8) | ((uint64_t)c.tex0.psm << 9) |
+                             ((uint64_t)c.tex0.tbp0 << 16);
+        const float gap = path == 1 ? 64.0f : 48.0f;
+        const bool nearPrev = x0 <= s_pb[2] + gap && x1 >= s_pb[0] - gap && y0 <= s_pb[3] + gap && y1 >= s_pb[1] - gap;
+        const bool cont = s_inRun && s_runPath == path && (path == 1 || key == s_runKey) && nearPrev;
+        if (panel)
+            s_anchor = s_screenW * 0.5f;
+        else if (!cont)
+            s_anchor = x0 < s_screenW * 0.25f ? 0.0f : (x1 > s_screenW * 0.75f ? s_screenW : s_screenW * 0.5f);
+        s_inRun = true;
+        s_runPath = path;
+        s_runKey = key;
+        s_pb[0] = x0; s_pb[1] = y0; s_pb[2] = x1; s_pb[3] = y1;
+        {
+            static const bool dump = std::getenv("PS2X_WS_HUD_DUMP") != nullptr;
+            if (dump && g_totalMarkers.load(std::memory_order_relaxed) == 450)
+                std::fprintf(stderr, "[wshud-dump] path=%d prim=%d tme=%d tbp0=0x%x psm=0x%x tbw=%d fbp=0x%x n=%d bbox=(%.0f,%.0f)-(%.0f,%.0f) uv0=(%u,%u) anchor=%.0f new=%d\n",
+                             path, (int)pr.type, (int)pr.tme, (unsigned)c.tex0.tbp0, (unsigned)c.tex0.psm, (int)c.tex0.tbw,
+                             (unsigned)c.frame.fbp, n, x0, y0, x1, y1, (unsigned)b.vertices[0].u, (unsigned)b.vertices[0].v, s_anchor, cont ? 0 : 1);
+        }
+        const float s = scale();
+        for (int i = 0; i < n; ++i)
+        {
+            const float sx = b.vertices[i].x - ofx;
+            b.vertices[i].x = s_anchor + (sx - s_anchor) * s + ofx;
+        }
+    }
+
+    double wsT() { static const auto t0 = std::chrono::steady_clock::now(); return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(); }
+
+    // Host thread, once per presented frame.
+    void onPresent()
+    {
+        static int s_noP1 = 0;
+        static const float s_narrow = []() {
+            const char *e = std::getenv("PS2X_PRESENT_ASPECT");
+            const float a = e ? std::strtof(e, nullptr) : 0.0f;
+            return a > 0.5f ? a * scale() : 4.0f / 3.0f;
+        }();
+        const uint64_t p1 = g_p1Prims.exchange(0, std::memory_order_relaxed);
+        const uint64_t other = g_otherActivity.exchange(0, std::memory_order_relaxed);
+        if (p1 > 0)
+        {
+            s_noP1 = 0;
+            g_seen3D.store(true, std::memory_order_relaxed);
+            g_statP1Frames.fetch_add(1, std::memory_order_relaxed);
+            if (!g_wide.exchange(true))
+                std::fprintf(stderr, "[wshud] t=%.2f 3D frames: present 16:9\n", wsT());
+        }
+        else if (other > 0 && ++s_noP1 >= 30 && g_wide.exchange(false))
+            std::fprintf(stderr, "[wshud] t=%.2f no VU1 3D for 30 presents: present 4:3 pillarbox (aspect %.4f)\n", wsT(), s_narrow);
+        // Full-screen 2D menus are pictures drawn for 4:3 (no 3D behind them): switch to the pillarbox after 3 presents
+        // that restore a full-screen background without any VU1 3D, instead of showing them stretched for 0.5 s first.
+        // PS2X_WS_HUD_MENUFAST=0: old behaviour (30 presents).
+        {
+            static const bool s_fast = []() { const char *e = std::getenv("PS2X_WS_HUD_MENUFAST"); return !(e && e[0] == '0'); }();
+            static int s_menuRun = 0;
+            const uint64_t fc = g_fullCopies.exchange(0, std::memory_order_relaxed);
+            s_menuRun = (p1 == 0 && fc > 0) ? s_menuRun + 1 : (p1 > 0 ? 0 : s_menuRun);
+            if (s_fast && s_menuRun >= 3 && g_wide.exchange(false))
+                std::fprintf(stderr, "[wshud] t=%.2f full-screen 2D menu (background restore, no VU1 3D): present 4:3 pillarbox (aspect %.4f)\n", wsT(), s_narrow);
+        }
+        g_ps2xPresentAspectDyn.store(g_wide.load() ? 0.0f : s_narrow, std::memory_order_relaxed);
+
+        static const bool s_log = []() { const char *e = std::getenv("PS2X_WS_HUD_LOG"); return e && e[0] == '1'; }();
+        static auto s_t0 = std::chrono::steady_clock::now();
+        static uint64_t s_presents = 0;
+        ++s_presents;
+        const double el = std::chrono::duration<double>(std::chrono::steady_clock::now() - s_t0).count();
+        if (s_log && el >= 10.0)
+        {
+            std::fprintf(stderr, "[wshud] %.1fs: presents/s=%.1f presents-with-3D/s=%.1f markers/s=%.1f display-blits-after-3D/s=%.1f hud-prims/s=%.0f mode=%s\n",
+                         el, s_presents / el, g_statP1Frames.exchange(0) / el, g_statMarkers.exchange(0) / el, g_statBlits.exchange(0) / el,
+                         g_statHud.exchange(0) / el, g_wide.load() ? "16:9" : "4:3");
+            s_presents = 0;
+            s_t0 = std::chrono::steady_clock::now();
+        }
+    }
+}
