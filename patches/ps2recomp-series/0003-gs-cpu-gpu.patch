+                         (unsigned long long)m_statCut[(size_t)GSDrawListCut::Transfer], (unsigned long long)m_statCut[(size_t)GSDrawListCut::Readback],
+                         (unsigned long long)m_statCut[(size_t)GSDrawListCut::Clut], (unsigned long long)m_statCut[(size_t)GSDrawListCut::Finish],
+                         (unsigned long long)m_statCut[(size_t)GSDrawListCut::Present], (unsigned long long)m_statCut[(size_t)GSDrawListCut::Sync],
+                         (unsigned long long)m_statCut[(size_t)GSDrawListCut::Full],
