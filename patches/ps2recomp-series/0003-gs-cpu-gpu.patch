+    uint64_t clutHash = 0;
+    uint64_t content = 0; // PS2X_GS_TEXCACHE2: hash of the source VRAM pages (0 when off)
+    bool operator==(const TexKey &o) const
+    {
+        return content == o.content && tbp0 == o.tbp0 && tbw == o.tbw && psm == o.psm && cpsm == o.cpsm && csm == o.csm && csa == o.csa &&
+               ta0 == o.ta0 && ta1 == o.ta1 && aem == o.aem && w == o.w && h == o.h && clutHash == o.clutHash;
+    }
+};
+struct TexKeyHash
+{
+    size_t operator()(const TexKey &k) const
+    {
+        uint64_t h = k.clutHash * 0x9E3779B97F4A7C15ull;
+        auto mix = [&](uint64_t v) { h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2); };
+        mix(k.tbp0); mix((uint64_t(k.tbw) << 8) | k.psm); mix((uint64_t(k.cpsm) << 16) | (uint64_t(k.csm) << 8) | k.csa);
+        mix((uint64_t(k.ta0) << 16) | (uint64_t(k.ta1) << 8) | k.aem); mix((uint64_t(k.w) << 16) | k.h); mix(k.content);
+        return static_cast<size_t>(h);
+    }
+};
+struct TexEntry
+{
+    GLuint tex = 0;
+    uint64_t genSum = ~0ull;
+    GLint wrapS = -1, wrapT = -1, filter = -1;
+    std::vector<uint32_t> dbg; // PS2X_GS_TEXCACHE2_CHECK=1 only: decoded texels for compare
+    uint64_t lastUse = 0;      // Present() count when last bound (TEXCACHE2 eviction)
+    uint32_t bytes = 0;
+};
+struct TexFront
+{
+    uint64_t genSum = ~0ull; // page generations when 'content' was hashed
+    uint64_t content = 0;
+};
+
+// Default-on env toggle: unset or anything but '0' = on.
+inline bool envOn(const char *name)
+{
+    const char *e = std::getenv(name);
+    return !(e && e[0] == '0');
+}
+
+inline uint64_t tcMum(uint64_t a, uint64_t b)
+{
+    const __uint128_t r = static_cast<__uint128_t>(a) * b;
+    return static_cast<uint64_t>(r) ^ static_cast<uint64_t>(r >> 64);
+}
+
+// 64-bit content hash of one 8 KiB GS page (4 independent lanes, wyhash-style mixing).
+inline uint64_t tcHashPage(const uint8_t *d)
+{
+    uint64_t l0 = 0xa0761d6478bd642full, l1 = 0xe7037ed1a0b428dbull, l2 = 0x8ebc6af09c88c6e3ull, l3 = 0x589965cc75374cc3ull;
+    for (uint32_t i = 0; i < 8192u; i += 64u)
+    {
+        uint64_t w[8];
+        std::memcpy(w, d + i, 64);
+        l0 = tcMum(l0 ^ w[0], w[1] ^ 0x1d8e4e27c47d124full) + w[0];
+        l1 = tcMum(l1 ^ w[2], w[3] ^ 0x9E3779B97F4A7C15ull) + w[2];
+        l2 = tcMum(l2 ^ w[4], w[5] ^ 0xbf58476d1ce4e5b9ull) + w[4];
+        l3 = tcMum(l3 ^ w[6], w[7] ^ 0x94d049bb133111ebull) + w[6];
+    }
+    return tcMum(tcMum(l0, 0x9E3779B97F4A7C15ull) ^ l1, tcMum(l2, 0xbf58476d1ce4e5b9ull) ^ l3);
+}
+
+struct DrawKey
+{
+    GSFrameReg frame{};
+    GSScissorReg scissor{};
+    GSZbufReg zbuf{};
+    GSTex0Reg tex0{};
+    uint64_t clamp = 0, alpha = 0, test = 0, fba = 0, colclamp = 0;
+    uint8_t cls = 0, tme = 0, abe = 0, fge = 0, iip = 0, linear = 0, pabe = 0;
+    GSTexaReg texa{};
+    uint8_t fogR = 0, fogG = 0, fogB = 0;
+    uint16_t tw = 0, th = 0;
+};
+
+inline bool sameKey(const DrawKey &a, const DrawKey &b)
+{
+    return a.frame.fbp == b.frame.fbp && a.frame.fbw == b.frame.fbw && a.frame.psm == b.frame.psm && a.frame.fbmsk == b.frame.fbmsk &&
+           a.scissor.x0 == b.scissor.x0 && a.scissor.x1 == b.scissor.x1 && a.scissor.y0 == b.scissor.y0 && a.scissor.y1 == b.scissor.y1 &&
+           a.zbuf.zbp == b.zbuf.zbp && a.zbuf.psm == b.zbuf.psm && a.zbuf.zmask == b.zbuf.zmask &&
+           a.tex0.tbp0 == b.tex0.tbp0 && a.tex0.tbw == b.tex0.tbw && a.tex0.psm == b.tex0.psm && a.tex0.tw == b.tex0.tw &&
+           a.tex0.th == b.tex0.th && a.tex0.tcc == b.tex0.tcc && a.tex0.tfx == b.tex0.tfx && a.tex0.cbp == b.tex0.cbp &&
+           a.tex0.cpsm == b.tex0.cpsm && a.tex0.csm == b.tex0.csm && a.tex0.csa == b.tex0.csa &&
+           a.clamp == b.clamp && a.alpha == b.alpha && a.test == b.test && a.fba == b.fba && a.colclamp == b.colclamp &&
+           a.cls == b.cls && a.tme == b.tme && a.abe == b.abe && a.fge == b.fge && a.iip == b.iip && a.linear == b.linear &&
+           a.pabe == b.pabe && a.texa.ta0 == b.texa.ta0 && a.texa.aem == b.texa.aem && a.texa.ta1 == b.texa.ta1 &&
+           a.fogR == b.fogR && a.fogG == b.fogG && a.fogB == b.fogB && a.tw == b.tw && a.th == b.th;
+}
+
+const char *kVertexShader = R"(#version 330 core
+layout(location = 0) in vec4 aPos;   // window x, window y, z, fog
+layout(location = 1) in vec4 aColor; // 0..255
+layout(location = 2) in vec4 aStq;
+uniform vec2 uInvSize;
+noperspective out vec4 vColor;
+flat out vec4 vFlatColor;
+noperspective out vec3 vStq;
+noperspective out float vZ;
+noperspective out float vFog;
+void main()
+{
+    gl_Position = vec4(aPos.xy * uInvSize * 2.0 - 1.0, 0.0, 1.0);
+    vColor = aColor;
+    vFlatColor = aColor;
+    vStq = aStq.xyz;
+    vZ = aPos.z;
+    vFog = aPos.w;
+}
+)";
+
+const char *kFragmentShader = R"(#version 330 core
+noperspective in vec4 vColor;
+flat in vec4 vFlatColor;
+noperspective in vec3 vStq;
+noperspective in float vZ;
+noperspective in float vFog;
+uniform sampler2D uTex;
+uniform sampler2D uDst;
+uniform int uIip;
+uniform int uTme;
+uniform int uTfx;
+uniform int uTcc;
+uniform int uFge;
+uniform vec3 uFogCol;
+uniform int uAte;
+uniform int uAtst;
+uniform int uAref;
+uniform int uAtInv;
+uniform int uDate;
+uniform int uDatm;
+uniform int uFba;
+uniform int uAMsb;
+uniform int uCt16;
+uniform float uZmax;
+uniform int uRtt;       // PS2X_GS_SCALE_RTT: uTex is a GS render target (rgb = c/255, a = A/128)
+uniform vec2 uRttScale; // texture size / target texture size
+uniform vec2 uRttEdge;  // half a (scaled) texel in st units, for CLAMP
+uniform ivec2 uRttWrap; // 0 = repeat, 1 = clamp
+uniform int uRttCt24;   // sampled as CT24: alpha from TEXA
+uniform float uRttTa0;
+uniform int uRttAem;
+layout(location = 0, index = 0) out vec4 oColor;
+layout(location = 0, index = 1) out vec4 oFactor;
+void main()
+{
+    vec4 c = (uIip != 0) ? vColor : vFlatColor;
+    c = floor(c + 0.001);
+    if (uTme != 0)
+    {
+        vec2 st = vStq.xy / max(abs(vStq.z), 1e-20);
+        vec4 t;
+        if (uRtt != 0)
+        {
+            st.x = (uRttWrap.x == 0) ? fract(st.x) : clamp(st.x, uRttEdge.x, 1.0 - uRttEdge.x);
+            st.y = (uRttWrap.y == 0) ? fract(st.y) : clamp(st.y, uRttEdge.y, 1.0 - uRttEdge.y);
+            vec4 r = texture(uTex, st * uRttScale);
+            t.rgb = floor(clamp(r.rgb, 0.0, 1.0) * 255.0 + 0.5);
+            if (uRttCt24 != 0)
+                t.a = (uRttAem != 0 && t.r + t.g + t.b == 0.0) ? 0.0 : uRttTa0;
+            else
+                t.a = floor(clamp(r.a, 0.0, 2.0) * 128.0 + 0.5);
+            t.a = min(t.a, 255.0);
+        }
+        else
+            t = floor(texture(uTex, st) * 255.0 + 0.5);
+        if (uTfx == 0) {
+            c.rgb = floor(t.rgb * c.rgb / 128.0);
+            c.a = (uTcc != 0) ? floor(t.a * c.a / 128.0) : c.a;
+        } else if (uTfx == 1) {
+            c.rgb = t.rgb;
+            c.a = (uTcc != 0) ? t.a : c.a;
+        } else if (uTfx == 2) {
+            c.rgb = floor(t.rgb * c.rgb / 128.0) + c.a;
+            c.a = (uTcc != 0) ? t.a + c.a : c.a;
+        } else {
+            c.rgb = floor(t.rgb * c.rgb / 128.0) + c.a;
+            c.a = (uTcc != 0) ? t.a : c.a;
+        }
+        c = clamp(c, 0.0, 255.0);
+    }
+    if (uFge != 0)
+        c.rgb = floor((vFog * c.rgb + (255.0 - vFog) * uFogCol) / 256.0);
+
+    if (uAte != 0)
+    {
+        int a = int(c.a);
+        bool pass = true;
+        if (uAtst == 0) pass = false;
+        else if (uAtst == 2) pass = a < uAref;
+        else if (uAtst == 3) pass = a <= uAref;
+        else if (uAtst == 4) pass = a == uAref;
+        else if (uAtst == 5) pass = a >= uAref;
+        else if (uAtst == 6) pass = a > uAref;
+        else if (uAtst == 7) pass = a != uAref;
+        if (uAtInv != 0) pass = !pass;
+        if (!pass) discard;
+    }
+
+    float dstA = 0.0;
+    if (uDate != 0 || uAMsb != 0)
+        dstA = texelFetch(uDst, ivec2(gl_FragCoord.xy), 0).a * 128.0;
+    if (uDate != 0)
+    {
+        bool msb = dstA >= 127.5;
+        if (msb != (uDatm != 0)) discard;
+    }
+
+    gl_FragDepth = min(max(vZ, 0.0), uZmax) * (1.0 / 4294967296.0);
+
+    float sa = c.a;
+    if (uFba != 0 && sa < 128.0) sa += 128.0;
+    if (uAMsb != 0) sa = mod(sa, 128.0) + (dstA >= 127.5 ? 128.0 : 0.0);
+    if (uCt16 != 0) sa = (sa >= 128.0) ? 128.0 : 0.0;
+    oColor = vec4(c.rgb / 255.0, sa / 128.0);
+    oFactor = vec4(0.0, 0.0, 0.0, c.a / 128.0);
+}
+)";
+
+class GSGpuBackend final : public GSRasterBackend
+{
+public:
+    GSGpuBackend() = default;
+    ~GSGpuBackend() override { stop(); }
+    GSBackendKind Kind() const override { return GSBackendKind::OpenGL; }
+    const char *Name() const override { return "gl"; }
+    uint32_t Capabilities() const override { return kGSCapGpu | kGSCapDrawList; }
+
+    bool start()
+    {
+        std::promise<bool> ready;
+        std::future<bool> fut = ready.get_future();
+        m_thread = std::thread([this, &ready]() { threadMain(ready); });
+        const bool ok = fut.get();
+        if (!ok)
+        {
+            if (m_thread.joinable())
+                m_thread.join();
+        }
+        return ok;
+    }
+
+    // ---- GSRasterBackend -------------------------------------------------
+    void Initialize(uint8_t *vram, uint32_t vramSize) override
+    {
+        runSync([this, vram, vramSize]() {
+            m_vram = vram;
+            m_vramSize = vramSize;
+            m_cpu.Initialize(vram, vramSize);
+            dropAll();
+        });
+    }
+
+    void Reset() override
+    {
+        runSync([this]() {
+            m_cpu.Reset();
+            dropAll();
+            m_clutHash = m_cpu.ClutHash();
+        });
+    }
+
+    void Submit(const GSPrimitiveBatch &batch) override
+    {
+        Cmd c;
+        c.isDraw = true;
+        c.batch = batch;
+        push(std::move(c));
+    }
+
+    // Native draw list: one queue command per list instead of one per primitive. The worker rebuilds the exact
+    // per-primitive batches (same rules as the default replay) and feeds appendDraw, so GL output is unchanged.
+    void SubmitList(const GSDrawList &list) override
+    {
+        if (list.batches.empty())
+            return;
+        auto shared = std::make_shared<GSDrawList>(list);
+        Cmd c;
+        c.isDraw = false;
+        c.isList = true;
+        c.list = std::move(shared);
+        push(std::move(c));
+    }
+
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override
+    {
+        post([this, tex0, texclut]() {
+            const uint32_t cbw = (tex0.csm != 0u) ? std::max<uint32_t>(texclut.cbw, 1u) : 1u;
+            const uint32_t rows = (tex0.csm != 0u) ? static_cast<uint32_t>(texclut.cov) + 1u : 16u;
+            resolveOverlapping(pageSpan(tex0.cbp, cbw, tex0.cpsm, 64u, rows), nullptr);
+            m_cpu.LoadClut(tex0, texclut);
+            m_clutHash = m_cpu.ClutHash();
+        });
+    }
+
+    void BeginTransfer(const GSTransferCommand &command) override
+    {
+        post([this, command]() {
+            const auto &b = command.bitbltbuf;
+            const auto &p = command.trxpos;
+            const auto &r = command.trxreg;
+            const PageRange src = pageSpan(b.sbp, b.sbw, b.spsm, uint32_t(p.ssax) + r.rrw, uint32_t(p.ssay) + r.rrh);
+            const PageRange dst = pageSpan(b.dbp, b.dbw, b.dpsm, uint32_t(p.dsax) + r.rrw, uint32_t(p.dsay) + r.rrh);
+            m_xferActive = false;
+            switch (command.direction)
+            {
+            case 0: // host -> local
+                resolveOverlapping(dst, nullptr);
+                m_cpu.BeginTransfer(command);
+                m_xferDst = dst;
+                m_xferActive = true;
+                m_bumpTag = 1; vramWritten(dst);
+                break;
+            case 1: // local -> host
+                resolveOverlapping(src, nullptr);
+                m_cpu.BeginTransfer(command);
+                break;
+            case 2: // local -> local
+                resolveOverlapping(src, nullptr);
+                resolveOverlapping(dst, nullptr);
+                m_cpu.BeginTransfer(command);
+                m_bumpTag = 3; vramWritten(dst);
+                ++m_stats.localCopies;
+                break;
+            default:
+                m_cpu.BeginTransfer(command);
+                break;
+            }
+        });
+    }
+
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override
+    {
+        auto buf = std::make_shared<std::vector<uint8_t>>(data, data + sizeBytes);
+        post([this, buf]() {
+            if (m_xferActive)
+                resolveOverlapping(m_xferDst, nullptr);
+            m_cpu.UploadImage(buf->data(), static_cast<uint32_t>(buf->size()));
+            if (m_xferActive)
+                m_bumpTag = 2; vramWritten(m_xferDst);
+        });
+    }
+
+    void Flush() override {}
+
+    void TextureFlush() override
+    {
+        post([this]() { m_cpu.TextureFlush(); });
+    }
+
+    void Sync(GSSyncReason reason) override
+    {
+        // Every observable result already goes through an ordered, waiting command.
+        if (reason == GSSyncReason::Reset)
+            runSync([]() {});
+    }
+
+    PresentationFrame Present(const GSPresentationRequest &request) override
+    {
+        PresentationFrame out;
+        runSync([this, &request, &out]() {
+            ++m_presents;
+            if (!m_presentLazy)
+            {
+                resolveAll();
+                out = m_cpu.Present(request);
+                if (m_scale > 1)
+                    scalePresent(request, out, false, 0);
+                maybePrintStats();
+                return;
+            }
+            // PS2X_GS_PRESENT_LAZY: only make the memory Present can read current (display
+            // buffers, preferred source, context frames when a display is at fbp 0), and reuse
+            // the last converted frame when neither those pages nor the request changed.
+            PageRange rs[6];
+            int ctxN = 0;
+            int n = presentReadSet(request, rs, &ctxN);
+            // The context frames are only read when a single enabled display at fbp 0 comes out
+            // all black; resolve them up front only when both CRTs are on (merge path).
+            const bool bothCrt = (request.pmode & 3u) == 3u;
+            bool ctxDeferred = ctxN > 0 && !bothCrt && m_presentCtxLazy;
+            if (!ctxDeferred)
+                n += ctxN;
+            const bool fieldMode = (request.smode2 & 1u) != 0u && (request.smode2 & 2u) == 0u;
+            const int slot = fieldMode ? static_cast<int>(request.vsyncTick & 1u) : 0;
+            uint64_t gs = 0x51ed270b27a3c1f5ull;
+            m_rctx = 1;
+            for (int i = 0; i < n; ++i)
+                resolveOverlapping(rs[i], nullptr);
+            m_rctx = 0;
+            for (int i = 0; i < n; ++i)
+                gs = tcMum(gs ^ pageGenSum(rs[i]), 0x9E3779B97F4A7C15ull + static_cast<uint64_t>(i) * 0x1000193ull + rs[i].first);
+            if (m_statsOn && m_pcValid[slot] && gs != m_pcGen[slot] && m_presentDiag < 60 && m_presents > 2000)
+            {
+                ++m_presentDiag;
+                std::string tagsSeen;
+                for (int i = 0; i < n; ++i)
+                    for (uint32_t pg = rs[i].first; pg < rs[i].last; ++pg)
+                    {
+                        const uint32_t ix = pg & (kPages - 1u);
+                        if (m_pageGen[ix] != m_lastPageGenSnap[ix])
+                        {
+                            char b[48];
+                            std::snprintf(b, sizeof b, " p%u:t%u", ix, m_pageBumpTag[ix]);
+                            if (tagsSeen.size() < 400) tagsSeen += b;
+                        }
+                    }
+                std::fprintf(stderr, "[gs:gpu:presentdiag] present#%llu changed:%s\n", (unsigned long long)m_presents, tagsSeen.c_str());
+            }
+            if (m_statsOn && m_pcValid[slot] && gs == m_pcGen[slot] && !samePresentRequest(request, m_pcReq[slot], ctxDeferred) && m_presentDiag < 120)
+            {
+                ++m_presentDiag;
+                const auto &a = request; const auto &b = m_pcReq[slot];
+                std::fprintf(stderr, "[gs:gpu:presentdiag] reqdiff pmode=%d smode2=%llx/%llx disp=%d%d%d%d bg=%d tick=%llu/%llu pref=%d/%d dest=%u/%u prefFbp=%u/%u ctxDeferred=%d\n",
+                             a.pmode != b.pmode, (unsigned long long)a.smode2, (unsigned long long)b.smode2, a.dispfb1 != b.dispfb1,
+                             a.display1 != b.display1, a.dispfb2 != b.dispfb2, a.display2 != b.display2, a.bgcolor != b.bgcolor,
+                             (unsigned long long)a.vsyncTick, (unsigned long long)b.vsyncTick, a.hasPreferredSource, b.hasPreferredSource,
+                             a.preferredDestFbp, b.preferredDestFbp, a.preferredSource.fbp, b.preferredSource.fbp, ctxDeferred ? 1 : 0);
+            }
+            if (m_statsOn)
+                m_lastPageGenSnap = m_pageGen;
+            bool reused = false;
+            if (m_pcValid[slot] && gs == m_pcGen[slot] && samePresentRequest(request, m_pcReq[slot], ctxDeferred))
+            {
+                out = m_pcFrame[slot];
+                ++m_stats.presentReuse;
+                reused = true;
+            }
+            else
+            {
+                out = m_cpu.PresentInPlace(request);
+                bool cacheable = true;
+                if (ctxDeferred && (out.pixels.empty() || out.sourceFbp != out.displayFbp || presentAllBlack(out)))
+                {
+                    // Fallback may have looked at the (unresolved) context frames: redo it with
+                    // them current, and don't reuse this frame later.
+                    m_rctx = 1;
+                    for (int i = 0; i < ctxN; ++i)
+                        resolveOverlapping(rs[n + i], nullptr);
+                    m_rctx = 0;
+                    out = m_cpu.PresentInPlace(request);
+                    cacheable = false;
+                    ++m_stats.presentCtxRedo;
+                }
+                m_pcFrame[slot] = out;
+                m_pcReq[slot] = request;
+                m_pcGen[slot] = gs;
+                m_pcValid[slot] = cacheable;
+                ++m_stats.presentConvert;
+            }
+            if (m_presentCheck)
+            {
+                // Debug: full resolve + the original snapshot Present, compared with what we return.
+                resolveAll();
+                const PresentationFrame ref = m_cpu.Present(request);
+                ++m_stats.presentChecks;
+                if (ref.width != out.width || ref.height != out.height || ref.pixels != out.pixels ||
+                    ref.displayFbp != out.displayFbp || ref.sourceFbp != out.sourceFbp || ref.usedPreferred != out.usedPreferred)
+                {
+                    ++m_stats.presentMismatches;
+                    size_t diff = 0;
+                    for (size_t i = 0; i < ref.pixels.size() && i < out.pixels.size(); ++i)
+                        diff += ref.pixels[i] != out.pixels[i];
+                    if (++m_presentMismatchTotal <= 30)
+                        std::fprintf(stderr, "[gs:gpu:presentcheck] MISMATCH reuse=%d %ux%u vs %ux%u bytes-differ=%zu dispfb1=%llx dispfb2=%llx\n",
+                                     (m_stats.presentReuse && gs == m_pcGen[slot]) ? 1 : 0, out.width, out.height, ref.width, ref.height, diff,
+                                     (unsigned long long)request.dispfb1, (unsigned long long)request.dispfb2);
+                    out = ref;
+                    m_pcValid[slot] = false;
+                }
+            }
+            if (m_scale > 1)
+                scalePresent(request, out, reused, slot);
+            maybePrintStats();
+        });
+        return out;
+    }
+
+    // PS2X_GS_SCALE > 1: replace the native frame by the displayed rectangle read straight from
+    // the scaled render target, when that target holds the displayed picture. Otherwise the
+    // native frame is kept (the host scales it to the window).
+    void scalePresent(const GSPresentationRequest &request, PresentationFrame &out, bool reused, int slot)
+    {
+        if (!out || out.usedPreferred)
+        {
+            m_scaledValid[slot] = false;
+            ++m_scaledFallbacks;
+            return;
+        }
+        if (reused && m_scaledValid[slot])
+        {
+            out = m_scaledFrame[slot];
+            return;
+        }
+        m_scaledValid[slot] = false;
+        const bool crt1 = (request.pmode & 1u) != 0u, crt2 = (request.pmode & 2u) != 0u;
+        const uint64_t dispfb = crt1 ? request.dispfb1 : request.dispfb2;
+        const uint32_t fbp = static_cast<uint32_t>(dispfb & 0x1FFu);
+        const uint32_t fbw = static_cast<uint32_t>((dispfb >> 9) & 0x3Fu);
+        const uint8_t psm = static_cast<uint8_t>((dispfb >> 15) & 0x1Fu);
+        const int dbx = static_cast<int>((dispfb >> 32) & 0x7FFu), dby = static_cast<int>((dispfb >> 43) & 0x7FFu);
+        auto it = m_targets.find(fbp);
+        const char *why = nullptr;
+        if (crt1 && crt2) why = "both CRTs";
+        else if (out.sourceFbp != fbp) why = "source is not the display buffer";
+        else if (it == m_targets.end()) why = "no GPU target";
+        else if (it->second.stale) why = "target stale (CPU wrote it)";
+        else if (it->second.psm != psm || it->second.fbw != std::max<uint32_t>(fbw, 1u)) why = "format differs";
+        else if (static_cast<uint32_t>(dby) + out.height > it->second.rows || dbx + static_cast<int>(out.width) > kDim) why = "outside target";
+        if (why)
+        {
+            ++m_scaledFallbacks;
+            if (m_scaleLog < 12 && std::strcmp(why, m_lastScaleWhy ? m_lastScaleWhy : "") != 0)
+            {
+                ++m_scaleLog;
+                std::fprintf(stderr, "[gs:gpu:scale] native present (%s) fbp=%u psm=%u present#%llu\n", why, fbp, psm,
+                             (unsigned long long)m_presents);
+            }
+            m_lastScaleWhy = why;
+            return;
+        }
+        m_lastScaleWhy = nullptr;
+        const int S = m_scale;
+        const int w = static_cast<int>(out.width) * S, h = static_cast<int>(out.height) * S;
+        PresentationFrame f;
+        f.width = static_cast<uint32_t>(w);
+        f.height = static_cast<uint32_t>(h);
+        f.displayFbp = out.displayFbp;
+        f.sourceFbp = out.sourceFbp;
+        f.pixels.resize(static_cast<size_t>(w) * h * 4u);
+        gl.glBindFramebuffer(GL_READ_FRAMEBUFFER, m_readFbo);
+        gl.glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, it->second.tex, 0);
+        gl.glReadBuffer(GL_COLOR_ATTACHMENT0);
+        gl.glReadPixels(dbx * S, dby * S, w, h, GL_RGBA, GL_UNSIGNED_BYTE, f.pixels.data());
+        for (size_t i = 3; i < f.pixels.size(); i += 4)
+            f.pixels[i] = 255u;
+        out = std::move(f);
+        m_scaledFrame[slot] = out;
+        m_scaledValid[slot] = true;
+        ++m_scaledPresents;
+    }
+    int m_scaleLog = 0;
+    const char *m_lastScaleWhy = nullptr;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override
+    {
+        bool result = false;
+        runSync([this, &context, rgba, &result]() {
+            const PageRange r = pageSpan(context.frame.fbp << 5u, std::max<uint32_t>(context.frame.fbw, 1u), context.frame.psm,
+                                         0u, static_cast<uint32_t>(context.scissor.y1) + 1u);
+            resolveOverlapping(r, nullptr);
+            result = m_cpu.ClearFramebuffer(context, rgba);
+            m_bumpTag = 4; vramWritten(r);
+        });
+        return result;
+    }
+
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override
+    {
+        uint32_t n = 0;
+        runSync([this, dst, maxBytes, &n]() { n = m_cpu.ConsumeLocalToHostBytes(dst, maxBytes); });
+        return n;
+    }
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override
+    {
+        auto *self = const_cast<GSGpuBackend *>(this);
+        uint32_t v = 0;
+        self->runSync([self, psm, base, bw, x, y, &v]() {
+            self->resolveOverlapping(pageSpan(base, bw, psm, x + 1u, y + 1u), nullptr);
+            v = self->m_cpu.ReadVram(psm, base, bw, x, y);
+        });
+        return v;
+    }
+
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+    {
+        post([this, psm, base, bw, x, y, value]() {
+            const PageRange r = pageSpan(base, bw, psm, x + 1u, y + 1u);
+            resolveOverlapping(r, nullptr);
+            m_cpu.WriteVram(psm, base, bw, x, y, value);
+            m_bumpTag = 5; vramWritten(r);
+        });
+    }
+
+    void SnapshotVram(std::vector<uint8_t> &out) const override
+    {
+        auto *self = const_cast<GSGpuBackend *>(this);
+        self->runSync([self, &out]() {
+            self->resolveAll();
+            self->m_cpu.SnapshotVram(out);
+        });
+    }
+
+    GSTransferSnapshot GetTransferSnapshot() const override
+    {
+        // Debug/progress info only; GSCpuBackend guards it with its own mutex.
+        return m_cpu.GetTransferSnapshot();
+    }
+
+private:
+    struct Cmd
+    {
+        bool isDraw = false;
+        bool isList = false;
+        GSPrimitiveBatch batch{};
+        std::function<void()> fn;
+        std::shared_ptr<GSDrawList> list;
+    };
+
+    void appendList(const GSDrawList &list)
+    {
+        GSPrimitiveBatch prim{};
+        for (const GSDrawListBatch &b : list.batches)
+        {
+            prim.state = b.state;
+            prim.vertexCount = b.vertsPerPrim;
+            const uint32_t n = b.vertsPerPrim > 3u ? 3u : b.vertsPerPrim;
+            for (uint32_t p = 0; p < b.primCount; ++p)
+            {
+                const size_t base = static_cast<size_t>(b.firstVertex) + static_cast<size_t>(p) * b.vertsPerPrim;
+                if (base + n > list.vertices.size())
+                    break;
+                for (uint32_t v = 0; v < n; ++v)
+                    prim.vertices[v] = list.vertices[base + v];
+                appendDraw(prim);
+            }
+        }
+    }
+
+    struct Stats
+    {
+        uint64_t prims = 0, batches = 0, resolves = 0, resolvedPixels = 0, uploads = 0, texDecodes = 0, texHits = 0,
+                 localCopies = 0, dstCopies = 0, texHashes = 0, pageHashes = 0, texChecks = 0, texMismatches = 0, texEvicts = 0, presentReuse = 0, presentConvert = 0, presentChecks = 0, presentMismatches = 0, presentCtxRedo = 0;
+        uint64_t resolveBy[4] = {0, 0, 0, 0};
+    };
+
+    // ---- queue -------------------------------------------------------------
+    uint64_t push(Cmd &&c)
+    {
+        std::unique_lock<std::mutex> lk(m_qm);
+        if (m_queue.size() >= kMaxQueue)
+        {
+            const auto t0 = std::chrono::steady_clock::now();
+            m_spaceCv.wait(lk, [&]() { return m_queue.size() < kMaxQueue || m_stop; });
+            m_fullWaitNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+        }
+        m_queue.push_back(std::move(c));
+        const uint64_t seq = ++m_pushed;
+        lk.unlock();
+        m_qcv.notify_one();
+        return seq;
+    }
+
+    template <typename F>
+    uint64_t post(F &&f)
+    {
+        Cmd c;
+        c.isDraw = false;
+        c.fn = std::forward<F>(f);
+        return push(std::move(c));
+    }
+
+    template <typename F>
+    void runSync(F &&f)
+    {
+        if (std::this_thread::get_id() == m_threadId)
+        {
+            flushDraws();
+            f();
+            return;
+        }
+        const uint64_t seq = post(std::forward<F>(f));
+        const auto t0 = std::chrono::steady_clock::now();
+        std::unique_lock<std::mutex> lk(m_qm);
+        m_doneCv.wait(lk, [&]() { return m_done >= seq || m_stop; });
+        m_syncWaitNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+    }
+
+    void stop()
+    {
+        {
+            std::lock_guard<std::mutex> lk(m_qm);
+            m_stop = true;
+        }
+        m_qcv.notify_all();
+        m_spaceCv.notify_all();
+        m_doneCv.notify_all();
+        if (m_thread.joinable())
+            m_thread.join();
+    }
+
+    void threadMain(std::promise<bool> &ready)
+    {
+        m_threadId = std::this_thread::get_id();
+        pthread_setname_np(pthread_self(), "GSGpu"); // thread CPU% in PS2X_PROF
+        const bool ok = initGL();
+        ready.set_value(ok);
+        if (!ok)
+            return;
+        std::vector<Cmd> local;
+        local.reserve(kMaxQueue);
+        for (;;)
+        {
+            {
+                std::unique_lock<std::mutex> lk(m_qm);
+                m_qcv.wait(lk, [&]() { return !m_queue.empty() || m_stop; });
+                if (m_stop && m_queue.empty())
+                    break;
+                local.swap(m_queue);
+            }
+            m_spaceCv.notify_all();
+            const auto busy0 = std::chrono::steady_clock::now();
+            for (Cmd &c : local)
+            {
+                if (c.isDraw)
+                    appendDraw(c.batch);
+                else if (c.isList)
+                    appendList(*c.list);
+                else
+                {
+                    flushDraws();
+                    c.fn();
+                }
+            }
+            const uint64_t n = local.size();
+            local.clear();
+            m_busyNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - busy0).count());
+            {
+                std::lock_guard<std::mutex> lk(m_qm);
+                m_done += n;
+            }
+            m_doneCv.notify_all();
+        }
+        shutdownGL();
+    }
+
+    // ---- GL setup ------------------------------------------------------------
+    bool initGL()
+    {
+        m_eglLib = dlopen("libEGL.so.1", RTLD_NOW | RTLD_LOCAL);
+        if (!m_eglLib)
+        {
+            std::fprintf(stderr, "[gs:gpu] dlopen libEGL.so.1 failed: %s\n", dlerror());
+            return false;
+        }
+#define GSGPU_EGL(n) auto n##_p = reinterpret_cast<decltype(&::n)>(dlsym(m_eglLib, #n))
+        GSGPU_EGL(eglGetProcAddress);
+        GSGPU_EGL(eglGetDisplay);
+        GSGPU_EGL(eglInitialize);
+        GSGPU_EGL(eglBindAPI);
+        GSGPU_EGL(eglChooseConfig);
+        GSGPU_EGL(eglCreateContext);
+        GSGPU_EGL(eglMakeCurrent);
+        GSGPU_EGL(eglGetError);
+#undef GSGPU_EGL
+        m_eglDestroyContext = reinterpret_cast<decltype(&::eglDestroyContext)>(dlsym(m_eglLib, "eglDestroyContext"));
+        m_eglTerminate = reinterpret_cast<decltype(&::eglTerminate)>(dlsym(m_eglLib, "eglTerminate"));
+        m_eglMakeCurrent = eglMakeCurrent_p;
+        if (!eglGetProcAddress_p || !eglGetDisplay_p || !eglInitialize_p || !eglBindAPI_p || !eglChooseConfig_p ||
+            !eglCreateContext_p || !eglMakeCurrent_p || !eglGetError_p)
+        {
+            std::fprintf(stderr, "[gs:gpu] libEGL is missing core entry points\n");
+            return false;
+        }
+
+        auto getPlatformDisplay = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress_p("eglGetPlatformDisplayEXT"));
+        EGLint major = 0, minor = 0;
+        m_dpy = EGL_NO_DISPLAY;
+        if (getPlatformDisplay && !envFlag("PS2X_GS_GPU_DEFAULT_DISPLAY"))
+        {
+            m_dpy = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+            if (m_dpy != EGL_NO_DISPLAY && !eglInitialize_p(m_dpy, &major, &minor))
+                m_dpy = EGL_NO_DISPLAY;
+        }
+        if (m_dpy == EGL_NO_DISPLAY)
+        {
+            m_dpy = eglGetDisplay_p(EGL_DEFAULT_DISPLAY);
+            if (m_dpy == EGL_NO_DISPLAY || !eglInitialize_p(m_dpy, &major, &minor))
+            {
+                std::fprintf(stderr, "[gs:gpu] eglInitialize failed (0x%x)\n", eglGetError_p());
+                m_dpy = EGL_NO_DISPLAY;
+                return false;
+            }
+        }
+        if (!eglBindAPI_p(EGL_OPENGL_API))
+        {
+            std::fprintf(stderr, "[gs:gpu] eglBindAPI(OpenGL) failed\n");
+            return false;
+        }
+        EGLConfig config = nullptr;
+        EGLint numConfigs = 0;
+        const EGLint cfgAttribs[] = {EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT, EGL_NONE};
+        if (!eglChooseConfig_p(m_dpy, cfgAttribs, &config, 1, &numConfigs) || numConfigs < 1)
+        {
+            const EGLint cfgAttribs2[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT, EGL_NONE};
+            numConfigs = 0;
+            if (!eglChooseConfig_p(m_dpy, cfgAttribs2, &config, 1, &numConfigs) || numConfigs < 1)
+                config = nullptr; // EGL_KHR_no_config_context
+        }
+        const EGLint ctxAttribs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 3,
+                                     EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT, EGL_NONE};
+        m_ctx = eglCreateContext_p(m_dpy, config, EGL_NO_CONTEXT, ctxAttribs);
+        if (m_ctx == EGL_NO_CONTEXT)
+        {
+            std::fprintf(stderr, "[gs:gpu] eglCreateContext(GL 3.3 core) failed (0x%x)\n", eglGetError_p());
+            return false;
+        }
+        if (!eglMakeCurrent_p(m_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, m_ctx))
+        {
+            std::fprintf(stderr, "[gs:gpu] eglMakeCurrent(surfaceless) failed (0x%x)\n", eglGetError_p());
+            return false;
+        }
+        bool missing = false;
+#define GSGPU_LOAD(t, n)                                                         \
+    gl.n = reinterpret_cast<t>(eglGetProcAddress_p(#n));                          \
+    if (!gl.n) { std::fprintf(stderr, "[gs:gpu] missing GL entry point %s\n", #n); missing = true; }
+        GSGPU_GL_FUNCS(GSGPU_LOAD)
+#undef GSGPU_LOAD
+        if (missing)
+            return false;
+
+        std::fprintf(stderr, "[gs:gpu] OpenGL renderer: %s | %s (EGL %d.%d)\n",
+                     reinterpret_cast<const char *>(gl.glGetString(GL_RENDERER)),
+                     reinterpret_cast<const char *>(gl.glGetString(GL_VERSION)), major, minor);
+
+        if (!buildProgram())
+            return false;
+
+        gl.glGenVertexArrays(1, &m_vao);
+        gl.glBindVertexArray(m_vao);
+        gl.glGenBuffers(1, &m_vbo);
+        gl.glBindBuffer(GL_ARRAY_BUFFER, m_vbo);
+        const GLsizei stride = kFloatsPerVertex * sizeof(float);
+        gl.glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, stride, reinterpret_cast<void *>(0));
+        gl.glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, stride, reinterpret_cast<void *>(4 * sizeof(float)));
+        gl.glVertexAttribPointer(2, 4, GL_FLOAT, GL_FALSE, stride, reinterpret_cast<void *>(8 * sizeof(float)));
+        gl.glEnableVertexAttribArray(0);
+        gl.glEnableVertexAttribArray(1);
+        gl.glEnableVertexAttribArray(2);
+        gl.glProvokingVertex(GL_LAST_VERTEX_CONVENTION);
+
+        gl.glGenFramebuffers(1, &m_drawFbo);
+        gl.glGenFramebuffers(1, &m_readFbo);
+        gl.glGenFramebuffers(1, &m_scratchFbo);
+        m_scratchTex = makeColorTexture();
+        gl.glBindFramebuffer(GL_FRAMEBUFFER, m_scratchFbo);
+        gl.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_scratchTex, 0);
+        if (m_scale > 1)
+        {
+            gl.glGenFramebuffers(1, &m_nativeFbo);
+            m_nativeTex = makeColorTexture(kDim);
+            gl.glBindFramebuffer(GL_FRAMEBUFFER, m_nativeFbo);
+            gl.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_nativeTex, 0);
+            std::fprintf(stderr, "[gs:gpu] internal resolution %dx (targets %dx%d, resolve %s)\n", m_scale, kDim * m_scale,
+                         kDim * m_scale, m_resolveNearest ? "nearest" : "linear");
+        }
+        gl.glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        gl.glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        gl.glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        if (const GLenum err = gl.glGetError(); err != GL_NO_ERROR)
+            std::fprintf(stderr, "[gs:gpu] GL error after init: 0x%x\n", err);
+        m_statsOn = envFlag("PS2X_GS_GPU_STATS");
+        m_lastStats = std::chrono::steady_clock::now();
+        return true;
+    }
+
+    void shutdownGL()
+    {
+        dropAll();
+        if (m_dpy != EGL_NO_DISPLAY)
+        {
+            if (m_eglMakeCurrent)
+                m_eglMakeCurrent(m_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            if (m_ctx != EGL_NO_CONTEXT && m_eglDestroyContext)
+                m_eglDestroyContext(m_dpy, m_ctx);
+        }
+        m_ctx = EGL_NO_CONTEXT;
+        m_dpy = EGL_NO_DISPLAY;
+    }
+
+    GLuint compile(GLenum type, const char *src)
+    {
+        GLuint sh = gl.glCreateShader(type);
+        gl.glShaderSource(sh, 1, &src, nullptr);
+        gl.glCompileShader(sh);
+        GLint ok = 0;
+        gl.glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+        if (!ok)
+        {
+            char log[4096] = {};
+            gl.glGetShaderInfoLog(sh, sizeof(log), nullptr, log);
+            std::fprintf(stderr, "[gs:gpu] shader compile failed:\n%s\n", log);
+            return 0;
+        }
+        return sh;
+    }
+
+    bool buildProgram()
+    {
+        GLuint vs = compile(GL_VERTEX_SHADER, kVertexShader);
+        GLuint fs = compile(GL_FRAGMENT_SHADER, kFragmentShader);
+        if (!vs || !fs)
+            return false;
+        m_prog = gl.glCreateProgram();
+        gl.glAttachShader(m_prog, vs);
+        gl.glAttachShader(m_prog, fs);
+        gl.glLinkProgram(m_prog);
+        GLint ok = 0;
+        gl.glGetProgramiv(m_prog, GL_LINK_STATUS, &ok);
+        if (!ok)
+        {
+            char log[4096] = {};
+            gl.glGetProgramInfoLog(m_prog, sizeof(log), nullptr, log);
+            std::fprintf(stderr, "[gs:gpu] program link failed:\n%s\n", log);
+            return false;
+        }
+        gl.glUseProgram(m_prog);
+#define GSGPU_U(n) u.n = gl.glGetUniformLocation(m_prog, #n)
+        GSGPU_U(uInvSize); GSGPU_U(uTex); GSGPU_U(uDst); GSGPU_U(uIip); GSGPU_U(uTme); GSGPU_U(uTfx); GSGPU_U(uTcc);
+        GSGPU_U(uFge); GSGPU_U(uFogCol); GSGPU_U(uAte); GSGPU_U(uAtst); GSGPU_U(uAref); GSGPU_U(uAtInv); GSGPU_U(uDate);
+        GSGPU_U(uDatm); GSGPU_U(uFba); GSGPU_U(uAMsb); GSGPU_U(uCt16); GSGPU_U(uZmax);
+        GSGPU_U(uRtt); GSGPU_U(uRttScale); GSGPU_U(uRttEdge); GSGPU_U(uRttWrap); GSGPU_U(uRttCt24); GSGPU_U(uRttTa0);
+        GSGPU_U(uRttAem);
+#undef GSGPU_U
+        gl.glUniform1i(u.uTex, 0);
+        gl.glUniform1i(u.uDst, 1);
+        gl.glUniform2f(u.uInvSize, 1.0f / kDim, 1.0f / kDim);
+        return true;
+    }
+
+    GLuint makeColorTexture(int dim = 0)
+    {
+        if (dim <= 0)
+            dim = kDim * m_scale;
+        GLuint t = 0;
+        gl.glGenTextures(1, &t);
+        gl.glBindTexture(GL_TEXTURE_2D, t);
+        gl.glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA16F, dim, dim, 0, GL_RGBA, GL_FLOAT, nullptr);
+        gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        return t;
+    }
+
+    void dropAll()
+    {
+        if (!gl.glDeleteTextures)
+            return;
+        for (auto &kv : m_targets)
+            gl.glDeleteTextures(1, &kv.second.tex);
+        m_targets.clear();
+        for (auto &kv : m_depth)
+            gl.glDeleteTextures(1, &kv.second);
+        m_depth.clear();
+        for (auto &kv : m_texCache)
+            gl.glDeleteTextures(1, &kv.second.tex);
+        m_texCache.clear();
+        m_verts.clear();
+        m_haveKey = false;
+        m_attachedColor = m_attachedDepth = 0;
+        m_pageGen.fill(0);
+        m_pageHashGen.fill(0);
+        m_texFront.clear();
+        m_texBytes = 0;
+        ++m_globalGen;
+    }
+
+    // ---- VRAM coherency -------------------------------------------------------
+    void bumpPages(const PageRange &r)
+    {
+        for (uint32_t p = r.first; p < r.last; ++p)
+        {
+            ++m_pageGen[p & (kPages - 1u)];
+            m_pageBumpTag[p & (kPages - 1u)] = m_bumpTag;
+        }
+        m_bumpTag = 0;
+    }
+
+    uint64_t pageGenSum(const PageRange &r) const
+    {
+        uint64_t s = m_globalGen << 40;
+        for (uint32_t p = r.first; p < r.last; ++p)
+            s += m_pageGen[p & (kPages - 1u)] * (p + 1u);
+        return s;
+    }
+
+    // CPU side just wrote 'r' in VRAM: GPU copies of it are stale, textures from it too.
+    void vramWritten(const PageRange &r)
+    {
+        bumpPages(r);
+        for (auto &kv : m_targets)
+        {
+            Target &t = kv.second;
+            if (t.range().overlaps(r))
+            {
+                if (t.gpuDirty) // should have been resolved by the caller; never drop GPU data
+                    resolve(t);
+                t.stale = true;
+            }
+        }
+    }
+
+    void resolveOverlapping(const PageRange &r, const Target *except)
+    {
+        for (auto &kv : m_targets)
+        {
+            Target &t = kv.second;
+            if (&t != except && t.gpuDirty && t.range().overlaps(r))
+                resolve(t);
+        }
+    }
+
+    void resolveAll()
+    {
+        for (auto &kv : m_targets)
+            if (kv.second.gpuDirty)
+                resolve(kv.second);
+    }
+
+    void resolve(Target &t)
+    {
+        if (!t.gpuDirty)
+            return;
+        t.gpuDirty = false;
+        const int w = std::min<int>(kDim, static_cast<int>(t.fbw) * 64);
+        Rect rc = t.dirty;
+        rc.x0 = std::max(rc.x0, 0);
+        rc.y0 = std::max(rc.y0, 0);
+        rc.x1 = std::min(rc.x1, w - 1);
+        rc.y1 = std::min(rc.y1, static_cast<int>(t.rows) - 1);
+        t.dirty = Rect{};
+        if (rc.empty() || !m_vram)
+            return;
+        const int rw = rc.x1 - rc.x0 + 1;
+        const int rh = rc.y1 - rc.y0 + 1;
+        m_readback.resize(static_cast<size_t>(rw) * rh * 4u);
+        gl.glBindFramebuffer(GL_READ_FRAMEBUFFER, m_readFbo);
+        gl.glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t.tex, 0);
+        gl.glReadBuffer(GL_COLOR_ATTACHMENT0);
+        if (m_scale > 1)
+        {
+            // Downsample the scaled rectangle into the native scratch, then read that.
+            const int S = m_scale;
+            gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_nativeFbo);
+            gl.glDisable(GL_SCISSOR_TEST);
+            gl.glBlitFramebuffer(rc.x0 * S, rc.y0 * S, (rc.x1 + 1) * S, (rc.y1 + 1) * S, rc.x0, rc.y0, rc.x1 + 1, rc.y1 + 1,
+                                 GL_COLOR_BUFFER_BIT, m_resolveNearest ? GL_NEAREST : GL_LINEAR);
+            gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_drawFbo);
+            gl.glBindFramebuffer(GL_READ_FRAMEBUFFER, m_nativeFbo);
+            gl.glReadBuffer(GL_COLOR_ATTACHMENT0);
+        }
+        gl.glReadPixels(rc.x0, rc.y0, rw, rh, GL_RGBA, GL_FLOAT, m_readback.data());
+        const uint32_t bp = t.fbp << 5u;
+        const uint32_t bw = t.fbw;
+        const float *src = m_readback.data();
+        auto to8 = [](float v, float scale) -> uint32_t {
+            float f = v * scale + 0.5f;
+            f = f < 0.0f ? 0.0f : (f > 255.0f ? 255.0f : f);
+            return static_cast<uint32_t>(f);
+        };
+        for (int y = 0; y < rh; ++y)
+        {
+            const uint32_t gy = static_cast<uint32_t>(rc.y0 + y);
+            for (int x = 0; x < rw; ++x, src += 4)
+            {
+                const uint32_t gx = static_cast<uint32_t>(rc.x0 + x);
+                const uint32_t r = to8(src[0], 255.0f), g = to8(src[1], 255.0f), b = to8(src[2], 255.0f);
+                const uint32_t a = to8(src[3], 128.0f);
+                switch (t.psm)
+                {
+                case GS_PSM_CT32:
+                    GSMem::WriteCT32(m_vram, bp, bw, gx, gy, r | (g << 8) | (b << 16) | (a << 24));
+                    break;
+                case GS_PSM_CT24:
+                    GSMem::WriteCT24(m_vram, bp, bw, gx, gy, r | (g << 8) | (b << 16));
+                    break;
+                case GS_PSM_CT16:
+                case GS_PSM_CT16S:
+                {
+                    const uint32_t v = (r >> 3) | ((g >> 3) << 5) | ((b >> 3) << 10) | ((a >= 0x80u ? 1u : 0u) << 15);
+                    if (t.psm == GS_PSM_CT16)
+                        GSMem::WriteCT16(m_vram, bp, bw, gx, gy, v);
+                    else
+                        GSMem::WriteCT16S(m_vram, bp, bw, gx, gy, v);
+                    break;
+                }
+                default:
+                    m_cpu.WriteVram(t.psm, bp, bw, gx, gy, r | (g << 8) | (b << 16) | (a << 24));
+                    break;
+                }
+            }
+        }
+        m_bumpTag = 16 + (t.fbp & 0xFFF) * 32; bumpPages(pageSpan(bp, bw, t.psm, 0, static_cast<uint32_t>(rc.y1) + 1u));
+        ++m_stats.resolves;
+        ++m_stats.resolveBy[m_rctx & 3];
+        if (m_statsOn && m_resolveLog < 40 && m_presents > 2000)
+        {
+            ++m_resolveLog;
+            std::fprintf(stderr, "[gs:gpu:resolve] ctx=%d fbp=%u fbw=%u psm=%u rect=%d,%d-%d,%d present#%llu\n", m_rctx, t.fbp, t.fbw, t.psm,
+                         rc.x0, rc.y0, rc.x1, rc.y1, (unsigned long long)m_presents);
+        }
+        m_stats.resolvedPixels += static_cast<uint64_t>(rw) * rh;
+    }
+
+    void uploadRows(Target &t, uint32_t from, uint32_t to)
+    {
+        if (to <= from || !m_vram)
+            return;
+        const int w = std::min<int>(kDim, static_cast<int>(t.fbw) * 64);
+        const int rows = static_cast<int>(to - from);
+        m_upload.resize(static_cast<size_t>(w) * rows * 4u);
+        float *dst = m_upload.data();
+        const uint32_t bp = t.fbp << 5u;
+        const uint32_t bw = t.fbw;
+        for (int y = 0; y < rows; ++y)
+        {
+            const uint32_t gy = from + static_cast<uint32_t>(y);
+            for (int x = 0; x < w; ++x, dst += 4)
+            {
+                uint32_t r, g, b, a;
+                switch (t.psm)
+                {
+                case GS_PSM_CT32:
+                {
+                    const uint32_t v = GSMem::ReadCT32(m_vram, bp, bw, static_cast<uint32_t>(x), gy);
+                    r = v & 0xFF; g = (v >> 8) & 0xFF; b = (v >> 16) & 0xFF; a = v >> 24;
+                    break;
+                }
+                case GS_PSM_CT24:
+                {
+                    const uint32_t v = GSMem::ReadCT24(m_vram, bp, bw, static_cast<uint32_t>(x), gy);
+                    r = v & 0xFF; g = (v >> 8) & 0xFF; b = (v >> 16) & 0xFF; a = 0x80;
+                    break;
+                }
+                case GS_PSM_CT16:
+                case GS_PSM_CT16S:
+                case GS_PSM_Z16:
+                case GS_PSM_Z16S:
+                {
+                    const uint32_t v = m_cpu.ReadVram(t.psm, bp, bw, static_cast<uint32_t>(x), gy);
+                    r = (v & 0x1F) << 3; g = ((v >> 5) & 0x1F) << 3; b = ((v >> 10) & 0x1F) << 3; a = (v & 0x8000) ? 0x80 : 0;
+                    break;
+                }
+                default:
+                {
+                    const uint32_t v = m_cpu.ReadVram(t.psm, bp, bw, static_cast<uint32_t>(x), gy);
+                    r = v & 0xFF; g = (v >> 8) & 0xFF; b = (v >> 16) & 0xFF; a = v >> 24;
+                    break;
+                }
+                }
+                dst[0] = r / 255.0f;
+                dst[1] = g / 255.0f;
+                dst[2] = b / 255.0f;
+                dst[3] = a / 128.0f;
+            }
+        }
+        if (m_scale > 1)
+        {
+            const int S = m_scale;
+            gl.glBindTexture(GL_TEXTURE_2D, m_nativeTex);
+            gl.glTexSubImage2D(GL_TEXTURE_2D, 0, 0, static_cast<GLint>(from), w, rows, GL_RGBA, GL_FLOAT, m_upload.data());
+            gl.glBindFramebuffer(GL_READ_FRAMEBUFFER, m_nativeFbo);
+            gl.glReadBuffer(GL_COLOR_ATTACHMENT0);
+            gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_readFbo);
+            gl.glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t.tex, 0);
+            gl.glDisable(GL_SCISSOR_TEST);
+            gl.glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+            gl.glBlitFramebuffer(0, static_cast<GLint>(from), w, static_cast<GLint>(to), 0, static_cast<GLint>(from) * S, w * S,
+                                 static_cast<GLint>(to) * S, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            gl.glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+            gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_drawFbo);
+        }
+        else
+        {
+            gl.glBindTexture(GL_TEXTURE_2D, t.tex);
+            gl.glTexSubImage2D(GL_TEXTURE_2D, 0, 0, static_cast<GLint>(from), w, rows, GL_RGBA, GL_FLOAT, m_upload.data());
+        }
+        ++m_stats.uploads;
+    }
+
+    Target &prepareTarget(const GSFrameReg &frame, uint32_t rowsNeeded)
+    {
+        const uint32_t fbw = std::max<uint32_t>(frame.fbw, 1u);
+        auto it = m_targets.find(frame.fbp);
+        if (it == m_targets.end())
+        {
+            Target t;
+            t.fbp = frame.fbp;
+            t.fbw = fbw;
+            t.psm = frame.psm;
+            t.tex = makeColorTexture();
+            it = m_targets.emplace(frame.fbp, t).first;
+        }
+        Target &t = it->second;
+        if (t.fbw != fbw || t.psm != frame.psm)
+        {
+            resolve(t);
+            t.fbw = fbw;
+            t.psm = frame.psm;
+            t.stale = true;
+        }
+        rowsNeeded = std::min<uint32_t>(std::max<uint32_t>(rowsNeeded, 1u), kDim);
+        if (t.stale || rowsNeeded > t.rows)
+        {
+            const uint32_t from = t.stale ? 0u : t.rows;
+            const uint32_t to = std::max(t.rows, rowsNeeded);
+            // Make VRAM current for that range before pulling it in.
+            resolveOverlapping(pageSpan(t.fbp << 5u, t.fbw, t.psm, 0, to), &t);
+            uploadRows(t, from, to);
+            t.rows = to;
+            t.stale = false;
+        }
+        return t;
+    }
+
+    void markDirty(Target &t, const Rect &rc)
+    {
+        if (!t.gpuDirty)
+        {
+            // Other targets aliasing this memory become stale once we draw here.
+            const PageRange mine = t.range();
+            for (auto &kv : m_targets)
+            {
+                Target &o = kv.second;
+                if (&o == &t || !o.range().overlaps(mine))
+                    continue;
+                m_rctx = 3;
+                resolve(o);
+                m_rctx = 0;
+                o.stale = true;
+            }
+            t.gpuDirty = true;
+            t.dirty = rc;
+        }
+        else
+            t.dirty.add(rc);
+    }
+
+    GLuint prepareDepth(uint32_t zbp, bool &created)
+    {
+        created = false;
+        auto it = m_depth.find(zbp);
+        if (it != m_depth.end())
+            return it->second;
+        GLuint t = 0;
+        gl.glGenTextures(1, &t);
+        gl.glBindTexture(GL_TEXTURE_2D, t);
+        gl.glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT32F, kDim * m_scale, kDim * m_scale, 0, GL_DEPTH_COMPONENT, GL_FLOAT, nullptr);
+        gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        m_depth.emplace(zbp, t);
+        created = true;
+        return t;
+    }
+
+    // PS2X_GS_SCALE_RTT: a draw that samples a whole render target (same base, width and a 32/24-bit
+    // format) reads the GPU target itself, so render-to-texture effects keep the internal resolution.
+    // Anything else (offsets, CLUT formats, CPU-newer data, sampling the target being drawn) falls back
+    // to the native resolve + CPU decode path.
+    Target *rttSource(const GSDrawState &st, const Target &dst)
+    {
+        const auto &tx = st.context.tex0;
+        int why = 0;
+        Target *t = nullptr;
+        const uint32_t w = std::min<uint32_t>(std::max<uint32_t>(st.textureWidth, 1u), kDim);
+        const uint32_t h = std::min<uint32_t>(std::max<uint32_t>(st.textureHeight, 1u), kDim);
+        auto it = ((tx.tbp0 & 31u) == 0u) ? m_targets.find(tx.tbp0 >> 5u) : m_targets.end();
+        if (it == m_targets.end())
+            why = 2; // not a render target base (ordinary texture)
+        else
+        {
+            t = &it->second;
+            if ((tx.psm != GS_PSM_CT32 && tx.psm != GS_PSM_CT24) || (t->psm != GS_PSM_CT32 && t->psm != GS_PSM_CT24))
+                why = 1;
+            else if (t->fbw != tx.tbw || w > t->fbw * 64u)
+                why = 3;
+            else if (t == &dst)
+                why = 4;
+            else if (t->stale)
+                why = 5;
+            else if (h > t->rows && !m_rttRowsLoose)
+                why = 6;
+        }
+        ++m_rttCount[why];
+        if (why != 0 && why != 2 && m_rttLog < 24 && m_presents > 1500)
+        {
+            ++m_rttLog;
+            std::fprintf(stderr, "[gs:gpu:rtt] fallback why=%d tbp=0x%x tbw=%u psm=0x%x %ux%u target fbw=%u psm=0x%x rows=%u\n", why,
+                         tx.tbp0, tx.tbw, tx.psm, w, h, t ? t->fbw : 0u, t ? t->psm : 0u, t ? t->rows : 0u);
+        }
+        if (m_presents >= m_rttNextLog)
+        {
+            m_rttNextLog = m_presents + 1200;
+            std::fprintf(stderr, "[gs:gpu:rtt] hits=%llu fmt=%llu nontarget=%llu width=%llu self=%llu stale=%llu rows=%llu\n",
+                         (unsigned long long)m_rttCount[0], (unsigned long long)m_rttCount[1], (unsigned long long)m_rttCount[2],
+                         (unsigned long long)m_rttCount[3], (unsigned long long)m_rttCount[4], (unsigned long long)m_rttCount[5],
+                         (unsigned long long)m_rttCount[6]);
+        }
+        if (why == 0 && m_rttHitLog < 8 && m_presents > 1500)
+        {
+            ++m_rttHitLog;
+            std::fprintf(stderr, "[gs:gpu:rtt] hit tbp=0x%x tbw=%u psm=0x%x %ux%u -> fbp=0x%x (target psm=0x%x rows=%u, drawing to fbp=0x%x)\n",
+                         tx.tbp0, tx.tbw, tx.psm, w, h, t->fbp, t->psm, t->rows, dst.fbp);
+        }
+        return why == 0 ? t : nullptr;
+    }
+
+    TexEntry *prepareTexture(const GSDrawState &st)
+    {
+        const auto &tx = st.context.tex0;
+        const uint32_t w = std::min<uint32_t>(std::max<uint32_t>(st.textureWidth, 1u), kDim);
+        const uint32_t h = std::min<uint32_t>(std::max<uint32_t>(st.textureHeight, 1u), kDim);
+        const PageRange r = pageSpan(tx.tbp0, tx.tbw, tx.psm, w, h);
+        m_rctx = 2;
+        resolveOverlapping(r, nullptr); // render-to-texture: make VRAM current first
+        m_rctx = 0;
+
+        TexKey k;
+        k.tbp0 = tx.tbp0;
+        k.tbw = tx.tbw;
+        k.psm = tx.psm;
+        k.w = static_cast<uint16_t>(w);
+        k.h = static_cast<uint16_t>(h);
+        const bool indexed = tx.psm == GS_PSM_T8 || tx.psm == GS_PSM_T8H || tx.psm == GS_PSM_T4 ||
+                             tx.psm == GS_PSM_T4HL || tx.psm == GS_PSM_T4HH;
+        const bool usesTexa = indexed ? (tx.cpsm != GS_PSM_CT32) : (tx.psm != GS_PSM_CT32);
+        if (indexed)
+        {
+            k.cpsm = tx.cpsm;
+            k.csm = tx.csm;
+            k.csa = tx.csa;
+            k.clutHash = m_clutHash;
+        }
+        if (usesTexa)
+        {
+            k.ta0 = st.texa.ta0;
+            k.ta1 = st.texa.ta1;
+            k.aem = st.texa.aem ? 1 : 0;
+        }
+        if (m_tc2 && (m_texCache.size() > 4096 || m_texBytes > (256ull << 20)))
+            evictTextures();
+        if (m_texCache.size() > 4096 || m_texBytes > (768ull << 20))
+        {
+            for (auto &kv : m_texCache)
+                gl.glDeleteTextures(1, &kv.second.tex);
+            m_texCache.clear();
+            m_texFront.clear();
+            m_texBytes = 0;
+        }
+        const uint64_t gen = pageGenSum(r);
+        if (m_tc2)
+        {
+            // Content-addressed: page generations only say "maybe changed"; the hash of the
+            // source pages decides. Re-uploads of identical data and A/B textures sharing one
+            // VRAM slot then hit instead of re-decoding.
+            TexFront &f = m_texFront[k];
+            if (f.genSum != gen)
+            {
+                f.content = contentHash(r);
+                f.genSum = gen;
+                ++m_stats.texHashes;
+            }
+            k.content = f.content;
+        }
+        TexEntry &e = m_texCache[k];
+        if (!e.tex)
+        {
+            gl.glGenTextures(1, &e.tex);
+            gl.glBindTexture(GL_TEXTURE_2D, e.tex);
+            gl.glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, static_cast<GLsizei>(w), static_cast<GLsizei>(h), 0, GL_RGBA,
+                            GL_UNSIGNED_BYTE, nullptr);
+            e.bytes = w * h * 4u;
+            m_texBytes += e.bytes;
+        }
+        e.lastUse = m_presents;
+        const bool decode = m_tc2 ? (e.genSum == ~0ull) : (e.genSum != gen);
+        if (decode)
+        {
+            m_texels.resize(static_cast<size_t>(w) * h);
+            m_cpu.DecodeTextureRgba(st, w, h, m_texels.data());
+            gl.glBindTexture(GL_TEXTURE_2D, e.tex);
+            gl.glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, static_cast<GLsizei>(w), static_cast<GLsizei>(h), GL_RGBA,
+                               GL_UNSIGNED_BYTE, m_texels.data());
+            e.genSum = m_tc2 ? 0ull : gen;
+            if (m_tc2Check)
+                e.dbg = m_texels;
+            ++m_stats.texDecodes;
+        }
+        else
+        {
+            ++m_stats.texHits;
+            if (m_tc2Check)
+            {
+                // Debug: decode anyway and compare with what the cached texture was built from.
+                m_texels.resize(static_cast<size_t>(w) * h);
+                m_cpu.DecodeTextureRgba(st, w, h, m_texels.data());
+                ++m_stats.texChecks;
+                if (e.dbg.size() != m_texels.size() || std::memcmp(e.dbg.data(), m_texels.data(), m_texels.size() * 4u) != 0)
+                {
+                    ++m_stats.texMismatches;
+                    ++m_texMismatchTotal;
+                    size_t diff = 0;
+                    for (size_t i = 0; i < m_texels.size() && i < e.dbg.size(); ++i)
+                        diff += e.dbg[i] != m_texels[i];
+                    if (m_texMismatchTotal <= 50)
+                        std::fprintf(stderr, "[gs:gpu:texcheck] MISMATCH tbp=0x%x tbw=%u psm=0x%x %ux%u cpsm=0x%x csa=%u clut=%016llx content=%016llx texels-differ=%zu\n",
+                                     k.tbp0, k.tbw, k.psm, w, h, k.cpsm, k.csa, (unsigned long long)k.clutHash,
+                                     (unsigned long long)k.content, diff);
+                    // keep rendering correct in check mode
+                    gl.glBindTexture(GL_TEXTURE_2D, e.tex);
+                    gl.glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, static_cast<GLsizei>(w), static_cast<GLsizei>(h), GL_RGBA,
+                                       GL_UNSIGNED_BYTE, m_texels.data());
+                    e.dbg = m_texels;
+                }
+            }
+        }
+        return &e;
+    }
+
+    static uint32_t presentDisplayHeight(uint64_t display64)
+    {
+        // mirrors decodeDisplaySize() in gs_cpu_backend.cpp
+        const uint32_t dw = static_cast<uint32_t>((display64 >> 32) & 0x0FFFu);
+        const uint32_t dh = static_cast<uint32_t>((display64 >> 44) & 0x07FFu);
+        const uint32_t magh = static_cast<uint32_t>((display64 >> 23) & 0x0Fu);
+        uint32_t w = (dw + 1u) / (magh + 1u), h = dh + 1u;
+        if (w < 64u || h < 64u)
+            h = 448u;
+        return std::min<uint32_t>(h, 512u);
+    }
+
+    // Display/preferred ranges into rs[0..n); context-frame ranges (only read by the
+    // "fbp 0 display is all black" fallback) into rs[n..n+*ctxN).
+    int presentReadSet(const GSPresentationRequest &q, PageRange *rs, int *ctxN = nullptr) const
+    {
+        int n = 0;
+        const uint32_t h1 = presentDisplayHeight(q.display1), h2 = presentDisplayHeight(q.display2);
+        const uint32_t hm = std::max(h1, h2);
+        auto disp = [&](uint64_t fb, uint32_t h) {
+            const uint32_t fbp = static_cast<uint32_t>(fb & 0x1FFu), fbw = static_cast<uint32_t>((fb >> 9) & 0x3Fu);
+            const uint32_t psm = static_cast<uint32_t>((fb >> 15) & 0x1Fu);
+            const uint32_t ox = static_cast<uint32_t>((fb >> 32) & 0x7FFu), oy = static_cast<uint32_t>((fb >> 43) & 0x7FFu);
+            rs[n++] = pageSpan(fbp << 5u, fbw ? fbw : 10u, psm, ox + 640u, oy + h);
+        };
+        // only enabled CRTs are read (PMODE.EN1/EN2, same as decodePmode())
+        if (q.pmode & 1u)
+            disp(q.dispfb1, h1);
+        if (q.pmode & 2u)
+            disp(q.dispfb2, h2);
+        if (q.hasPreferredSource) // base in blocks (frameBaseIsPages=false)
+            rs[n++] = pageSpan(q.preferredSource.fbp, q.preferredSource.fbw ? q.preferredSource.fbw : 10u, q.preferredSource.psm, 640u, hm);
+        int c = 0;
+        if (((q.pmode & 1u) && (q.dispfb1 & 0x1FFu) == 0u) || ((q.pmode & 2u) && (q.dispfb2 & 0x1FFu) == 0u))
+            for (const GSFrameReg &cf : q.contextFrames)
+                rs[n + c++] = pageSpan(cf.fbp << 5u, cf.fbw ? cf.fbw : 10u, cf.psm, 640u, hm);
+        if (ctxN)
+            *ctxN = c;
+        else
+            n += c;
+        return n;
+    }
+
+    static bool presentAllBlack(const PresentationFrame &f)
+    {
+        // same test as countNonBlackPixels() (RGB != 0), over the whole host frame
+        const uint8_t *p = f.pixels.data();
+        const size_t n = f.pixels.size() / 4u;
+        for (size_t i = 0; i < n; ++i)
+            if (p[i * 4u] | p[i * 4u + 1u] | p[i * 4u + 2u])
+                return false;
+        return true;
+    }
+
+    static bool sameFrameReg(const GSFrameReg &a, const GSFrameReg &b)
+    {
+        return a.fbp == b.fbp && a.fbw == b.fbw && a.psm == b.psm && a.fbmsk == b.fbmsk;
+    }
+
+    // ctxIgnored: the cached frame did not take the black-display fallback, so the context
+    // frames did not influence it (and won't, while the display pages are unchanged).
+    static bool samePresentRequest(const GSPresentationRequest &a, const GSPresentationRequest &b, bool ctxIgnored)
+    {
+        const bool fieldMode = (a.smode2 & 1u) != 0u && (a.smode2 & 2u) == 0u; // as decodeSMode2/fieldMode
+        const bool prefUsed = a.hasPreferredSource || b.hasPreferredSource;
+        return a.pmode == b.pmode && a.smode2 == b.smode2 && a.dispfb1 == b.dispfb1 && a.display1 == b.display1 &&
+               a.dispfb2 == b.dispfb2 && a.display2 == b.display2 && a.bgcolor == b.bgcolor &&
+               (!fieldMode || ((a.vsyncTick ^ b.vsyncTick) & 1u) == 0u) &&
+               (ctxIgnored || (sameFrameReg(a.contextFrames[0], b.contextFrames[0]) && sameFrameReg(a.contextFrames[1], b.contextFrames[1]))) &&
+               a.hasPreferredSource == b.hasPreferredSource &&
+               (!prefUsed || (sameFrameReg(a.preferredSource, b.preferredSource) && a.preferredDestFbp == b.preferredDestFbp));
+    }
+
+    // TEXCACHE2: drop entries not bound in the last ~2 s of presents (oldest-first fallback).
+    void evictTextures()
+    {
+        uint64_t age = 120;
+        while (m_texCache.size() > 2048 || m_texBytes > (192ull << 20))
+        {
+            for (auto it = m_texCache.begin(); it != m_texCache.end();)
+            {
+                if (m_presents - it->second.lastUse >= age)
+                {
+                    gl.glDeleteTextures(1, &it->second.tex);
+                    m_texBytes -= it->second.bytes;
+                    it = m_texCache.erase(it);
+                    ++m_stats.texEvicts;
+                }
+                else
+                    ++it;
+            }
+            if (age == 0)
+                break;
+            age /= 2;
+        }
+    }
+
+    uint64_t pageHash(uint32_t p)
+    {
+        const uint32_t i = p & (kPages - 1u);
+        if (m_pageHashGen[i] != m_pageGen[i] + 1u)
+        {
+            m_pageHash[i] = (m_vram && (i + 1u) * 8192u <= m_vramSize) ? tcHashPage(m_vram + i * 8192u) : 0u;
+            m_pageHashGen[i] = m_pageGen[i] + 1u;
+            ++m_stats.pageHashes;
+        }
+        return m_pageHash[i];
+    }
+
+    uint64_t contentHash(const PageRange &r)
+    {
+        uint64_t h = 0x243f6a8885a308d3ull ^ (static_cast<uint64_t>(r.last - r.first) << 32);
+        for (uint32_t p = r.first; p < r.last; ++p)
+            h = tcMum(h ^ pageHash(p), 0x9E3779B97F4A7C15ull + p);
+        return h | 1u; // never 0 (0 = "off" in TexKey)
+    }
+
+    // ---- drawing --------------------------------------------------------------
+    static uint8_t primClass(GSPrimType t)
+    {
+        switch (t)
+        {
+        case GS_PRIM_POINT: return 0;
+        case GS_PRIM_LINE:
+        case GS_PRIM_LINESTRIP: return 1;
+        case GS_PRIM_SPRITE: return 3;
+        default: return 2;
+        }
+    }
+
+    void appendDraw(const GSPrimitiveBatch &batch)
+    {
+        const GSDrawState &st = batch.state;
+        const auto &ctx = st.context;
+        const uint8_t cls = primClass(st.prim.type);
+        DrawKey k;
+        k.frame = ctx.frame;
+        k.scissor = ctx.scissor;
+        k.zbuf = ctx.zbuf;
+        k.test = ctx.test;
+        k.fba = ctx.fba;
+        k.colclamp = st.colclamp;
+        k.cls = (cls == 3) ? 2 : cls;
+        k.iip = (cls == 3) ? 0 : (st.prim.iip ? 1 : 0);
+        k.tme = st.prim.tme ? 1 : 0;
+        k.abe = st.prim.abe ? 1 : 0;
+        k.fge = st.prim.fge ? 1 : 0;
+        k.pabe = st.pabe ? 1 : 0;
+        if (k.tme)
+        {
+            k.tex0 = ctx.tex0;
+            k.tex0.cld = 0;
+            k.clamp = ctx.clamp;
+            k.texa = st.texa;
+            k.tw = st.textureWidth;
+            k.th = st.textureHeight;
+            k.linear = st.linearFilter ? 1 : 0;
+        }
+        if (k.abe)
+            k.alpha = ctx.alpha;
+        if (k.fge)
+        {
+            k.fogR = st.fogR;
+            k.fogG = st.fogG;
+            k.fogB = st.fogB;
+        }
+        if (!m_haveKey || !sameKey(k, m_key))
+        {
+            flushDraws();
+            m_key = k;
+            m_state = st;
+            m_haveKey = true;
+        }
+        ++m_stats.prims;
+
+        // Same pixel convention as the CPU rasterizer (integer XYOFFSET, pixel sampled at
+        // its centre x+0.5), so both paths line up for comparison.
+        const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+        const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+        const float tw = static_cast<float>(std::max<uint16_t>(st.textureWidth, 1));
+        const float th = static_cast<float>(std::max<uint16_t>(st.textureHeight, 1));
+        const float pc = (cls <= 1) ? 0.5f : 0.0f; // points/lines: hit the pixel centre
+        auto emit = [&](float x, float y, const GSVertex &cv, float s, float t, float q) {
+            const float gx = x - ofx, gy = y - ofy;
+            const float vtx[kFloatsPerVertex] = {gx + pc, gy + pc, static_cast<float>(cv.z), static_cast<float>(cv.fog),
+                                                 float(cv.r), float(cv.g), float(cv.b), float(cv.a), s, t, q, 0.0f};
+            m_verts.insert(m_verts.end(), vtx, vtx + kFloatsPerVertex);
+            m_bbox.add(Rect{static_cast<int>(std::floor(gx)), static_cast<int>(std::floor(gy)),
+                            static_cast<int>(std::ceil(gx)), static_cast<int>(std::ceil(gy))});
+        };
+        auto stq = [&](const GSVertex &v, float &s, float &t, float &q) {
+            if (st.prim.fst) { s = (v.u / 16.0f) / tw; t = (v.v / 16.0f) / th; q = 1.0f; }
+            else { s = v.s; t = v.t; q = v.q; }
+        };
+
+        if (cls == 3)
+        {
+            const GSVertex &v0 = batch.vertices[0];
+            const GSVertex &v1 = batch.vertices[1];
+            float s0, t0, q0, s1, t1, q1;
+            stq(v0, s0, t0, q0);
+            stq(v1, s1, t1, q1);
+            if (!st.prim.fst)
+            {
+                const float a0 = std::max(std::fabs(q0), 1e-20f), a1 = std::max(std::fabs(q1), 1e-20f);
+                s0 /= a0; t0 /= a0; s1 /= a1; t1 /= a1;
+                q0 = q1 = 1.0f;
+            }
+            emit(v0.x, v0.y, v1, s0, t0, 1.0f);
+            emit(v1.x, v0.y, v1, s1, t0, 1.0f);
+            emit(v0.x, v1.y, v1, s0, t1, 1.0f);
+            emit(v1.x, v0.y, v1, s1, t0, 1.0f);
+            emit(v1.x, v1.y, v1, s1, t1, 1.0f);
+            emit(v0.x, v1.y, v1, s0, t1, 1.0f);
+        }
+        else
+        {
+            const int n = (cls == 0) ? 1 : (cls == 1 ? 2 : 3);
+            for (int i = 0; i < n && i < batch.vertexCount; ++i)
+            {
+                const GSVertex &v = batch.vertices[i];
+                float s, t, q;
+                stq(v, s, t, q);
+                emit(v.x, v.y, v, s, t, q);
+            }
+            if (batch.vertexCount < n) // malformed; drop what we added
+                m_verts.resize(m_verts.size() - static_cast<size_t>(std::min<int>(n, batch.vertexCount)) * kFloatsPerVertex);
+        }
+        if (m_verts.size() >= kMaxBatchFloats)
+            flushDraws();
+    }
+
+    void logOnce(const char *what, uint64_t value)
+    {
+        const uint64_t key = (reinterpret_cast<uintptr_t>(what) * 31u) ^ value;
+        if (m_logged.size() < 256 && m_logged.emplace(key, 1).second)
+            std::fprintf(stderr, "[gs:gpu] approximated: %s (0x%llx)\n", what, static_cast<unsigned long long>(value));
+    }
+
+    void setBlend(const DrawKey &k, uint8_t fpsm)
+    {
+        if (!k.abe)
+        {
+            gl.glDisable(GL_BLEND);
+            return;
+        }
+        const int A = static_cast<int>(k.alpha & 3u), B = static_cast<int>((k.alpha >> 2) & 3u);
+        const int C = static_cast<int>((k.alpha >> 4) & 3u), D = static_cast<int>((k.alpha >> 6) & 3u);
+        const float fix = static_cast<float>((k.alpha >> 32) & 0xFFu) / 128.0f;
+        GLenum F = GL_SRC1_ALPHA, OMF = GL_ONE_MINUS_SRC1_ALPHA;
+        if (C == 1 && fpsm != GS_PSM_CT24) { F = GL_DST_ALPHA; OMF = GL_ONE_MINUS_DST_ALPHA; }
+        else if (C == 1) { F = GL_CONSTANT_ALPHA; OMF = GL_ONE_MINUS_CONSTANT_ALPHA; gl.glBlendColor(0, 0, 0, 1.0f); }
+        else if (C >= 2) { F = GL_CONSTANT_ALPHA; OMF = GL_ONE_MINUS_CONSTANT_ALPHA; gl.glBlendColor(0, 0, 0, fix); }
+        if (C == 3) logOnce("ALPHA.C=3 (reserved)", k.alpha);
+        // Output = (A - B) * F + D, expressed as coefficients of Cs and Cd.
+        auto coef = [&](int which, GLenum &factor, int &sign) {
+            const int kf = (A == which ? 1 : 0) - (B == which ? 1 : 0);
+            const int k1 = (D == which ? 1 : 0);
+            sign = 1;
+            if (k1 == 0 && kf == 0) factor = GL_ZERO;
+            else if (k1 == 1 && kf == 0) factor = GL_ONE;
+            else if (k1 == 0 && kf == 1) factor = F;
+            else if (k1 == 0 && kf == -1) { factor = F; sign = -1; }
+            else if (k1 == 1 && kf == -1) factor = OMF;
+            else { factor = GL_ONE; logOnce("blend coefficient 1+f", k.alpha); }
+        };
+        GLenum sf, df;
+        int ss, ds;
+        coef(0, sf, ss);
+        coef(1, df, ds);
+        if (sf == GL_ZERO) ss = 1;
+        if (df == GL_ZERO) ds = 1;
+        GLenum eq = GL_FUNC_ADD;
+        if (ss > 0 && ds < 0) eq = GL_FUNC_SUBTRACT;
+        else if (ss < 0 && ds > 0) eq = GL_FUNC_REVERSE_SUBTRACT;
+        else if (ss < 0 && ds < 0) { sf = GL_ZERO; df = GL_ZERO; }
+        gl.glEnable(GL_BLEND);
+        gl.glBlendEquationSeparate(eq, GL_FUNC_ADD);
+        gl.glBlendFuncSeparate(sf, df, GL_ONE, GL_ZERO);
+        if (k.pabe)
+            logOnce("PABE ignored", k.alpha);
+    }
+
+    void flushDraws()
+    {
+        if (m_verts.empty())
+            return;
+        const DrawKey &k = m_key;
+        const GSDrawState &st = m_state;
+        const auto &ctx = st.context;
+        const GLsizei count = static_cast<GLsizei>(m_verts.size() / kFloatsPerVertex);
+
+        Rect rc{ctx.scissor.x0, ctx.scissor.y0, ctx.scissor.x1, ctx.scissor.y1};
+        rc.x0 = std::max(rc.x0, m_bbox.x0 - 1);
+        rc.y0 = std::max(rc.y0, m_bbox.y0 - 1);
+        rc.x1 = std::min({rc.x1, m_bbox.x1 + 1, kDim - 1});
+        rc.y1 = std::min({rc.y1, m_bbox.y1 + 1, kDim - 1});
+        rc.x0 = std::max(rc.x0, 0);
+        rc.y0 = std::max(rc.y0, 0);
+        m_bbox = Rect{};
+        if (rc.empty() || k.frame.fbw == 0u)
+        {
+            m_verts.clear();
+            return;
+        }
+
+        Target &tgt = prepareTarget(k.frame, static_cast<uint32_t>(rc.y1) + 1u);
+        bool depthCreated = false;
+        const GLuint depth = prepareDepth(k.zbuf.zbp, depthCreated);
+        Target *rtt = (k.tme && m_rtt) ? rttSource(st, tgt) : nullptr;
+        TexEntry *tex = (k.tme && !rtt) ? prepareTexture(st) : nullptr;
+        // DATE / alpha-MSB preservation read the destination.
+        const uint32_t amask = (k.frame.fbmsk >> 24) & 0xFFu;
+        const bool date = ((k.test >> 14) & 1u) != 0u && k.frame.psm != GS_PSM_CT24;
+        const bool amsb = amask == 0x80u && k.frame.psm != GS_PSM_CT24;
+        if (amask != 0u && amask != 0xFFu && amask != 0x80u)
+            logOnce("partial alpha FBMSK", k.frame.fbmsk);
+        const bool colorWrites = (k.frame.fbmsk != 0xFFFFFFFFu);
+        if (colorWrites)
+            markDirty(tgt, rc);
+
+        gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_drawFbo);
+        if (m_attachedColor != tgt.tex)
+        {
+            gl.glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tgt.tex, 0);
+            m_attachedColor = tgt.tex;
+        }
+        if (m_attachedDepth != depth)
+        {
+            gl.glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depth, 0);
+            m_attachedDepth = depth;
+        }
+        if (!m_fboChecked)
+        {
+            const GLenum status = gl.glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+            if (status != GL_FRAMEBUFFER_COMPLETE)
+                std::fprintf(stderr, "[gs:gpu] framebuffer incomplete: 0x%x\n", status);
+            m_fboChecked = true;
+        }
+        gl.glViewport(0, 0, kDim * m_scale, kDim * m_scale);
+        if (depthCreated)
+        {
+            gl.glDisable(GL_SCISSOR_TEST);
+            gl.glDepthMask(GL_TRUE);
+            gl.glClearDepth(0.0);
+            gl.glClear(GL_DEPTH_BUFFER_BIT);
+        }
+
+        if (date || amsb)
+        {
+            // Snapshot the destination so the shader can read it.
+            gl.glBindFramebuffer(GL_READ_FRAMEBUFFER, m_readFbo);
+            gl.glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tgt.tex, 0);
+            gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_scratchFbo);
+            gl.glDisable(GL_SCISSOR_TEST);
+            {
+                const int S = m_scale;
+                gl.glBlitFramebuffer(rc.x0 * S, rc.y0 * S, (rc.x1 + 1) * S, (rc.y1 + 1) * S, rc.x0 * S, rc.y0 * S, (rc.x1 + 1) * S,
+                                     (rc.y1 + 1) * S, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            }
+            gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_drawFbo);
+            gl.glActiveTexture(GL_TEXTURE1);
+            gl.glBindTexture(GL_TEXTURE_2D, m_scratchTex);
+            gl.glActiveTexture(GL_TEXTURE0);
+            ++m_stats.dstCopies;
+        }
+
+        gl.glEnable(GL_SCISSOR_TEST);
+        gl.glScissor(ctx.scissor.x0 * m_scale, ctx.scissor.y0 * m_scale, (ctx.scissor.x1 - ctx.scissor.x0 + 1) * m_scale,
+                     (ctx.scissor.y1 - ctx.scissor.y0 + 1) * m_scale);
+
+        // Depth
+        const uint32_t zfmt = k.zbuf.psm & 0xFu;
+        float zmax = 4294967295.0f;
+        if (zfmt == 1u) zmax = 16777215.0f;
+        else if (zfmt == 2u || zfmt == 10u) zmax = 65535.0f;
+        const uint32_t ztst = static_cast<uint32_t>((k.test >> 17) & 3u);
+        static const GLenum kDepthFuncs[4] = {GL_NEVER, GL_ALWAYS, GL_GEQUAL, GL_GREATER};
+        gl.glEnable(GL_DEPTH_TEST);
+        gl.glDepthFunc(kDepthFuncs[ztst]);
+        const bool zwrite = !k.zbuf.zmask;
+
+        // Colour write mask
+        const bool wr = (k.frame.fbmsk & 0xFFu) != 0xFFu;
+        const bool wg = ((k.frame.fbmsk >> 8) & 0xFFu) != 0xFFu;
+        const bool wb = ((k.frame.fbmsk >> 16) & 0xFFu) != 0xFFu;
+        const bool wa = amask != 0xFFu && k.frame.psm != GS_PSM_CT24;
+
+        setBlend(k, k.frame.psm);
+
+        gl.glUseProgram(m_prog);
+        gl.glUniform1i(u.uIip, k.iip);
+        gl.glUniform1i(u.uTme, k.tme);
+        gl.glUniform1i(u.uTfx, k.tex0.tfx & 3);
+        gl.glUniform1i(u.uTcc, k.tex0.tcc & 1);
+        gl.glUniform1i(u.uFge, k.fge);
+        gl.glUniform3f(u.uFogCol, k.fogR, k.fogG, k.fogB);
+        gl.glUniform1i(u.uDate, date ? 1 : 0);
+        gl.glUniform1i(u.uDatm, static_cast<int>((k.test >> 15) & 1u));
+        gl.glUniform1i(u.uFba, (k.fba & 1u) ? 1 : 0);
+        gl.glUniform1i(u.uAMsb, amsb ? 1 : 0);
+        gl.glUniform1i(u.uCt16, (k.frame.psm == GS_PSM_CT16 || k.frame.psm == GS_PSM_CT16S) ? 1 : 0);
+        gl.glUniform1f(u.uZmax, zmax);
+
+        if (m_rtt)
+            gl.glUniform1i(u.uRtt, rtt ? 1 : 0);
+        if (rtt)
+        {
+            // Sample the (scaled) render target directly instead of its native VRAM resolve.
+            const uint32_t tw = std::min<uint32_t>(std::max<uint32_t>(st.textureWidth, 1u), kDim);
+            const uint32_t th = std::min<uint32_t>(std::max<uint32_t>(st.textureHeight, 1u), kDim);
+            const float dim = static_cast<float>(kDim);
+            gl.glActiveTexture(GL_TEXTURE0);
+            gl.glBindTexture(GL_TEXTURE_2D, rtt->tex);
+            const GLint filt = k.linear ? GL_LINEAR : GL_NEAREST;
+            gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filt);
+            gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filt);
+            gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            const uint32_t wms = static_cast<uint32_t>(k.clamp & 3u), wmt = static_cast<uint32_t>((k.clamp >> 2) & 3u);
+            gl.glUniform2f(u.uRttScale, tw / dim, th / dim);
+            gl.glUniform2f(u.uRttEdge, 0.5f / (tw * m_scale), 0.5f / (th * m_scale));
+            gl.glUniform2i(u.uRttWrap, (wms == 0u || wms == 3u) ? 0 : 1, (wmt == 0u || wmt == 3u) ? 0 : 1);
+            gl.glUniform1i(u.uRttCt24, k.tex0.psm == GS_PSM_CT24 ? 1 : 0);
+            gl.glUniform1f(u.uRttTa0, static_cast<float>(st.texa.ta0));
+            gl.glUniform1i(u.uRttAem, st.texa.aem ? 1 : 0);
+        }
+        else if (tex)
+        {
+            gl.glActiveTexture(GL_TEXTURE0);
+            gl.glBindTexture(GL_TEXTURE_2D, tex->tex);
+            const uint32_t wms = static_cast<uint32_t>(k.clamp & 3u), wmt = static_cast<uint32_t>((k.clamp >> 2) & 3u);
+            auto wrapOf = [&](uint32_t m) -> GLint {
+                if (m >= 2u) logOnce("region CLAMP/REPEAT", k.clamp);
+                return (m == 0u || m == 3u) ? GL_REPEAT : GL_CLAMP_TO_EDGE;
+            };
+            const GLint ws = wrapOf(wms), wt = wrapOf(wmt);
+            const GLint filt = k.linear ? GL_LINEAR : GL_NEAREST;
+            if (tex->wrapS != ws) { gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, ws); tex->wrapS = ws; }
+            if (tex->wrapT != wt) { gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, wt); tex->wrapT = wt; }
+            if (tex->filter != filt)
+            {
+                gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filt);
+                gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filt);
+                tex->filter = filt;
+            }
+        }
+
+        gl.glBindVertexArray(m_vao);
+        gl.glBindBuffer(GL_ARRAY_BUFFER, m_vbo);
+        gl.glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(m_verts.size() * sizeof(float)), m_verts.data(), GL_STREAM_DRAW);
+        const GLenum mode = (k.cls == 0) ? GL_POINTS : (k.cls == 1 ? GL_LINES : GL_TRIANGLES);
+
+        // Alpha test. AFAIL != KEEP is done as a second pass over the failing fragments.
+        const bool ate = (k.test & 1u) != 0u;
+        const int atst = static_cast<int>((k.test >> 1) & 7u);
+        const int aref = static_cast<int>((k.test >> 4) & 0xFFu);
+        const int afail = static_cast<int>((k.test >> 12) & 3u);
+        const bool alphaTest = ate && atst != 1;
+        gl.glUniform1i(u.uAte, alphaTest ? 1 : 0);
+        gl.glUniform1i(u.uAtst, atst);
+        gl.glUniform1i(u.uAref, aref);
+
+        gl.glUniform1i(u.uAtInv, 0);
+        gl.glColorMask(wr, wg, wb, wa);
+        gl.glDepthMask(zwrite ? GL_TRUE : GL_FALSE);
+        gl.glDrawArrays(mode, 0, count);
+        if (alphaTest && afail != 0)
+        {
+            gl.glUniform1i(u.uAtInv, 1);
+            if (afail == 1) { gl.glColorMask(wr, wg, wb, wa); gl.glDepthMask(GL_FALSE); }
+            else if (afail == 2) { gl.glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE); gl.glDepthMask(zwrite ? GL_TRUE : GL_FALSE); }
+            else { gl.glColorMask(wr, wg, wb, GL_FALSE); gl.glDepthMask(GL_FALSE); }
+            gl.glDrawArrays(mode, 0, count);
+        }
+        ++m_stats.batches;
+        m_verts.clear();
+        if (m_debugErrors)
+        {
+            if (const GLenum err = gl.glGetError(); err != GL_NO_ERROR)
+                logOnce("GL error", err);
+        }
+    }
+
+    void maybePrintStats()
+    {
+        if (!m_statsOn)
+            return;
+        const auto now = std::chrono::steady_clock::now();
