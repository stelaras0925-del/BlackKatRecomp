+    // Opt-in OpenGL GS renderer (PS2X_GS_GPU=1), defined in gs_gpu_backend.inl (included at the end of this file).
+    std::unique_ptr<GSRasterBackend> createGsGpuBackend();
+    bool isGsGpuBackend(const GSRasterBackend *backend);
+
+    // PS2X_GS_BACKEND=cpu|gl|vulkan; PS2X_GS_GPU=1 is the legacy spelling of gl.
+    std::string gsBackendChoice()
+    {
+        std::string v;
+        if (const char *e = std::getenv("PS2X_GS_BACKEND"))
+            for (const char *c = e; *c; ++c)
+                v += static_cast<char>(std::tolower(static_cast<unsigned char>(*c)));
+        if (v == "opengl" || v == "gpu")
+            v = "gl";
+        if (v == "vk")
+            v = "vulkan";
+        if (v.empty())
+        {
+            const char *g = std::getenv("PS2X_GS_GPU");
+            v = (g && g[0] == '1') ? "gl" : "cpu";
+        }
+        return v;
+    }
+
+    std::unique_ptr<GSRasterBackend> makeCpuOrGlBackend(std::unique_ptr<GSRasterBackend> inner, bool wantGl);
+
+    std::unique_ptr<GSRasterBackend> makeDefaultRasterBackend(std::unique_ptr<GSRasterBackend> inner)
+    {
+        const std::string choice = gsBackendChoice();
+        if (choice == "vulkan")
+        {
+            // Skeleton stage: the Vulkan backend wraps the usual renderer (GL if PS2X_GS_GPU=1, else CPU) as its
+            // VRAM-accurate reference and owns presentation.
+            const char *g = std::getenv("PS2X_GS_GPU");
+            std::unique_ptr<GSRasterBackend> ref = makeCpuOrGlBackend(std::move(inner), g && g[0] == '1');
+            if (auto vk = gsCreateVulkanBackend(ref))
+            {
+                std::fprintf(stderr, "[gs] Vulkan GS backend selected (PS2X_GS_BACKEND=vulkan), reference renderer inside\n");
+                return vk;
+            }
+            std::fprintf(stderr, "[gs] PS2X_GS_BACKEND=vulkan but Vulkan is %s; using %s\n",
+                         gsVulkanCompiledIn() ? "unavailable/failed" : "not compiled in", ref ? ref->Name() : "?");
+            return ref;
+        }
+        return makeCpuOrGlBackend(std::move(inner), choice == "gl");
+    }
+
+    std::unique_ptr<GSRasterBackend> makeCpuOrGlBackend(std::unique_ptr<GSRasterBackend> inner, bool wantGl)
+    {
+        if (wantGl)
+        {
+            if (auto gpu = createGsGpuBackend())
+            {
+                std::fprintf(stderr, "[gs] GPU (OpenGL) GS renderer enabled (PS2X_GS_GPU=1); unset it for the CPU rasterizer\n");
+                return gpu;
+            }
+            std::fprintf(stderr, "[gs] PS2X_GS_GPU=1 but GPU init failed; falling back to the CPU rasterizer\n");
+        }
+        if (gsSyncMode())
+            return inner;
+        const int n = gsThreadCount();
+        std::fprintf(stderr, "[gs] rasterizer on %d worker thread(s), %d-row bands (PS2X_GS_THREADS=N, PS2X_GS_SYNC=1 for none)\n",
+                     n, GSThreadedBackend::kBandRows);
+        return std::make_unique<GSThreadedBackend>(std::move(inner), n);
+    }
