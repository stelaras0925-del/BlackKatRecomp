+                         th, t.psm, lo, hi);
+                if (overlapsWritten(lo, hi - lo))
+                    pushBarrier(BarrierKind::Hazard);
+            }
+            const uint32_t h = static_cast<uint32_t>(ctx.scissor.y1) + 1u;
+            const uint32_t w = std::max<uint32_t>(ctx.frame.fbw, 1u) * 64u;
+            uint64_t lo, hi;
+            bufRange(static_cast<uint64_t>(ctx.frame.fbp) * 8192u, w, h, ctx.frame.psm, lo, hi);
+            addWritten(lo, hi);
+            if (((ctx.test >> 16) & 1u) && !ctx.zbuf.zmask)
