+                    for (int i = 0; i < 8; ++i)
+                        if (m_drainCalls[i])
+                            line += std::string(" ") + names[i] + "=" + std::to_string(m_drainCalls[i]) + "/" +
+                                    std::to_string(m_drainWaits[i]) + "w/" + std::to_string(m_drainWaitNs[i] / 1000000ull) + "ms";
+                    line += " cmds=" + std::to_string(m_workers[0].submitted) + " barriers=" + std::to_string(m_barriers);
+                    std::fprintf(stderr, "%s\n", line.c_str());
+                }
+            }
+        }
+
+        int m_n = 1;
+        std::deque<Worker> m_workers;
+        mutable std::mutex m_mutex;
+        mutable std::condition_variable m_doneCv;
+        std::condition_variable m_barrierCv;
+        bool m_quit = false;
+        std::vector<std::pair<uint64_t, uint64_t>> m_written;
+        uint64_t m_barriers = 0;
+        mutable uint64_t m_drainCalls[8] = {};
+        mutable uint64_t m_drainWaits[8] = {};
+        mutable uint64_t m_drainWaitNs[8] = {};
+        mutable std::chrono::steady_clock::time_point m_lastStats{};
+    };
+
+    int gsThreadCount()
+    {
+        if (const char *e = std::getenv("PS2X_GS_THREADS"); e && e[0])
+            return std::max(1, std::atoi(e));
+        const unsigned hw = std::thread::hardware_concurrency();
+        return std::max(1, std::min(4, static_cast<int>(hw / 2u)));
+    }
+
+    bool gsSyncMode()
+    {
+        static const bool on = []() { const char *e = std::getenv("PS2X_GS_SYNC"); return e && e[0] == '1'; }();
+        return on;
+    }
+
+    // ---- Phase 3 step 1: real draw list (PS2X_DRAWLIST=2) ---------------------------------------------------
+    // Sits in front of the chosen backend: Submit() appends to a GSDrawList (new batch on ANY GSDrawState byte
+    // difference or vertex-count change), every other backend call first hands the pending list over with
+    // SubmitList(). So ordering is exactly the per-primitive order. PS2X_DRAWLIST_CHECK=1 hashes every primitive
+    // as submitted and as reconstructed from the lists (default-replay rules) and reports any divergence.
+    class GSListBackend final : public GSRasterBackend
+    {
+    public:
+        explicit GSListBackend(std::unique_ptr<GSRasterBackend> inner) : m_inner(std::move(inner))
+        {
+            m_check = []() { const char *e = std::getenv("PS2X_DRAWLIST_CHECK"); return e && e[0] == '1'; }();
