+        for (uint32_t x = 0; x < width; ++x)
+        {
+            const u32 raw = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, x, y);
+            uint32_t c = 0xFFFF00FFu;
+            switch (tex.psm)
+            {
+            case GS_PSM_CT32:
+            case GS_PSM_Z32:
+            case GS_PSM_CT24:
+            case GS_PSM_Z24:
+                c = applyTexa(state.texa, tex.psm, raw);
+                break;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+            case GS_PSM_Z16:
+            case GS_PSM_Z16S:
+                c = applyTexa(state.texa, tex.psm, Rgba5551ToRgba8888(static_cast<u16>(raw)));
+                break;
+            case GS_PSM_T8:
+            case GS_PSM_T8H:
+            case GS_PSM_T4:
+            case GS_PSM_T4HL:
+            case GS_PSM_T4HH:
