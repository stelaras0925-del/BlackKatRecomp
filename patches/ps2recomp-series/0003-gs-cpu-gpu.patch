+    // vk18 debug (PS2X_PRESSPIKE=1): find one-vsync flicker in the presented stream, any backend. Each latched
+    // frame is reduced to a 32x24 grid of mean luma; frame t-1 is a "spike" when >= PS2X_PRESSPIKE_CELLS cells
+    // (default 6) differ from both t-2 and t by > 20 while t-2 and t agree within 6 (A B A). Prints one line per
+    // spike (first 60) plus a summary every 600 presents; PS2X_PRESSPIKE_DUMP=prefix writes the three frames of the
+    // first 12 spikes as 160-wide PPMs.
+    struct PresSpike
+    {
+        bool on = std::getenv("PS2X_PRESSPIKE") != nullptr;
+        int minCells = std::getenv("PS2X_PRESSPIKE_CELLS") ? std::atoi(std::getenv("PS2X_PRESSPIKE_CELLS")) : 6;
+        const char *dump = std::getenv("PS2X_PRESSPIKE_DUMP");
+        static constexpr int GW = 32, GH = 24;
+        float g[3][GW * GH]{};
+        std::vector<uint8_t> small[3];
+        std::vector<uint8_t> hist[8]; uint32_t histPos = 0; // last 8 small frames
+        uint32_t sw = 0, sh = 0;
+        int have = 0; uint64_t n = 0, spikes = 0, printed = 0, dumped = 0, changes = 0;
+        void dumpSmall(int idx, uint64_t pn, const char *tag)
+        {
+            char path[512]; std::snprintf(path, sizeof(path), "%s_%llu_%s.ppm", dump, (unsigned long long)pn, tag);
+            if (FILE *f = std::fopen(path, "wb")) { std::fprintf(f, "P6\n%u %u\n255\n", sw, sh); std::fwrite(small[idx].data(), 1, small[idx].size(), f); std::fclose(f); }
+        }
+        void feed(const std::vector<uint8_t> &px, uint32_t w, uint32_t h, uint32_t dfbp, uint32_t sfbp)
