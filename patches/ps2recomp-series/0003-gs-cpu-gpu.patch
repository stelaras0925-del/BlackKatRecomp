+            }
+        }
+
+        void pushAll(Cmd &&c)
+        {
+            std::unique_lock<std::mutex> lk(m_mutex);
+            // Backpressure: a producer that outruns the raster threads (e.g. the EE with
+            // PS2X_VU1_THREAD=1) must not grow the queues without bound, or Present()'s
+            // drain never catches up. PS2X_GS_QUEUE_MAX=<cmds> (default 8192, 0 = unbounded; 1024 cost ~15% in sync mode).
+            static const uint64_t s_queueMax = []() -> uint64_t {
+                const char *e = std::getenv("PS2X_GS_QUEUE_MAX");
+                return e ? static_cast<uint64_t>(std::strtoull(e, nullptr, 0)) : 8192u;
+            }();
+            if (s_queueMax != 0u)
+            {
+                m_doneCv.wait(lk, [&]() {
+                    for (const auto &w : m_workers)
+                        if (w.submitted - w.completed >= s_queueMax)
+                            return false;
+                    return true;
+                });
+            }
+            for (int i = 0; i < m_n; ++i)
+            {
+                Worker &w = m_workers[i];
+                if (i + 1 < m_n)
+                    w.q.push_back(c);
+                else
+                    w.q.push_back(std::move(c));
