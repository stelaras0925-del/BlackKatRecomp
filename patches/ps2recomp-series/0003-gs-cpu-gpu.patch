+                if (w.idle)
+                    w.cv.notify_one();
+            }
+        }
+        void pushBarrier(BarrierKind kind)
+        {
+            auto op = std::make_shared<Barrier>();
+            op->kind = kind;
+            pushBarrierOp(std::move(op));
+        }
+        void pushBarrierOp(std::shared_ptr<Barrier> op)
+        {
+            m_written.clear();
+            ++m_barriers;
+            Cmd c;
+            c.type = Cmd::BarrierT;
+            c.barrier = std::move(op);
+            pushAll(std::move(c));
+        }
+        void flushAllCaches()
+        {
+            for (auto &w : m_workers)
+                w.be->TextureFlush();
+        }
+        void executeBarrier(Barrier &b)
+        {
+            GSRasterBackend &be0 = *m_workers[0].be;
+            switch (b.kind)
+            {
+            case BarrierKind::Hazard: break;
+            case BarrierKind::Transfer: be0.BeginTransfer(b.transfer); break;
+            case BarrierKind::Upload: be0.UploadImage(b.data.data(), static_cast<uint32_t>(b.data.size())); break;
+            case BarrierKind::Write: be0.WriteVram(b.w[0], b.w[1], b.w[2], b.w[3], b.w[4], b.w[5]); break;
+            }
+            if (m_n > 1)
+                flushAllCaches();
+        }
+
+        void drawBanded(int k, GSPrimitiveBatch &batch)
+        {
+            GSRasterBackend &be = *m_workers[k].be;
+            if (m_n == 1)
+            {
+                be.Submit(batch);
+                return;
+            }
+            GSScissorReg &sc = batch.state.context.scissor;
+            const int ofy = batch.state.context.xyoffset.ofy >> 4;
+            const int cnt = std::max<int>(1, std::min<int>(batch.vertexCount, 3));
+            float ymin = batch.vertices[0].y, ymax = ymin;
+            for (int i = 1; i < cnt; ++i)
+            {
+                ymin = std::min(ymin, batch.vertices[i].y);
+                ymax = std::max(ymax, batch.vertices[i].y);
+            }
+            int y0 = static_cast<int>(std::floor(ymin)) - ofy - 1;
+            int y1 = static_cast<int>(std::ceil(ymax)) - ofy + 1;
+            const int s0 = sc.y0, s1 = sc.y1;
+            y0 = std::max(y0, s0);
+            y1 = std::min(y1, s1);
+            if (y0 > y1)
+                return;
+            for (int band = y0 / kBandRows; band * kBandRows <= y1; ++band)
+            {
+                if (band % m_n != k)
+                    continue;
+                const int b0 = std::max(s0, band * kBandRows);
+                const int b1 = std::min(s1, band * kBandRows + kBandRows - 1);
+                if (b0 > b1)
+                    continue;
+                sc.y0 = static_cast<uint16_t>(b0);
+                sc.y1 = static_cast<uint16_t>(b1);
+                be.Submit(batch);
+            }
+        }
+
+        void workerLoop(int k)
+        {
+            Worker &self = m_workers[k];
+            {
+                char nm[16];
+                std::snprintf(nm, sizeof(nm), "GSRast%d", k);
+                pthread_setname_np(pthread_self(), nm); // thread CPU% in PS2X_PROF
+            }
+            std::deque<Cmd> local;
+            std::unique_lock<std::mutex> lk(m_mutex);
+            for (;;)
+            {
+                self.idle = true;
+                self.cv.wait(lk, [&]() { return m_quit || !self.q.empty(); });
+                self.idle = false;
+                if (self.q.empty() && m_quit)
+                    return;
+                local.swap(self.q);
+                lk.unlock();
+                uint64_t n = 0;
+                for (Cmd &c : local)
+                {
+                    switch (c.type)
+                    {
+                    case Cmd::SubmitT: drawBanded(k, c.batch); break;
+                    case Cmd::ClutT: self.be->LoadClut(c.tex0, c.clut); break;
+                    case Cmd::TexFlushT: self.be->TextureFlush(); break;
+                    case Cmd::BarrierT:
+                    {
+                        Barrier &b = *c.barrier;
+                        std::unique_lock<std::mutex> bl(m_mutex);
+                        if (++b.arrived == m_n)
+                        {
+                            bl.unlock();
+                            executeBarrier(b);
+                            bl.lock();
+                            b.done = true;
+                            m_barrierCv.notify_all();
+                        }
+                        else
+                        {
+                            m_barrierCv.wait(bl, [&]() { return b.done; });
+                        }
+                        break;
+                    }
+                    }
+                    ++n;
+                }
+                local.clear();
+                lk.lock();
+                self.completed += n;
+                m_doneCv.notify_all();
+            }
+        }
+
+        bool allDone() const
+        {
+            for (const auto &w : m_workers)
+                if (w.completed < w.submitted)
+                    return false;
+            return true;
+        }
+
+        // PS2X_GS_THREAD_STATS=1: every ~5 s log drains per reason, how many
+        // had to wait, the total wait time, and barriers queued.
+        void drain(int why) const
+        {
+            const auto me = std::this_thread::get_id();
+            for (const auto &w : m_workers)
+                if (w.th.get_id() == me)
+                    return;
+            static const bool s_stats = []() { const char *e = std::getenv("PS2X_GS_THREAD_STATS"); return e && e[0] == '1'; }();
+            std::unique_lock<std::mutex> lk(m_mutex);
+            std::vector<uint64_t> target(m_workers.size());
+            for (size_t i = 0; i < m_workers.size(); ++i)
+                target[i] = m_workers[i].submitted;
+            auto reached = [&]() {
+                for (size_t i = 0; i < m_workers.size(); ++i)
+                    if (m_workers[i].completed < target[i])
+                        return false;
+                return true;
+            };
+            if (s_stats)
+                ++m_drainCalls[why & 7];
+            if (reached())
+                return;
+            const auto t0 = std::chrono::steady_clock::now();
+            m_doneCv.wait(lk, reached);
+            if (s_stats)
+            {
+                const auto t1 = std::chrono::steady_clock::now();
+                ++m_drainWaits[why & 7];
+                m_drainWaitNs[why & 7] += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count());
+                if (t1 - m_lastStats > std::chrono::seconds(5))
+                {
+                    m_lastStats = t1;
+                    static const char *names[8] = {"init/reset", "flush", "sync", "present", "clear", "l2h", "readvram", "snapshot"};
