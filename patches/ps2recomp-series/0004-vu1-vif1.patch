+    // PS2X_VU1_OPSTATS=1 (diagnostic): counts generic-upper / fast-upper / lower ops by opcode.
+    std::atomic<uint64_t> g_opStat[3][512];
+    std::atomic<uint64_t> g_opStatN{0};
+    inline uint32_t vu1OpKey(int kind, uint32_t instr)
+    {
+        if (kind < 2)
+        {
+            const uint32_t op = instr & 0x3Fu;
+            return op >= 0x3Cu ? 0x100u | (instr & 3u) | ((instr >> 4) & 0x7Cu) : op;
+        }
+        const uint32_t hi = (instr >> 25) & 0x7Fu;
+        if (hi != 0x40u)
+            return hi;
+        const uint32_t op = instr & 0x3Fu;
+        return op >= 0x3Cu ? 0x100u | (instr & 3u) | ((instr >> 4) & 0x7Cu) : 0x80u | op;
+    }
+    inline void vu1OpStatNote(int kind, uint32_t instr)
+    {
+        g_opStat[kind][vu1OpKey(kind, instr)].fetch_add(1, std::memory_order_relaxed);
+        if (kind == 2 && (g_opStatN.fetch_add(1, std::memory_order_relaxed) & ((1u << 22) - 1u)) == 0u)
+        {
+            static const char *names[3] = {"upper-generic", "upper-fast", "lower"};
+            for (int k = 0; k < 3; ++k)
+            {
+                std::vector<std::pair<uint64_t, uint32_t>> v;
+                uint64_t tot = 0;
+                for (uint32_t i = 0; i < 512u; ++i)
+                {
+                    const uint64_t c = g_opStat[k][i].load(std::memory_order_relaxed);
+                    tot += c;
+                    if (c)
+                        v.push_back({c, i});
+                }
+                std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.first > b.first; });
+                std::fprintf(stderr, "[vu1:ops] %s total=%llu:", names[k], (unsigned long long)tot);
+                for (size_t i = 0; i < v.size() && i < 64u; ++i)
+                    std::fprintf(stderr, " %03x=%.3f%%", v[i].second, tot ? 100.0 * v[i].first / tot : 0.0);
+                std::fprintf(stderr, "\n");
+            }
+        }
+    }
+
+    inline void vu1ProfNotePair(uint32_t pc, uint32_t lower, uint32_t upper)
+    {
+        Vu1Prof &p = vu1Prof();
+        const uint32_t i = (pc >> 3) & 2047u;
+        ++p.pcHits[i];
+        p.pcLower[i] = lower;
+        p.pcUpper[i] = upper;
+        ++p.runPairs;
+    }
+    void vu1ProfBeginRun() { vu1Prof().runPairs = 0; }
+    void vu1ProfEndRun(uint32_t startPc, uint64_t cycles)
+    {
+        Vu1Prof &p = vu1Prof();
+        auto &e = p.progs[startPc];
+        ++e[0];
+        e[1] += p.runPairs;
+        e[2] += cycles;
+        p.totalPairs += p.runPairs;
+        p.totalCycles += cycles;
+        const auto now = std::chrono::steady_clock::now();
+        const double span = std::chrono::duration<double>(now - p.last).count();
+        if (span < 5.0)
+            return;
+        p.last = now;
+        std::vector<std::pair<uint64_t, uint32_t>> v;
+        for (auto &kv : p.progs)
+            v.emplace_back(kv.second[1], kv.first);
+        std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.first > b.first; });
+        std::fprintf(stderr, "[vu1:prof] %.2f Mpairs/s %.2f Mcycles/s (stall %.0f%%), %zu programs\n",
+                     p.totalPairs / span / 1e6, p.totalCycles / span / 1e6,
+                     p.totalCycles ? 100.0 * (1.0 - double(p.totalPairs) / double(p.totalCycles)) : 0.0, v.size());
+        for (size_t k = 0; k < v.size() && k < 8; ++k)
+        {
+            const auto &e2 = p.progs[v[k].second];
+            std::fprintf(stderr, "[vu1:prof]   prog pc=0x%04x runs=%llu pairs=%llu (%.1f%%) cycles=%llu pairs/run=%.0f\n",
+                         v[k].second, (unsigned long long)e2[0], (unsigned long long)e2[1],
+                         p.totalPairs ? 100.0 * e2[1] / p.totalPairs : 0.0, (unsigned long long)e2[2],
+                         e2[0] ? double(e2[1]) / e2[0] : 0.0);
+        }
+        std::vector<std::pair<uint64_t, uint32_t>> h;
+        for (uint32_t i = 0; i < 2048u; ++i)
+            if (p.pcHits[i])
+                h.emplace_back(p.pcHits[i], i);
+        std::sort(h.begin(), h.end(), [](auto &a, auto &b) { return a.first > b.first; });
+        uint64_t top = 0;
+        for (size_t k = 0; k < h.size() && k < 64; ++k)
+            top += h[k].first;
+        std::fprintf(stderr, "[vu1:prof]   %zu distinct pairs, top-64 pairs = %.1f%%\n", h.size(),
+                     p.totalPairs ? 100.0 * top / p.totalPairs : 0.0);
+        for (size_t k = 0; k < h.size() && k < 12; ++k)
+            std::fprintf(stderr, "[vu1:prof]   pc=0x%04x hits=%.1f%% upper=%08x lower=%08x\n", h[k].second * 8u,
+                         100.0 * h[k].first / p.totalPairs, p.pcUpper[h[k].second], p.pcLower[h[k].second]);
+        p.progs.clear();
+        std::memset(p.pcHits, 0, sizeof(p.pcHits));
+        p.totalPairs = p.totalCycles = 0;
+    }
