+
+    bool applyCompletions(PS2Memory &mem)
+    {
+        State &s = st();
+        if (s.finishedAtomic.load(std::memory_order_acquire) == s.applied)
+            return false;
+        std::vector<Completion> done;
+        {
+            std::lock_guard<std::mutex> lk(s.m);
+            done.swap(s.done);
+        }
+        for (const Completion &c : done)
+        {
+            if (c.vpuSet && g_applyVpuStopBits)
+                g_applyVpuStopBits(c.vpuBits);
+            if (c.gif)
+            {
+                --s.busyGif;
+                completeChannel(mem, 2u, 0x1000A000u);
+            }
+            if (c.vif1)
+            {
+                --s.busyVif1;
+                completeChannel(mem, 1u, 0x10009000u);
+            }
+        }
+        // A channel that was kicked again while busy must keep STR set.
+        if (s.busyGif > 0)
+            mem.m_ioRegisters[0x1000A000u] |= 0x100u;
+        if (s.busyVif1 > 0)
+            mem.m_ioRegisters[0x10009000u] |= 0x100u;
+        s.applied += done.size();
+        maybeStats();
+        return !done.empty();
+    }
+
+    void drain(PS2Memory &mem, const char *reason)
+    {
+        if (!enabled() || onWorkerThread())
+            return;
+        st().drains.fetch_add(1, std::memory_order_relaxed);
+        waitIdle(reason);
+        applyCompletions(mem);
+    }
+
+    void drainIfOffWorker(const char *reason)
+    {
+        if (!enabled() || onWorkerThread())
+            return;
+        waitIdle(reason);
+    }
+
+    // EE thread, from processPendingTransfers(): move GIF + VIF1 transfers into a worker job.
+    void takeTransfers(PS2Memory &mem)
+    {
+        State &s = st();
+        if (mem.m_pendingGifTransfers.empty() && mem.m_pendingVif1Transfers.empty())
+            return;
+        // GIF-only kick while the worker is idle: nothing queued can be overtaken, so let the
+        // synchronous path in processPendingTransfers() run it on the EE thread right away
+        // (immediate completion, no thread round trip). Front-end text/sprite code kicks
+        // tens of thousands of tiny PATH3 packets per second and polls for each one; through
+        // the worker it ran at ~4 vsync/s and missed menu input. PS2X_VU1_THREAD_GIF_INLINE=0
+        // sends every GIF kick to the worker.
+        static const bool s_gifInline = []() {
+            const char *e = std::getenv("PS2X_VU1_THREAD_GIF_INLINE");
+            return !(e && e[0] == '0');
+        }();
+        if (s_gifInline && mem.m_pendingVif1Transfers.empty() &&
+            s.finishedAtomic.load(std::memory_order_acquire) == s.submittedAtomic.load(std::memory_order_relaxed))
+        {
+            if (s.applied != s.finishedAtomic.load(std::memory_order_acquire))
+                applyCompletions(mem);
+            s.inlineGif.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        ensureStarted();
+        Job job;
+        // GIF_STAT.FQC as the synchronous path reports it.
+        uint32_t observedGifQwc = 0u;
+        for (const auto &transfer : mem.m_pendingGifTransfers)
+        {
+            const uint64_t transferQwc = !transfer.chainData.empty() ? (transfer.chainData.size() / 16u) : transfer.qwc;
+            observedGifQwc = static_cast<uint32_t>(std::min<uint64_t>(16u, static_cast<uint64_t>(observedGifQwc) + transferQwc));
+        }
+        if (observedGifQwc != 0u)
+        {
+            constexpr uint32_t kGifStat = 0x10003020u;
+            constexpr uint32_t kGifFqcMask = 0x1F000000u;
+            uint32_t &gifStat = mem.m_ioRegisters[kGifStat];
+            gifStat = (gifStat & ~kGifFqcMask) | (observedGifQwc << 24u);
+            g_ps2xGifFqcPending = true;
+        }
+        auto take = [&](std::vector<PS2Memory::PendingTransfer> &list, bool gif) {
+            for (auto &p : list)
+            {
+                if (traceOn())
+                {
+                    const uint32_t base = gif ? 0x1000A000u : 0x10009000u;
+                    char key[192];
+                    uint32_t w[4] = {};
+                    if (p.chainData.size() >= 16)
+                        std::memcpy(w, p.chainData.data(), 16);
+                    std::snprintf(key, sizeof(key), "%s src=%08x qwc=%u chain=%zu chcr=%08x tadr=%08x first=%08x_%08x_%08x_%08x",
+                                  gif ? "GIF " : "VIF1", p.srcAddr, p.qwc, p.chainData.size(), mem.m_ioRegisters[base],
+                                  mem.m_ioRegisters[base + 0x30], w[0], w[1], w[2], w[3]);
+                    ++s.traceKeys[key];
+                }
+                Item it;
+                it.gif = gif;
+                it.src = p.srcAddr;
+                it.qwc = p.qwc;
+                it.chain = static_cast<uint32_t>(p.chainData.size());
+                if (!p.chainData.empty())
+                    it.data = std::move(p.chainData);
+                else
+                    it.data = gatherLinear(mem, p.srcAddr, p.qwc, p.fromScratchpad);
+                if (gif)
+                    it.data.resize(it.data.size() & ~size_t(15)); // GIF consumes whole qwords only
+                job.bytes += it.data.size();
+                job.items.push_back(std::move(it));
+            }
+        };
+        job.fbrst = g_readFbrst ? g_readFbrst() : 0u;
+        job.hadGif = !mem.m_pendingGifTransfers.empty();
+        job.hadVif1 = !mem.m_pendingVif1Transfers.empty();
+        take(mem.m_pendingGifTransfers, true);
+        take(mem.m_pendingVif1Transfers, false);
+        mem.m_pendingGifTransfers.clear();
+        mem.m_pendingVif1Transfers.clear();
+        // Debug: PS2X_VU1_THREAD_INLINE=1 runs the job right here on the EE thread
+        // (all other async hooks stay active) to isolate thread-affinity bugs.
+        static const bool s_inlineDebug = []() { const char *e = std::getenv("PS2X_VU1_THREAD_INLINE"); return e && e[0] == '1'; }();
+        if (s_inlineDebug)
+        {
+            runJobItems(&mem, job);
+            if (job.hadGif)
+                completeChannel(mem, 2u, 0x1000A000u);
+            if (job.hadVif1)
+                completeChannel(mem, 1u, 0x10009000u);
+            return;
+        }
+        if (job.hadGif)
+            ++s.busyGif;
+        if (job.hadVif1)
+            ++s.busyVif1;
+        s.jobs.fetch_add(1, std::memory_order_relaxed);
+        s.jobBytes.fetch_add(job.bytes, std::memory_order_relaxed);
+        if (job.bytes >= 256u * 1024u)
+            s.bigJobs.fetch_add(1, std::memory_order_relaxed);
+        {
+            std::lock_guard<std::mutex> lk(s.m);
+            s.mem = &mem;
+            s.queue.push_back(std::move(job));
+            ++s.submitted;
+            s.submittedAtomic.store(s.submitted, std::memory_order_release);
+        }
+        s.workCv.notify_one();
+        // Debug: PS2X_VU1_THREAD_SYNC=1 runs each job on the worker but waits for it here,
+        // so completion timing matches the synchronous path (isolates thread vs timing bugs).
+        static const bool s_syncDebug = []() { const char *e = std::getenv("PS2X_VU1_THREAD_SYNC"); return e && e[0] == '1'; }();
+        if (s_syncDebug)
+        {
+            waitIdle(nullptr);
+            applyCompletions(mem);
+            return;
+        }
+        // Backpressure: the EE must not run unboundedly ahead of the worker (input lag, memory).
+        // PS2X_VU1_THREAD_MAXJOBS=<n> (default 32 jobs in flight).
+        static const uint64_t s_maxJobs = []() -> uint64_t {
+            const char *e = std::getenv("PS2X_VU1_THREAD_MAXJOBS");
+            const long v = e ? std::atol(e) : 0;
+            return v > 0 ? static_cast<uint64_t>(v) : 32u;
+        }();
+        if (s.submittedAtomic.load(std::memory_order_relaxed) - s.finishedAtomic.load(std::memory_order_acquire) > s_maxJobs)
+        {
+            const uint64_t t0 = nowNs();
+            {
+                std::unique_lock<std::mutex> lk(s.m);
+                s.idleCv.wait(lk, [&]() { return s.submitted - s.finished <= s_maxJobs / 2; });
+            }
+            s.drainWaitNs.fetch_add(nowNs() - t0, std::memory_order_relaxed);
+            s.drainsWaited.fetch_add(1, std::memory_order_relaxed);
+            if (statsOn())
+            {
+                std::lock_guard<std::mutex> lk(s.reasonMutex);
+                ++s.waitReasons["queue-full"];
+            }
+        }
+    }
+
+    // EE thread: is a job for this DMA channel still in flight?
+    bool channelBusy(uint32_t channelBase)
+    {
+        State &s = st();
+        if (channelBase == 0x10009000u)
+            return s.busyVif1 > 0;
+        if (channelBase == 0x1000A000u)
+            return s.busyGif > 0;
+        return false;
+    }
+
+    bool chcrReadWhileBusy(PS2Memory &mem, uint32_t address, uint32_t &value)
+    {
+        static thread_local uint64_t tl_spinStart = 0;
+        const uint32_t channelBase = address & 0xFFFFFF00u;
+        if (!channelBusy(channelBase))
+        {
+            if (tl_spinStart)
+            {
+                st().eeSpinNs.fetch_add(nowNs() - tl_spinStart, std::memory_order_relaxed);
+                tl_spinStart = 0;
+            }
+            return false;
+        }
+        if (!tl_spinStart)
+            tl_spinStart = nowNs();
+        if (drainOnPoll())
+        {
+            drain(mem, "chcr-poll");
+            return false;
+        }
+        // PS2X_EEVU1_OVERLAP=<n> (experiment, default off): a D1 CHCR poll reports the channel
+        // idle (STR=0) while at most n VIF1 jobs are still queued, so the EE builds the next
+        // packet while VU1 works. Data was copied at kick time; later kicks queue in order.
+        static const uint64_t s_overlap = []() -> uint64_t {
+            const char *e = std::getenv("PS2X_EEVU1_OVERLAP");
+            const long v = e ? std::atol(e) : 0;
+            return v > 0 ? static_cast<uint64_t>(v) : 0u;
+        }();
+        if (s_overlap && channelBase == 0x10009000u && (address & 0xFFu) == 0u)
+        {
+            State &s = st();
+            const uint64_t inFlight = s.submittedAtomic.load(std::memory_order_relaxed) - s.finishedAtomic.load(std::memory_order_acquire);
+            if (inFlight <= s_overlap)
+            {
+                value = mem.m_ioRegisters[address] & ~0x100u;
+                return true;
+            }
+        }
+        st().busyPolls.fetch_add(1, std::memory_order_relaxed);
+        value = mem.m_ioRegisters[address] | 0x100u;
+        return true;
+    }
+} // namespace ps2x_vu1async
