+        return;
+    std::fprintf(stderr, "[vif1:trace] ===== anomaly kind=%u: %s | last VIFcodes, oldest first =====\n", kind, why);
+    const uint32_t n = std::min<uint32_t>(g_vif1RingN, 32u);
+    for (uint32_t i = 0; i < n; ++i)
