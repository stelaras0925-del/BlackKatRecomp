+    inline int fmacFastKind(uint8_t code, bool special)
+    {
+        if (code <= 0x07u)
+            return 1;
+        if (code <= 0x0Fu)
+            return 2;
+        if (code >= 0x18u && code <= 0x1Bu)
+            return 1;
