+        case 0x21u: case 0x23u: case 0x25u: case 0x27u: case 0x29u: case 0x2Du:
+            return 2;
+        case 0x2Eu:
+            return special ? 1 : 2; // OPMULA : OPMSUB (w lane excluded by the caller)
