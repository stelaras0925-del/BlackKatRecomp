+// vu1NormPs(x) in place; t1..t4 are scratch (all distinct from x).
+inline void vu1EmitNormPs(Vu1Emit &e, int x, int t1, int t2, int t3, int t4)
+{
+    e.movaps(t1, x); e.piM(Vu1Emit::kPand, t1, kR13, kPoolSign);            // sign
+    e.movaps(t2, x); e.psrld(t2, 23); e.piM(Vu1Emit::kPand, t2, kR13, kPoolFF); // e
+    e.pi(Vu1Emit::kPxor, t3, t3); e.pi(Vu1Emit::kPcmpeqd, t3, t2);           // isZ
+    e.piM(Vu1Emit::kPcmpeqd, t2, kR13, kPoolFF);                           // isM
+    e.movaps(t4, t3); e.pi(Vu1Emit::kPor, t4, t2); e.pi(Vu1Emit::kPandn, t4, x); // ~(isZ|isM) & b
+    e.pi(Vu1Emit::kPand, t3, t1);                                          // isZ & sign
+    e.pi(Vu1Emit::kPor, t4, t3);
+    e.piM(Vu1Emit::kPor, t1, kR13, kPoolMaxv);                             // sign | 0x7F7FFFFF
+    e.pi(Vu1Emit::kPand, t2, t1);                                          // isM & maxv
+    e.pi(Vu1Emit::kPor, t4, t2);
+    e.movaps(x, t4);
+}
+// vu1ExpOut(r) -> out (lanes with exponent < 3 or > 252); t is scratch.
+inline void vu1EmitExpOut(Vu1Emit &e, int out, int r, int t)
+{
+    e.movaps(out, r); e.psrld(out, 23); e.piM(Vu1Emit::kPand, out, kR13, kPoolFF);
+    e.movapsLoad(t, kR13, kPoolC3); e.pi(Vu1Emit::kPcmpgtd, t, out); // 3 > e
+    e.piM(Vu1Emit::kPcmpgtd, out, kR13, kPoolC252);                  // e > 252
+    e.pi(Vu1Emit::kPor, out, t);
+}
diff --git a/ps2xRuntime/src/lib/ps2_vu1_async.h b/ps2xRuntime/src/lib/ps2_vu1_async.h
new file mode 100644
index 0000000000000000000000000000000000000000..5adf17feb75b455d6e0fa1b9333cac9d02114ab0
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vu1_async.h
@@ -0,0 +1,53 @@
+#pragma once
+// Asynchronous VIF1/VU1/GIF worker (default on, PS2X_VU1_THREAD=0 disables). Private runtime header: it is only
+// included by runtime .cpp files, never by ps2_runtime.h or generated code.
+#include <cstdint>
+#include <functional>
+
+class PS2Memory;
+
+namespace ps2x_vu1async
+{
+    // Worker on unless PS2X_VU1_THREAD=0 (read once).
+    bool enabled();
+    // True on the worker thread itself.
+    bool onWorkerThread();
+    // EE thread: wait until every queued VIF1/GIF job has run, then publish completions.
+    void drain(PS2Memory &mem, const char *reason);
+    // Any thread except the worker: wait until the worker is idle (no completion publishing).
+    void drainIfOffWorker(const char *reason);
+    // EE thread: publish finished jobs (CHCR.STR clear, D_STAT, DMAC cause). True if any.
+    bool applyCompletions(PS2Memory &mem);
+    // Called (from the worker) after each finished job so the EE scheduler wakes up.
+    void setNotify(std::function<void()> fn);
+
+    // EE-context plumbing for VU1 runs on the worker (set once by PS2Runtime):
+    //  readFbrst():           EE thread, at kick: FBRST (DE1/TE1) of the current guest context.
+    //  applyVpuStopBits(b):   EE thread, at completion: VPU_STAT bits 9/10 (VU1 D/T stop).
+    void setContextHooks(std::function<uint32_t()> readFbrst, std::function<void(uint32_t)> applyVpuStopBits);
+    uint32_t workerFbrst();                     // worker: FBRST snapshot of the running job
+    void workerNoteVpuStopBits(uint32_t bits);  // worker: stop bits after an MSCAL/MSCNT
+
+    // ps2_memory.cpp internals (defined in ps2_vu1_async.inl).
+    void takeTransfers(PS2Memory &mem);
+    bool channelBusy(uint32_t channelBase);
+    // CHCR read of a channel with a job in flight: returns true and the value to report
+    // (STR still set), or drains first when PS2X_VU1_THREAD_DRAIN_ON_POLL=1 and returns false.
+    bool chcrReadWhileBusy(PS2Memory &mem, uint32_t address, uint32_t &value);
+
+    // GS stage (default on with the worker; PS2X_GS_STAGE=0 disables): on the VU1 worker, GIF
+    // arbiter submits/drains (GIF packet parsing + GS backend calls) are queued to a separate
+    // "GSStage" thread in order instead of running inline; the worker waits for the stage at
+    // the end of every job, so DMA completions are still published after their GS work.
+    // Return false when the call must run directly (not on the worker, stage off).
+    bool gsDeferSubmit(PS2Memory &mem, uint32_t pathId, const uint8_t *data, uint32_t sizeBytes, bool path2DirectHl);
+    bool gsDeferDrain(PS2Memory &mem);
+}
+
+// Perf counters for [run:tick] (defined in ps2_memory.cpp).
+namespace ps2x_perf
+{
+    // EE writes to GS DISPFB1/DISPFB2 (one per displayed game frame for sceGsSwapDBuff games).
+    void noteDispfbWrite();
+    uint64_t dispfbWrites();
+}
diff --git a/ps2xRuntime/src/lib/ps2_vu1_async.inl b/ps2xRuntime/src/lib/ps2_vu1_async.inl
new file mode 100644
index 0000000000000000000000000000000000000000..56a6a94ffcf1747bff5d73361d5036a8b196b670
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vu1_async.inl
@@ -0,0 +1,842 @@
+// ps2_vu1_async.inl - asynchronous VIF1 + VU1 + GIF worker (default on; PS2X_VU1_THREAD=0 disables).
+// Included at the end of ps2_memory.cpp (needs PS2Memory internals; no header change).
+//
+// When enabled, processPendingTransfers() no longer runs VIF1 (UNPACK/MPG/MSCAL -> VU1
+// microprograms -> XGKICK) and PATH3 GIF DMA on the EE thread. It copies the transfer data
+// (chain data is already gathered at kick time), queues one job per kick and returns. A
+// single worker thread runs the jobs in kick order, so PATH3 vs PATH1/PATH2 GS order is the
+// same as in synchronous mode. VIF0 stays synchronous on the EE thread.
+//
+// While a job is in flight its channel keeps CHCR.STR=1. When the worker finishes it posts
+// an EE scheduler Dmac event; the EE thread then publishes the completion exactly like the
+// synchronous path did (CHCR.STR clear, QWC=0, D_STAT CIS bit, DMAC cause -> handlers).
+//
+// EE accesses to state the worker owns drain the worker first: VU1 code/data memory,
+// VIF1 registers / FIFO, GIF control, the runtime's direct GS paths (GS::writeRegister /
+// processGIFPacket from a non-worker thread, native GIF chain shortcuts).
+
+#include <condition_variable>
+#include <memory>
+#include <deque>
+#include <thread>
+#include <pthread.h>
+
+extern std::atomic<uint64_t> g_ps2xVu1RunCycles;
+
+namespace ps2x_vu1async
+{
+    namespace
+    {
+        struct Item
+        {
+            bool gif = false;
+            std::vector<uint8_t> data;
+            uint32_t src = 0, qwc = 0, chain = 0; // VIF1 desync trace
+        };
+        struct Job
+        {
+            std::vector<Item> items;
+            bool hadGif = false;
+            bool hadVif1 = false;
+            size_t bytes = 0;
+            uint32_t fbrst = 0;
+        };
+        struct Completion
+        {
+            bool gif = false;
+            bool vif1 = false;
+            bool vpuSet = false;
+            uint32_t vpuBits = 0;
+        };
+        struct State
+        {
+            std::mutex m;
+            std::condition_variable workCv;
+            std::condition_variable idleCv;
+            std::deque<Job> queue;
+            std::vector<Completion> done;
+            uint64_t submitted = 0; // guarded by m
+            uint64_t finished = 0;  // guarded by m
+            std::atomic<uint64_t> finishedAtomic{0};
+            std::atomic<uint64_t> submittedAtomic{0};
+            PS2Memory *mem = nullptr;
+            std::thread::id workerId{};
+            bool started = false;
+            std::function<void()> notify;
+            // EE thread only
+            uint64_t applied = 0;
+            int busyGif = 0;
+            int busyVif1 = 0;
+            // stats
+            std::atomic<uint64_t> workerBusyNs{0};
+            std::atomic<uint64_t> drainWaitNs{0};
+            std::atomic<uint64_t> drains{0};
+            std::atomic<uint64_t> drainsWaited{0};
+            std::atomic<uint64_t> jobs{0};
+            std::atomic<uint64_t> bigJobs{0};
+            std::atomic<uint64_t> jobBytes{0};
+            std::atomic<uint64_t> busyPolls{0};
+            std::atomic<uint64_t> eeSpinNs{0}; // EE time from the first busy CHCR poll until it reads not-busy
+            std::atomic<uint64_t> inlineGif{0};
+            std::mutex reasonMutex;
+            std::unordered_map<std::string, uint64_t> waitReasons;
+            std::unordered_map<std::string, uint64_t> traceKeys; // EE thread only
+            std::chrono::steady_clock::time_point lastStats = std::chrono::steady_clock::now();
+        };
+
+        thread_local bool tlsIsWorker = false;
+        thread_local uint32_t tlsJobFbrst = 0;
+        thread_local bool tlsVpuSet = false;
+        thread_local uint32_t tlsVpuBits = 0;
+        std::function<uint32_t()> g_readFbrst;
+        std::function<void(uint32_t)> g_applyVpuStopBits;
+
+        State &st()
+        {
+            static State *s = new State(); // never destroyed: the worker is detached
+            return *s;
+        }
+
+        bool statsOn()
+        {
+            static const bool on = []() { const char *e = std::getenv("PS2X_VU1_THREAD_STATS"); return e && e[0] == '1'; }();
+            return on;
+        }
+
+        bool traceOn()
+        {
+            static const bool on = []() { const char *e = std::getenv("PS2X_VU1_THREAD_TRACE"); return e && e[0] == '1'; }();
+            return on;
+        }
+
+        bool drainOnPoll()
+        {
+            static const bool on = []() { const char *e = std::getenv("PS2X_VU1_THREAD_DRAIN_ON_POLL"); return e && e[0] == '1'; }();
+            return on;
+        }
+
+        uint64_t nowNs()
+        {
+            return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                             std::chrono::steady_clock::now().time_since_epoch())
+                                             .count());
+        }
+
+        // ---- GS stage ------------------------------------------------------------------------
+        thread_local bool tlsIsGsStage = false;
+        // Ops are batched on the worker (PS2X_GS_STAGE_BATCH=<ops>, default 32; 1 = one op per
+        // hand-off) into one byte arena per batch; batches are recycled through a pool.
+        // PS2X_GS_STAGE_PIPE (default on, 0 = wait at job end): the job's completion is posted by
+        // the stage right after the job's last GS op, so the worker can start the next job while
+        // the stage finishes this one. EE-visible order is unchanged: a job still completes only
+        // after all of its GS work, and completions stay in job order (one FIFO).
+        enum class GsOpKind : uint8_t
+        {
+            Submit,
+            Drain,
+            Complete
+        };
+        struct GsOpHdr
+        {
+            GsOpKind kind = GsOpKind::Submit;
+            bool hl = false;
+            uint32_t path = 0;
+            uint32_t offset = 0;
+            uint32_t size = 0;
+            Completion completion{};
+        };
+        struct GsBatch
+        {
+            std::vector<GsOpHdr> ops;
+            std::vector<uint8_t> bytes;
+        };
+        struct GsStage
+        {
+            std::mutex m;
+            std::condition_variable workCv;
+            std::condition_variable doneCv;
+            std::deque<std::unique_ptr<GsBatch>> queue;
+            std::vector<std::unique_ptr<GsBatch>> pool;
+            uint64_t pushed = 0; // ops, guarded by m
+            uint64_t done = 0;   // ops, guarded by m
+            PS2Memory *mem = nullptr;
+            bool started = false;
+            std::atomic<uint64_t> busyNs{0};
+            std::atomic<uint64_t> waitNs{0};
+            std::atomic<uint64_t> ops{0};
+            std::atomic<uint64_t> batches{0};
+        };
+        GsStage &gsStage()
+        {
+            static GsStage *g = new GsStage(); // never destroyed: the thread is detached
+            return *g;
+        }
+        bool gsStageOn();
+        bool gsStagePipe()
+        {
+            static const bool on = []() { const char *e = std::getenv("PS2X_GS_STAGE_PIPE"); return !(e && e[0] == '0'); }();
+            return on;
+        }
+        size_t gsStageBatchOps()
+        {
+            static const size_t n = []() -> size_t {
+                const char *e = std::getenv("PS2X_GS_STAGE_BATCH");
+                const long v = e ? std::atol(e) : 0;
+                return v > 0 ? static_cast<size_t>(v) : 32u;
+            }();
+            return n;
+        }
+        thread_local std::unique_ptr<GsBatch> tlsGsBatch; // worker only
+
+        void postCompletion(const Completion &c)
+        {
+            State &s = st();
+            std::function<void()> notify;
+            {
+                std::lock_guard<std::mutex> lk(s.m);
+                s.done.push_back(c);
+                ++s.finished;
+                s.finishedAtomic.store(s.finished, std::memory_order_release);
+                notify = s.notify;
+            }
+            s.idleCv.notify_all();
+            if (notify)
+                notify();
+        }
+
+        void gsStageMain()
+        {
+            GsStage &g = gsStage();
+            tlsIsWorker = true; // GS code run here must not drain the worker (it waits for us)
+            tlsIsGsStage = true;
+            pthread_setname_np(pthread_self(), "GSStage");
+            std::vector<std::unique_ptr<GsBatch>> work;
+            for (;;)
+            {
+                PS2Memory *mem = nullptr;
+                {
+                    std::unique_lock<std::mutex> lk(g.m);
+                    g.workCv.wait(lk, [&]() { return !g.queue.empty(); });
+                    work.clear();
+                    while (!g.queue.empty())
+                    {
+                        work.push_back(std::move(g.queue.front()));
+                        g.queue.pop_front();
+                    }
+                    mem = g.mem;
+                }
+                for (auto &batch : work)
+                {
+                    const uint64_t t0 = nowNs();
+                    for (const GsOpHdr &op : batch->ops)
+                    {
+                        if (op.kind == GsOpKind::Complete)
+                        {
+                            postCompletion(op.completion);
+                            continue;
+                        }
+                        try
+                        {
+                            if (!mem || !mem->m_gifArbiter)
+                                continue;
+                            if (op.kind == GsOpKind::Drain)
+                                mem->m_gifArbiter->drain();
+                            else
+                                mem->m_gifArbiter->submit(static_cast<GifPathId>(op.path), batch->bytes.data() + op.offset, op.size, op.hl);
+                        }
+                        catch (const std::exception &e)
+                        {
+                            std::fprintf(stderr, "[gsstage] op threw: %s\n", e.what());
+                        }
+                    }
+                    g.busyNs.fetch_add(nowNs() - t0, std::memory_order_relaxed);
+                    const size_t n = batch->ops.size();
+                    batch->ops.clear();
+                    batch->bytes.clear();
+                    {
+                        std::lock_guard<std::mutex> lk(g.m);
+                        g.done += n;
+                        if (g.pool.size() < 64u)
+                            g.pool.push_back(std::move(batch));
+                    }
+                    g.doneCv.notify_all();
+                }
+            }
+        }
+
+        // Worker: hand the current batch to the stage.
+        void gsStageFlush(PS2Memory &mem)
+        {
+            if (!tlsGsBatch || tlsGsBatch->ops.empty())
+                return;
+            GsStage &g = gsStage();
+            bool wake = false;
+            const size_t n = tlsGsBatch->ops.size();
+            {
+                std::lock_guard<std::mutex> lk(g.m);
+                if (!g.started)
+                {
+                    g.started = true;
+                    std::thread(gsStageMain).detach();
+                    std::fprintf(stderr, "[gsstage] GS stage thread started (PS2X_GS_STAGE=0 disables)\n");
+                }
+                g.mem = &mem;
+                wake = g.queue.empty();
+                g.queue.push_back(std::move(tlsGsBatch));
+                g.pushed += n;
+                if (!g.pool.empty())
+                {
+                    tlsGsBatch = std::move(g.pool.back());
+                    g.pool.pop_back();
+                }
+            }
+            g.ops.fetch_add(n, std::memory_order_relaxed);
+            g.batches.fetch_add(1, std::memory_order_relaxed);
+            if (wake)
+                g.workCv.notify_one();
+        }
+
+        // Worker: append one op to the current batch (data copied into the batch arena).
+        void gsStageAppend(PS2Memory &mem, GsOpKind kind, uint32_t path, const uint8_t *data, uint32_t size, bool hl,
+                           const Completion *completion = nullptr)
+        {
+            if (!tlsGsBatch)
+            {
+                tlsGsBatch = std::make_unique<GsBatch>();
+                tlsGsBatch->bytes.reserve(256u * 1024u);
+            }
+            GsBatch &b = *tlsGsBatch;
+            GsOpHdr h;
+            h.kind = kind;
+            h.hl = hl;
+            h.path = path;
+            h.offset = static_cast<uint32_t>(b.bytes.size());
+            h.size = size;
+            if (completion)
+                h.completion = *completion;
+            if (data && size)
+                b.bytes.insert(b.bytes.end(), data, data + size);
+            b.ops.push_back(h);
+            if (kind == GsOpKind::Complete || b.ops.size() >= gsStageBatchOps() || b.bytes.size() >= 256u * 1024u)
+                gsStageFlush(mem);
+        }
+
+        // Worker: wait until the GS stage has run every op queued so far.
+        void gsStageWait(PS2Memory &mem)
+        {
+            gsStageFlush(mem);
+            GsStage &g = gsStage();
+            const uint64_t t0 = nowNs();
+            std::unique_lock<std::mutex> lk(g.m);
+            if (g.done >= g.pushed)
+                return;
+            g.doneCv.wait(lk, [&]() { return g.done >= g.pushed; });
+            lk.unlock();
+            g.waitNs.fetch_add(nowNs() - t0, std::memory_order_relaxed);
+        }
+
+        void runJobItems(PS2Memory *mem, const Job &job)
+        {
+            for (const Item &it : job.items)
+            {
+                if (it.data.empty())
+                    continue;
+                if (it.gif)
+                {
+                    mem->m_seenGifCopy = true;
+                    mem->m_gifCopyCount.fetch_add(1, std::memory_order_relaxed);
+                    mem->submitGifPacket(GifPathId::Path3, it.data.data(), static_cast<uint32_t>(it.data.size()), false);
+                }
+                else
+                {
+                    ps2xVif1NoteTransfer(it.src, it.qwc, it.chain);
+                    mem->processVIF1Data(it.data.data(), static_cast<uint32_t>(it.data.size()));
+                }
+            }
+            if (mem->m_gifArbiter && !gsDeferDrain(*mem))
+                mem->m_gifArbiter->drain();
+            if (tlsIsWorker && gsStageOn() && !gsStagePipe())
+                gsStageWait(*mem);
+        }
+
+        void workerMain()
+        {
+            State &s = st();
+            tlsIsWorker = true;
+            pthread_setname_np(pthread_self(), "VU1Worker");
+            for (;;)
+            {
+                Job job;
+                PS2Memory *mem = nullptr;
+                {
+                    std::unique_lock<std::mutex> lk(s.m);
+                    s.workCv.wait(lk, [&]() { return !s.queue.empty(); });
+                    job = std::move(s.queue.front());
+                    s.queue.pop_front();
+                    mem = s.mem;
+                }
+                const uint64_t t0 = nowNs();
+                if (mem)
+                {
+                    try
+                    {
+                        tlsJobFbrst = job.fbrst;
+                        tlsVpuSet = false;
+                        runJobItems(mem, job);
+                    }
+                    catch (const std::exception &e)
+                    {
+                        std::fprintf(stderr, "[vu1thread] job threw: %s\n", e.what());
+                    }
+                }
+                s.workerBusyNs.fetch_add(nowNs() - t0, std::memory_order_relaxed);
+                const Completion completion{job.hadGif, job.hadVif1, tlsVpuSet, tlsVpuBits};
+                if (mem && gsStageOn() && gsStagePipe())
+                    gsStageAppend(*mem, GsOpKind::Complete, 0u, nullptr, 0u, false, &completion);
+                else
+                    postCompletion(completion);
+            }
+        }
+
+        void ensureStarted()
+        {
+            State &s = st();
+            std::lock_guard<std::mutex> lk(s.m);
+            if (s.started)
+                return;
+            s.started = true;
+            std::thread t(workerMain);
+            s.workerId = t.get_id();
+            t.detach();
+            std::fprintf(stderr, "[vu1thread] VIF1/VU1/GIF worker thread started (PS2X_VU1_THREAD=0 disables)\n");
+        }
+
+        void completeChannel(PS2Memory &mem, uint32_t channelBit, uint32_t channelBase)
+        {
+            static constexpr uint32_t D_STAT = 0x1000E010u;
+            uint32_t dstat = mem.m_ioRegisters.count(D_STAT) ? mem.m_ioRegisters[D_STAT] : 0u;
+            dstat |= (1u << channelBit);
+            const uint32_t status = dstat & 0x3FFu;
+            const uint32_t mask = (dstat >> 16) & 0x3FFu;
+            if ((status & mask) != 0u)
+                dstat |= (1u << 31);
+            else
+                dstat &= ~(1u << 31);
+            mem.m_ioRegisters[D_STAT] = dstat;
+            mem.queueCompletedDmacCause(channelBit);
+            mem.m_ioRegisters[channelBase + 0x00] &= ~0x100u;
+            mem.m_ioRegisters[channelBase + 0x20] = 0;
+        }
+
+        void maybeStats()
+        {
+            State &s = st();
+            if (!statsOn())
+                return;
+            const auto now = std::chrono::steady_clock::now();
+            const double span = std::chrono::duration<double>(now - s.lastStats).count();
+            if (span < 5.0)
+                return;
+            s.lastStats = now;
+            std::string reasons;
+            {
+                std::lock_guard<std::mutex> lk(s.reasonMutex);
+                for (auto &kv : s.waitReasons)
+                    reasons += " " + kv.first + "=" + std::to_string(kv.second);
+                s.waitReasons.clear();
+            }
+            const uint64_t busyNsSnap = s.workerBusyNs.exchange(0);
+            std::fprintf(stderr,
+                         "[vu1thread:stats] jobs=%llu (big %llu, %.1f MB) worker busy %.0f%% VU1 %.1f Mcyc/busy-s | EE drains=%llu waited=%llu (%.0f ms) busyPolls=%llu spin %.0f ms inlineGif=%llu |%s\n",
+                         (unsigned long long)s.jobs.exchange(0), (unsigned long long)s.bigJobs.exchange(0),
+                         s.jobBytes.exchange(0) / 1048576.0, 100.0 * (busyNsSnap / 1e9) / span,
+                         busyNsSnap ? (g_ps2xVu1RunCycles.exchange(0) * 1e3 / double(busyNsSnap)) : 0.0,
+                         (unsigned long long)s.drains.exchange(0), (unsigned long long)s.drainsWaited.exchange(0),
+                         s.drainWaitNs.exchange(0) / 1e6, (unsigned long long)s.busyPolls.exchange(0), s.eeSpinNs.exchange(0) / 1e6, (unsigned long long)s.inlineGif.exchange(0), reasons.c_str());
+            if (gsStageOn())
+                std::fprintf(stderr, "[vu1thread:stats] GS stage busy %.0f%%, worker waited %.0f ms for it, %llu ops in %llu batches\n",
+                             100.0 * (gsStage().busyNs.exchange(0) / 1e9) / span, gsStage().waitNs.exchange(0) / 1e6,
+                             (unsigned long long)gsStage().ops.exchange(0), (unsigned long long)gsStage().batches.exchange(0));
+            if (traceOn() && !s.traceKeys.empty())
+            {
+                std::vector<std::pair<uint64_t, std::string>> v;
+                for (auto &kv : s.traceKeys)
+                    v.emplace_back(kv.second, kv.first);
+                std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.first > b.first; });
+                for (size_t i = 0; i < v.size() && i < 8; ++i)
+                    std::fprintf(stderr, "[vu1thread:trace] %8llu x %s\n", (unsigned long long)v[i].first, v[i].second.c_str());
+                s.traceKeys.clear();
+            }
+        }
+
+        // Wait (any thread) until the worker has run everything submitted before this call.
+        // Snapshot semantics: a thread that is not the submitter must not wait for "idle",
+        // because the EE may keep the queue non-empty forever.
+        void waitIdle(const char *reason)
+        {
+            State &s = st();
+            const uint64_t target = s.submittedAtomic.load(std::memory_order_acquire);
+            if (s.finishedAtomic.load(std::memory_order_acquire) >= target)
+                return;
+            const uint64_t t0 = nowNs();
+            {
+                std::unique_lock<std::mutex> lk(s.m);
+                s.idleCv.wait(lk, [&]() { return s.finished >= target; });
+            }
+            s.drainWaitNs.fetch_add(nowNs() - t0, std::memory_order_relaxed);
+            s.drainsWaited.fetch_add(1, std::memory_order_relaxed);
+            if (statsOn() && reason)
+            {
+                std::lock_guard<std::mutex> lk(s.reasonMutex);
+                ++s.waitReasons[reason];
+            }
+        }
+
+        std::vector<uint8_t> gatherLinear(PS2Memory &mem, uint32_t srcAddr, uint32_t qwc, bool fromScratchpad)
+        {
+            std::vector<uint8_t> out;
+            if (qwc == 0)
+                return out;
+            uint32_t srcPhys = 0;
+            try
+            {
+                srcPhys = mem.translateAddress(srcAddr);
+            }
+            catch (const std::exception &)
+            {
+                return out;
+            }
+            const uint64_t bytes64 = static_cast<uint64_t>(qwc) * 16ull;
+            uint32_t bytesLeft = (bytes64 > 0xFFFFFFFFull) ? 0xFFFFFFFFu : static_cast<uint32_t>(bytes64);
+            const uint8_t *base = fromScratchpad ? mem.m_scratchpad : mem.m_rdram;
+            const uint32_t size = fromScratchpad ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            out.reserve(bytesLeft);
+            while (bytesLeft > 0)
+            {
+                if (srcPhys >= size)
+                    srcPhys = 0;
+                uint32_t chunk = bytesLeft;
+                if (srcPhys + chunk > size)
+                    chunk = size - srcPhys;
+                if (chunk == 0)
+                    break;
+                out.insert(out.end(), base + srcPhys, base + srcPhys + chunk);
+                bytesLeft -= chunk;
+                srcPhys += chunk;
+            }
+            return out;
+        }
+    } // namespace
+
+    bool enabled()
+    {
+        static const bool on = []() {
+            // Default on (stable + faster in the ship-deck scene, 2026-11-17). PS2X_VU1_THREAD=0
+            // restores the old fully synchronous VIF1/VU1/GIF path on the EE thread.
+            const char *e = std::getenv("PS2X_VU1_THREAD");
+            return !(e && e[0] == '0');
+        }();
+        return on;
+    }
