+// ---- Phase 0a draw tagging (PS2X_DRAWTAG=1, diagnostic, default off) ----------------------
+// Tags every VU1 XGKICK / VIF1 DIRECT packet with the VU1 program (MSCAL start) and the game
+// function ("emitter") whose heap allocation holds the MSCAL/DIRECT VIFcode. Emitter ranges are
+// registered by the game overrides (ps2xDrawTagAddRange); guest addresses of gathered DMA chains
+// come from ps2xDrawTagRegisterChain (ps2_memory.cpp). The tag travels in-band as a 16-byte
+// NLOOP=0 GIFtag prefix that GifArbiter::drain strips (g_ps2xDrawTag).
+// Tag layout: bits 0..10 = program pc (MSCAL imm; 0x7FF = VIF DIRECT), bits 11..18 = emitter id
+// (0 = no guest address, 0xFF = address outside every registered range), bit 31 = valid.
+uint32_t g_ps2xDrawTagCur = 0u;
+namespace
+{
+    struct DtRange { uint32_t hi; uint32_t id; };
+    std::mutex g_dtMutex;
+    std::map<uint32_t, DtRange> g_dtRanges;                       // guest lo -> (hi, emitter)
+    struct DtChain { uint32_t size; uint64_t seq; std::vector<uint32_t> segs; }; // (bufOff, guest, len)*
+    std::map<const uint8_t *, DtChain> g_dtChains;
+    uint64_t g_dtChainSeq = 0;
+    thread_local const uint8_t *tl_dtBase = nullptr;
+    thread_local std::vector<uint32_t> tl_dtSegs;
+    // per-interval VIF-side counters (worker thread only)
+    std::map<uint32_t, uint64_t> g_dtMscal;   // tag -> MSCAL count
+    std::map<uint32_t, uint64_t> g_dtUnattr;  // guest addr >> 16 -> count (emitter 0xFF)
+    uint64_t g_dtNoAddr = 0;
+}
+extern "C" bool ps2xDrawTagOn()
+{
+    static const bool on = []() { const char *e = std::getenv("PS2X_DRAWTAG"); return e && e[0] == '1'; }();
+    return on;
+}
+extern "C" void ps2xDrawTagAddRange(uint32_t lo, uint32_t hi, uint32_t id)
+{
+    if (!ps2xDrawTagOn() || hi <= lo)
+        return;
+    const uint32_t len = hi - lo;
+    lo &= 0x1FFFFFFFu;
+    hi = lo + len;
+    std::lock_guard<std::mutex> lk(g_dtMutex);
+    auto it = g_dtRanges.lower_bound(lo);
+    if (it != g_dtRanges.begin())
+    {
+        auto pv = std::prev(it);
+        if (pv->second.hi > lo)
+            it = pv;
+    }
+    while (it != g_dtRanges.end() && it->first < hi)
+        it = g_dtRanges.erase(it);
+    g_dtRanges[lo] = DtRange{hi, id};
+}
+void ps2xDrawTagRegisterChain(const uint8_t *buf, uint32_t size, std::vector<uint32_t> &&segs)
+{
+    if (!buf || !size)
+        return;
+    std::lock_guard<std::mutex> lk(g_dtMutex);
+    auto it = g_dtChains.lower_bound(buf);
+    if (it != g_dtChains.begin())
+    {
+        auto pv = std::prev(it);
+        if (pv->first + pv->second.size > buf)
+            it = pv;
+    }
+    while (it != g_dtChains.end() && it->first < buf + size)
+        it = g_dtChains.erase(it);
+    if (g_dtChains.size() > 512u)
+    {
+        auto old = g_dtChains.begin();
+        for (auto j = g_dtChains.begin(); j != g_dtChains.end(); ++j)
+            if (j->second.seq < old->second.seq)
+                old = j;
+        g_dtChains.erase(old);
+    }
+    g_dtChains[buf] = DtChain{size, ++g_dtChainSeq, std::move(segs)};
+}
+namespace
+{
+    // Called at processVIF1Data entry (worker thread): find the chain buffer holding data.
+    void dtEnterBuffer(const uint8_t *data)
+    {
+        tl_dtBase = nullptr;
+        tl_dtSegs.clear();
+        std::lock_guard<std::mutex> lk(g_dtMutex);
+        auto it = g_dtChains.upper_bound(data);
+        if (it == g_dtChains.begin())
+            return;
+        --it;
+        if (data >= it->first + it->second.size)
+            return;
+        tl_dtBase = it->first;
+        tl_dtSegs = it->second.segs;
+    }
+    uint32_t dtGuestAddr(const uint8_t *p, const uint8_t *rdram)
+    {
+        if (rdram && p >= rdram && p < rdram + 32u * 1024u * 1024u)
+            return static_cast<uint32_t>(p - rdram);
+        if (!tl_dtBase || p < tl_dtBase)
+            return 0xFFFFFFFFu;
+        const uint32_t off = static_cast<uint32_t>(p - tl_dtBase);
+        for (size_t i = 0; i + 2 < tl_dtSegs.size(); i += 3)
+            if (off >= tl_dtSegs[i] && off < tl_dtSegs[i] + tl_dtSegs[i + 2])
+                return (tl_dtSegs[i + 1] & 0x1FFFFFFFu) + (off - tl_dtSegs[i]);
+        return 0xFFFFFFFFu;
+    }
+    uint32_t dtMakeTag(uint32_t prog, const uint8_t *p, const uint8_t *rdram)
+    {
+        uint32_t em = 0u;
+        const uint32_t ga = dtGuestAddr(p, rdram);
+        std::lock_guard<std::mutex> lk(g_dtMutex);
+        if (ga == 0xFFFFFFFFu)
+            ++g_dtNoAddr;
+        else
+        {
+            em = 0xFFu;
+            auto it = g_dtRanges.upper_bound(ga);
+            if (it != g_dtRanges.begin())
+            {
+                --it;
+                if (ga < it->second.hi)
+                    em = it->second.id & 0xFFu;
+            }
+            if (em == 0xFFu)
+                ++g_dtUnattr[ga >> 16];
+        }
+        const uint32_t tag = 0x80000000u | (prog & 0x7FFu) | (em << 11);
+        ++g_dtMscal[tag];
+        return tag;
+    }
+}
+// VIF-side interval report (called from the GS side dump, any thread; racy counters are fine for a diagnostic).
+extern "C" void ps2xDrawTagVifReport(FILE *f)
+{
+    std::lock_guard<std::mutex> lk(g_dtMutex);
+    std::fprintf(f, "[drawtag:vif] MSCAL/DIRECT tags this interval (prog em count), noaddr=%llu\n", (unsigned long long)g_dtNoAddr);
+    for (const auto &kv : g_dtMscal)
+        if ((kv.first & 0x7FFu) == 0x7FFu)
+            std::fprintf(f, "[drawtag:vif]   DIRECT em=%u n=%llu\n", (kv.first >> 11) & 0xFFu, (unsigned long long)kv.second);
+        else
+            std::fprintf(f, "[drawtag:vif]   prog=0x%04x em=%u n=%llu\n", (kv.first & 0x7FFu) * 8u, (kv.first >> 11) & 0xFFu, (unsigned long long)kv.second);
+    for (const auto &kv : g_dtUnattr)
+        std::fprintf(f, "[drawtag:vif]   unattributed addr %08x.. n=%llu\n", kv.first << 16, (unsigned long long)kv.second);
+    g_dtMscal.clear();
+    g_dtUnattr.clear();
+    g_dtNoAddr = 0;
+}
+// Submit a GIF packet with the in-band tag prefix.
+void ps2xDrawTagPrefix(std::vector<uint8_t> &out, const uint8_t *data, uint32_t size, uint32_t tag)
+{
+    out.resize(16u + size);
+    const uint64_t lo = (1ull << 60);                       // NLOOP=0 EOP=0 FLG=PACKED NREG=1
+    const uint64_t hi = 0xD7A61A6000000000ull | tag;        // magic + tag
+    std::memcpy(out.data(), &lo, 8);
+    std::memcpy(out.data() + 8, &hi, 8);
+    std::memcpy(out.data() + 16, data, size);
+}
