+// ps2_vu1_native.inl - PS2X_VU1_NATIVE: x86-64 code for the VU1 block executor's blocks.
+// Included inside an anonymous namespace of ps2_vu1_core.cpp (no CMake change needed).
+//
+// Milestone 1 ("call-threaded" native blocks): every pair of a block is emitted as straight-line
+// x86-64 with all per-pair constants baked in. The stall check (max over the pair's ready slots
+// against m_cycle), the ready-slot writes, the VF0/VI0 reset, PC update, cycle advance, commit
+// hint test, XGKICK test and stop test are inline. The upper and lower ops are direct calls
+// into the exact interpreter code (fmacCore/execUpper, fastLower/execLower), and so is any
+// actual stall. The C++ block loop stays the fallback and the BC_CHECK reference
+// runs the plain interpreter.
+//
+// Milestone 2: native SSE2 FMAC (exact vu1FmacSimd math; rejected lanes call the C++ path),
+// inline dead-flag carry. Milestone 3: native MAX/MINI/ITOF/FTOI/ABS uppers, native
+// LQ/LQI/SQ/SQI/ILW/ILWR/ISW/ISWR/MOVE/MTIR/MFIR/FCAND/IADD*/IAND/IOR/IBEQ/IBNE lowers (incl. the
+// branch-read VI backup), VF0/VI0 reset only after a pair that may write them, I-bit immediates.
+// Default ON since milestone 3 (0 mismatches: 1.22M BC_CHECK runs / 200 s title-path scene and
+// 0.98M runs / 200 s slot-4 save scene). PS2X_VU1_NATIVE=0 reverts to the C++ block loop.
+// Sub-switches: PS2X_VU1_NATIVE_FMAC=0, PS2X_VU1_NATIVE_OPS=0 (milestone-2 op set),
+// PS2X_VU1_NATIVE_VF0=0 (reset every pair), PS2X_VU1_NATIVE_STATS=1 (log blocks + helper ops).
+
+struct Vu1JitCtx
+{
+    void *stall = nullptr;   // lambdas of the current run() (type-erased)
+    void *fmac = nullptr;
+    void *upper = nullptr;
+    void *lower = nullptr;
+    void *pcBranch = nullptr;
+    void *flags = nullptr;
+    const uint8_t *vuData = nullptr;
+    int32_t oldVi = 0;
+    uint64_t stallTarget = 0;
+    void *store = nullptr;
+    void *commit = nullptr;
+    void *xgkick = nullptr;
+    uint64_t budgetEnd = 0;
+    void **nativeTab = nullptr; // PS2X_VU1_OPT bit 2: the run's compiled-block table (Vu1Xlat::native)
+    uint32_t chained = 0;       // set by a block that jumped on into another block
+    void *self = nullptr;       // PS2X_VU1_OPT bits 11/12: the VU1Interpreter running the block
+};
+thread_local int64_t tl_vu1EntryOff = -1; // bytes from a block's start to the end of its (fixed) prologue
+using Vu1JitHelper = uint32_t (*)(Vu1JitCtx *, uint32_t, uint32_t);
+using Vu1NativeFn = uint32_t (*)(void *self, Vu1JitCtx *ctx);
+static void *const kVu1NativeFailed = reinterpret_cast<void *>(1);
+
+bool vu1NativeOn()
+{
+    static const bool on = []() { const char *e = std::getenv("PS2X_VU1_NATIVE"); return !(e && e[0] == '0'); }();
+    return on;
+}
+bool vu1NativeStats()
+{
+    static const bool on = []() { const char *e = std::getenv("PS2X_VU1_NATIVE_STATS"); return e && e[0] == '1'; }();
+    return on;
+}
+
+// Per-thread executable arena (Vu1Xlat caches are thread_local too, and the emitted code
+// embeds this thread's TLS addresses of the commit hint).
+struct Vu1CodeArena
+{
+    uint8_t *base = nullptr;
+    size_t size = 0, used = 0;
+    bool failed = false;
+    uint64_t blocks = 0, pairs = 0;
+    bool reserve()
+    {
+        if (base || failed)
+            return base != nullptr;
+        size = 64u << 20;
+        void *m = mmap(nullptr, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (m == MAP_FAILED)
+        {
+            failed = true;
+            std::fprintf(stderr, "[vu1:native] mmap of the code arena failed; native blocks disabled\n");
+            return false;
+        }
+        base = static_cast<uint8_t *>(m);
+        return true;
+    }
+};
+thread_local Vu1CodeArena tl_vu1Arena;
