+            std::vector<uint8_t> px;
+            if (!clearAndRead(w, h, px))
+                return frame;
+            if (++m_presents % 600u == 1u)
+                std::fprintf(stderr, "[gs:vk] presents=%llu (%ux%u clear %06x) validation errors=%llu warnings=%llu\n",
+                             static_cast<unsigned long long>(m_presents), w, h, m_clear,
+                             static_cast<unsigned long long>(g_vkValErrors), static_cast<unsigned long long>(g_vkValWarnings));
+            if (!m_passthru)
+            {
+                frame.pixels = std::move(px);
+                frame.width = w;
+                frame.height = h;
+            }
+            return frame;
+        }
+
+    private:
+        bool fail(const char *what, VkResult r)
+        {
+            std::fprintf(stderr, "[gs:vk] %s failed (VkResult %d)\n", what, static_cast<int>(r));
+            return false;
+        }
+
+        uint32_t memType(uint32_t bits, VkMemoryPropertyFlags want)
+        {
+            VkPhysicalDeviceMemoryProperties mp;
+            vkGetPhysicalDeviceMemoryProperties(m_phys, &mp);
+            for (uint32_t i = 0; i < mp.memoryTypeCount; ++i)
+                if ((bits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & want) == want)
+                    return i;
+            return UINT32_MAX;
+        }
+
+        void freeTarget()
+        {
+            if (!m_dev) return;
+            if (m_mapped) { vkUnmapMemory(m_dev, m_bufMem); m_mapped = nullptr; }
+            if (m_buf) vkDestroyBuffer(m_dev, m_buf, nullptr);
+            if (m_bufMem) vkFreeMemory(m_dev, m_bufMem, nullptr);
+            if (m_img) vkDestroyImage(m_dev, m_img, nullptr);
+            if (m_imgMem) vkFreeMemory(m_dev, m_imgMem, nullptr);
+            m_buf = VK_NULL_HANDLE; m_bufMem = VK_NULL_HANDLE; m_img = VK_NULL_HANDLE; m_imgMem = VK_NULL_HANDLE;
+            m_w = m_h = 0;
+        }
+
+        bool makeTarget(uint32_t w, uint32_t h)
+        {
+            freeTarget();
+            VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+            ii.imageType = VK_IMAGE_TYPE_2D;
+            ii.format = VK_FORMAT_R8G8B8A8_UNORM;
+            ii.extent = {w, h, 1};
+            ii.mipLevels = 1;
+            ii.arrayLayers = 1;
+            ii.samples = VK_SAMPLE_COUNT_1_BIT;
+            ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+            ii.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+            ii.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            if (vkCreateImage(m_dev, &ii, nullptr, &m_img) != VK_SUCCESS) return false;
+            VkMemoryRequirements mr;
+            vkGetImageMemoryRequirements(m_dev, m_img, &mr);
+            VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+            ai.allocationSize = mr.size;
+            ai.memoryTypeIndex = memType(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+            if (ai.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &m_imgMem) != VK_SUCCESS) return false;
+            vkBindImageMemory(m_dev, m_img, m_imgMem, 0);
+
+            VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+            bi.size = static_cast<VkDeviceSize>(w) * h * 4u;
+            bi.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+            bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+            if (vkCreateBuffer(m_dev, &bi, nullptr, &m_buf) != VK_SUCCESS) return false;
+            vkGetBufferMemoryRequirements(m_dev, m_buf, &mr);
+            ai.allocationSize = mr.size;
+            ai.memoryTypeIndex = memType(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+            if (ai.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &m_bufMem) != VK_SUCCESS) return false;
+            vkBindBufferMemory(m_dev, m_buf, m_bufMem, 0);
+            if (vkMapMemory(m_dev, m_bufMem, 0, VK_WHOLE_SIZE, 0, &m_mapped) != VK_SUCCESS) return false;
+            m_w = w; m_h = h;
+            return true;
+        }
+
+        bool clearAndRead(uint32_t w, uint32_t h, std::vector<uint8_t> &out)
+        {
+            std::lock_guard<std::mutex> lk(m_mutex);
+            if (!m_dev || m_broken) return false;
+            if ((w != m_w || h != m_h) && !makeTarget(w, h)) { m_broken = true; fail("target allocation", VK_ERROR_OUT_OF_DEVICE_MEMORY); return false; }
+            vkResetCommandBuffer(m_cmd, 0);
+            VkCommandBufferBeginInfo bb{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+            bb.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+            vkBeginCommandBuffer(m_cmd, &bb);
+            VkImageSubresourceRange rng{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+            VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+            b.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+            b.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            b.image = m_img;
+            b.subresourceRange = rng;
+            vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+            VkClearColorValue cc{};
+            cc.float32[0] = ((m_clear >> 16) & 0xFF) / 255.0f;
+            cc.float32[1] = ((m_clear >> 8) & 0xFF) / 255.0f;
+            cc.float32[2] = (m_clear & 0xFF) / 255.0f;
+            cc.float32[3] = 1.0f;
+            vkCmdClearColorImage(m_cmd, m_img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &cc, 1, &rng);
+            b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            b.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+            b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+            vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+            VkBufferImageCopy cp{};
+            cp.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+            cp.imageExtent = {w, h, 1};
+            vkCmdCopyImageToBuffer(m_cmd, m_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, m_buf, 1, &cp);
+            VkBufferMemoryBarrier hb{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+            hb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            hb.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+            hb.srcQueueFamilyIndex = hb.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            hb.buffer = m_buf;
+            hb.size = VK_WHOLE_SIZE;
+            vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1, &hb, 0, nullptr);
+            vkEndCommandBuffer(m_cmd);
+            VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+            si.commandBufferCount = 1;
+            si.pCommandBuffers = &m_cmd;
+            if (VkResult r = vkQueueSubmit(m_queue, 1, &si, m_fence); r != VK_SUCCESS) { m_broken = true; return fail("vkQueueSubmit", r); }
+            vkWaitForFences(m_dev, 1, &m_fence, VK_TRUE, UINT64_MAX);
+            vkResetFences(m_dev, 1, &m_fence);
+            const uint8_t *src = static_cast<const uint8_t *>(m_mapped);
+            out.assign(src, src + static_cast<size_t>(w) * h * 4u);
+            return true;
+        }
+
+        void destroy()
+        {
+            if (m_dev)
+            {
+                vkDeviceWaitIdle(m_dev);
+                m_vram.destroy();
+                freeTarget();
+                if (m_fence) vkDestroyFence(m_dev, m_fence, nullptr);
+                if (m_pool) vkDestroyCommandPool(m_dev, m_pool, nullptr);
+                vkDestroyDevice(m_dev, nullptr);
+                m_dev = VK_NULL_HANDLE;
+            }
+            if (m_inst)
+            {
+                if (m_msg)
+                {
+                    std::fprintf(stderr, "[gs:vk] shutdown: presents=%llu validation errors=%llu warnings=%llu\n",
+                                 static_cast<unsigned long long>(m_presents), static_cast<unsigned long long>(g_vkValErrors),
+                                 static_cast<unsigned long long>(g_vkValWarnings));
+                    auto d = reinterpret_cast<PFN_vkDestroyDebugUtilsMessengerEXT>(vkGetInstanceProcAddr(m_inst, "vkDestroyDebugUtilsMessengerEXT"));
+                    if (d) d(m_inst, m_msg, nullptr);
+                    m_msg = VK_NULL_HANDLE;
+                }
+                vkDestroyInstance(m_inst, nullptr);
+                m_inst = VK_NULL_HANDLE;
+            }
+        }
+
+        std::unique_ptr<GSRasterBackend> m_ref;
+        // Vulkan alone (default since vk17 when Vulkan renders and serves GS -> host reads; PS2X_VK_REF=1 turns it off):
+        // the wrapped reference renderer only gets transfers/CLUT and a metadata present every 30 frames (no draws), so
+        // its VRAM lacks drawn pixels. The prof line counts reads that still went to it ("from ref") and fallbacks.
+        bool skipRef() const { return m_noRef && m_vramOn && m_vram.renderOn() && !m_vram.comparing(); }
+        uint32_t m_metaDfbp = 0;
+        bool m_staleMeta = std::getenv("PS2X_VK_STALEMETA") != nullptr; // debug: old behaviour (cached source fbp)
+        double m_pL2hMs = 0; unsigned long long m_pL2hBytes = 0, m_pL2hRef = 0, m_pFb = 0; unsigned m_l2hLog = 0;
+        bool m_l2hVk = !(std::getenv("PS2X_VK_L2H") && std::getenv("PS2X_VK_L2H")[0] == '0'), m_l2hOwn = false;
+        bool m_l2hCheck = std::getenv("PS2X_VK_L2HCHECK") != nullptr;
+        std::vector<uint8_t> m_l2hBuf; size_t m_l2hPos = 0;
+        uint64_t m_l2hCmpN = 0, m_l2hCmpBad = 0, m_l2hCmpCalls = 0, m_l2hCh[4]{}, m_l2hSum[4][2]{}; int m_l2hCmpMax = 0;
+        bool m_prof = std::getenv("PS2X_VK_PROF") != nullptr,
+             // vk17: with GS -> host reads served by Vulkan the reference renderer no longer gets draws by default
+             // (its GL thread cost ~45% of a core at 4x). PS2X_VK_REF=1 (or PS2X_VK_L2H=0) keeps it drawing.
+             m_noRef = std::getenv("PS2X_VK_NOREF") != nullptr || (m_l2hVk && !m_l2hCheck && !(std::getenv("PS2X_VK_REF") && std::getenv("PS2X_VK_REF")[0] == '1'));
+        double m_pVk = 0, m_pRef = 0, m_pRefP = 0, m_pVkP = 0, m_pWall0 = 0;
+        uint64_t m_pN = 0;
+        bool m_refPresAll = std::getenv("PS2X_VK_REFPRES") && std::getenv("PS2X_VK_REFPRES")[0] == '1', m_haveMeta = false;
+        const char *m_presDump = std::getenv("PS2X_VK_PRESDUMP");
+        PresentationFrame m_meta;
+        mutable uint64_t m_pL2h = 0, m_pRv = 0, m_pSnap = 0;
+        VkVramMirror m_vram;
+        bool m_vramOn = false;
+        std::mutex m_mutex;
+        bool m_validate = false, m_passthru = false, m_broken = false;
+        uint32_t m_clear = 0x2050a0u;
+        uint64_t m_presents = 0;
+        VkInstance m_inst = VK_NULL_HANDLE;
+        VkDebugUtilsMessengerEXT m_msg = VK_NULL_HANDLE;
+        VkPhysicalDevice m_phys = VK_NULL_HANDLE;
+        VkDevice m_dev = VK_NULL_HANDLE;
+        VkQueue m_queue = VK_NULL_HANDLE;
+        uint32_t m_qfam = 0;
+        VkCommandPool m_pool = VK_NULL_HANDLE;
+        VkCommandBuffer m_cmd = VK_NULL_HANDLE;
+        VkFence m_fence = VK_NULL_HANDLE;
+        VkImage m_img = VK_NULL_HANDLE;
+        VkDeviceMemory m_imgMem = VK_NULL_HANDLE;
+        VkBuffer m_buf = VK_NULL_HANDLE;
+        VkDeviceMemory m_bufMem = VK_NULL_HANDLE;
+        void *m_mapped = nullptr;
+        uint32_t m_w = 0, m_h = 0;
+    };
+}
+
+std::unique_ptr<GSRasterBackend> gsCreateVulkanBackend(std::unique_ptr<GSRasterBackend> &inner)
+{
+    if (!inner)
+        return nullptr;
+    auto vk = std::make_unique<GSVulkanBackend>(nullptr);
+    if (!vk->init())
+        return nullptr; // `inner` untouched
+    vk->setRef(std::move(inner));
+    return vk;
+}
+
+bool gsVulkanCompiledIn() { return true; }
+
+#else // !PS2X_HAVE_VULKAN
+
+std::unique_ptr<GSRasterBackend> gsCreateVulkanBackend(std::unique_ptr<GSRasterBackend> &) { return nullptr; }
+bool gsVulkanCompiledIn() { return false; }
+
+#endif
diff --git a/ps2xRuntime/src/lib/gs/gs_vk_render.inl b/ps2xRuntime/src/lib/gs/gs_vk_render.inl
new file mode 100644
index 0000000000000000000000000000000000000000..a5f6fa847f637d2d74f6ba0a758336e139cd1b21
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_vk_render.inl
@@ -0,0 +1,1372 @@
+// Vulkan GS renderer (Phase 3 steps 3-6). Textually #included INSIDE class VkVramMirror (gs_vk_vram.inl) so it
+// shares the VRAM buffer, LUTs, descriptor set, command buffer and mutex: uploads (compute) and draws (graphics)
+// are recorded into one command stream in GS event order.
+//   pipeline key  = topology | blend (eq, src, dst) | depth (test, op, write) | colour write mask
+//   render target = Vulkan RGBA8 image per FRAME (fbp, fbw, psm) + D32 per ZBUF (zbp, fbw, psm), GENERAL layout
+//   draws         = GSDrawList batches, vertices expanded on the CPU into a 64 MB ring, textures read in the
+//                   fragment shader straight from the VRAM buffer (+ CLUT at CBP)
+// Not yet: render-to-texture (textures only see uploaded data), target <-> VRAM sync, DATE, FB/ZB-only alpha fail,
+// PABE, AA1, CLD buffering, mipmaps, bilinear.
+public:
+    bool renderOn() const { return m_rOn; }
+    bool comparing() const { return m_cmpEvery != 0u || m_checkEvery != 0u; }
+    struct RStats { uint64_t batches = 0, draws = 0, verts = 0, pipelines = 0, targets = 0, passes = 0, skipped = 0, writebacks = 0, seeds = 0, xsync = 0, rtt = 0; };
+
+    void drawList(const GSDrawList &l)
+    {
+        if (!m_rOn) return;
+        const auto lt0 = std::chrono::steady_clock::now();
+        std::lock_guard<std::mutex> lk(m_m);
+        m_pLockMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - lt0).count();
+        waitInFlight();
+        for (const GSDrawListBatch &b : l.batches)
+            drawBatchLocked(b, l.vertices.data() + b.firstVertex, static_cast<size_t>(b.primCount) * b.vertsPerPrim);
+    }
+    void drawPrim(const GSPrimitiveBatch &prim)
+    {
+        if (!m_rOn) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        GSDrawListBatch b;
+        b.state = prim.state;
+        b.primCount = 1;
+        b.vertsPerPrim = prim.vertexCount > 3 ? 3 : prim.vertexCount;
+        drawBatchLocked(b, prim.vertices.data(), b.vertsPerPrim);
+    }
+
+private:
+    struct RTarget { VkImage img = VK_NULL_HANDLE; VkDeviceMemory mem = VK_NULL_HANDLE; VkImageView view = VK_NULL_HANDLE; uint32_t w = 0, h = 0; bool depth = false; uint64_t lastF = 0, draws = 0; uint32_t dirtyRows = 0, hiRows = 0, dirtyLo = 0xFFFFFFFFu, loRows = 0xFFFFFFFFu; bool stale = false; uint64_t seq = 0; uint32_t staleLo = 0xFFFFFFFFu, staleHi = 0; uint64_t drawF = 0; uint32_t drawLo = 0, drawHi = 0; };
+    static constexpr uint32_t kRing = 64u * 1024u * 1024u;
+    static constexpr uint32_t kRingHalf = (kRing / 2u / 768u) * 768u; // slot 1's ring base: whole vertices, 256-aligned
+    size_t ringLo() const { return m_two ? m_slot * kRingHalf : 0u; }
+    size_t ringHi() const { return m_two ? (m_slot ? kRing : kRingHalf) : kRing; }
+    static constexpr uint32_t kRows = 1024u;
+    static constexpr uint32_t kFloats = 16u; // vk20: +vec4 sprite texel rect (text filter)
+
+    bool renderInit()
+    {
+        if (const char *e = std::getenv("PS2X_VK_RENDER"); e && e[0] == '0')
+            return false;
+        if (const char *e = std::getenv("PS2X_VK_CMP"))
+            m_cmpEvery = static_cast<uint32_t>(std::max(0, std::atoi(e)));
+        if (const char *e = std::getenv("PS2X_VK_ALIAS"); e && e[0] == '0') m_noAlias = true;
+        if (const char *e = std::getenv("PS2X_VK_WB"); e && e[0] == '0') m_noWb = true;
+        if (const char *e = std::getenv("PS2X_VK_CLUT"); e && e[0] == '0') m_noClut = true;
+        if (const char *e = std::getenv("PS2X_VK_WB16"); e && e[0] == '0') m_noWb16 = true;
+        if (const char *e = std::getenv("PS2X_VK_SEED"); e && e[0] == '0') m_noSeed = true;
+        if (const char *e = std::getenv("PS2X_VK_XSYNC"); e && e[0] == '0') m_noXsync = true;
+        if (const char *e = std::getenv("PS2X_VK_ZKEYPSM"); e && e[0] == '1') m_zkeyPsm = true;
+        if (const char *e = std::getenv("PS2X_VK_TRACE")) m_traceFrame = std::strtoull(e, nullptr, 10);
+        if (const char *e = std::getenv("PS2X_VK_ZFIX"); e && e[0] == '0') m_zfixOff = true;
+        if (!buffer(kRing, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, m_ring, m_ringMem, &m_ringMap) ||
+            !presBuf(0) || !presBuf(1))
+            return false;
+        m_pres = m_presB[0]; m_presMem = m_presMemB[0]; m_presMap = m_presMapB[0];
+        m_aaOn = aaInit();
+        if (!m_aaOn) aaDestroy();
+        auto mod = [&](const uint32_t *code, size_t size) {
+            VkShaderModuleCreateInfo sm{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            sm.codeSize = size;
+            sm.pCode = code;
+            VkShaderModule m = VK_NULL_HANDLE;
+            vkCreateShaderModule(m_dev, &sm, nullptr, &m);
+            return m;
+        };
+        m_vs = mod(kGsVkDrawVertSpv, sizeof(kGsVkDrawVertSpv));
+        m_fs = mod(kGsVkDrawFragSpv, sizeof(kGsVkDrawFragSpv));
+        VkPushConstantRange pr{VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0, 128};
+        VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        pl.setLayoutCount = 1;
+        pl.pSetLayouts = &m_dsl;
+        pl.pushConstantRangeCount = 1;
+        pl.pPushConstantRanges = &pr;
+        VkPipelineCacheCreateInfo pci{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+        if (!m_vs || !m_fs || vkCreatePipelineLayout(m_dev, &pl, nullptr, &m_gpl) != VK_SUCCESS ||
+            vkCreatePipelineCache(m_dev, &pci, nullptr, &m_pcache) != VK_SUCCESS)
+            return false;
+        m_rOn = true;
+        std::fprintf(stderr, "[gs:vk] renderer on (draw list -> pipelines keyed by topology/blend/depth/mask, textures from VRAM buffer)%s\n",
+                     m_cmpEvery ? ", comparing with the reference frame" : "");
+        return true;
+    }
+
+    void renderDestroy()
+    {
+        aaDestroy();
+        if (!m_dev) return;
+        for (auto &kv : m_pipes) vkDestroyPipeline(m_dev, kv.second, nullptr);
+        m_pipes.clear();
+        auto killT = [&](RTarget &t) { if (t.view) vkDestroyImageView(m_dev, t.view, nullptr); if (t.img) vkDestroyImage(m_dev, t.img, nullptr); if (t.mem) vkFreeMemory(m_dev, t.mem, nullptr); };
+        for (auto &kv : m_colorT) killT(kv.second);
+        for (auto &kv : m_depthT) killT(kv.second);
+        m_colorT.clear(); m_depthT.clear();
+        if (m_pcache) vkDestroyPipelineCache(m_dev, m_pcache, nullptr);
+        if (m_gpl) vkDestroyPipelineLayout(m_dev, m_gpl, nullptr);
+        if (m_vs) vkDestroyShaderModule(m_dev, m_vs, nullptr);
+        if (m_fs) vkDestroyShaderModule(m_dev, m_fs, nullptr);
+        auto kill = [&](VkBuffer &b, VkDeviceMemory &m) { if (b) vkDestroyBuffer(m_dev, b, nullptr); if (m) vkFreeMemory(m_dev, m, nullptr); b = VK_NULL_HANDLE; m = VK_NULL_HANDLE; };
+        kill(m_ring, m_ringMem); kill(m_presB[0], m_presMemB[0]); kill(m_presB[1], m_presMemB[1]); m_pres = VK_NULL_HANDLE; m_presMem = VK_NULL_HANDLE;
+        m_rOn = false;
+    }
+
+    // Address aliasing: a buffer at fbp that lies inside an existing same-width/format target (e.g. the second
+    // half of a double-buffered frame) is drawn into that target at a row offset instead of a new image.
+    static uint32_t pageRows(uint32_t psm) { return (psm == GS_PSM_CT16 || psm == GS_PSM_CT16S || psm == 0x32u || psm == 0x3Au) ? 64u : 32u; }
+    uint64_t aliasKey(uint64_t key, bool depth, uint32_t &off)
+    {
+        off = 0;
+        auto &map = depth ? m_depthT : m_colorT;
+        if (map.count(key) || m_noAlias) return key;
+        const uint32_t fbp = key & 0x1FFu, fbw = std::max<uint32_t>((key >> 9) & 0x3Fu, 1u), psm = (key >> 15) & 0x3Fu;
+        uint64_t best = key; uint32_t bestOff = 0;
+        for (auto &kv : map)
+        {
+            if ((kv.first >> 9) != (key >> 9)) continue;
+            const uint32_t b = kv.first & 0x1FFu;
+            if (b >= fbp || (fbp - b) % fbw) continue;
+            const uint32_t o = (fbp - b) / fbw * pageRows(psm);
+            if (o + 224u > kRows) continue;
+            if (best == key || o < bestOff) { best = kv.first; bestOff = o; }
+        }
+        off = bestOff;
+        return best;
+    }
+
