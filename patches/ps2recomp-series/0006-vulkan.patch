+    int S = int(p.pc[19]);
+    x = rtWrap(x, p.pc[14] & 3u, p.pc[9] & 0xFFFFu, p.pc[15] & 0xFFFFu, p.pc[15] >> 16, S);
+    y = rtWrap(y, (p.pc[14] >> 2) & 3u, p.pc[9] >> 16, p.pc[16] & 0xFFFFu, p.pc[16] >> 16, S);
