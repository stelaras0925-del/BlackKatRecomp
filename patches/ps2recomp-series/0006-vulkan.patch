+            for (uint32_t x = 0; x < w; ++x) std::fwrite(im + (size_t(y) * t.w + x) * 4u, 1, 3, fp);
+        }
+        std::fclose(fp);
+        std::fprintf(stderr, "[gs:vk:sprdump] %s dirty %u..%u hi %u\n", path, t.dirtyLo, t.dirtyRows, t.hiRows);
+    }
