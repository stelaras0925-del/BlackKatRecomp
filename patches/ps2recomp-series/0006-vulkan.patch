+    struct ProbeSlot { unsigned long long f; unsigned long long ckey; uint32_t n; unsigned long long test; };
+    std::vector<ProbeSlot> m_probe;
+    void probeLocked(uint64_t ckey, uint32_t n, uint64_t test)
