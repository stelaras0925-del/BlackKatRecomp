--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_vk_render.inl
@@ -0,0 +1,1062 @@
+// Vulkan GS renderer (Phase 3 steps 3-6). Textually #included INSIDE class VkVramMirror (gs_vk_vram.inl) so it
+// shares the VRAM buffer, LUTs, descriptor set, command buffer and mutex: uploads (compute) and draws (graphics)
+// are recorded into one command stream in GS event order.
+//   pipeline key  = topology | blend (eq, src, dst) | depth (test, op, write) | colour write mask
+//   render target = Vulkan RGBA8 image per FRAME (fbp, fbw, psm) + D32 per ZBUF (zbp, fbw, psm), GENERAL layout
+//   draws         = GSDrawList batches, vertices expanded on the CPU into a 64 MB ring, textures read in the
+//                   fragment shader straight from the VRAM buffer (+ CLUT at CBP)
+// Not yet: render-to-texture (textures only see uploaded data), target <-> VRAM sync, DATE, FB/ZB-only alpha fail,
+// PABE, AA1, CLD buffering, mipmaps, bilinear.
+public:
+    bool renderOn() const { return m_rOn; }
+    bool comparing() const { return m_cmpEvery != 0u || m_checkEvery != 0u; }
+    struct RStats { uint64_t batches = 0, draws = 0, verts = 0, pipelines = 0, targets = 0, passes = 0, skipped = 0, writebacks = 0, seeds = 0, xsync = 0, rtt = 0; };
+
+    void drawList(const GSDrawList &l)
+    {
+        if (!m_rOn) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        for (const GSDrawListBatch &b : l.batches)
+            drawBatchLocked(b, l.vertices.data() + b.firstVertex, static_cast<size_t>(b.primCount) * b.vertsPerPrim);
+    }
+    void drawPrim(const GSPrimitiveBatch &prim)
+    {
+        if (!m_rOn) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        GSDrawListBatch b;
+        b.state = prim.state;
+        b.primCount = 1;
+        b.vertsPerPrim = prim.vertexCount > 3 ? 3 : prim.vertexCount;
+        drawBatchLocked(b, prim.vertices.data(), b.vertsPerPrim);
+    }
+
+private:
+    struct RTarget { VkImage img = VK_NULL_HANDLE; VkDeviceMemory mem = VK_NULL_HANDLE; VkImageView view = VK_NULL_HANDLE; uint32_t w = 0, h = 0; bool depth = false; uint64_t lastF = 0, draws = 0; uint32_t dirtyRows = 0, hiRows = 0, dirtyLo = 0xFFFFFFFFu, loRows = 0xFFFFFFFFu; bool stale = false; uint64_t seq = 0; };
+    static constexpr uint32_t kRing = 64u * 1024u * 1024u;
+    static constexpr uint32_t kRows = 1024u;
+    static constexpr uint32_t kFloats = 12u;
+
+    bool renderInit()
+    {
+        if (const char *e = std::getenv("PS2X_VK_RENDER"); e && e[0] == '0')
+            return false;
+        if (const char *e = std::getenv("PS2X_VK_CMP"))
+            m_cmpEvery = static_cast<uint32_t>(std::max(0, std::atoi(e)));
+        if (const char *e = std::getenv("PS2X_VK_ALIAS"); e && e[0] == '0') m_noAlias = true;
+        if (const char *e = std::getenv("PS2X_VK_WB"); e && e[0] == '0') m_noWb = true;
+        if (const char *e = std::getenv("PS2X_VK_CLUT"); e && e[0] == '0') m_noClut = true;
+        if (const char *e = std::getenv("PS2X_VK_WB16"); e && e[0] == '0') m_noWb16 = true;
+        if (const char *e = std::getenv("PS2X_VK_SEED"); e && e[0] == '0') m_noSeed = true;
+        if (const char *e = std::getenv("PS2X_VK_XSYNC"); e && e[0] == '0') m_noXsync = true;
+        if (const char *e = std::getenv("PS2X_VK_ZKEYPSM"); e && e[0] == '1') m_zkeyPsm = true;
+        if (const char *e = std::getenv("PS2X_VK_TRACE")) m_traceFrame = std::strtoull(e, nullptr, 10);
+        if (const char *e = std::getenv("PS2X_VK_ZFIX"); e && e[0] == '0') m_zfixOff = true;
+        if (!buffer(kRing, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, m_ring, m_ringMem, &m_ringMap) ||
+            !presBuf(0) || !presBuf(1))
+            return false;
+        m_pres = m_presB[0]; m_presMem = m_presMemB[0]; m_presMap = m_presMapB[0];
+        auto mod = [&](const uint32_t *code, size_t size) {
+            VkShaderModuleCreateInfo sm{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            sm.codeSize = size;
+            sm.pCode = code;
+            VkShaderModule m = VK_NULL_HANDLE;
+            vkCreateShaderModule(m_dev, &sm, nullptr, &m);
+            return m;
+        };
+        m_vs = mod(kGsVkDrawVertSpv, sizeof(kGsVkDrawVertSpv));
+        m_fs = mod(kGsVkDrawFragSpv, sizeof(kGsVkDrawFragSpv));
+        VkPushConstantRange pr{VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0, 128};
+        VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        pl.setLayoutCount = 1;
+        pl.pSetLayouts = &m_dsl;
+        pl.pushConstantRangeCount = 1;
+        pl.pPushConstantRanges = &pr;
+        VkPipelineCacheCreateInfo pci{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+        if (!m_vs || !m_fs || vkCreatePipelineLayout(m_dev, &pl, nullptr, &m_gpl) != VK_SUCCESS ||
+            vkCreatePipelineCache(m_dev, &pci, nullptr, &m_pcache) != VK_SUCCESS)
+            return false;
+        m_rOn = true;
+        std::fprintf(stderr, "[gs:vk] renderer on (draw list -> pipelines keyed by topology/blend/depth/mask, textures from VRAM buffer)%s\n",
+                     m_cmpEvery ? ", comparing with the reference frame" : "");
+        return true;
+    }
+
+    void renderDestroy()
+    {
+        if (!m_dev) return;
+        for (auto &kv : m_pipes) vkDestroyPipeline(m_dev, kv.second, nullptr);
+        m_pipes.clear();
+        auto killT = [&](RTarget &t) { if (t.view) vkDestroyImageView(m_dev, t.view, nullptr); if (t.img) vkDestroyImage(m_dev, t.img, nullptr); if (t.mem) vkFreeMemory(m_dev, t.mem, nullptr); };
+        for (auto &kv : m_colorT) killT(kv.second);
+        for (auto &kv : m_depthT) killT(kv.second);
+        m_colorT.clear(); m_depthT.clear();
+        if (m_pcache) vkDestroyPipelineCache(m_dev, m_pcache, nullptr);
+        if (m_gpl) vkDestroyPipelineLayout(m_dev, m_gpl, nullptr);
+        if (m_vs) vkDestroyShaderModule(m_dev, m_vs, nullptr);
+        if (m_fs) vkDestroyShaderModule(m_dev, m_fs, nullptr);
+        auto kill = [&](VkBuffer &b, VkDeviceMemory &m) { if (b) vkDestroyBuffer(m_dev, b, nullptr); if (m) vkFreeMemory(m_dev, m, nullptr); b = VK_NULL_HANDLE; m = VK_NULL_HANDLE; };
+        kill(m_ring, m_ringMem); kill(m_presB[0], m_presMemB[0]); kill(m_presB[1], m_presMemB[1]); m_pres = VK_NULL_HANDLE; m_presMem = VK_NULL_HANDLE;
+        m_rOn = false;
+    }
+
+    // Address aliasing: a buffer at fbp that lies inside an existing same-width/format target (e.g. the second
+    // half of a double-buffered frame) is drawn into that target at a row offset instead of a new image.
+    static uint32_t pageRows(uint32_t psm) { return (psm == GS_PSM_CT16 || psm == GS_PSM_CT16S || psm == 0x32u || psm == 0x3Au) ? 64u : 32u; }
+    uint64_t aliasKey(uint64_t key, bool depth, uint32_t &off)
+    {
+        off = 0;
+        auto &map = depth ? m_depthT : m_colorT;
+        if (map.count(key) || m_noAlias) return key;
+        const uint32_t fbp = key & 0x1FFu, fbw = std::max<uint32_t>((key >> 9) & 0x3Fu, 1u), psm = (key >> 15) & 0x3Fu;
+        uint64_t best = key; uint32_t bestOff = 0;
+        for (auto &kv : map)
+        {
+            if ((kv.first >> 9) != (key >> 9)) continue;
+            const uint32_t b = kv.first & 0x1FFu;
+            if (b >= fbp || (fbp - b) % fbw) continue;
+            const uint32_t o = (fbp - b) / fbw * pageRows(psm);
+            if (o + 224u > kRows) continue;
+            if (best == key || o < bestOff) { best = kv.first; bestOff = o; }
+        }
+        off = bestOff;
+        return best;
+    }
+
+    // Render-to-texture: copy a dirty CT32/CT24 colour target back into the VRAM mirror (swizzled) so later
+    // texture/CLUT reads of that memory see what was drawn. PS2X_VK_WB=0 disables.
+    void writeBackLocked(uint64_t key, RTarget &t)
+    {
+        const uint32_t psm = (key >> 15) & 0x3Fu, hi = std::min(t.dirtyRows, t.h), lo = std::min(t.dirtyLo, hi), rows = hi - lo;
+        t.dirtyRows = 0; t.dirtyLo = 0xFFFFFFFFu;
+        const bool is16 = psm == GS_PSM_CT16 || psm == GS_PSM_CT16S;
+        if ((psm != GS_PSM_CT32 && psm != GS_PSM_CT24 && !(is16 && !m_noWb16)) || rows == 0) return;
+        const Fmt f = fmt(psm);
+        if (!f.ok) return;
+        const uint32_t bytes = t.w * rows * 4u, alloc = (bytes + 255u) & ~255u;
+        if (alloc > kStaging) return;
+        endRenderingLocked();
+        if (m_stageUsed + alloc > kStaging) { if (m_begun) submitWait(); m_stageUsed = 0; }
+        ensureCompute();
+        VkBufferImageCopy cp{};
+        cp.bufferOffset = m_stageUsed;
+        cp.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        cp.imageOffset = {0, static_cast<int32_t>(lo), 0};
+        cp.imageExtent = {t.w, rows, 1};
+        if (m_scale > 1)
+        {   // scaled target: nearest downsample into the 1x scratch image first (picks the texel at x*N + N/2)
+            scaleBlitLocked(t.img, 0, lo * m_scale, t.w * m_scale, rows * m_scale, m_scrImg, 0, 0, t.w, rows);
+            cp.imageOffset = {0, 0, 0};
+            vkCmdCopyImageToBuffer(m_cmd, m_scrImg, VK_IMAGE_LAYOUT_GENERAL, m_stage, 1, &cp);
+        }
+        else
+            vkCmdCopyImageToBuffer(m_cmd, t.img, VK_IMAGE_LAYOUT_GENERAL, m_stage, 1, &cp);
+        barrier();
+        PC pc{};
+        pc.ioBitBase = static_cast<uint32_t>(m_stageUsed * 8u);
+        pc.firstPixel = 0; pc.count = t.w * rows;
+        pc.srcBits = 32; pc.lutBase = f.lut; pc.pw = f.pw; pc.ph = f.ph;
+        pc.ppr = std::max<uint32_t>(1u, t.w / f.pw);
+        pc.baseBits = (static_cast<uint32_t>(key & 0x1FFu) * 65536u) & 0x1FFFFFFu;
+        pc.dsax = 0; pc.dsay = lo; pc.rrw = t.w;
+        pc.nbits = f.nbits; pc.shift = f.shift; pc.mode = is16 ? 4u : 2u;
+        vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+        vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        barrier();
+        m_stageUsed += alloc;
+        ++m_rs.writebacks;
+    }
+    // VRAM -> target image (unswizzle + convert in compute, then buffer->image copy). PS2X_VK_SEED=0 disables.
+    void seedLocked(uint64_t key, RTarget &t, uint32_t rows, uint32_t y0 = 0)
+    {
+        const uint32_t psm = (key >> 15) & 0x3Fu;
+        const Fmt f = fmt(psm);
+        rows = std::min(rows, t.h);
+        if (!f.ok || rows <= y0) return;
+        const uint32_t bytes = t.w * (rows - y0) * 4u, alloc = (bytes + 255u) & ~255u;
+        if (alloc > kStaging) return;
+        endRenderingLocked();
+        if (m_stageUsed + alloc > kStaging) { if (m_begun) submitWait(); m_stageUsed = 0; }
+        ensureCompute();
+        PC pc{};
+        pc.ioBitBase = static_cast<uint32_t>(m_stageUsed / 4u);
+        pc.firstPixel = t.w * y0; pc.count = t.w * (rows - y0);
+        pc.srcBits = 32; pc.lutBase = f.lut; pc.pw = f.pw; pc.ph = f.ph;
+        pc.ppr = std::max<uint32_t>(1u, t.w / f.pw);
+        pc.baseBits = (static_cast<uint32_t>(key & 0x1FFu) * 65536u) & 0x1FFFFFFu;
+        pc.dsax = 0; pc.dsay = 0; pc.rrw = t.w;
+        pc.nbits = f.nbits; pc.shift = f.shift; pc.mode = 5;
+        vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+        vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        barrier();
+        VkBufferImageCopy cp{};
+        cp.bufferOffset = m_stageUsed;
+        cp.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        cp.imageOffset = {0, static_cast<int32_t>(y0), 0};
+        cp.imageExtent = {t.w, rows - y0, 1};
+        if (m_scale > 1)
+        {   // scaled target: 1x rows into the scratch image, then a nearest upsample (each texel -> N x N block)
+            cp.imageOffset = {0, 0, 0};
+            vkCmdCopyBufferToImage(m_cmd, m_stage, m_scrImg, VK_IMAGE_LAYOUT_GENERAL, 1, &cp);
+            barrier();
+            scaleBlitLocked(m_scrImg, 0, 0, t.w, rows - y0, t.img, 0, y0 * m_scale, t.w * m_scale, (rows - y0) * m_scale);
+        }
+        else
+            vkCmdCopyBufferToImage(m_cmd, m_stage, t.img, VK_IMAGE_LAYOUT_GENERAL, 1, &cp);
+        barrier();
+        m_stageUsed += alloc;
+        ++m_rs.seeds;
+    }
+    // A host->local transfer into memory covered by a colour target: write the target back first (so it can't clobber
+    // the upload later), then re-seed it after the upload.
+    void preUploadLocked(uint64_t b, uint64_t e) { if (m_rOn && !m_noWb) writeBackRangeLocked(b, e); }
+    void postUploadLocked(uint64_t b, uint64_t e)
+    {
+        if (!m_rOn || m_noSeed) return;
+        for (auto &kv : m_colorT)
+        {
+            RTarget &t = kv.second;
+            if (!t.hiRows) continue;
+            const uint32_t kp = (kv.first >> 15) & 0x3Fu, bpp = (kp == GS_PSM_CT16 || kp == GS_PSM_CT16S) ? 2u : 4u;
+            const uint64_t tb = static_cast<uint64_t>(kv.first & 0x1FFu) * 8192u, te = tb + static_cast<uint64_t>(t.w) * t.hiRows * bpp;
+            if (b < te && tb < e) t.stale = true; // re-seeded lazily before the next draw into it or present
+        }
+    }
+    static uint32_t texBits(uint32_t psm)
+    {
+        switch (psm) { case 0x02: case 0x0A: case 0x32: case 0x3A: return 16u; case 0x13: return 8u; case 0x14: return 4u; default: return 32u; }
+    }
+    // debug (PS2X_VK_SPRDUMP=prefix): at the final display sprite, decode VRAM fbp 0x46/w10/CT32 (left) next to
+    // target 01400 rows 224.. (right) -> prefix_<frame>.ppm, every 60th frame from 1200, at most 8 dumps
+    // debug (PS2X_VK_PROBE=1 with PS2X_VK_TRACE): after every draw in the trace window, copy 8 rows (240..247) of the
+    // 3D target 0x1400 into a readback slot; the means are printed after the next submit (no extra waits).
+    struct ProbeSlot { unsigned long long f; unsigned long long ckey; uint32_t n; unsigned long long test; };
+    std::vector<ProbeSlot> m_probe;
+    void probeLocked(uint64_t ckey, uint32_t n, uint64_t test)
+    {
+        auto it = m_colorT.find(0x1400ull);
+        if (it == m_colorT.end() || m_probe.size() >= 400) return;
+        RTarget &t = it->second;
+        if (t.w < 640 || t.h < 248) return;
+        endRenderingLocked();
+        ensureCompute();
+        VkBufferImageCopy cp{};
+        cp.bufferOffset = m_probe.size() * 20480ull;
+        cp.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        cp.imageOffset = {0, 240, 0};
+        cp.imageExtent = {640, 8, 1};
+        cp.bufferRowLength = 640;
+        barrier(true);
+        vkCmdCopyImageToBuffer(m_cmd, t.img, VK_IMAGE_LAYOUT_GENERAL, m_rb, 1, &cp);
+        barrier(true);
+        m_probe.push_back({(unsigned long long)(m_rFrames + 1), (unsigned long long)ckey, n, (unsigned long long)test});
+    }
+    void probePrint()
+    {
+        for (size_t s = 0; s < m_probe.size(); ++s)
+        {
+            const uint8_t *im = static_cast<const uint8_t *>(m_rbMap) + s * 20480u;
+            double r = 0, g = 0, b = 0;
+            for (uint32_t i = 0; i < 640u * 8u; ++i) { r += im[i * 4]; g += im[i * 4 + 1]; b += im[i * 4 + 2]; }
+            const double k = 1.0 / (640.0 * 8.0);
+            std::fprintf(stderr, "[gs:vk:probe] f%llu ckey %llx n%u test %llx top %.0f,%.0f,%.0f\n", m_probe[s].f, m_probe[s].ckey, m_probe[s].n, m_probe[s].test, r * k, g * k, b * k);
+        }
+        m_probe.clear();
+    }
+    void spriteDumpLocked(const char *tag = "")
+    {
+        static const char *pre = std::getenv("PS2X_VK_SPRDUMP");
+        static int done = 0;
+        const bool inTr = m_traceFrame && m_rFrames + 1 >= m_traceFrame && m_rFrames + 1 < m_traceFrame + 8; // debug: dump every sprite (and after the sky) inside the trace window
+        if (!pre || done >= 32 || (!inTr && (m_rFrames < 1200 || (m_rFrames / 3) % 20 != 0 || m_rFrames == m_sprDumpF))) return;
+        auto it = m_colorT.find(0x1400ull);
+        if (it == m_colorT.end()) return;
+        m_sprDumpF = m_rFrames; ++done;
+        RTarget &t = it->second;
+        const uint32_t w = 640, h = 448, off = 224;
+        if (t.w < w || t.h < off + h) return;
+        ensureCompute();
+        VkBufferCopy c0{0, 0, kVram};
+        vkCmdCopyBuffer(m_cmd, m_vram, m_rb, 1, &c0);
+        VkBufferImageCopy cp{};
+        cp.bufferOffset = kVram;
+        cp.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        cp.imageOffset = {0, static_cast<int32_t>(off), 0};
+        cp.imageExtent = {w, h, 1};
+        cp.bufferRowLength = t.w;
+        vkCmdCopyImageToBuffer(m_cmd, t.img, VK_IMAGE_LAYOUT_GENERAL, m_rb, 1, &cp);
+        barrier(true);
+        submitWait();
+        m_stageUsed = 0;
+        const uint32_t *mv = static_cast<const uint32_t *>(m_rbMap);
+        const uint8_t *im = static_cast<const uint8_t *>(m_rbMap) + kVram;
+        const Fmt f = fmt(GS_PSM_CT32);
+        char path[512]; std::snprintf(path, sizeof(path), "%s_%llu%s.ppm", pre, (unsigned long long)m_rFrames, tag);
+        FILE *fp = std::fopen(path, "wb");
+        if (!fp) return;
+        std::fprintf(fp, "P6\n%u %u\n255\n", w * 2, h);
+        const uint32_t ppr = 640u / f.pw;
+        for (uint32_t y = 0; y < h; ++y)
+        {
+            for (uint32_t x = 0; x < w; ++x)
+            {
+                const uint32_t page = (y / f.ph) * ppr + x / f.pw;
+                const uint32_t bit = (0x46u * 65536u + page * 65536u + m_lut[f.lut + (y % f.ph) * f.pw + (x % f.pw)]) & 0x1FFFFFFu;
+                const uint32_t v = mv[bit >> 5];
+                const uint8_t px[3] = {uint8_t(v), uint8_t(v >> 8), uint8_t(v >> 16)};
+                std::fwrite(px, 1, 3, fp);
+            }
+            for (uint32_t x = 0; x < w; ++x) std::fwrite(im + (size_t(y) * t.w + x) * 4u, 1, 3, fp);
+        }
+        std::fclose(fp);
+        std::fprintf(stderr, "[gs:vk:sprdump] %s dirty %u..%u hi %u\n", path, t.dirtyLo, t.dirtyRows, t.hiRows);
+    }
+    uint64_t m_sprDumpF = 0;
+    // nearest blit between images in GENERAL layout (scale changes for write-back / seed)
+    void scaleBlitLocked(VkImage src, uint32_t sx, uint32_t sy, uint32_t sw, uint32_t sh, VkImage dst, uint32_t dx, uint32_t dy, uint32_t dw, uint32_t dh)
+    {
+        VkImageBlit bl{};
+        bl.srcSubresource = bl.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        bl.srcOffsets[0] = {static_cast<int32_t>(sx), static_cast<int32_t>(sy), 0};
+        bl.srcOffsets[1] = {static_cast<int32_t>(sx + sw), static_cast<int32_t>(sy + sh), 1};
+        bl.dstOffsets[0] = {static_cast<int32_t>(dx), static_cast<int32_t>(dy), 0};
+        bl.dstOffsets[1] = {static_cast<int32_t>(dx + dw), static_cast<int32_t>(dy + dh), 1};
+        vkCmdBlitImage(m_cmd, src, VK_IMAGE_LAYOUT_GENERAL, dst, VK_IMAGE_LAYOUT_GENERAL, 1, &bl, VK_FILTER_NEAREST);
+        barrier();
+    }
+    // Render-to-texture at scale > 1: a CT32/CT24 texture that lies inside a colour target (same width, row aligned,
+    // sampled area within rows the target has drawn, no newer overlapping target) is read from the scaled image
+    // (copied to the binding-4 RTT image) instead of the 1x VRAM mirror, so post passes keep the detail.
+    bool rttFindLocked(const GSContext &c, float umin, float vmin, float umax, float vmax, uint64_t &key, uint32_t &rowOff)
+    {
+        if (m_scale <= 1 || s_vkNoRtt()) return false;
+        if (c.tex0.psm != GS_PSM_CT32 && c.tex0.psm != GS_PSM_CT24) return false;
+        if (umin < -0.5f || vmin < -0.5f) return false;
+        const uint32_t tbw = std::max<uint32_t>(c.tex0.tbw, 1u);
+        const uint64_t tb = static_cast<uint64_t>(c.tex0.tbp0) * 256u;
+        const RTarget *best = nullptr;
+        for (auto &kv : m_colorT)
+        {
+            const RTarget &t = kv.second;
+            if (((kv.first >> 15) & 0x3Fu) != GS_PSM_CT32 || ((kv.first >> 9) & 0x3Fu) != tbw || !t.hiRows || t.w != tbw * 64u) continue;
+            const uint64_t base = static_cast<uint64_t>(kv.first & 0x1FFu) * 8192u, rb = static_cast<uint64_t>(t.w) * 4u;
+            if (tb < base || (tb - base) % rb) continue;
+            const uint64_t ro = (tb - base) / rb;
+            if (umax > static_cast<float>(t.w) || ro + static_cast<uint64_t>(std::ceil(vmax)) > t.hiRows) continue;
+            if (!best || t.seq > best->seq) { best = &t; key = kv.first; rowOff = static_cast<uint32_t>(ro); }
+        }
+        if (!best) return false;
+        const uint64_t b0 = tb, b1 = tb + static_cast<uint64_t>(best->w) * 4u * static_cast<uint64_t>(std::ceil(vmax));
+        for (auto &kv : m_colorT)
+        {   // a newer target drew over the same memory: VRAM (merged) is the authority
+            if (kv.first == key || kv.second.seq <= best->seq || !kv.second.hiRows) continue;
+            const uint32_t op = (kv.first >> 15) & 0x3Fu, obpp = (op == GS_PSM_CT16 || op == GS_PSM_CT16S) ? 2u : 4u;
+            const uint64_t ob = static_cast<uint64_t>(kv.first & 0x1FFu) * 8192u, oe = ob + static_cast<uint64_t>(kv.second.w) * kv.second.hiRows * obpp;
+            if (ob < b1 && b0 < oe) return false;
+        }
+        return true;
+    }
+    static bool s_vkNoRtt() { static const bool v = [] { const char *e = std::getenv("PS2X_VK_SCALE_RTT"); return e && e[0] == '0'; }(); return v; }
+    void writeBackOverlapsLocked(const GSContext &c)
+    {
+        const uint64_t tb = static_cast<uint64_t>(c.tex0.tbp0) * 256u;
+        const uint64_t te = tb + static_cast<uint64_t>(std::max<uint32_t>(c.tex0.tbw, 1u)) * 64u * (1ull << std::min<uint32_t>(c.tex0.th, 10u)) * texBits(c.tex0.psm) / 8u;
+        writeBackRangeLocked(tb, te);
+    }
+    bool dirtySpan(uint64_t key, const RTarget &t, uint64_t &b, uint64_t &e) const
+    {
+        if (t.dirtyRows <= std::min(t.dirtyLo, t.dirtyRows)) return false;
+        const uint32_t kp = (key >> 15) & 0x3Fu, bpp = (kp == GS_PSM_CT16 || kp == GS_PSM_CT16S) ? 2u : 4u;
+        const uint64_t base = static_cast<uint64_t>(key & 0x1FFu) * 8192u;
+        b = base + static_cast<uint64_t>(t.w) * t.dirtyLo * bpp; e = base + static_cast<uint64_t>(t.w) * t.dirtyRows * bpp;
+        return true;
+    }
+    // Write back every dirty target overlapping [tb,te), oldest draw first so the newest content wins; older dirty
+    // targets overlapping a written-back one are superseded (dropped) so they can't clobber it later.
+    void writeBackRangeLocked(uint64_t tb, uint64_t te)
+    {
+        std::vector<std::pair<uint64_t, uint64_t>> hit; // (seq, key)
+        for (auto &kv : m_colorT)
+        {
+            uint64_t b, e;
+            if (dirtySpan(kv.first, kv.second, b, e) && tb < e && b < te) hit.emplace_back(kv.second.seq, kv.first);
+        }
+        if (m_traceFrame && m_rFrames + 1 >= m_traceFrame && m_rFrames + 1 < m_traceFrame + 2 && tb == 0x2bc0ull * 256u)
+        {   // debug: what the shadow-map read (tbp 0x2bc0) writes back
+            std::fprintf(stderr, "[gs:vk:wb] f%llu range %llx-%llx hits %zu:", (unsigned long long)(m_rFrames + 1), (unsigned long long)tb, (unsigned long long)te, hit.size());
+            for (auto &h : hit) { const RTarget &x = m_colorT[h.second]; std::fprintf(stderr, " %05llx w%u rows %u..%u seq %llu", (unsigned long long)h.second, x.w, x.dirtyLo, x.dirtyRows, (unsigned long long)x.seq); }
+            std::fprintf(stderr, "\n");
+        }
+        if (hit.empty()) return;
+        std::sort(hit.begin(), hit.end());
+        for (auto &h : hit)
+        {
+            RTarget &t = m_colorT[h.second];
+            uint64_t b, e;
+            if (!dirtySpan(h.second, t, b, e)) continue;
+            writeBackLocked(h.second, t);
+            for (auto &kv : m_colorT)
+            {
+                uint64_t ob, oe;
+                if (kv.first != h.second && kv.second.seq < t.seq && dirtySpan(kv.first, kv.second, ob, oe) && ob < e && b < oe)
+                { kv.second.dirtyRows = 0; kv.second.dirtyLo = 0xFFFFFFFFu; }
+            }
+        }
+    }
+
+    // GS CLUT buffer emulation: each CLUT load snapshots the previous buffer into a new ring slot and loads the
+    // entries from VRAM (after writing back any drawn target that covers the palette). Draws read the current slot.
+    // PS2X_VK_CLUT=0 falls back to reading the palette straight from CBP at draw time.
+public:
+    void loadClut(const GSTex0Reg &t, const GSTexClutReg &)
+    {
+        if (!m_ok || !m_rOn || m_noClut) return;
+        const uint32_t psm = t.psm;
+        const bool t4 = psm == GS_PSM_T4 || psm == 0x24u || psm == 0x2Cu;
+        if (!t4 && psm != GS_PSM_T8 && psm != GS_PSM_T8H) return;
+        switch (t.cld)
+        {
+        case 1: break;
+        case 2: m_clutCbp[0] = t.cbp; break;
+        case 3: m_clutCbp[1] = t.cbp; break;
+        case 4: if (m_clutCbp[0] == t.cbp) return; m_clutCbp[0] = t.cbp; break;
+        case 5: if (m_clutCbp[1] == t.cbp) return; m_clutCbp[1] = t.cbp; break;
+        default: return;
+        }
+        const bool c16 = t.cpsm == GS_PSM_CT16 || t.cpsm == GS_PSM_CT16S;
+        if (!c16 && t.cpsm != GS_PSM_CT32 && t.cpsm != GS_PSM_CT24) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        if (m_txActive && m_txBytes.size() > m_txFlushedBytes) { endRenderingLocked(); flushTxLocked(false); }
+        writeBackRangeLocked(static_cast<uint64_t>(t.cbp) * 256u, static_cast<uint64_t>(t.cbp) * 256u + 1024u);
+        endRenderingLocked();
+        if (m_clutPending + 2u >= kClutSlots) submitWait();
+        ensureCompute();
+        const uint32_t prev = m_clutSlot, cur = (m_clutSlot + 1u) % kClutSlots;
+        VkBufferCopy cp{kVram + prev * 2048u, kVram + cur * 2048u, 2048u};
+        vkCmdCopyBuffer(m_cmd, m_vram, m_vram, 1, &cp);
+        barrier();
+        const Fmt f = fmt(c16 ? t.cpsm : GS_PSM_CT32);
+        PC pc{};
+        const uint32_t csaOff = t4 ? ((c16 ? (t.csa & 31u) : (t.csa & 15u)) << 4) : 0u;
+        pc.ioBitBase = kVram / 4u + cur * 512u + csaOff;
+        pc.firstPixel = t4 ? 1u : 0u;
+        pc.count = t4 ? 16u : 256u;
+        pc.lutBase = f.lut; pc.pw = f.pw; pc.ph = f.ph; pc.ppr = std::max<uint32_t>(1u, 64u / f.pw);
+        pc.baseBits = (t.cbp * 256u * 8u) & 0x1FFFFFFu;
+        pc.nbits = c16 ? 16u : 32u; pc.shift = 0; pc.mode = 3;
+        vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+        vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        barrier();
+        m_clutSlot = cur;
+        ++m_clutPending;
+        ++m_clutLoads;
+    }
+private:
+
+    RTarget *target(uint64_t key, uint32_t w, bool depth)
+    {
+        auto &map = depth ? m_depthT : m_colorT;
+        auto it = map.find(key);
+        if (it != map.end()) return &it->second;
+        if (map.size() >= 48) return nullptr;
+        RTarget t;
+        t.w = w; t.h = kRows; t.depth = depth;
+        const VkFormat fmt = depth ? VK_FORMAT_D32_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM;
+        VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ii.imageType = VK_IMAGE_TYPE_2D;
+        ii.format = fmt;
+        ii.extent = {w * m_scale, kRows * m_scale, 1}; // PS2X_VK_SCALE: images at N x the GS size
+        ii.mipLevels = 1; ii.arrayLayers = 1; ii.samples = VK_SAMPLE_COUNT_1_BIT; ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ii.usage = depth ? (VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT)
+                         : (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+        if (vkCreateImage(m_dev, &ii, nullptr, &t.img) != VK_SUCCESS) return nullptr;
+        VkMemoryRequirements mr;
+        vkGetImageMemoryRequirements(m_dev, t.img, &mr);
+        VkPhysicalDeviceMemoryProperties mp;
+        vkGetPhysicalDeviceMemoryProperties(m_phys, &mp);
+        uint32_t idx = UINT32_MAX;
+        for (uint32_t i = 0; i < mp.memoryTypeCount; ++i)
+            if ((mr.memoryTypeBits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) { idx = i; break; }
+        VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        ai.allocationSize = mr.size;
+        ai.memoryTypeIndex = idx;
+        if (idx == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &t.mem) != VK_SUCCESS) return nullptr;
+        vkBindImageMemory(m_dev, t.img, t.mem, 0);
+        VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vi.image = t.img;
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = fmt;
+        vi.subresourceRange = {static_cast<VkImageAspectFlags>(depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT), 0, 1, 0, 1};
+        if (vkCreateImageView(m_dev, &vi, nullptr, &t.view) != VK_SUCCESS) return nullptr;
+        // UNDEFINED -> GENERAL, cleared (TODO: seed from VRAM)
+        endRenderingLocked();
+        ensureBegun();
+        VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+        b.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+        b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        b.image = t.img;
+        b.subresourceRange = vi.subresourceRange;
+        vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+        if (depth)
+        {
+            VkClearDepthStencilValue z{0.0f, 0};
+            vkCmdClearDepthStencilImage(m_cmd, t.img, VK_IMAGE_LAYOUT_GENERAL, &z, 1, &vi.subresourceRange);
+        }
+        else
+        {
+            VkClearColorValue c{};
+            vkCmdClearColorImage(m_cmd, t.img, VK_IMAGE_LAYOUT_GENERAL, &c, 1, &vi.subresourceRange);
+        }
+        barrier();
+        ++m_rs.targets;
+        if (!depth && !m_noSeed)
+        {   // seed the new colour target from VRAM (rows that lie inside the 4 MB)
+            const uint32_t kp = (key >> 15) & 0x3Fu, bpp = (kp == GS_PSM_CT16 || kp == GS_PSM_CT16S) ? 2u : 4u;
+            const uint64_t base = static_cast<uint64_t>(key & 0x1FFu) * 8192u;
+            const uint32_t rows = base < kVram ? static_cast<uint32_t>(std::min<uint64_t>(kRows, (kVram - base) / (static_cast<uint64_t>(w) * bpp))) : 0u;
+            seedLocked(key, t, rows);
+        }
+        return &map.emplace(key, t).first->second;
+    }
+
+    VkPipeline pipeline(uint64_t key)
+    {
+        auto it = m_pipes.find(key);
+        if (it != m_pipes.end()) return it->second;
+        const uint32_t topo = key & 3u;
+        const bool blend = (key >> 2) & 1u;
+        const VkBlendOp eq = static_cast<VkBlendOp>((key >> 3) & 3u);
+        const VkBlendFactor sf = static_cast<VkBlendFactor>((key >> 5) & 31u), df = static_cast<VkBlendFactor>((key >> 10) & 31u);
+        const bool ztest = (key >> 15) & 1u;
+        const VkCompareOp zop = static_cast<VkCompareOp>((key >> 16) & 7u);
+        const bool zwrite = (key >> 19) & 1u;
+        const uint32_t cmask = (key >> 20) & 15u;
+        VkPipelineShaderStageCreateInfo st[2] = {{VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_VERTEX_BIT, m_vs, "main", nullptr},
+                                                 {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_FRAGMENT_BIT, m_fs, "main", nullptr}};
+        VkVertexInputBindingDescription vb{0, kFloats * 4u, VK_VERTEX_INPUT_RATE_VERTEX};
+        VkVertexInputAttributeDescription va[3] = {{0, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 0}, {1, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 16}, {2, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 32}};
+        VkPipelineVertexInputStateCreateInfo vis{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        vis.vertexBindingDescriptionCount = 1; vis.pVertexBindingDescriptions = &vb;
+        vis.vertexAttributeDescriptionCount = 3; vis.pVertexAttributeDescriptions = va;
+        VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        ia.topology = topo == 0 ? VK_PRIMITIVE_TOPOLOGY_POINT_LIST : topo == 1 ? VK_PRIMITIVE_TOPOLOGY_LINE_LIST : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        vp.viewportCount = 1; vp.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        rs.polygonMode = VK_POLYGON_MODE_FILL; rs.cullMode = VK_CULL_MODE_NONE; rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE; rs.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+        ds.depthTestEnable = (ztest || zwrite) ? VK_TRUE : VK_FALSE; // Vulkan only writes depth with the test enabled
+        ds.depthWriteEnable = zwrite ? VK_TRUE : VK_FALSE;
+        ds.depthCompareOp = zop;
+        VkPipelineColorBlendAttachmentState ba{};
+        ba.blendEnable = blend ? VK_TRUE : VK_FALSE;
+        ba.srcColorBlendFactor = sf; ba.dstColorBlendFactor = df; ba.colorBlendOp = eq;
+        ba.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE; ba.dstAlphaBlendFactor = VK_BLEND_FACTOR_ZERO; ba.alphaBlendOp = VK_BLEND_OP_ADD;
+        ba.colorWriteMask = cmask;
+        VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        cb.attachmentCount = 1; cb.pAttachments = &ba;
+        VkDynamicState dyn[3] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_BLEND_CONSTANTS};
+        VkPipelineDynamicStateCreateInfo dy{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+        dy.dynamicStateCount = 3; dy.pDynamicStates = dyn;
+        const VkFormat cf = VK_FORMAT_R8G8B8A8_UNORM;
+        VkPipelineRenderingCreateInfo ri{VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+        ri.colorAttachmentCount = 1; ri.pColorAttachmentFormats = &cf; ri.depthAttachmentFormat = VK_FORMAT_D32_SFLOAT;
+        VkGraphicsPipelineCreateInfo gp{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        gp.pNext = &ri;
+        gp.stageCount = 2; gp.pStages = st;
+        gp.pVertexInputState = &vis; gp.pInputAssemblyState = &ia; gp.pViewportState = &vp; gp.pRasterizationState = &rs;
+        gp.pMultisampleState = &ms; gp.pDepthStencilState = &ds; gp.pColorBlendState = &cb; gp.pDynamicState = &dy;
+        gp.layout = m_gpl;
+        VkPipeline p = VK_NULL_HANDLE;
+        if (vkCreateGraphicsPipelines(m_dev, m_pcache, 1, &gp, nullptr, &p) != VK_SUCCESS)
+            p = VK_NULL_HANDLE;
+        m_pipes.emplace(key, p);
+        ++m_rs.pipelines;
+        return p;
+    }
+
+    // GS ALPHA (A-B)*C+D  ->  Vulkan blend (same mapping as the GL backend; As = out.a = As/128, Ad = stored a)
+    static void blendOf(uint64_t alpha, uint32_t fpsm, VkBlendOp &eq, VkBlendFactor &sf, VkBlendFactor &df, float &fix)
+    {
