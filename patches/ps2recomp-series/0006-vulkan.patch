+                    }
+                std::fprintf(stderr, "[gs:vk:render] frame %llu: %s %ux%u | vs reference: mean max-channel diff %.1f, %.1f%% px >24 | batches %llu verts %llu passes %llu pipelines %llu targets %llu skipped %llu\n",
+                             (unsigned long long)m_rFrames, havePres ? "presented" : "NO TARGET", pw, ph, n ? sum / n : -1.0, n ? 100.0 * big / n : -1.0,
+                             (unsigned long long)m_rs.batches, (unsigned long long)m_rs.verts, (unsigned long long)m_rs.passes,
+                             (unsigned long long)m_rs.pipelines, (unsigned long long)m_rs.targets, (unsigned long long)m_rs.skipped);
+                if (m_rs.writebacks || m_rs.seeds) std::fprintf(stderr, "[gs:vk:render] write-backs %llu seeds %llu xsync %llu clut loads %llu\n", (unsigned long long)m_rs.writebacks, (unsigned long long)m_rs.seeds, (unsigned long long)m_rs.xsync, (unsigned long long)m_clutLoads);
+                m_rs.batches = m_rs.verts = m_rs.passes = m_rs.skipped = m_rs.writebacks = m_rs.seeds = m_rs.xsync = 0;
+                if (std::getenv("PS2X_VK_TDEBUG"))
+                {
+                    std::fprintf(stderr, "[gs:vk:tgt] want %05llx shown %05llx src %ux%u |", (unsigned long long)m_wantKey, (unsigned long long)m_presKey, frame->width, frame->height);
+                    for (auto &kv : m_colorT)
+                        if (kv.second.draws) std::fprintf(stderr, " %05llx:%llu@%llu", (unsigned long long)kv.first, (unsigned long long)kv.second.draws, (unsigned long long)kv.second.lastF);
