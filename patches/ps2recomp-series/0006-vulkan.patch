+    }
+
+    // ---- atlas tracking (under m_m) ----
+    void fontInvalidate(uint64_t b, uint64_t e, const char *why)
+    {
+        if (!m_fontValid) return;
+        const uint64_t fb = static_cast<uint64_t>(m_fontTbp) * 256u, fe = fb + static_cast<uint64_t>(m_font.tw) * m_font.th / 2u;
+        if (b >= fe || e <= fb) return;
+        m_fontValid = false;
+        static int s_log = 0;
+        if (s_log < 6) { ++s_log; std::fprintf(stderr, "[gs:vk:font] atlas at %x overwritten (%s %llx-%llx): original font until the next upload\n", m_fontTbp, why, (unsigned long long)b, (unsigned long long)e); }
+    }
+    void fontBeginTx(const GSTransferCommand &c)
+    {
+        if (!m_font.ok) return;
+        m_fontTx = false;
+        const uint32_t rrw = c.trxreg.rrw, rrh = c.trxreg.rrh, dbw = std::max<uint32_t>(c.bitbltbuf.dbw, 1u);
+        const uint64_t b = static_cast<uint64_t>(c.bitbltbuf.dbp) * 256u;
+        const uint64_t e = b + static_cast<uint64_t>(dbw) * 64u * (c.trxpos.dsay + rrh) * texBits(c.bitbltbuf.dpsm) / 8u;
+        m_fontPendB = m_fontPendE = 0;
+        if (c.direction == 2u) fontInvalidate(b, e, "local copy");
+        else { m_fontPendB = b; m_fontPendE = e; } // uploads count once data arrives (the game opens some transfers it never fills)
+        if (c.direction == 0u && c.bitbltbuf.dpsm == 0x14u && rrw == m_font.tw && rrh == m_font.th && dbw * 64u == m_font.tw && c.trxpos.dsax == 0 && c.trxpos.dsay == 0)
+        {
+            m_fontTx = true; m_fontTxDbp = c.bitbltbuf.dbp; m_fontTxN = 0; m_fontTailN = 0;
+            m_fontH = 0xcbf29ce484222325ull ^ (static_cast<uint64_t>(m_font.tw) * m_font.th / 2u);
+        }
+    }
+    void fontUpload(const uint8_t *d, uint32_t n)
+    {
+        if (!m_font.ok || !n) return;
+        if (m_fontPendE) { fontInvalidate(m_fontPendB, m_fontPendE, "upload"); m_fontPendB = m_fontPendE = 0; }
+        if (!m_fontTx) return;
+        const uint32_t total = m_font.tw * m_font.th / 2u;
+        auto step = [&](const uint8_t *w8) { uint64_t w; std::memcpy(&w, w8, 8); m_fontH ^= w; m_fontH *= 0x100000001b3ull; m_fontH ^= m_fontH >> 29; };
+        n = std::min(n, total - m_fontTxN);
+        m_fontTxN += n;
+        while (n)
+        {
+            if (m_fontTailN || n < 8u)
+            {
+                const uint32_t m = std::min<uint32_t>(n, 8u - m_fontTailN);
+                std::memcpy(m_fontTail + m_fontTailN, d, m); m_fontTailN += m; d += m; n -= m;
+                if (m_fontTailN == 8u) { step(m_fontTail); m_fontTailN = 0; }
+                continue;
+            }
+            step(d); d += 8; n -= 8;
+        }
+        if (m_fontTxN < total) return;
+        m_fontTx = false;
+        const bool hit = m_fontH == m_font.hash;
+        static int s_log = 0;
+        if (s_log < 8 && (hit != m_fontValid || !hit)) { ++s_log; std::fprintf(stderr, "[gs:vk:font] 512x512 T4 upload at %x hash %016llx: %s\n", m_fontTxDbp, (unsigned long long)m_fontH, hit ? "menu font atlas, vector glyphs on" : "not the menu font"); }
+        if (hit) { m_fontValid = true; m_fontTbp = m_fontTxDbp; }
+    }
+    // A colour / depth draw over the atlas memory (rows y0..y1 of a fbw-wide buffer at fbp) invalidates it.
+    void fontDrawCheck(uint32_t fbp, uint32_t fbw, uint32_t psm, int y0, int y1)
+    {
+        if (!m_fontValid || y1 < y0) return;
+        const uint32_t pr = pageRows(psm), w = std::max<uint32_t>(fbw, 1u);
+        const uint64_t base = static_cast<uint64_t>(fbp) * 8192u;
+        fontInvalidate(base + static_cast<uint64_t>(std::max(y0, 0) / pr) * w * 8192u, base + static_cast<uint64_t>(std::max(y1, 0) / pr + 1u) * w * 8192u, "draw");
+    }
+    bool fontActive(const GSContext &c, const GSDrawState &st) const
+    {
+        return m_fontValid && st.prim.tme && c.tex0.tbp0 == m_fontTbp && c.tex0.psm == 0x14u && st.textureWidth == m_font.tw &&
+               st.textureHeight == m_font.th && c.tex0.cbp == m_fontTbp + m_font.cbpOff;
+    }
+    // One triangle of a glyph quad -> the same corner of the replacement quad. False: draw it unchanged.
+    bool fontMapTri(const GSVertex *v, bool fst, bool iip, float tw, float th, GSVertex *nv, float *ns, float *nt)
+    {
+        float U[3], V[3];
+        for (int i = 0; i < 3; ++i)
+        {
+            if (fst) { U[i] = v[i].u / 16.0f; V[i] = v[i].v / 16.0f; }
+            else { const float q = std::fabs(v[i].q) > 1e-20f ? v[i].q : 1.0f; U[i] = v[i].s / q * tw; V[i] = v[i].t / q * th; }
+        }
+        const float u0 = std::min({U[0], U[1], U[2]}), u1 = std::max({U[0], U[1], U[2]}), w0 = std::min({V[0], V[1], V[2]}), w1 = std::max({V[0], V[1], V[2]});
+        const float x0 = std::min({v[0].x, v[1].x, v[2].x}), x1 = std::max({v[0].x, v[1].x, v[2].x});
+        const float y0 = std::min({v[0].y, v[1].y, v[2].y}), y1 = std::max({v[0].y, v[1].y, v[2].y});
+        const long ku = std::lround(u0), kv = std::lround(w0);
+        if (ku < 0 || kv < 0 || std::fabs(u0 - ku) > 0.05f || std::fabs(w0 - kv) > 0.05f) return false;
+        auto it = m_font.byUv.find((static_cast<uint32_t>(ku) << 16) | static_cast<uint32_t>(kv));
+        if (it == m_font.byUv.end()) return false;
+        const FontGlyph &g = m_font.g[it->second];
+        if (std::fabs(u1 - u0 - g.ow) > 0.05f || std::fabs(w1 - w0 - g.oh) > 0.05f || x1 - x0 < 0.5f || y1 - y0 < 0.5f) return false;
+        const float kx = (x1 - x0) / g.ow, ky = (y1 - y0) / g.oh;
+        bool cx[3], cy[3];
+        for (int i = 0; i < 3; ++i)
+        {   // every vertex a quad corner, texture not mirrored
+            const bool rx = std::fabs(v[i].x - x1) < 0.01f, lx = std::fabs(v[i].x - x0) < 0.01f;
+            const bool by = std::fabs(v[i].y - y1) < 0.01f, ty = std::fabs(v[i].y - y0) < 0.01f;
+            const bool ru = std::fabs(U[i] - u1) < 0.05f, bv = std::fabs(V[i] - w1) < 0.05f;
