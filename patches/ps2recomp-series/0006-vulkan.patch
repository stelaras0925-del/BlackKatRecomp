+                     firstBad != UINT32_MAX ? (" first@0x" + hex(firstBad * 4u) + " mirror=" + hex(mv[firstBad]) + " ref=" + hex(reinterpret_cast<const uint32_t *>(refVram.data())[firstBad]) + " own=" + hex(ow[firstBad])).c_str() : "",
+                     (unsigned long long)m_uploads, m_uploadBytes / 1048576.0, (unsigned long long)m_dispatches, (unsigned long long)m_disowns, rtCount,
+                     (unsigned long long)rtBad, (unsigned long long)m_badChecks, (unsigned long long)m_checks);
+    }
+
+private:
+    struct PC
+    {
+        uint32_t ioBitBase, firstPixel, count, srcBits, lutBase, pw, ph, ppr, baseBits, dsax, dsay, rrw, nbits, shift, mode;
+    };
+    struct Fmt { uint32_t lut, pw, ph, srcBits, nbits, shift; bool ok; };
+    enum { L_CT32, L_Z32, L_CT16, L_CT16S, L_Z16, L_Z16S, L_T8, L_T4, L_N };
+
+    static std::string hex(uint32_t v) { char b[16]; std::snprintf(b, sizeof b, "%08x", v); return b; }
+
+    Fmt fmt(uint32_t psm) const
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT32: return {m_lutOff[L_CT32], 64, 32, 32, 32, 0, true};
+        case GS_PSM_CT24: return {m_lutOff[L_CT32], 64, 32, 24, 24, 0, true};
+        case GS_PSM_CT16: return {m_lutOff[L_CT16], 64, 64, 16, 16, 0, true};
+        case GS_PSM_CT16S: return {m_lutOff[L_CT16S], 64, 64, 16, 16, 0, true};
+        case GS_PSM_T8: return {m_lutOff[L_T8], 128, 64, 8, 8, 0, true};
+        case GS_PSM_T4: return {m_lutOff[L_T4], 128, 128, 4, 4, 0, true};
+        case GS_PSM_T8H: return {m_lutOff[L_CT32], 64, 32, 8, 8, 24, true};
+        case GS_PSM_T4HL: return {m_lutOff[L_CT32], 64, 32, 4, 4, 24, true};
+        case GS_PSM_T4HH: return {m_lutOff[L_CT32], 64, 32, 4, 4, 28, true};
+        case GS_PSM_Z32: return {m_lutOff[L_Z32], 64, 32, 32, 32, 0, true};
+        case GS_PSM_Z24: return {m_lutOff[L_Z32], 64, 32, 24, 24, 0, true};
+        case GS_PSM_Z16: return {m_lutOff[L_Z16], 64, 64, 16, 16, 0, true};
+        case GS_PSM_Z16S: return {m_lutOff[L_Z16S], 64, 64, 16, 16, 0, true};
+        default: return {0, 64, 32, 32, 32, 0, false};
+        }
+    }
