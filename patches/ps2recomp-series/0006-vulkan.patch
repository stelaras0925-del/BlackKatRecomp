+    void disownRectLocked(uint32_t baseBlock, uint32_t bw, uint32_t psm, uint32_t y0, uint32_t y1)
+    {
+        const Fmt f = fmt(psm);
+        const uint32_t ppr = std::max<uint32_t>(1u, (bw * 64u) / f.pw);
+        const uint32_t p0 = baseBlock / 32u;
+        const uint32_t r0 = y0 / f.ph, r1 = (std::max(y1, y0 + 1u) - 1u) / f.ph;
+        for (uint32_t r = r0; r <= r1 && r < 64u; ++r)
+            for (uint32_t c = 0; c <= ppr; ++c) // +1 page: base not page aligned
+            {
+                const uint32_t pg = (p0 + r * ppr + c) % kPages;
+                if (!m_pageOwned[pg]) continue;
+                m_pageOwned[pg] = 0;
+                ensureCompute();
+                vkCmdFillBuffer(m_cmd, m_own, static_cast<VkDeviceSize>(pg) * 8192u, 8192u, 0u);
+                m_needBarrier = true;
+                ++m_disowns;
+            }
+        if (m_needBarrier) { barrier(); m_needBarrier = false; }
+    }
