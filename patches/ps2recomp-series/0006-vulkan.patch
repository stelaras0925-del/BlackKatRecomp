+        const bool prevPres = async && m_presHave;
+        const uint32_t prevW = m_presW, prevH = m_presH;
+        const void *prevMap = m_presMapB[m_presCur ^ 1u];
+        if (async) submitAsync(); else submitWait();
+        m_presHave = havePres; m_presW = pw; m_presH = ph;
+        m_stageUsed = 0;
+        m_ringUsed = 0;
+        if (async)
+        {
+            if (m_rOn && frame) ++m_rFrames;
+            if (prevPres && vkPix)
+            {   // one pass from (cached) readback memory, alpha forced to 255
+                const size_t n = static_cast<size_t>(prevW) * prevH;
+                vkPix->resize(n * 4u);
+                const uint32_t *s32 = static_cast<const uint32_t *>(prevMap);
+                uint32_t *d32 = reinterpret_cast<uint32_t *>(vkPix->data());
+                for (size_t i = 0; i < n; ++i) d32[i] = s32[i] | 0xFF000000u;
+                *vkW = prevW; *vkH = prevH;
+            }
+            static const bool s_profA = std::getenv("PS2X_VK_PROF") != nullptr;
+            if (s_profA && m_rFrames % 300u == 0u)
+            {
+                std::fprintf(stderr, "[gs:vk:prof] per frame (async): submits %.2f wait %.2f ms\n", m_pSubs / 300.0, m_pWaitMs / 300.0);
+                m_pSubs = 0; m_pWaitMs = 0;
+            }
+            return;
+        }
+        if (m_rOn && frame)
+        {
+            ++m_rFrames;
+            static const bool s_prof = std::getenv("PS2X_VK_PROF") != nullptr;
+            if (s_prof && m_rFrames % 300u == 0u)
+            {
+                std::fprintf(stderr, "[gs:vk:prof] per frame: submits %.2f wait %.2f ms | totals: batches %llu passes %llu wb %llu seeds %llu xsync %llu clut %llu\n", m_pSubs / 300.0, m_pWaitMs / 300.0,
+                             (unsigned long long)m_rs.batches, (unsigned long long)m_rs.passes, (unsigned long long)m_rs.writebacks, (unsigned long long)m_rs.seeds, (unsigned long long)m_rs.xsync, 0ull);
+                m_pSubs = 0; m_pWaitMs = 0;
+            }
+            if (havePres)
+            {
+                const uint8_t *src = static_cast<const uint8_t *>(m_presMap);
+                const size_t n = static_cast<size_t>(pw) * ph;
+                vkPix->resize(n * 4u);
+                const uint32_t *s32 = reinterpret_cast<const uint32_t *>(src);
+                uint32_t *d32 = reinterpret_cast<uint32_t *>(vkPix->data());
+                for (size_t i = 0; i < n; ++i) d32[i] = s32[i] | 0xFF000000u;
+                *vkW = pw; *vkH = ph;
+            }
+            if (m_cmpEvery && (m_rFrames % m_cmpEvery) == 0u)
+            {
+                double sum = 0; uint64_t big = 0, n = 0;
+                if (havePres && frame->width == pw && frame->height == ph && frame->pixels.size() >= vkPix->size())
+                    for (size_t i = 0; i < vkPix->size(); i += 4)
+                    {
+                        int d = 0;
+                        for (int k = 0; k < 3; ++k) d = std::max(d, std::abs(int((*vkPix)[i + k]) - int(frame->pixels[i + k])));
