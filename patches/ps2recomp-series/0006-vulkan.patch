+    uint32_t recordRoundTripLocked()
+    {
+        if (!m_rtValid || m_rtExpect.empty()) return 0;
+        PC pc = m_rtPc;
+        pc.count = static_cast<uint32_t>(m_rtExpect.size());
+        pc.mode = 1;
+        const uint32_t outByte = (m_stageUsed + 255u) & ~255u;
+        if (outByte + pc.count * 4u > kStaging) return 0;
+        m_rtOutWord = outByte / 4u;
+        pc.ioBitBase = m_rtOutWord;
+        vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+        vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        return pc.count;
+    }
