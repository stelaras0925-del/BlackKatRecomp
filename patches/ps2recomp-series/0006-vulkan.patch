+                pc.ppr = std::max<uint32_t>(1u, (std::max<uint32_t>(m_tx.bitbltbuf.dbw, 1u) * 64u) / f.pw);
+                pc.baseBits = (m_tx.bitbltbuf.dbp * 256u * 8u) & 0x1FFFFFFu;
+                pc.dsax = m_tx.trxpos.dsax; pc.dsay = m_tx.trxpos.dsay; pc.rrw = rrw;
+                pc.nbits = f.nbits; pc.shift = f.shift; pc.mode = 0;
+                ensureCompute();
+                vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
