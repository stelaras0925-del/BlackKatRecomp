+                    if (FILE *f = std::fopen(path, "wb"))
+                    {
+                        std::fprintf(f, "P6\n%u %u\n255\n", pw * 2, ph);
+                        std::vector<uint8_t> row(pw * 6u);
+                        for (uint32_t y = 0; y < ph; ++y)
+                        {
+                            for (uint32_t x = 0; x < pw; ++x)
+                                for (int k = 0; k < 3; ++k)
+                                {
+                                    row[x * 3 + k] = (*vkPix)[(size_t(y) * pw + x) * 4 + k];
+                                    row[(pw + x) * 3 + k] = frame->pixels[(size_t(y) * pw + x) * 4 + k];
