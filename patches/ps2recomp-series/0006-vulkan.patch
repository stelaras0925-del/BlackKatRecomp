+            const uint64_t txB = static_cast<uint64_t>(m_tx.bitbltbuf.dbp) * 256u;
+            const uint64_t txE = txB + static_cast<uint64_t>(std::max<uint32_t>(m_tx.bitbltbuf.dbw, 1u)) * 64u * (m_tx.trxpos.dsay + rrh) * texBits(m_tx.bitbltbuf.dpsm) / 8u;
+            preUploadLocked(txB, txE);
+            if (const char *td = std::getenv("PS2X_VK_TRACEDUMP"); td && m_traceFrame && m_rFrames + 1 >= m_traceFrame && m_rFrames + 1 < m_traceFrame + 8 && m_txDone == 0)
+            {   // debug: host -> GS upload bytes in the trace window (first chunk)
+                static unsigned s_up = 0;
+                char path[512]; std::snprintf(path, sizeof(path), "%s/up_%llu_%03u_%x_%u_%x_%ux%u.bin", td, (unsigned long long)(m_rFrames + 1), s_up++, m_tx.bitbltbuf.dbp, m_tx.bitbltbuf.dbw, m_tx.bitbltbuf.dpsm, rrw, rrh);
+                if (FILE *f = std::fopen(path, "wb")) { std::fwrite(m_txBytes.data() + startByte, 1, len, f); std::fclose(f); }
