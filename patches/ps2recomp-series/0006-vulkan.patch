+
+# Optional Vulkan GS backend (PS2X_GS_BACKEND=vulkan at run time). Builds without Vulkan: the factory is a stub.
+find_package(Vulkan QUIET)
+option(PS2X_VULKAN "Build the Vulkan GS backend (needs Vulkan headers + loader)" ${Vulkan_FOUND})
+if(PS2X_VULKAN AND Vulkan_FOUND)
+    target_compile_definitions(ps2_runtime PRIVATE PS2X_HAVE_VULKAN=1)
+    target_link_libraries(ps2_runtime PUBLIC Vulkan::Vulkan)
+    find_program(PS2X_GLSLANG_VALIDATOR glslangValidator)
+    if(PS2X_GLSLANG_VALIDATOR)
+        set(_vk_spv_dir ${CMAKE_CURRENT_BINARY_DIR}/gs_vk_shaders)
+        file(MAKE_DIRECTORY ${_vk_spv_dir})
+        foreach(_sh IN ITEMS "gs_vk_swizzle.comp|kGsVkSwizzleSpv|gs_vk_swizzle.spv.h"
+                              "gs_vk_draw.vert|kGsVkDrawVertSpv|gs_vk_draw_vert.spv.h"
+                              "gs_vk_draw.frag|kGsVkDrawFragSpv|gs_vk_draw_frag.spv.h"
+                              "gs_vk_fxaa.comp|kGsVkFxaaSpv|gs_vk_fxaa.spv.h")
+            string(REPLACE "|" ";" _shl "${_sh}")
+            list(GET _shl 0 _src)
+            list(GET _shl 1 _var)
+            list(GET _shl 2 _out)
+            add_custom_command(
+                OUTPUT ${_vk_spv_dir}/${_out}
+                COMMAND ${PS2X_GLSLANG_VALIDATOR} -V --target-env vulkan1.3 --vn ${_var}
+                        -o ${_vk_spv_dir}/${_out} ${CMAKE_CURRENT_SOURCE_DIR}/src/lib/gs/shaders/${_src}
+                DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/src/lib/gs/shaders/${_src}
+                COMMENT "SPIR-V ${_src}"
+                VERBATIM)
+            target_sources(ps2_runtime PRIVATE ${_vk_spv_dir}/${_out})
+        endforeach()
+        target_include_directories(ps2_runtime PRIVATE ${_vk_spv_dir})
+        target_compile_definitions(ps2_runtime PRIVATE PS2X_HAVE_VK_SHADERS=1)
+    endif()
+    message(STATUS "ps2xRuntime: Vulkan GS backend enabled (${Vulkan_INCLUDE_DIRS})")
+else()
+    message(STATUS "ps2xRuntime: Vulkan GS backend disabled (PS2X_VULKAN=${PS2X_VULKAN}, Vulkan_FOUND=${Vulkan_FOUND})")
+endif()
