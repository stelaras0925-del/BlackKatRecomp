+    // ---- vk19 hi-res L2H tile cache ----
+    static constexpr uint32_t kImpTile = 64, kImpGrid = 4, kImpSlots = kImpGrid * kImpGrid;
+    struct ImpSlot { uint64_t hash = 0, use = 0; uint32_t w = 0, h = 0; };
+    ImpSlot m_imp[kImpSlots];
+    struct ImpAlias { bool on = false; uint32_t dbp = 0, dbw = 0, w = 0, h = 0, slot = 0; uint64_t seq = 0; } m_impA[8];
+    bool m_impOn = false;
+    uint64_t m_impUse = 0, m_pImpHits = 0, m_pImpCaps = 0, m_pImpMatch = 0;
+    VkImage m_impImg = VK_NULL_HANDLE; VkDeviceMemory m_impMem = VK_NULL_HANDLE;
+    static uint64_t fnv(const void *d, size_t n)
+    {
+        const uint8_t *p = static_cast<const uint8_t *>(d); uint64_t h = 1469598103934665603ull;
+        for (size_t i = 0; i < n; ++i) { h ^= p[i]; h *= 1099511628211ull; }
+        return h ? h : 1u;
+    }
+    // Copies the scaled source rect of a CT32 read (at 0,0, up to 64x64, from a drawn target) into a cache slot.
+    int impCaptureLocked(const GSTransferCommand &c)
+    {
+        if (!m_impOn || c.bitbltbuf.spsm != GS_PSM_CT32 || c.trxpos.ssax || c.trxpos.ssay) return -1;
+        const uint32_t w = c.trxreg.rrw, h = c.trxreg.rrh;
+        if (w > kImpTile || h > kImpTile || w < 8 || h < 8) return -1;
+        const uint32_t sbw = std::max<uint32_t>(c.bitbltbuf.sbw, 1u);
+        const uint64_t key = static_cast<uint64_t>(c.bitbltbuf.sbp / 32u) | (static_cast<uint64_t>(sbw) << 9) | (static_cast<uint64_t>(GS_PSM_CT32) << 15);
+        if (c.bitbltbuf.sbp % 32u) return -1;
+        auto it = m_colorT.find(key);
+        if (it == m_colorT.end() || it->second.hiRows < h || it->second.w < w || it->second.lastF != m_rFrames + 1) return -1;
+        uint32_t best = 0;
+        for (uint32_t i = 1; i < kImpSlots; ++i) if (m_imp[i].use < m_imp[best].use) best = i;
+        endRenderingLocked();
+        VkImageCopy ic{};
+        ic.srcSubresource = ic.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        ic.dstOffset = {static_cast<int32_t>((best % kImpGrid) * kImpTile * m_scale), static_cast<int32_t>((best / kImpGrid) * kImpTile * m_scale), 0};
+        ic.extent = {w * m_scale, h * m_scale, 1};
+        vkCmdCopyImage(m_cmd, it->second.img, VK_IMAGE_LAYOUT_GENERAL, m_impImg, VK_IMAGE_LAYOUT_GENERAL, 1, &ic);
+        m_imp[best] = ImpSlot{0, ++m_impUse, w, h};
+        ++m_pImpCaps;
+        return static_cast<int>(best);
+    }
+    // A finished CT32 upload whose bytes equal a cached read: remember that this texture is that tile.
+    void impMatchUploadLocked(uint64_t total)
+    {
+        const uint32_t dbp = m_tx.bitbltbuf.dbp, dbw = std::max<uint32_t>(m_tx.bitbltbuf.dbw, 1u), w = m_tx.trxreg.rrw, h = m_tx.trxreg.rrh;
+        const uint64_t b = static_cast<uint64_t>(dbp) * 256u, e = b + static_cast<uint64_t>(dbw) * 64u * (m_tx.trxpos.dsay + h) * texBits(m_tx.bitbltbuf.dpsm) / 8u;
+        for (auto &a : m_impA)
+        {   // any upload over an alias' memory ends it
+            if (!a.on) continue;
+            const uint64_t ab = static_cast<uint64_t>(a.dbp) * 256u, ae = ab + static_cast<uint64_t>(a.dbw) * 64u * a.h * 4u;
+            if (b < ae && ab < e) a.on = false;
+        }
+        if (m_tx.bitbltbuf.dpsm != GS_PSM_CT32 || m_tx.trxpos.dsax || m_tx.trxpos.dsay || w > kImpTile || h > kImpTile || total != static_cast<uint64_t>(w) * h) return;
+        if (m_txBytes.size() < total * 4u) return;
+        const uint64_t hs = fnv(m_txBytes.data(), total * 4u);
+        for (uint32_t i = 0; i < kImpSlots; ++i)
+            if (m_imp[i].hash == hs && m_imp[i].w == w && m_imp[i].h == h)
+            {
+                uint32_t k = 0;
+                for (uint32_t j = 0; j < 8; ++j) if (!m_impA[j].on) { k = j; break; }
+                m_impA[k] = ImpAlias{true, dbp, dbw, w, h, i, m_drawSeq};
+                m_imp[i].use = ++m_impUse;
+                ++m_pImpMatch;
+                return;
+            }
+    }
+
+    uint32_t recordRoundTripLocked()
+    {
+        if (!m_rtValid || m_rtExpect.empty()) return 0;
+        PC pc = m_rtPc;
+        pc.count = static_cast<uint32_t>(m_rtExpect.size());
+        pc.mode = 1;
+        const uint32_t outByte = (m_stageUsed + 255u) & ~255u;
+        if (outByte + pc.count * 4u > stageHi()) return 0;
+        m_rtOutWord = outByte / 4u;
+        pc.ioBitBase = m_rtOutWord;
+        vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+        vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        return pc.count;
+    }
+
+    void ensureBegun() { if (!m_begun) begin(); }
+    void ensureCompute() { endRenderingLocked(); ensureBegun(); }
+    // async present (default when rendering and not comparing; PS2X_VK_SYNCPRES=1 turns it off): the frame's command
+    // buffer is submitted without waiting; the next locked call (or begin/submitWait) waits for the fence first.
+    bool m_inFlight = false; // any slot pending (kept for readers of the old flag)
+    double m_pHeldMs = 0, m_pCopyMs = 0, m_pLockMs = 0; // vk17 prof: endFrame time under m_m / readback copy outside it
+    VkCommandBuffer m_cmdB[2]{};
+    VkFence m_fenceB[2]{};
+    bool m_pendB[2]{};
+    uint32_t m_slot = 0;
+    bool m_two = false;
+    uint32_t stageLo() const { return m_two ? m_slot * (kStaging / 2u) : 0u; }
+    uint32_t stageHi() const { return m_two ? stageLo() + kStaging / 2u : kStaging; }
+    uint32_t stageCap() const { return m_two ? kStaging / 2u : kStaging; }
+    void waitSlot(uint32_t i)
+    {
+        if (!m_pendB[i]) return;
+        const auto pt0 = std::chrono::steady_clock::now();
+        vkWaitForFences(m_dev, 1, &m_fenceB[i], VK_TRUE, UINT64_MAX);
+        m_pWaitMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - pt0).count();
+        vkResetFences(m_dev, 1, &m_fenceB[i]);
+        m_pendB[i] = false;
+        m_inFlight = m_pendB[0] || m_pendB[1];
+        probePrint();
+    }
+    void waitAllLocked() { waitSlot(m_slot ^ 1u); waitSlot(m_slot); }
+    // Called first by every locked entry point. One slot: wait for the submitted frame (as before). Two slots: only
+    // when no command buffer is open, wait for the current slot's previous use (two frames back), so its half of the
+    // ring/staging memory can be written by the CPU again.
+    void waitInFlight()
+    {
+        if (!m_inFlight) return;
+        if (!m_two) { waitAllLocked(); return; }
+        if (!m_begun) waitSlot(m_slot);
+    }
+    void submitAsync()
+    {
+        if (!m_begun) return;
+        endRenderingLocked();
+        vkEndCommandBuffer(m_cmd);
+        VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        si.commandBufferCount = 1;
+        si.pCommandBuffers = &m_cmd;
+        ++m_pSubs;
+        if (vkQueueSubmit(m_q, 1, &si, m_fence) == VK_SUCCESS) { m_pendB[m_slot] = true; m_inFlight = true; }
+        m_begun = false;
+        m_clutPending = 0;
+        if (m_two) { m_slot ^= 1u; m_cmd = m_cmdB[m_slot]; m_fence = m_fenceB[m_slot]; }
+    }
+    // vk19: submit what is recorded so far (no fence) and continue in a fresh command buffer of the same slot, so the
+    // GPU runs the frame while it is being recorded and a GS -> host read (submitWait) only waits for the tail.
+    // The slot's fence (on the frame's last submit) covers the kicked buffers: fence signals include all earlier
+    // submissions. Kicked buffers are reset in begin() only after that fence (or a submitWait) was waited.
+    static constexpr uint32_t kKick = 32;
+    VkCommandBuffer m_cmdK[2][kKick]{};
+    uint32_t m_kickIdx = 0, m_kickBatches = 0, m_kickEvery = 16;
+    uint64_t m_pKicks = 0;
+    void kickLocked()
+    {
+        m_kickBatches = 0;
+        if (!m_begun || !m_two || m_kickIdx >= kKick) return;
+        endRenderingLocked();
+        vkEndCommandBuffer(m_cmd);
+        VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        si.commandBufferCount = 1;
+        si.pCommandBuffers = &m_cmd;
+        ++m_pSubs; ++m_pKicks;
+        vkQueueSubmit(m_q, 1, &si, VK_NULL_HANDLE);
