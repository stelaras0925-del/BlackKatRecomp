+                            std::fwrite(row.data(), 1, row.size(), f);
+                        }
+                        std::fclose(f);
+                    }
+                }
+            }
+        }
+        if (!check)
+            return;
+        std::vector<uint8_t> refVram;
+        ref->SnapshotVram(refVram);
+        const uint32_t *mv = static_cast<const uint32_t *>(m_rbMap);
+        const uint32_t *ow = mv + kVram / 4u;
+        if (const char *d = std::getenv("PS2X_VK_DUMPVRAM"); d && refVram.size() >= kVram)
+        {   // decode one buffer region from mirror and reference VRAM: left = Vulkan mirror, right = reference
+            unsigned fbp = 70, fbw = 10, psm = 0, w = 640, h = 448;
+            if (const char *r = std::getenv("PS2X_VK_DUMPREG")) std::sscanf(r, "%u,%u,%x,%u,%u", &fbp, &fbw, &psm, &w, &h);
