+        static const bool s_skyLog = std::getenv("PS2X_VK_SKYLOG") != nullptr; // debug: log the sky batch (217 tris, TEST 0x50002)
+        const bool skyB = (s_skyLog || std::getenv("PS2X_VK_PROBESKY")) && b.primCount == 217 && c.test == 0x50002ull;
+        static const bool skyB0 = std::getenv("PS2X_VK_PROBESKY") != nullptr;
+        if (skyB && s_skyLog)
+        {
+            float x0 = 1e9f, x1 = -1e9f, y0 = 1e9f, y1 = -1e9f, z0 = 1e30f, z1 = -1e30f; int a0 = 999, a1 = -1, f0 = 999, f1 = -1;
