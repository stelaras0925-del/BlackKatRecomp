+    // Page-local bit-offset tables from the runtime's own GS memory functions (scratch CPU backend + 4 MB).
+    void buildLuts()
+    {
+        struct L { uint32_t psm, pw, ph, bits; } ls[L_N] = {{GS_PSM_CT32, 64, 32, 32}, {GS_PSM_Z32, 64, 32, 32}, {GS_PSM_CT16, 64, 64, 16},
+                                                         {GS_PSM_CT16S, 64, 64, 16}, {GS_PSM_Z16, 64, 64, 16}, {GS_PSM_Z16S, 64, 64, 16},
+                                                         {GS_PSM_T8, 128, 64, 8}, {GS_PSM_T4, 128, 128, 4}};
+        std::vector<uint8_t> mem(kVram, 0);
+        GSCpuBackend cpu;
+        cpu.Initialize(mem.data(), kVram);
+        for (int f = 0; f < L_N; ++f)
+        {
+            const L &l = ls[f];
+            const uint32_t n = l.pw * l.ph, slots = 65536u / l.bits;
+            std::vector<uint32_t> slotPix(slots, 0);
+            const uint32_t ones = l.bits >= 32 ? 0xFFFFFFFFu : ((1u << l.bits) - 1u);
+            for (uint32_t k = 0; (1u << k) < n; ++k)
+            {
+                std::memset(mem.data(), 0, 8192);
+                for (uint32_t i = 0; i < n; ++i)
+                    if ((i >> k) & 1u)
+                        cpu.WriteVram(l.psm, 0, l.pw / 64u, i % l.pw, i / l.pw, ones);
+                for (uint32_t s = 0; s < slots; ++s)
+                {
+                    const uint32_t bit = s * l.bits;
+                    uint32_t w;
+                    std::memcpy(&w, mem.data() + (bit >> 5) * 4u, 4);
+                    if ((w >> (bit & 31u)) & ones)
+                        slotPix[s] |= 1u << k;
+                }
+            }
+            m_lutOff[f] = static_cast<uint32_t>(m_lut.size());
+            m_lut.resize(m_lut.size() + n, 0);
+            for (uint32_t s = 0; s < slots; ++s)
+                if (slotPix[s] < n)
+                    m_lut[m_lutOff[f] + slotPix[s]] = s * l.bits;
+        }
+    }
