+    uint cv;
+    if ((p.pc[12] & 256u) != 0u) // CLUT-buffer snapshot (pc[10] = word index of the entry base)
+        cv = vram[p.pc[10] + ((kind == 3u) ? (raw & 255u) : (raw & 15u))] & ((clutBits >= 32u) ? 0xFFFFFFFFu : 0xFFFFu);
+    else
+        cv = readPix(p.pc[10], 1u, 64u, (clutBits == 32u) ? 32u : 64u, p.pc[11], cx, cy, clutBits, 0u);
