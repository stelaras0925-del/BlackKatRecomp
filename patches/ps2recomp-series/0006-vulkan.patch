+
+    // GS CLUT buffer emulation: each CLUT load snapshots the previous buffer into a new ring slot and loads the
+    // entries from VRAM (after writing back any drawn target that covers the palette). Draws read the current slot.
+    // PS2X_VK_CLUT=0 falls back to reading the palette straight from CBP at draw time.
+public:
+    void loadClut(const GSTex0Reg &t, const GSTexClutReg &)
+    {
+        if (!m_ok || !m_rOn || m_noClut) return;
+        const uint32_t psm = t.psm;
+        const bool t4 = psm == GS_PSM_T4 || psm == 0x24u || psm == 0x2Cu;
+        if (!t4 && psm != GS_PSM_T8 && psm != GS_PSM_T8H) return;
+        switch (t.cld)
+        {
+        case 1: break;
+        case 2: m_clutCbp[0] = t.cbp; break;
+        case 3: m_clutCbp[1] = t.cbp; break;
+        case 4: if (m_clutCbp[0] == t.cbp) return; m_clutCbp[0] = t.cbp; break;
+        case 5: if (m_clutCbp[1] == t.cbp) return; m_clutCbp[1] = t.cbp; break;
+        default: return;
+        }
+        const bool c16 = t.cpsm == GS_PSM_CT16 || t.cpsm == GS_PSM_CT16S;
+        if (!c16 && t.cpsm != GS_PSM_CT32 && t.cpsm != GS_PSM_CT24) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        if (m_txActive && m_txBytes.size() > m_txFlushedBytes) { endRenderingLocked(); flushTxLocked(false); }
+        writeBackRangeLocked(static_cast<uint64_t>(t.cbp) * 256u, static_cast<uint64_t>(t.cbp) * 256u + 1024u);
+        endRenderingLocked();
+        if (m_clutPending + 2u >= kClutSlots) submitWait();
+        ensureCompute();
+        const uint32_t prev = m_clutSlot, cur = (m_clutSlot + 1u) % kClutSlots;
+        VkBufferCopy cp{kVram + prev * 2048u, kVram + cur * 2048u, 2048u};
+        vkCmdCopyBuffer(m_cmd, m_vram, m_vram, 1, &cp);
+        barrier();
+        const Fmt f = fmt(c16 ? t.cpsm : GS_PSM_CT32);
+        PC pc{};
+        const uint32_t csaOff = t4 ? ((c16 ? (t.csa & 31u) : (t.csa & 15u)) << 4) : 0u;
+        pc.ioBitBase = kVram / 4u + cur * 512u + csaOff;
+        pc.firstPixel = t4 ? 1u : 0u;
+        pc.count = t4 ? 16u : 256u;
+        pc.lutBase = f.lut; pc.pw = f.pw; pc.ph = f.ph; pc.ppr = std::max<uint32_t>(1u, 64u / f.pw);
+        pc.baseBits = (t.cbp * 256u * 8u) & 0x1FFFFFFu;
+        pc.nbits = c16 ? 16u : 32u; pc.shift = 0; pc.mode = 3;
+        vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+        vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        barrier();
+        m_clutSlot = cur;
+        ++m_clutPending;
+        ++m_clutLoads;
+    }
+private:
+
+    RTarget *target(uint64_t key, uint32_t w, bool depth)
+    {
+        auto &map = depth ? m_depthT : m_colorT;
+        auto it = map.find(key);
+        if (it != map.end()) return &it->second;
+        if (map.size() >= 48) return nullptr;
+        RTarget t;
+        t.w = w; t.h = kRows; t.depth = depth;
+        const VkFormat fmt = depth ? VK_FORMAT_D32_SFLOAT : VK_FORMAT_R8G8B8A8_UNORM;
+        VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ii.imageType = VK_IMAGE_TYPE_2D;
+        ii.format = fmt;
+        ii.extent = {w * m_scale, kRows * m_scale, 1}; // PS2X_VK_SCALE: images at N x the GS size
+        ii.mipLevels = 1; ii.arrayLayers = 1; ii.samples = VK_SAMPLE_COUNT_1_BIT; ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ii.usage = depth ? (VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT)
+                         : (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+        if (vkCreateImage(m_dev, &ii, nullptr, &t.img) != VK_SUCCESS) return nullptr;
+        VkMemoryRequirements mr;
+        vkGetImageMemoryRequirements(m_dev, t.img, &mr);
+        VkPhysicalDeviceMemoryProperties mp;
+        vkGetPhysicalDeviceMemoryProperties(m_phys, &mp);
+        uint32_t idx = UINT32_MAX;
+        for (uint32_t i = 0; i < mp.memoryTypeCount; ++i)
+            if ((mr.memoryTypeBits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) { idx = i; break; }
+        VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        ai.allocationSize = mr.size;
+        ai.memoryTypeIndex = idx;
+        if (idx == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &t.mem) != VK_SUCCESS) return nullptr;
+        vkBindImageMemory(m_dev, t.img, t.mem, 0);
+        VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vi.image = t.img;
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = fmt;
+        vi.subresourceRange = {static_cast<VkImageAspectFlags>(depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT), 0, 1, 0, 1};
+        if (vkCreateImageView(m_dev, &vi, nullptr, &t.view) != VK_SUCCESS) return nullptr;
+        // UNDEFINED -> GENERAL, cleared (TODO: seed from VRAM)
+        endRenderingLocked();
+        ensureBegun();
+        VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+        b.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+        b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        b.image = t.img;
+        b.subresourceRange = vi.subresourceRange;
+        vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+        if (depth)
+        {
+            VkClearDepthStencilValue z{0.0f, 0};
+            vkCmdClearDepthStencilImage(m_cmd, t.img, VK_IMAGE_LAYOUT_GENERAL, &z, 1, &vi.subresourceRange);
+        }
+        else
+        {
+            VkClearColorValue c{};
+            vkCmdClearColorImage(m_cmd, t.img, VK_IMAGE_LAYOUT_GENERAL, &c, 1, &vi.subresourceRange);
+        }
+        barrier();
+        ++m_rs.targets;
+        if (!depth && !m_noSeed)
+        {   // seed the new colour target from VRAM (rows that lie inside the 4 MB)
+            const uint32_t kp = (key >> 15) & 0x3Fu, bpp = (kp == GS_PSM_CT16 || kp == GS_PSM_CT16S) ? 2u : 4u;
+            const uint64_t base = static_cast<uint64_t>(key & 0x1FFu) * 8192u;
+            const uint32_t rows = base < kVram ? static_cast<uint32_t>(std::min<uint64_t>(kRows, (kVram - base) / (static_cast<uint64_t>(w) * bpp))) : 0u;
+            seedLocked(key, t, rows);
+        }
+        return &map.emplace(key, t).first->second;
+    }
+
+    VkPipeline pipeline(uint64_t key)
+    {
+        auto it = m_pipes.find(key);
+        if (it != m_pipes.end()) return it->second;
+        const uint32_t topo = key & 3u;
+        const bool blend = (key >> 2) & 1u;
+        const VkBlendOp eq = static_cast<VkBlendOp>((key >> 3) & 3u);
+        const VkBlendFactor sf = static_cast<VkBlendFactor>((key >> 5) & 31u), df = static_cast<VkBlendFactor>((key >> 10) & 31u);
+        const bool ztest = (key >> 15) & 1u;
+        const VkCompareOp zop = static_cast<VkCompareOp>((key >> 16) & 7u);
+        const bool zwrite = (key >> 19) & 1u;
+        const uint32_t cmask = (key >> 20) & 15u;
+        VkPipelineShaderStageCreateInfo st[2] = {{VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_VERTEX_BIT, m_vs, "main", nullptr},
+                                                 {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_FRAGMENT_BIT, m_fs, "main", nullptr}};
+        VkVertexInputBindingDescription vb{0, kFloats * 4u, VK_VERTEX_INPUT_RATE_VERTEX};
+        VkVertexInputAttributeDescription va[4] = {{0, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 0}, {1, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 16}, {2, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 32}, {3, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 48}};
+        VkPipelineVertexInputStateCreateInfo vis{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        vis.vertexBindingDescriptionCount = 1; vis.pVertexBindingDescriptions = &vb;
+        vis.vertexAttributeDescriptionCount = 4; vis.pVertexAttributeDescriptions = va;
+        VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        ia.topology = topo == 0 ? VK_PRIMITIVE_TOPOLOGY_POINT_LIST : topo == 1 ? VK_PRIMITIVE_TOPOLOGY_LINE_LIST : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        vp.viewportCount = 1; vp.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        rs.polygonMode = VK_POLYGON_MODE_FILL; rs.cullMode = VK_CULL_MODE_NONE; rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE; rs.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+        ds.depthTestEnable = (ztest || zwrite) ? VK_TRUE : VK_FALSE; // Vulkan only writes depth with the test enabled
+        ds.depthWriteEnable = zwrite ? VK_TRUE : VK_FALSE;
+        ds.depthCompareOp = zop;
+        VkPipelineColorBlendAttachmentState ba{};
+        ba.blendEnable = blend ? VK_TRUE : VK_FALSE;
+        ba.srcColorBlendFactor = sf; ba.dstColorBlendFactor = df; ba.colorBlendOp = eq;
+        ba.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE; ba.dstAlphaBlendFactor = VK_BLEND_FACTOR_ZERO; ba.alphaBlendOp = VK_BLEND_OP_ADD;
+        ba.colorWriteMask = cmask;
+        VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        cb.attachmentCount = 1; cb.pAttachments = &ba;
+        VkDynamicState dyn[3] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_BLEND_CONSTANTS};
+        VkPipelineDynamicStateCreateInfo dy{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+        dy.dynamicStateCount = 3; dy.pDynamicStates = dyn;
+        const VkFormat cf = VK_FORMAT_R8G8B8A8_UNORM;
+        VkPipelineRenderingCreateInfo ri{VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+        ri.colorAttachmentCount = 1; ri.pColorAttachmentFormats = &cf; ri.depthAttachmentFormat = VK_FORMAT_D32_SFLOAT;
+        VkGraphicsPipelineCreateInfo gp{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        gp.pNext = &ri;
+        gp.stageCount = 2; gp.pStages = st;
+        gp.pVertexInputState = &vis; gp.pInputAssemblyState = &ia; gp.pViewportState = &vp; gp.pRasterizationState = &rs;
+        gp.pMultisampleState = &ms; gp.pDepthStencilState = &ds; gp.pColorBlendState = &cb; gp.pDynamicState = &dy;
+        gp.layout = m_gpl;
+        VkPipeline p = VK_NULL_HANDLE;
+        if (vkCreateGraphicsPipelines(m_dev, m_pcache, 1, &gp, nullptr, &p) != VK_SUCCESS)
+            p = VK_NULL_HANDLE;
+        m_pipes.emplace(key, p);
+        ++m_rs.pipelines;
+        return p;
+    }
+
+    // GS ALPHA (A-B)*C+D  ->  Vulkan blend (same mapping as the GL backend; As = out.a = As/128, Ad = stored a)
+    static void blendOf(uint64_t alpha, uint32_t fpsm, VkBlendOp &eq, VkBlendFactor &sf, VkBlendFactor &df, float &fix)
+    {
+        const int A = alpha & 3, B = (alpha >> 2) & 3, C = (alpha >> 4) & 3, D = (alpha >> 6) & 3;
+        fix = static_cast<float>((alpha >> 32) & 0xFFu) / 128.0f;
+        VkBlendFactor F = VK_BLEND_FACTOR_SRC_ALPHA, OMF = VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+        if (C == 1 && fpsm != GS_PSM_CT24) { F = VK_BLEND_FACTOR_DST_ALPHA; OMF = VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA; }
+        else if (C == 1) { F = VK_BLEND_FACTOR_CONSTANT_ALPHA; OMF = VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA; fix = 1.0f; }
+        else if (C >= 2) { F = VK_BLEND_FACTOR_CONSTANT_ALPHA; OMF = VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA; }
+        auto coef = [&](int which, VkBlendFactor &factor, int &sign) {
+            const int kf = (A == which ? 1 : 0) - (B == which ? 1 : 0), k1 = (D == which ? 1 : 0);
+            sign = 1;
+            if (k1 == 0 && kf == 0) factor = VK_BLEND_FACTOR_ZERO;
+            else if (k1 == 1 && kf == 0) factor = VK_BLEND_FACTOR_ONE;
+            else if (k1 == 0 && kf == 1) factor = F;
+            else if (k1 == 0 && kf == -1) { factor = F; sign = -1; }
+            else if (k1 == 1 && kf == -1) factor = OMF;
+            else factor = VK_BLEND_FACTOR_ONE;
+        };
+        int ss, dsn;
+        coef(0, sf, ss);
+        coef(1, df, dsn);
+        if (sf == VK_BLEND_FACTOR_ZERO) ss = 1;
+        if (df == VK_BLEND_FACTOR_ZERO) dsn = 1;
+        eq = VK_BLEND_OP_ADD;
+        if (ss > 0 && dsn < 0) eq = VK_BLEND_OP_SUBTRACT;
+        else if (ss < 0 && dsn > 0) eq = VK_BLEND_OP_REVERSE_SUBTRACT;
+        else if (ss < 0 && dsn < 0) { sf = VK_BLEND_FACTOR_ZERO; df = VK_BLEND_FACTOR_ZERO; }
+    }
+
+    void endRenderingLocked()
+    {
+        if (!m_rendering) return;
+        vkCmdEndRendering(m_cmd);
+        m_rendering = false;
+        barrier();
+    }
