+    uint y = wrap(v, (p.pc[14] >> 2) & 3u, th, p.pc[16] & 0xFFFFu, p.pc[16] >> 16);
+    uint kind = (p.pc[8] >> 16) & 255u;
+    uint raw = readPix(p.pc[4], p.pc[5], p.pc[6] & 0xFFFFu, p.pc[6] >> 16, p.pc[7], x, y, p.pc[8] & 255u, (p.pc[8] >> 8) & 255u);
