+            wi.dstSet = m_set; wi.dstBinding = 4; wi.descriptorCount = 1;
+            wi.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER; wi.pImageInfo = &ii;
