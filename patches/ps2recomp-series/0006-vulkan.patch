+            char path[512]; std::snprintf(path, sizeof(path), "%s_%llu.ppm", d, (unsigned long long)m_frames);
+            if (FILE *fp = f.ok ? std::fopen(path, "wb") : nullptr)
+            {
+                std::fprintf(fp, "P6\n%u %u\n255\n", w * 2, h);
+                const uint32_t ppr = std::max<uint32_t>(1u, fbw * 64u / f.pw);
+                for (uint32_t y = 0; y < h; ++y)
+                    for (int side = 0; side < 2; ++side)
+                        for (uint32_t x = 0; x < w; ++x)
+                        {
+                            const uint32_t page = (y / f.ph) * ppr + x / f.pw;
+                            const uint32_t bit = (fbp * 65536u + page * 65536u + m_lut[f.lut + (y % f.ph) * f.pw + (x % f.pw)] + f.shift) & 0x1FFFFFFu;
