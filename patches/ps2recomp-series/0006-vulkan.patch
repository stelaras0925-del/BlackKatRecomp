+    // Page-local bit-offset tables from the runtime's own GS memory functions (scratch CPU backend + 4 MB).
+    void buildLuts()
+    {
+        struct L { uint32_t psm, pw, ph, bits; } ls[L_N] = {{GS_PSM_CT32, 64, 32, 32}, {GS_PSM_Z32, 64, 32, 32}, {GS_PSM_CT16, 64, 64, 16},
+                                                         {GS_PSM_CT16S, 64, 64, 16}, {GS_PSM_Z16, 64, 64, 16}, {GS_PSM_Z16S, 64, 64, 16},
+                                                         {GS_PSM_T8, 128, 64, 8}, {GS_PSM_T4, 128, 128, 4}};
+        std::vector<uint8_t> mem(kVram, 0);
+        GSCpuBackend cpu;
+        cpu.Initialize(mem.data(), kVram);
+        for (int f = 0; f < L_N; ++f)
+        {
+            const L &l = ls[f];
+            const uint32_t n = l.pw * l.ph, slots = 65536u / l.bits;
+            std::vector<uint32_t> slotPix(slots, 0);
+            const uint32_t ones = l.bits >= 32 ? 0xFFFFFFFFu : ((1u << l.bits) - 1u);
+            for (uint32_t k = 0; (1u << k) < n; ++k)
+            {
+                std::memset(mem.data(), 0, 8192);
+                for (uint32_t i = 0; i < n; ++i)
+                    if ((i >> k) & 1u)
+                        cpu.WriteVram(l.psm, 0, l.pw / 64u, i % l.pw, i / l.pw, ones);
+                for (uint32_t s = 0; s < slots; ++s)
+                {
+                    const uint32_t bit = s * l.bits;
+                    uint32_t w;
+                    std::memcpy(&w, mem.data() + (bit >> 5) * 4u, 4);
+                    if ((w >> (bit & 31u)) & ones)
+                        slotPix[s] |= 1u << k;
+                }
+            }
+            m_lutOff[f] = static_cast<uint32_t>(m_lut.size());
+            m_lut.resize(m_lut.size() + n, 0);
+            for (uint32_t s = 0; s < slots; ++s)
+                if (slotPix[s] < n)
+                    m_lut[m_lutOff[f] + slotPix[s]] = s * l.bits;
+        }
+    }
+
+    void disownRectLocked(uint32_t baseBlock, uint32_t bw, uint32_t psm, uint32_t y0, uint32_t y1)
+    {
+        const Fmt f = fmt(psm);
+        const uint32_t ppr = std::max<uint32_t>(1u, (bw * 64u) / f.pw);
+        const uint32_t p0 = baseBlock / 32u;
+        const uint32_t r0 = y0 / f.ph, r1 = (std::max(y1, y0 + 1u) - 1u) / f.ph;
+        for (uint32_t r = r0; r <= r1 && r < 64u; ++r)
+            for (uint32_t c = 0; c <= ppr; ++c) // +1 page: base not page aligned
+            {
+                const uint32_t pg = (p0 + r * ppr + c) % kPages;
+                if (!m_pageOwned[pg]) continue;
+                m_pageOwned[pg] = 0;
+                ensureCompute();
+                vkCmdFillBuffer(m_cmd, m_own, static_cast<VkDeviceSize>(pg) * 8192u, 8192u, 0u);
+                m_needBarrier = true;
+                ++m_disowns;
+            }
+        if (m_needBarrier) { barrier(); m_needBarrier = false; }
+    }
+
+    // Local->local transfer (TRXDIR 2) done in the mirror when Vulkan renders: write back dirty targets over the source
+    // and destination, unswizzle the source rect to staging (mode 1, one raw GS value per word), swizzle it into the
+    // destination (mode 0, 32-bit io), then re-seed targets over the destination. Menus restore their background
+    // this way every frame (e.g. 0x1a40 -> 0x8c0, 640x448 CT32). PS2X_VK_L2L=0 restores the old disown-only path.
+    bool localCopyLocked(const GSTransferCommand &c)
+    {
+        static const bool s_noL2l = [] { const char *e = std::getenv("PS2X_VK_L2L"); return e && e[0] == '0'; }();
+        if (!m_rOn || s_noL2l) return false;
+        const Fmt fs = fmt(c.bitbltbuf.spsm), fd = fmt(c.bitbltbuf.dpsm);
+        const uint32_t rrw = c.trxreg.rrw, rrh = c.trxreg.rrh;
+        if (!fs.ok || !fd.ok || rrw == 0 || rrh == 0) return false;
+        const uint64_t n = static_cast<uint64_t>(rrw) * rrh, alloc = (n * 4u + 255u) & ~255ull;
+        if (alloc > kStaging) return false;
+        const uint32_t sbw = std::max<uint32_t>(c.bitbltbuf.sbw, 1u), dbw = std::max<uint32_t>(c.bitbltbuf.dbw, 1u);
+        const uint64_t sB = static_cast<uint64_t>(c.bitbltbuf.sbp) * 256u, sE = sB + static_cast<uint64_t>(sbw) * 64u * (c.trxpos.ssay + rrh) * texBits(c.bitbltbuf.spsm) / 8u;
+        const uint64_t dB = static_cast<uint64_t>(c.bitbltbuf.dbp) * 256u, dE = dB + static_cast<uint64_t>(dbw) * 64u * (c.trxpos.dsay + rrh) * texBits(c.bitbltbuf.dpsm) / 8u;
+        preUploadLocked(sB, sE);
+        preUploadLocked(dB, dE);
+        if (m_stageUsed + alloc > kStaging) { if (m_begun) submitWait(); m_stageUsed = 0; }
+        ensureCompute();
+        PC pc{};
+        pc.ioBitBase = static_cast<uint32_t>(m_stageUsed / 4u);
+        pc.firstPixel = 0; pc.count = static_cast<uint32_t>(n);
+        pc.srcBits = 32; pc.lutBase = fs.lut; pc.pw = fs.pw; pc.ph = fs.ph;
+        pc.ppr = std::max<uint32_t>(1u, sbw * 64u / fs.pw);
+        pc.baseBits = (c.bitbltbuf.sbp * 256u * 8u) & 0x1FFFFFFu;
+        pc.dsax = c.trxpos.ssax; pc.dsay = c.trxpos.ssay; pc.rrw = rrw;
+        pc.nbits = fs.nbits; pc.shift = fs.shift; pc.mode = 1;
+        vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+        vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        barrier();
+        pc.ioBitBase = static_cast<uint32_t>(m_stageUsed * 8u);
+        pc.lutBase = fd.lut; pc.pw = fd.pw; pc.ph = fd.ph;
+        pc.ppr = std::max<uint32_t>(1u, dbw * 64u / fd.pw);
+        pc.baseBits = (c.bitbltbuf.dbp * 256u * 8u) & 0x1FFFFFFu;
+        pc.dsax = c.trxpos.dsax; pc.dsay = c.trxpos.dsay;
+        pc.nbits = fd.nbits; pc.shift = fd.shift; pc.mode = 0;
+        vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+        vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+        barrier();
+        m_stageUsed += alloc;
+        ++m_dispatches;
+        postUploadLocked(dB, dE);
+        const uint32_t p0 = c.bitbltbuf.dbp / 32u;
+        for (uint32_t r = c.trxpos.dsay / fd.ph; r <= (c.trxpos.dsay + rrh - 1u) / fd.ph && r < 64u; ++r)
+            for (uint32_t col = 0; col <= pc.ppr; ++col)
+                m_pageOwned[(p0 + r * pc.ppr + col) % kPages] = 1;
+        m_ownedSinceDraw = true;
+        return true;
+    }
+    void flushTxLocked(bool finish = true)
+    {
+        if (!m_txActive) return;
+        const Fmt f = fmt(m_tx.bitbltbuf.dpsm);
+        const uint32_t rrw = m_tx.trxreg.rrw, rrh = m_tx.trxreg.rrh;
+        if (!f.ok || rrw == 0 || rrh == 0) { if (finish) m_txActive = false; return; }
+        const uint64_t total = static_cast<uint64_t>(rrw) * rrh;
+        const uint64_t have = std::min<uint64_t>(total, (static_cast<uint64_t>(m_txBytes.size()) * 8u) / f.srcBits);
+        if (have > m_txDone)
+        {
+            const uint64_t startBit = m_txDone * f.srcBits;
+            const uint64_t startByte = (startBit / 32u) * 4u;
+            const uint64_t endByte = std::min<uint64_t>(m_txBytes.size(), ((have * f.srcBits + 31u) / 32u) * 4u);
+            const uint32_t len = static_cast<uint32_t>(endByte - startByte);
+            const uint32_t alloc = (len + 8u + 255u) & ~255u;
+            const uint64_t txB = static_cast<uint64_t>(m_tx.bitbltbuf.dbp) * 256u;
+            const uint64_t txE = txB + static_cast<uint64_t>(std::max<uint32_t>(m_tx.bitbltbuf.dbw, 1u)) * 64u * (m_tx.trxpos.dsay + rrh) * texBits(m_tx.bitbltbuf.dpsm) / 8u;
+            preUploadLocked(txB, txE);
+            if (m_traceFrame && m_rFrames + 1 >= m_traceFrame && m_rFrames + 1 < m_traceFrame + 8)
+                std::fprintf(stderr, "[gs:vk:tx] f%llu dbp %x dbw %u dpsm %x y %u h %u\n", (unsigned long long)(m_rFrames + 1), m_tx.bitbltbuf.dbp, m_tx.bitbltbuf.dbw, m_tx.bitbltbuf.dpsm, m_tx.trxpos.dsay, rrh);
+            if (m_stageUsed + alloc > kStaging)
+            {
+                if (m_begun) submitWait();
+                m_stageUsed = 0;
+            }
+            if (alloc <= kStaging)
+            {
+                uint8_t *dst = static_cast<uint8_t *>(m_stageMap) + m_stageUsed;
+                std::memcpy(dst, m_txBytes.data() + startByte, len);
+                std::memset(dst + len, 0, alloc - len);
+                PC pc{};
+                pc.ioBitBase = static_cast<uint32_t>(m_stageUsed * 8u + (startBit - startByte * 8u));
+                pc.firstPixel = static_cast<uint32_t>(m_txDone);
+                pc.count = static_cast<uint32_t>(have - m_txDone);
+                pc.srcBits = f.srcBits; pc.lutBase = f.lut; pc.pw = f.pw; pc.ph = f.ph;
+                pc.ppr = std::max<uint32_t>(1u, (std::max<uint32_t>(m_tx.bitbltbuf.dbw, 1u) * 64u) / f.pw);
+                pc.baseBits = (m_tx.bitbltbuf.dbp * 256u * 8u) & 0x1FFFFFFu;
+                pc.dsax = m_tx.trxpos.dsax; pc.dsay = m_tx.trxpos.dsay; pc.rrw = rrw;
+                pc.nbits = f.nbits; pc.shift = f.shift; pc.mode = 0;
+                ensureCompute();
+                vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipe);
+                vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_COMPUTE, m_pl, 0, 1, &m_set, 0, nullptr);
+                vkCmdPushConstants(m_cmd, m_pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(PC), &pc);
+                vkCmdDispatch(m_cmd, (pc.count + 63u) / 64u, 1, 1);
+                barrier();
+                m_stageUsed += alloc;
+                ++m_dispatches;
+                m_uploadBytes += len;
+                postUploadLocked(txB, txE);
+                // remember for the round-trip check (32/16/8-bit sources only, first 4096 pixels)
+                m_rtPc = pc;
+                m_rtValid = true;
+                m_rtExpect.clear();
+                const uint32_t nrt = std::min<uint32_t>(pc.count, 4096u);
+                for (uint32_t i = 0; i < nrt; ++i)
+                {
+                    const uint64_t sb = (m_txDone + i) * f.srcBits;
+                    uint64_t v = 0;
+                    for (uint32_t b = 0; b < (f.srcBits + 7u) / 8u + 1u && (sb / 8u + b) < m_txBytes.size(); ++b)
+                        v |= static_cast<uint64_t>(m_txBytes[sb / 8u + b]) << (8u * b);
+                    v >>= (sb & 7u);
+                    m_rtExpect.push_back(static_cast<uint32_t>(v & (f.nbits >= 32 ? 0xFFFFFFFFull : ((1ull << f.nbits) - 1ull))));
+                }
+                // mark pages possibly owned (rows touched by this dispatch)
+                const uint32_t ya = pc.dsay + pc.firstPixel / rrw, yb = pc.dsay + (pc.firstPixel + pc.count - 1u) / rrw;
+                const uint32_t p0 = m_tx.bitbltbuf.dbp / 32u;
+                for (uint32_t r = ya / f.ph; r <= yb / f.ph && r < 64u; ++r)
+                    for (uint32_t c = 0; c <= pc.ppr; ++c)
+                        m_pageOwned[(p0 + r * pc.ppr + c) % kPages] = 1;
+                m_ownedSinceDraw = true;
+            }
+            m_txDone = have;
+        }
+        m_txFlushedBytes = m_txBytes.size();
+        if (finish || m_txDone >= total)
+        {
+            if (m_txDone >= total || finish) ++m_uploads;
+            m_txActive = false;
+            m_txBytes.clear();
+            m_txFlushedBytes = 0;
+        }
+    }
