+                         (unsigned long long)(m_rFrames + 1), c.frame.fbp, c.frame.fbw, c.frame.psm, c.zbuf.zbp, c.zbuf.psm, (unsigned)type, (unsigned)b.primCount, (unsigned)st.prim.tme, (unsigned)st.prim.fst,
+                         c.tex0.tbp0, c.tex0.tbw, c.tex0.psm, st.textureWidth, st.textureHeight, c.tex0.cpsm, c.tex0.cbp, (unsigned)c.tex0.tfx, (unsigned)c.tex0.tcc, (unsigned)st.prim.abe,
