+// Vulkan PS2 VRAM mirror (Phase 3 step 2), #included by gs_vk_backend.cpp inside its anonymous namespace.
+// 4 MB device-local buffer = GS local memory. Host->local uploads are swizzled on the GPU by gs_vk_swizzle.comp;
+// an "own" buffer (same size) records which bits were last written by an upload. Draws, clears, local->local
+// copies and WriteVram clear ownership of the pages they may touch (they are not rendered by Vulkan yet).
+// PS2X_VK_VRAM_CHECK=N (1 = every 30 presents): at present, read back VRAM+own and compare every owned bit with the
+// reference backend's VRAM (SnapshotVram), plus an unswizzle round trip of the last upload.
+#if defined(PS2X_HAVE_VK_SHADERS)
+
+// (gs_cpu_backend.h and the SPIR-V header are included at file scope by gs_vk_backend.cpp)
+
+class VkVramMirror
+{
+public:
+    static constexpr uint32_t kVram = 4u * 1024u * 1024u;
+    static constexpr uint32_t kClutSlots = 1024u;
+    static constexpr uint32_t kStaging = 32u * 1024u * 1024u;
+    static constexpr uint32_t kPages = kVram / 8192u;
+
+    bool init(VkPhysicalDevice phys, VkDevice dev, VkQueue q, uint32_t qfam)
+    {
+        m_phys = phys; m_dev = dev; m_q = q;
+        if (const char *e = std::getenv("PS2X_VK_VRAM_CHECK"))
+        {
+            const int n = std::atoi(e);
+            m_checkEvery = n <= 0 ? 0u : (n == 1 ? 30u : static_cast<uint32_t>(n));
+        }
+        buildLuts();
+        // VRAM (4 MB) followed by the CLUT-buffer snapshot ring (kClutSlots x 512 entries, see loadClut)
+        if (!buffer(kVram + kClutSlots * 2048u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                    VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, m_vram, m_vramMem, nullptr) ||
+            !buffer(kVram, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                    VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, m_own, m_ownMem, nullptr) ||
+            !buffer(m_lut.size() * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                    m_lutBuf, m_lutMem, &m_lutMap) ||
+            !buffer(kStaging, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                    m_stage, m_stageMem, &m_stageMap) ||
+            !buffer(2u * kVram, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                    m_rb, m_rbMem, &m_rbMap))
+            return false;
+        std::memcpy(m_lutMap, m_lut.data(), m_lut.size() * 4u);
+        // PS2X_VK_SCALE=N (1-4): internal resolution of the Vulkan renderer. Debug compare/dump modes stay at 1x.
+        if (const char *e = std::getenv("PS2X_VK_SCALE"))
+            m_scale = static_cast<uint32_t>(std::clamp(std::atoi(e), 1, 4));
+        if (std::getenv("PS2X_VK_CMP") || std::getenv("PS2X_VK_DUMP") || m_checkEvery) m_scale = 1;
+        // aux images: the render-to-texture copy (sampled by the draw shader at binding 4) and, at scale > 1, a 1x
+        // scratch image for downsampled write-backs / upsampled seeds
+        m_rttW = m_scale > 1 ? 1024u * m_scale : 1u; m_rttH = m_rttW;
+        if (!auxImage(m_rttW, m_rttH, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, m_rttImg, m_rttMem, &m_rttView))
+            return false;
+        if (m_scale > 1 && !auxImage(kScrW, kScrH, VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, m_scrImg, m_scrMem, nullptr))
+            return false;
