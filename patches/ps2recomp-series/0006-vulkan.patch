+        if (alloc > stageCap()) return false;
+        const uint32_t sbw = std::max<uint32_t>(c.bitbltbuf.sbw, 1u);
+        const uint64_t sB = static_cast<uint64_t>(c.bitbltbuf.sbp) * 256u, sE = sB + static_cast<uint64_t>(sbw) * 64u * (c.trxpos.ssay + rrh) * texBits(c.bitbltbuf.spsm) / 8u;
+        if (m_txActive && m_txBytes.size() > m_txFlushedBytes) { endRenderingLocked(); flushTxLocked(false); }
+        preUploadLocked(sB, sE);
+        if (m_stageUsed + alloc > stageHi()) { if (m_begun) submitWait(); m_stageUsed = stageLo(); }
+        ensureCompute();
+        const uint32_t at = m_stageUsed;
+        PC pc{};
+        pc.ioBitBase = at / 4u;
+        pc.firstPixel = 0; pc.count = static_cast<uint32_t>(n);
+        pc.srcBits = 32; pc.lutBase = fs.lut; pc.pw = fs.pw; pc.ph = fs.ph;
+        pc.ppr = std::max<uint32_t>(1u, sbw * 64u / fs.pw);
+        pc.baseBits = (c.bitbltbuf.sbp * 256u * 8u) & 0x1FFFFFFu;
+        pc.dsax = c.trxpos.ssax; pc.dsay = c.trxpos.ssay; pc.rrw = rrw;
