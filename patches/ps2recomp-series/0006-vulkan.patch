+        if (vkCreateImage(m_dev, &ii, nullptr, &img) != VK_SUCCESS) return false;
+        VkMemoryRequirements mr;
+        vkGetImageMemoryRequirements(m_dev, img, &mr);
+        VkPhysicalDeviceMemoryProperties mp;
+        vkGetPhysicalDeviceMemoryProperties(m_phys, &mp);
+        uint32_t idx = UINT32_MAX;
+        for (uint32_t i = 0; i < mp.memoryTypeCount; ++i)
+            if ((mr.memoryTypeBits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) { idx = i; break; }
+        VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        ai.allocationSize = mr.size; ai.memoryTypeIndex = idx;
+        if (idx == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &mem) != VK_SUCCESS) return false;
+        vkBindImageMemory(m_dev, img, mem, 0);
+        if (!view) return true;
+        VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vi.image = img; vi.viewType = VK_IMAGE_VIEW_TYPE_2D; vi.format = VK_FORMAT_R8G8B8A8_UNORM;
+        vi.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        return vkCreateImageView(m_dev, &vi, nullptr, view) == VK_SUCCESS;
+    }
+
+#include "gs_vk_render.inl"
+};
+#else
+class VkVramMirror
+{
+public:
+    bool init(VkPhysicalDevice, VkDevice, VkQueue, uint32_t) { return false; }
+    void destroy() {}
+    void beginTransfer(const GSTransferCommand &) {}
+    void loadClut(const GSTex0Reg &, const GSTexClutReg &) {}
+    void upload(const uint8_t *, uint32_t) {}
+    void draw(const GSContext &) {}
+    void disownAll() {}
+    void endFrame(GSRasterBackend *, const GSPresentationRequest * = nullptr, const PresentationFrame * = nullptr,
+                  std::vector<uint8_t> * = nullptr, uint32_t * = nullptr, uint32_t * = nullptr) {}
+    bool renderOn() const { return false; }
+    bool comparing() const { return false; }
+    void drawList(const GSDrawList &) {}
+    void drawPrim(const GSPrimitiveBatch &) {}
+};
+#endif
diff --git a/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.frag b/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.frag
new file mode 100644
index 0000000000000000000000000000000000000000..9e3c278d3fdf28e5521ce7f8071d2bc926514174
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.frag
@@ -0,0 +1,143 @@
+#version 450
+// GS draw fragment: texture fetched straight from the 4 MB VRAM buffer (swizzle LUTs), CLUT from VRAM at CBP,
+// TEXA expansion, TFX, fog, alpha test. Output colour 0..1 (=/255), alpha = As/128 (PS2 1.0 = 0x80).
+layout(std430, binding = 0) readonly buffer Vram { uint vram[]; };
+layout(std430, binding = 2) readonly buffer Lut { uint lut[]; };
+layout(binding = 4) uniform sampler2D rtTex; // scaled render-target copy (flags bit 14; pc 19 scale, 20 w|h<<16)
+layout(location = 0) in vec4 vColor;
+layout(location = 1) flat in vec4 vColorFlat;
+layout(location = 2) in vec3 vStq;
+layout(location = 3) in float vFog;
+layout(location = 0) out vec4 outColor;
+layout(push_constant) uniform PC { uint pc[32]; } p;
+// pc: 0 W, 1 H, 2 flags, 3 aref, 4 texBaseBits, 5 texPpr, 6 texPw|texPh<<16, 7 texLut, 8 texBits|texShift<<8|kind<<16,
+//     9 tw|th<<16, 10 clutBaseBits, 11 clutLut, 12 clutBits(16/32), 13 csa, 14 wms|wmt<<2, 15 minu|maxu<<16,
+//     16 minv|maxv<<16, 17 ta0|ta1<<8, 18 fog rgb
+// flags: 0 tme, 1 iip, 2 fge, 3 tcc, 4-5 tfx, 6 ate, 7-9 atst, 10-11 afail, 12 aem
+uint readPix(uint baseBits, uint ppr, uint pw, uint ph, uint lutBase, uint x, uint y, uint bits, uint shift)
+{
+    uint page = (y / ph) * ppr + (x / pw);
+    uint bit = (baseBits + page * 65536u + lut[lutBase + (y % ph) * pw + (x % pw)] + shift) & 0x1FFFFFFu;
+    uint v = vram[bit >> 5] >> (bit & 31u);
+    return bits >= 32u ? v : (v & ((1u << bits) - 1u));
+}
+vec4 c16(uint v, uint ta0, uint ta1, bool aem)
+{
+    vec3 rgb = vec3(float((v & 31u) << 3), float(((v >> 5) & 31u) << 3), float(((v >> 10) & 31u) << 3));
+    float a = ((v & 0x8000u) != 0u) ? float(ta1) : ((aem && (v & 0x7FFFu) == 0u) ? 0.0 : float(ta0));
+    return vec4(rgb, a);
+}
+vec4 c32(uint v) { return vec4(float(v & 255u), float((v >> 8) & 255u), float((v >> 16) & 255u), float(v >> 24)); }
+uint wrap(int c, uint mode, uint size, uint mn, uint mx)
+{
+    if (mode == 0u) return uint(c) & (size - 1u);
+    if (mode == 1u) return uint(clamp(c, 0, int(size) - 1));
+    if (mode == 2u) return uint(clamp(c, int(mn), int(mx)));
+    return (uint(c) & mn) | mx;
+}
+vec4 texel(int u, int v, uint flags, uint tw, uint th)
+{
+    uint x = wrap(u, p.pc[14] & 3u, tw, p.pc[15] & 0xFFFFu, p.pc[15] >> 16);
+    uint y = wrap(v, (p.pc[14] >> 2) & 3u, th, p.pc[16] & 0xFFFFu, p.pc[16] >> 16);
+    uint kind = (p.pc[8] >> 16) & 255u;
+    uint raw = readPix(p.pc[4], p.pc[5], p.pc[6] & 0xFFFFu, p.pc[6] >> 16, p.pc[7], x, y, p.pc[8] & 255u, (p.pc[8] >> 8) & 255u);
+    uint ta0 = p.pc[17] & 255u, ta1 = (p.pc[17] >> 8) & 255u;
+    bool aem = (flags & 4096u) != 0u;
+    vec4 T;
+    if (kind == 0u) T = c32(raw);
+    else if (kind == 1u) { T = c32(raw); T.a = (aem && (raw & 0xFFFFFFu) == 0u) ? 0.0 : float(ta0); }
+    else if (kind == 2u) T = c16(raw, ta0, ta1, aem);
+    else
+    {
+        uint cx, cy;
+        if (kind == 3u)
+        {
+            uint i = (raw & 0xE7u) | ((raw & 0x08u) << 1) | ((raw & 0x10u) >> 1);
+            cx = i & 15u; cy = i >> 4;
+        }
+        else { cx = raw & 7u; cy = raw >> 3; }
+        uint clutBits = p.pc[12] & 255u;
+        uint cv;
+        if ((p.pc[12] & 256u) != 0u) // CLUT-buffer snapshot (pc[10] = word index of the entry base)
+            cv = vram[p.pc[10] + ((kind == 3u) ? (raw & 255u) : (raw & 15u))] & ((clutBits >= 32u) ? 0xFFFFFFFFu : 0xFFFFu);
+        else
+            cv = readPix(p.pc[10], 1u, 64u, (clutBits == 32u) ? 32u : 64u, p.pc[11], cx, cy, clutBits, 0u);
+        T = (clutBits == 32u) ? c32(cv) : c16(cv, ta0, ta1, aem);
+    }
+    return T;
+}
+vec4 rtTexel(int x, int y, uint flags)
+{   // GS texel from the RTT image: rgb = c*255, alpha stored as A/128 -> GS 0..128
+    int S = int(p.pc[19]);
+    ivec2 lim = ivec2(int(p.pc[20] & 0xFFFFu) * S - 1, int(p.pc[20] >> 16) * S - 1);
+    vec4 c = texelFetch(rtTex, clamp(ivec2(x, y), ivec2(0), lim), 0);
+    vec4 T = vec4(floor(c.rgb * 255.0 + 0.5), floor((floor(c.a * 255.0 + 0.5) * 128.0 + 127.0) / 255.0));
+    if (((p.pc[8] >> 16) & 255u) == 1u)
+        T.a = (((flags & 4096u) != 0u) && T.r + T.g + T.b == 0.0) ? 0.0 : float(p.pc[17] & 255u);
+    return T;
+}
+void main()
+{
+    uint flags = p.pc[2];
+    vec4 F = ((flags & 2u) != 0u) ? vColor : vColorFlat;
+    F = floor(F + 0.5);
+    vec4 C = F;
+    if ((flags & 1u) != 0u)
+    {
+        uint tw = p.pc[9] & 0xFFFFu, th = p.pc[9] >> 16;
+        float q = (vStq.z == 0.0) ? 1.0 : vStq.z;
+        vec4 T;
+        float fu = vStq.x / q * float(tw), fv = vStq.y / q * float(th);
+        if ((flags & 16384u) != 0u)
+        {   // render target at N x: sample the scaled copy (sub-texel detail)
+            float S = float(p.pc[19]);
+            float hu = fu * S, hv = fv * S;
+            if ((flags & 8192u) != 0u)
+            {
+                hu -= 0.5; hv -= 0.5;
+                int u0 = int(floor(hu)), v0 = int(floor(hv));
+                float au = hu - float(u0), av = hv - float(v0);
+                vec4 t00 = rtTexel(u0, v0, flags), t10 = rtTexel(u0 + 1, v0, flags);
+                vec4 t01 = rtTexel(u0, v0 + 1, flags), t11 = rtTexel(u0 + 1, v0 + 1, flags);
+                T = floor(mix(mix(t00, t10, au), mix(t01, t11, au), av) + 0.5);
+            }
+            else
+                T = rtTexel(int(floor(hu)), int(floor(hv)), flags);
+        }
+        else if ((flags & 8192u) != 0u)
+        {   // bilinear (TEX1 MMAG/MMIN linear), GS samples texel centres: (u - 0.5, v - 0.5)
+            fu -= 0.5; fv -= 0.5;
+            int u0 = int(floor(fu)), v0 = int(floor(fv));
+            float au = fu - float(u0), av = fv - float(v0);
+            vec4 t00 = texel(u0, v0, flags, tw, th), t10 = texel(u0 + 1, v0, flags, tw, th);
+            vec4 t01 = texel(u0, v0 + 1, flags, tw, th), t11 = texel(u0 + 1, v0 + 1, flags, tw, th);
+            T = floor(mix(mix(t00, t10, au), mix(t01, t11, au), av) + 0.5);
+        }
+        else
+            T = texel(int(floor(fu)), int(floor(fv)), flags, tw, th);
+        uint tfx = (flags >> 4) & 3u;
+        bool tcc = (flags & 8u) != 0u;
+        if (tfx == 0u) { C.rgb = T.rgb * F.rgb / 128.0; C.a = tcc ? T.a * F.a / 128.0 : F.a; }
+        else if (tfx == 1u) { C.rgb = T.rgb; C.a = tcc ? T.a : F.a; }
+        else if (tfx == 2u) { C.rgb = T.rgb * F.rgb / 128.0 + F.a; C.a = tcc ? T.a + F.a : F.a; }
+        else { C.rgb = T.rgb * F.rgb / 128.0 + F.a; C.a = tcc ? T.a : F.a; }
+        C = min(floor(C), vec4(255.0));
+    }
+    if ((flags & 4u) != 0u)
+    {
+        vec3 fc = vec3(float(p.pc[18] & 255u), float((p.pc[18] >> 8) & 255u), float((p.pc[18] >> 16) & 255u));
+        float f = clamp(floor(vFog + 0.5), 0.0, 255.0);
+        C.rgb = floor((f * C.rgb + (255.0 - f) * fc) / 255.0);
+    }
+    if ((flags & 64u) != 0u)
+    {
+        uint atst = (flags >> 7) & 7u;
+        float aref = float(p.pc[3]);
+        bool pass = atst == 1u || (atst == 2u && C.a < aref) || (atst == 3u && C.a <= aref) || (atst == 4u && C.a == aref) ||
+                    (atst == 5u && C.a >= aref) || (atst == 6u && C.a > aref) || (atst == 7u && C.a != aref);
+        uint afail = (flags >> 10) & 3u;
+        if (!pass && (afail == 0u || afail == 2u))
+            discard;
+    }
+    outColor = vec4(C.rgb / 255.0, C.a / 128.0);
+}
diff --git a/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.vert b/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.vert
new file mode 100644
index 0000000000000000000000000000000000000000..3865b67b478994df520acf063bcc29d2e8026738
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.vert
@@ -0,0 +1,21 @@
+#version 450
+// GS draw vertex: pixel-space position (XYOFFSET removed), normalized depth, fog, colour (0-255), STQ.
+layout(location = 0) in vec4 inPos;   // x, y, z(0..1), fog(0..255)
+layout(location = 1) in vec4 inColor; // r, g, b, a (0..255)
+layout(location = 2) in vec4 inStq;   // s, t, q, 0
+layout(location = 0) out vec4 vColor;
+layout(location = 1) flat out vec4 vColorFlat;
+layout(location = 2) out vec3 vStq;
+layout(location = 3) out float vFog;
+layout(push_constant) uniform PC { uint pc[32]; } p;
+invariant gl_Position; // multi-pass draws (ZTST=ALWAYS then GEQUAL on the same geometry) need bit-identical depth
+void main()
+{
+    vec2 size = vec2(uintBitsToFloat(p.pc[0]), uintBitsToFloat(p.pc[1]));
+    gl_Position = vec4(inPos.x / size.x * 2.0 - 1.0, inPos.y / size.y * 2.0 - 1.0, inPos.z, 1.0);
+    gl_PointSize = 1.0;
+    vColor = inColor;
+    vColorFlat = inColor;
+    vStq = inStq.xyz;
+    vFog = inPos.w;
+}
diff --git a/ps2xRuntime/src/lib/gs/shaders/gs_vk_swizzle.comp b/ps2xRuntime/src/lib/gs/shaders/gs_vk_swizzle.comp
new file mode 100644
index 0000000000000000000000000000000000000000..9e1576659a18422b2c5071d1c4d7c97c454d45f6
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/gs_vk_swizzle.comp
@@ -0,0 +1,92 @@
+#version 450
+// PS2 GS local-memory swizzle (mode 0: host->local upload) / unswizzle (mode 1: local->linear) on a 4 MB VRAM
+// buffer. Addressing: bitAddr = base + page*65536 + lut[pageLocal(x,y)] + shift, lut generated on the CPU from
+// the runtime's own GS memory functions (one table per base layout: CT32, Z32, CT16, CT16S, Z16, Z16S, T8, T4).
+layout(local_size_x = 64) in;
+layout(std430, binding = 0) buffer Vram { uint vram[]; };
+layout(std430, binding = 1) buffer Own { uint own[]; };
+layout(std430, binding = 2) readonly buffer Lut { uint lut[]; };
+layout(std430, binding = 3) buffer Io { uint io[]; };
+layout(push_constant) uniform PC
+{
+    uint ioBitBase;  // mode 0: bit offset of the first source pixel in io[]; mode 1: word offset of output
+    uint firstPixel; // transfer-relative index of the first pixel of this dispatch
+    uint count;
+    uint srcBits;    // 32, 24, 16, 8, 4 (packed transfer pixel size)
+    uint lutBase;
+    uint pw;
+    uint ph;
+    uint ppr;        // pages per row
+    uint baseBits;   // DBP * 256 bytes * 8
+    uint dsax;
+    uint dsay;
+    uint rrw;
+    uint nbits;      // stored value width
+    uint shift;      // extra bit shift inside the slot (T8H/T4HL/T4HH)
+    uint mode;
+} pc;
+
+void main()
+{
+    uint i = gl_GlobalInvocationID.x;
+    if (i >= pc.count)
+        return;
+    if (pc.mode == 3u)
+    {   // CLUT load: buffer entry i <- CLUT memory at CBP (CSM1 layout: T4 8x2, T8 16x16 with entries 8-15/16-23 swapped)
+        uint x, y;
+        if (pc.firstPixel == 1u) { x = i & 7u; y = i >> 3; }
+        else { uint idx = (i & ~0x18u) | ((i & 0x08u) << 1) | ((i & 0x10u) >> 1); x = idx & 15u; y = idx >> 4; }
+        uint pg = (y / pc.ph) * pc.ppr + (x / pc.pw);
+        uint ba = (pc.baseBits + pg * 65536u + lut[pc.lutBase + (y % pc.ph) * pc.pw + (x % pc.pw)]) & 0x1FFFFFFu;
+        uint vm = (pc.nbits >= 32u) ? 0xFFFFFFFFu : ((1u << pc.nbits) - 1u);
+        vram[pc.ioBitBase + i] = (vram[ba >> 5] >> (ba & 31u)) & vm;
+        return;
+    }
+    uint p = pc.firstPixel + i;
+    uint x = pc.dsax + p % pc.rrw;
+    uint y = pc.dsay + p / pc.rrw;
+    uint page = (y / pc.ph) * pc.ppr + (x / pc.pw);
+    uint bitAddr = (pc.baseBits + page * 65536u + lut[pc.lutBase + (y % pc.ph) * pc.pw + (x % pc.pw)] + pc.shift) & 0x1FFFFFFu;
+    uint word = bitAddr >> 5;
+    uint sh = bitAddr & 31u;
+    uint vmask = (pc.nbits >= 32u) ? 0xFFFFFFFFu : ((1u << pc.nbits) - 1u);
+    if (pc.mode != 1u && pc.mode != 5u) // 1 = unswizzle read, 5 = target seed read; the rest write VRAM
+    {
+        uint sb = pc.ioBitBase + i * pc.srcBits;
+        uint w = sb >> 5, o = sb & 31u;
+        uint v = io[w] >> o;
+        if (o != 0u && o + pc.srcBits > 32u)
+            v |= io[w + 1u] << (32u - o);
+        if (pc.mode == 2u) // render-target write-back: RGBA8 image alpha is a/128 normalised -> GS 0..128
+            v = (v & 0x00FFFFFFu) | ((((v >> 24) * 128u + 127u) / 255u) << 24);
+        else if (pc.mode == 4u) // 16-bit target write-back: RGBA8 -> RGB5A1 (A1 set when GS alpha >= 0x80)
+            v = ((v >> 3) & 31u) | (((v >> 11) & 31u) << 5) | (((v >> 19) & 31u) << 10) | (((v >> 24) >= 255u) ? 0x8000u : 0u);
+        v &= vmask;
+        if (pc.nbits >= 32u)
+        {
+            vram[word] = v;
+            own[word] = 0xFFFFFFFFu;
+        }
+        else
+        {
+            uint m = vmask << sh;
+            atomicAnd(vram[word], ~m);
+            atomicOr(vram[word], (v << sh) & m);
+            atomicOr(own[word], m);
+        }
+    }
+    else
+    {
+        uint v = (vram[word] >> sh) & vmask;
+        if (pc.mode == 5u) // target seed: GS pixel -> RGBA8 with alpha normalised to a/128
+        {
+            if (pc.nbits == 16u)
+                v = ((v & 31u) << 3) | (((v >> 5) & 31u) << 11) | (((v >> 10) & 31u) << 19) | (((v & 0x8000u) != 0u) ? 0xFF000000u : 0u);
+            else if (pc.nbits == 24u)
+                v |= 0xFF000000u;
+            else
+                v = (v & 0x00FFFFFFu) | (min(255u, ((v >> 24) * 255u + 64u) / 128u) << 24);
+        }
+        io[pc.ioBitBase + i] = v;
+    }
+}
