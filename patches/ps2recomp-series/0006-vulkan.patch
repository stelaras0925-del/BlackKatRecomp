+#version 450
+// vk19: present post pass (PS2X_VK_AA=fxaa). Reads the displayed target region (copied to the AA image, linear
+// sampler) and writes packed RGBA8 into the present readback buffer. FXAA 3.11 style: local contrast test, edge
+// direction, edge-end search, sub-pixel blend. mode 0 = plain copy.
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(binding = 0) uniform sampler2D src;
+layout(std430, binding = 1) writeonly buffer Out { uint o[]; };
+layout(push_constant) uniform PC { uint w, h, mode; float subpix; float edgeThr; float edgeMin; } p;
+
+vec2 g_lo, g_hi;
+vec3 tex(vec2 uv) { return textureLod(src, clamp(uv, g_lo, g_hi), 0.0).rgb; }
+float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+
+void main()
+{
+    uvec2 g = gl_GlobalInvocationID.xy;
+    if (g.x >= p.w || g.y >= p.h) return;
+    vec2 rcp = 1.0 / vec2(textureSize(src, 0));
+    g_lo = 0.5 * rcp; g_hi = (vec2(p.w, p.h) - 0.5) * rcp;
+    vec2 uv = (vec2(g) + 0.5) * rcp;
+    vec4 M = texelFetch(src, ivec2(g), 0);
+    vec3 outc = M.rgb;
+    if (p.mode == 1u)
+    {
+        float lM = luma(M.rgb);
+        float lN = luma(tex(uv + vec2(0.0, -rcp.y))), lS = luma(tex(uv + vec2(0.0, rcp.y)));
+        float lW = luma(tex(uv + vec2(-rcp.x, 0.0))), lE = luma(tex(uv + vec2(rcp.x, 0.0)));
+        float lMax = max(max(lN, lS), max(lW, max(lE, lM))), lMin = min(min(lN, lS), min(lW, min(lE, lM)));
+        float range = lMax - lMin;
+        if (range >= max(p.edgeMin, lMax * p.edgeThr))
+        {
+            float lNW = luma(tex(uv + vec2(-rcp.x, -rcp.y))), lNE = luma(tex(uv + vec2(rcp.x, -rcp.y)));
+            float lSW = luma(tex(uv + vec2(-rcp.x, rcp.y))), lSE = luma(tex(uv + vec2(rcp.x, rcp.y)));
+            float lNS = lN + lS, lWE = lW + lE;
+            float eH = abs(lNW + lSW - 2.0 * lW) + 2.0 * abs(lNS - 2.0 * lM) + abs(lNE + lSE - 2.0 * lE);
+            float eV = abs(lNW + lNE - 2.0 * lN) + 2.0 * abs(lWE - 2.0 * lM) + abs(lSW + lSE - 2.0 * lS);
+            bool horz = eH >= eV;
+            float l1 = horz ? lN : lW, l2 = horz ? lS : lE;
+            float g1 = l1 - lM, g2 = l2 - lM;
+            bool steep1 = abs(g1) >= abs(g2);
+            float gS = 0.25 * max(abs(g1), abs(g2));
+            float stepLen = horz ? rcp.y : rcp.x;
+            float lAvgLocal;
+            if (steep1) { stepLen = -stepLen; lAvgLocal = 0.5 * (l1 + lM); } else lAvgLocal = 0.5 * (l2 + lM);
+            vec2 cuv = uv;
+            if (horz) cuv.y += 0.5 * stepLen; else cuv.x += 0.5 * stepLen;
+            vec2 off = horz ? vec2(rcp.x, 0.0) : vec2(0.0, rcp.y);
+            vec2 uv1 = cuv - off, uv2 = cuv + off;
+            float le1 = luma(tex(uv1)) - lAvgLocal, le2 = luma(tex(uv2)) - lAvgLocal;
+            bool r1 = abs(le1) >= gS, r2 = abs(le2) >= gS;
+            const float Q[10] = float[10](1.0, 1.0, 1.0, 1.0, 1.5, 2.0, 2.0, 2.0, 4.0, 8.0);
+            for (int i = 0; i < 10 && !(r1 && r2); ++i)
+            {
+                if (!r1) { uv1 -= off * Q[i]; le1 = luma(tex(uv1)) - lAvgLocal; r1 = abs(le1) >= gS; }
+                if (!r2) { uv2 += off * Q[i]; le2 = luma(tex(uv2)) - lAvgLocal; r2 = abs(le2) >= gS; }
+            }
+            float d1 = horz ? (uv.x - uv1.x) : (uv.y - uv1.y), d2 = horz ? (uv2.x - uv.x) : (uv2.y - uv.y);
+            bool dir1 = d1 < d2;
+            float dmin = min(d1, d2), len = d1 + d2;
+            float pixOff = -dmin / len + 0.5;
+            bool mSmaller = lM < lAvgLocal;
+            bool correct = ((dir1 ? le1 : le2) < 0.0) != mSmaller;
+            float fo = correct ? pixOff : 0.0;
+            float lAvg = (2.0 * (lNS + lWE) + lNW + lNE + lSW + lSE) / 12.0;
+            float s1 = clamp(abs(lAvg - lM) / range, 0.0, 1.0);
+            float s2 = (-2.0 * s1 + 3.0) * s1 * s1;
+            fo = max(fo, s2 * s2 * p.subpix);
+            vec2 fuv = uv;
+            if (horz) fuv.y += fo * stepLen; else fuv.x += fo * stepLen;
+            outc = tex(fuv);
+        }
+    }
+    o[g.y * p.w + g.x] = packUnorm4x8(vec4(outc, M.a));
+}
