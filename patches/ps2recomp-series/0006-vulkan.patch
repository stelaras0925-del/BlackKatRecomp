+vec4 texel(int u, int v, uint flags, uint tw, uint th);
+vec4 txFilter(float fu, float fv, uint flags, uint tw, uint th)
+{   // vk20: filter inside the sprite's texel rect; colour weighted by alpha so transparent texels don't darken edges
+    vec2 lo = vRect.xy + 0.5, hi = max(vRect.zw - 0.5, lo);
+    vec2 c = clamp(vec2(fu, fv), lo, hi) - 0.5;
+    ivec2 i = ivec2(floor(c)); vec2 f = c - vec2(i);
+    vec4 t00 = texel(i.x, i.y, flags, tw, th), t10 = texel(i.x + 1, i.y, flags, tw, th);
+    vec4 t01 = texel(i.x, i.y + 1, flags, tw, th), t11 = texel(i.x + 1, i.y + 1, flags, tw, th);
+    vec4 w = vec4((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y), (1.0 - f.x) * f.y, f.x * f.y);
+    float a = dot(w, vec4(t00.a, t10.a, t01.a, t11.a));
+    vec4 wa = w * (vec4(t00.a, t10.a, t01.a, t11.a) + 1e-3);
+    vec3 rgb = (wa.x * t00.rgb + wa.y * t10.rgb + wa.z * t01.rgb + wa.w * t11.rgb) / (wa.x + wa.y + wa.z + wa.w);
+    return floor(vec4(rgb, a) + 0.5);
+}
+vec4 bspl(float t)
+{   // uniform cubic B-spline weights for taps -1, 0, 1, 2
+    float t2 = t * t, t3 = t2 * t;
+    return vec4(1.0 - 3.0 * t + 3.0 * t2 - t3, 4.0 - 6.0 * t2 + 3.0 * t3, 1.0 + 3.0 * t + 3.0 * t2 - 3.0 * t3, t3) / 6.0;
+}
+vec4 txSharp(float fu, float fv, uint flags, uint tw, uint th, bool useRect)
+{   // vk20 "sharp" text upscale: cubic B-spline reconstruction of the glyph texels, re-thresholded against the local 2x2
+    // min/max -> smooth, crisp contours (no texel stair-steps); low-contrast areas keep the smooth reconstruction
+    vec2 lo = useRect ? vRect.xy : vec2(-1e9), hi = useRect ? vRect.zw - 1.0 : vec2(1e9);
+    vec2 c = vec2(fu, fv);
+    if (useRect) c = clamp(c, lo + 0.5, max(hi + 0.5, lo + 0.5));
+    c -= 0.5;
+    ivec2 i = ivec2(floor(c)); vec2 f = c - vec2(i);
+    vec4 wx = bspl(f.x), wy = bspl(f.y);
+    vec4 acc = vec4(0.0); vec3 accRgbA = vec3(0.0); float accA = 0.0;
+    float amn = 1e9, amx = -1e9, lmn = 1e9, lmx = -1e9; vec3 cLo = vec3(0.0);
+    const vec3 L = vec3(0.299, 0.587, 0.114);
+    for (int y = -1; y <= 2; ++y)
+        for (int x = -1; x <= 2; ++x)
+        {
+            ivec2 q = i + ivec2(x, y);
+            if (useRect) q = clamp(q, ivec2(lo), ivec2(max(hi, lo)));
+            vec4 t = texel(q.x, q.y, flags, tw, th);
+            float w = wx[x + 1] * wy[y + 1];
+            acc += w * t; accRgbA += w * (t.a + 1e-3) * t.rgb; accA += w * (t.a + 1e-3);
+            if (x >= 0 && x <= 1 && y >= 0 && y <= 1)
