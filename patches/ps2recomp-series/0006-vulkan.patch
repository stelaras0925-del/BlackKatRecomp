+            char path[512]; std::snprintf(path, sizeof(path), "%s/l2h_%llu_%x_%ux%u.bin", td, (unsigned long long)(m_rFrames + 1), c.bitbltbuf.sbp, rrw, rrh);
+            if (FILE *f = std::fopen(path, "wb")) { std::fwrite(out.data(), 4, out.size(), f); std::fclose(f); }
+        }
+        m_stageUsed = stageLo();
+        return true;
+    }
+private:
+    void flushTxLocked(bool finish = true)
+    {
+        if (!m_txActive) return;
+        const Fmt f = fmt(m_tx.bitbltbuf.dpsm);
+        const uint32_t rrw = m_tx.trxreg.rrw, rrh = m_tx.trxreg.rrh;
+        if (!f.ok || rrw == 0 || rrh == 0) { if (finish) m_txActive = false; return; }
+        const uint64_t total = static_cast<uint64_t>(rrw) * rrh;
+        const uint64_t have = std::min<uint64_t>(total, (static_cast<uint64_t>(m_txBytes.size()) * 8u) / f.srcBits);
+        if (have > m_txDone)
+        {
+            const uint64_t startBit = m_txDone * f.srcBits;
+            const uint64_t startByte = (startBit / 32u) * 4u;
+            const uint64_t endByte = std::min<uint64_t>(m_txBytes.size(), ((have * f.srcBits + 31u) / 32u) * 4u);
+            const uint32_t len = static_cast<uint32_t>(endByte - startByte);
