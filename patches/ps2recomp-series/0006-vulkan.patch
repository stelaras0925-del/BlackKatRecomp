+uint readPix(uint baseBits, uint ppr, uint pw, uint ph, uint lutBase, uint x, uint y, uint bits, uint shift)
+{
+    uint page = (y / ph) * ppr + (x / pw);
+    uint bit = (baseBits + page * 65536u + lut[lutBase + (y % ph) * pw + (x % pw)] + shift) & 0x1FFFFFFu;
+    uint v = vram[bit >> 5] >> (bit & 31u);
+    return bits >= 32u ? v : (v & ((1u << bits) - 1u));
+}
+vec4 c16(uint v, uint ta0, uint ta1, bool aem)
+{
+    vec3 rgb = vec3(float((v & 31u) << 3), float(((v >> 5) & 31u) << 3), float(((v >> 10) & 31u) << 3));
+    float a = ((v & 0x8000u) != 0u) ? float(ta1) : ((aem && (v & 0x7FFFu) == 0u) ? 0.0 : float(ta0));
+    return vec4(rgb, a);
+}
+vec4 c32(uint v) { return vec4(float(v & 255u), float((v >> 8) & 255u), float((v >> 16) & 255u), float(v >> 24)); }
+uint wrap(int c, uint mode, uint size, uint mn, uint mx)
+{
+    if (mode == 0u) return uint(c) & (size - 1u);
+    if (mode == 1u) return uint(clamp(c, 0, int(size) - 1));
+    if (mode == 2u) return uint(clamp(c, int(mn), int(mx)));
+    return (uint(c) & mn) | mx;
+}
+vec4 clutColor(uint raw, uint kind, uint ta0, uint ta1, bool aem)
+{   // CLUT entry for an indexed texel (kind 3 = T8, 4 = T4)
+    uint cx, cy;
+    if (kind == 3u)
+    {
+        uint i = (raw & 0xE7u) | ((raw & 0x08u) << 1) | ((raw & 0x10u) >> 1);
+        cx = i & 15u; cy = i >> 4;
+    }
+    else { cx = raw & 7u; cy = raw >> 3; }
