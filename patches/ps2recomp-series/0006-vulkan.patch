+//     9 tw|th<<16, 10 clutBaseBits, 11 clutLut, 12 clutBits(16/32), 13 csa, 14 wms|wmt<<2, 15 minu|maxu<<16,
+//     16 minv|maxv<<16, 17 ta0|ta1<<8, 18 fog rgb
