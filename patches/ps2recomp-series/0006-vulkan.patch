+        // runs frame N; CPU-written ring/staging memory is split into one half per slot. PS2X_VK_FRAMES=1: one slot.
+        m_two = !(std::getenv("PS2X_VK_FRAMES") && std::getenv("PS2X_VK_FRAMES")[0] == '1') && !m_checkEvery &&
+                !std::getenv("PS2X_VK_CMP") && !std::getenv("PS2X_VK_DUMP") && !(std::getenv("PS2X_VK_SYNCPRES") && std::getenv("PS2X_VK_SYNCPRES")[0] == '1');
