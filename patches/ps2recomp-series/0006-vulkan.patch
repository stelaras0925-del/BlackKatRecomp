+        const uint64_t ckey = aliasKey((uint64_t)c.frame.fbp | ((uint64_t)fbw << 9) | ((uint64_t)cpsmKey << 15), false, cOff);
+        const uint64_t zraw = (uint64_t)c.zbuf.zbp | ((uint64_t)fbw << 9) | (m_zkeyPsm ? ((uint64_t)c.zbuf.psm << 15) : 0ull);
