+        // 0x2bc0 is rendered, read back and later uploaded as a texture). PS2X_VK_HIRES_L2H=0 turns it off.
+        m_impOn = m_scale > 1 && !(std::getenv("PS2X_VK_HIRES_L2H") && std::getenv("PS2X_VK_HIRES_L2H")[0] == '0') && !s_vkNoRtt();
