+        if (m_fence) vkDestroyFence(m_dev, m_fence, nullptr);
+        if (m_pool) vkDestroyCommandPool(m_dev, m_pool, nullptr);
+        if (m_pipe) vkDestroyPipeline(m_dev, m_pipe, nullptr);
+        if (m_pl) vkDestroyPipelineLayout(m_dev, m_pl, nullptr);
+        if (m_dpool) vkDestroyDescriptorPool(m_dev, m_dpool, nullptr);
+        if (m_dsl) vkDestroyDescriptorSetLayout(m_dev, m_dsl, nullptr);
+        if (m_rttSmp) vkDestroySampler(m_dev, m_rttSmp, nullptr);
+        if (m_rttView) vkDestroyImageView(m_dev, m_rttView, nullptr);
+        for (auto im : {std::make_pair(m_rttImg, m_rttMem), std::make_pair(m_scrImg, m_scrMem)})
+        { if (im.first) vkDestroyImage(m_dev, im.first, nullptr); if (im.second) vkFreeMemory(m_dev, im.second, nullptr); }
+        m_dev = VK_NULL_HANDLE;
+        m_ok = false;
+    }
+
+    // ---- event hooks (any thread) ----
+    void beginTransfer(const GSTransferCommand &c)
+    {
+        if (!m_ok) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        flushTxLocked();
+        if (c.direction == 0u)
+        {
+            m_tx = c;
+            m_txActive = true;
+            m_txBytes.clear();
+            m_txDone = 0;
+        }
+        else if (c.direction == 2u)
+        {
+            static const bool s_l2lLog = std::getenv("PS2X_VK_L2LLOG") != nullptr; // debug: log local->local copies
+            static unsigned s_l2lN = 0;
+            if (s_l2lLog && s_l2lN < 400u)
+            {
+                ++s_l2lN;
+                std::fprintf(stderr, "[gs:vk:l2l] sbp %x sbw %u spsm %x ss %u,%u -> dbp %x dbw %u dpsm %x ds %u,%u size %ux%u\n", c.bitbltbuf.sbp, c.bitbltbuf.sbw, c.bitbltbuf.spsm,
+                             c.trxpos.ssax, c.trxpos.ssay, c.bitbltbuf.dbp, c.bitbltbuf.dbw, c.bitbltbuf.dpsm, c.trxpos.dsax, c.trxpos.dsay, c.trxreg.rrw, c.trxreg.rrh);
+            }
+            if (!localCopyLocked(c))
+                disownRectLocked(c.bitbltbuf.dbp, c.bitbltbuf.dbw, c.bitbltbuf.dpsm, c.trxpos.dsay, static_cast<uint32_t>(c.trxpos.dsay) + c.trxreg.rrh);
+        }
+    }
+    void upload(const uint8_t *d, uint32_t n)
+    {
+        if (!m_ok || !d || !n) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        if (m_txActive)
+            m_txBytes.insert(m_txBytes.end(), d, d + n);
+    }
+    void draw(const GSContext &c)
+    {
+        if (!m_ok) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        if (m_txActive && m_txBytes.size() > m_txFlushedBytes)
+            flushTxLocked(false);
+        const uint64_t k = (uint64_t)c.frame.fbp | ((uint64_t)c.frame.fbw << 9) | ((uint64_t)c.frame.psm << 16) | ((uint64_t)c.zbuf.zbp << 22) |
+                           ((uint64_t)c.zbuf.psm << 31) | ((uint64_t)(c.zbuf.zmask ? 1 : 0) << 37) | ((uint64_t)c.scissor.y0 << 38) | ((uint64_t)c.scissor.y1 << 50);
+        if (k == m_lastDrawKey && !m_ownedSinceDraw)
+            return;
+        m_lastDrawKey = k;
+        m_ownedSinceDraw = false;
+        disownRectLocked(c.frame.fbp * 32u, c.frame.fbw, c.frame.psm, c.scissor.y0, static_cast<uint32_t>(c.scissor.y1) + 1u);
+        if (!c.zbuf.zmask)
+            disownRectLocked(c.zbuf.zbp * 32u, c.frame.fbw, c.zbuf.psm, c.scissor.y0, static_cast<uint32_t>(c.scissor.y1) + 1u);
+    }
+    void disownAll()
+    {
+        if (!m_ok) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        flushTxLocked(false);
+        ensureCompute();
+        vkCmdFillBuffer(m_cmd, m_own, 0, VK_WHOLE_SIZE, 0u);
+        barrier();
+        for (auto &o : m_pageOwned) o = 0;
+    }
+    // At present: submit everything; optionally compare with the reference VRAM.
+    void endFrame(GSRasterBackend *ref, const GSPresentationRequest *req = nullptr, const PresentationFrame *frame = nullptr,
+                  std::vector<uint8_t> *vkPix = nullptr, uint32_t *vkW = nullptr, uint32_t *vkH = nullptr)
+    {
+        if (!m_ok) return;
+        std::lock_guard<std::mutex> lk(m_m);
+        waitInFlight();
+        flushTxLocked(false);
+        endRenderingLocked();
+        ++m_frames;
+        uint32_t pw = 0, ph = 0, srcW = 0;
+        static const bool s_syncPres = std::getenv("PS2X_VK_SYNCPRES") && std::getenv("PS2X_VK_SYNCPRES")[0] == '1';
