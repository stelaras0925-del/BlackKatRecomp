+    }
+    void probePrint()
+    {
+        for (size_t s = 0; s < m_probe.size(); ++s)
+        {
+            const uint8_t *im = static_cast<const uint8_t *>(m_rbMap) + s * 20480u;
+            double r = 0, g = 0, b = 0;
+            for (uint32_t i = 0; i < 640u * 8u; ++i) { r += im[i * 4]; g += im[i * 4 + 1]; b += im[i * 4 + 2]; }
+            const double k = 1.0 / (640.0 * 8.0);
+            std::fprintf(stderr, "[gs:vk:probe] f%llu ckey %llx n%u test %llx top %.0f,%.0f,%.0f\n", m_probe[s].f, m_probe[s].ckey, m_probe[s].n, m_probe[s].test, r * k, g * k, b * k);
+        }
+        m_probe.clear();
+    }
+    void spriteDumpLocked(const char *tag = "")
