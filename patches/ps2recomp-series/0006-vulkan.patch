+                vec4 t00 = rtTexel(u0, v0, flags), t10 = rtTexel(u0 + 1, v0, flags);
+                vec4 t01 = rtTexel(u0, v0 + 1, flags), t11 = rtTexel(u0 + 1, v0 + 1, flags);
+                T = floor(mix(mix(t00, t10, au), mix(t01, t11, au), av) + 0.5);
+            }
+            else
+                T = rtTexel(int(floor(hu)), int(floor(hv)), flags);
+        }
+        else if ((flags & 32768u) != 0u && vRect.z > vRect.x)
+            T = ((flags & 65536u) != 0u) ? txSharp(fu, fv, flags, tw, th, true) : txFilter(fu, fv, flags, tw, th);
+        else if ((flags & 98304u) == 98304u && (flags & 8192u) != 0u)
+            T = txSharp(fu, fv, flags, tw, th, false);
+        else if ((flags & 8192u) != 0u)
+        {   // bilinear (TEX1 MMAG/MMIN linear), GS samples texel centres: (u - 0.5, v - 0.5)
+            fu -= 0.5; fv -= 0.5;
+            int u0 = int(floor(fu)), v0 = int(floor(fv));
+            float au = fu - float(u0), av = fv - float(v0);
+            vec4 t00 = texel(u0, v0, flags, tw, th), t10 = texel(u0 + 1, v0, flags, tw, th);
+            vec4 t01 = texel(u0, v0 + 1, flags, tw, th), t11 = texel(u0 + 1, v0 + 1, flags, tw, th);
+            T = floor(mix(mix(t00, t10, au), mix(t01, t11, au), av) + 0.5);
+        }
+        else
+            T = texel(int(floor(fu)), int(floor(fv)), flags, tw, th);
+        uint tfx = (flags >> 4) & 3u;
+        bool tcc = (flags & 8u) != 0u;
+        if (tfx == 0u) { C.rgb = T.rgb * F.rgb / 128.0; C.a = tcc ? T.a * F.a / 128.0 : F.a; }
+        else if (tfx == 1u) { C.rgb = T.rgb; C.a = tcc ? T.a : F.a; }
+        else if (tfx == 2u) { C.rgb = T.rgb * F.rgb / 128.0 + F.a; C.a = tcc ? T.a + F.a : F.a; }
+        else { C.rgb = T.rgb * F.rgb / 128.0 + F.a; C.a = tcc ? T.a : F.a; }
+        C = min(floor(C), vec4(255.0));
+    }
+    if ((flags & 4u) != 0u)
+    {
+        vec3 fc = vec3(float(p.pc[18] & 255u), float((p.pc[18] >> 8) & 255u), float((p.pc[18] >> 16) & 255u));
+        float f = clamp(floor(vFog + 0.5), 0.0, 255.0);
+        C.rgb = floor((f * C.rgb + (255.0 - f) * fc) / 255.0);
+    }
+    if ((flags & 64u) != 0u)
+    {
+        uint atst = (flags >> 7) & 7u;
+        float aref = float(p.pc[3]);
+        bool pass = atst == 1u || (atst == 2u && C.a < aref) || (atst == 3u && C.a <= aref) || (atst == 4u && C.a == aref) ||
+                    (atst == 5u && C.a >= aref) || (atst == 6u && C.a > aref) || (atst == 7u && C.a != aref);
+        uint afail = (flags >> 10) & 3u;
+        if (!pass && (afail == 0u || afail == 2u))
+            discard;
+    }
+    outColor = vec4(C.rgb / 255.0, C.a / 128.0);
+}
diff --git a/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.vert b/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.vert
new file mode 100644
index 0000000000000000000000000000000000000000..e0c8b7073174fe85607979eebbd9eb28d2346fcf
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/gs_vk_draw.vert
@@ -0,0 +1,24 @@
+#version 450
+// GS draw vertex: pixel-space position (XYOFFSET removed), normalized depth, fog, colour (0-255), STQ.
+layout(location = 0) in vec4 inPos;   // x, y, z(0..1), fog(0..255)
+layout(location = 1) in vec4 inColor; // r, g, b, a (0..255)
+layout(location = 2) in vec4 inStq;   // s, t, q, 0
+layout(location = 3) in vec4 inRect;  // vk20: sprite texel rect lo.uv, hi.uv (text filter)
+layout(location = 4) flat out vec4 vRect;
+layout(location = 0) out vec4 vColor;
+layout(location = 1) flat out vec4 vColorFlat;
+layout(location = 2) out vec3 vStq;
+layout(location = 3) out float vFog;
+layout(push_constant) uniform PC { uint pc[32]; } p;
+invariant gl_Position; // multi-pass draws (ZTST=ALWAYS then GEQUAL on the same geometry) need bit-identical depth
+void main()
+{
+    vec2 size = vec2(uintBitsToFloat(p.pc[0]), uintBitsToFloat(p.pc[1]));
+    gl_Position = vec4(inPos.x / size.x * 2.0 - 1.0, inPos.y / size.y * 2.0 - 1.0, inPos.z, 1.0);
+    gl_PointSize = 1.0;
+    vColor = inColor;
+    vColorFlat = inColor;
+    vStq = inStq.xyz;
+    vFog = inPos.w;
+    vRect = inRect;
+}
diff --git a/ps2xRuntime/src/lib/gs/shaders/gs_vk_swizzle.comp b/ps2xRuntime/src/lib/gs/shaders/gs_vk_swizzle.comp
new file mode 100644
index 0000000000000000000000000000000000000000..9e1576659a18422b2c5071d1c4d7c97c454d45f6
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/shaders/gs_vk_swizzle.comp
@@ -0,0 +1,92 @@
+#version 450
+// PS2 GS local-memory swizzle (mode 0: host->local upload) / unswizzle (mode 1: local->linear) on a 4 MB VRAM
+// buffer. Addressing: bitAddr = base + page*65536 + lut[pageLocal(x,y)] + shift, lut generated on the CPU from
+// the runtime's own GS memory functions (one table per base layout: CT32, Z32, CT16, CT16S, Z16, Z16S, T8, T4).
+layout(local_size_x = 64) in;
+layout(std430, binding = 0) buffer Vram { uint vram[]; };
+layout(std430, binding = 1) buffer Own { uint own[]; };
+layout(std430, binding = 2) readonly buffer Lut { uint lut[]; };
+layout(std430, binding = 3) buffer Io { uint io[]; };
+layout(push_constant) uniform PC
+{
+    uint ioBitBase;  // mode 0: bit offset of the first source pixel in io[]; mode 1: word offset of output
+    uint firstPixel; // transfer-relative index of the first pixel of this dispatch
+    uint count;
+    uint srcBits;    // 32, 24, 16, 8, 4 (packed transfer pixel size)
+    uint lutBase;
+    uint pw;
+    uint ph;
+    uint ppr;        // pages per row
+    uint baseBits;   // DBP * 256 bytes * 8
+    uint dsax;
+    uint dsay;
+    uint rrw;
+    uint nbits;      // stored value width
+    uint shift;      // extra bit shift inside the slot (T8H/T4HL/T4HH)
+    uint mode;
+} pc;
+
+void main()
+{
+    uint i = gl_GlobalInvocationID.x;
+    if (i >= pc.count)
+        return;
+    if (pc.mode == 3u)
+    {   // CLUT load: buffer entry i <- CLUT memory at CBP (CSM1 layout: T4 8x2, T8 16x16 with entries 8-15/16-23 swapped)
+        uint x, y;
+        if (pc.firstPixel == 1u) { x = i & 7u; y = i >> 3; }
+        else { uint idx = (i & ~0x18u) | ((i & 0x08u) << 1) | ((i & 0x10u) >> 1); x = idx & 15u; y = idx >> 4; }
+        uint pg = (y / pc.ph) * pc.ppr + (x / pc.pw);
+        uint ba = (pc.baseBits + pg * 65536u + lut[pc.lutBase + (y % pc.ph) * pc.pw + (x % pc.pw)]) & 0x1FFFFFFu;
+        uint vm = (pc.nbits >= 32u) ? 0xFFFFFFFFu : ((1u << pc.nbits) - 1u);
+        vram[pc.ioBitBase + i] = (vram[ba >> 5] >> (ba & 31u)) & vm;
+        return;
+    }
+    uint p = pc.firstPixel + i;
+    uint x = pc.dsax + p % pc.rrw;
+    uint y = pc.dsay + p / pc.rrw;
+    uint page = (y / pc.ph) * pc.ppr + (x / pc.pw);
+    uint bitAddr = (pc.baseBits + page * 65536u + lut[pc.lutBase + (y % pc.ph) * pc.pw + (x % pc.pw)] + pc.shift) & 0x1FFFFFFu;
+    uint word = bitAddr >> 5;
+    uint sh = bitAddr & 31u;
+    uint vmask = (pc.nbits >= 32u) ? 0xFFFFFFFFu : ((1u << pc.nbits) - 1u);
+    if (pc.mode != 1u && pc.mode != 5u) // 1 = unswizzle read, 5 = target seed read; the rest write VRAM
+    {
+        uint sb = pc.ioBitBase + i * pc.srcBits;
+        uint w = sb >> 5, o = sb & 31u;
+        uint v = io[w] >> o;
+        if (o != 0u && o + pc.srcBits > 32u)
+            v |= io[w + 1u] << (32u - o);
+        if (pc.mode == 2u) // render-target write-back: RGBA8 image alpha is a/128 normalised -> GS 0..128
+            v = (v & 0x00FFFFFFu) | ((((v >> 24) * 128u + 127u) / 255u) << 24);
+        else if (pc.mode == 4u) // 16-bit target write-back: RGBA8 -> RGB5A1 (A1 set when GS alpha >= 0x80)
+            v = ((v >> 3) & 31u) | (((v >> 11) & 31u) << 5) | (((v >> 19) & 31u) << 10) | (((v >> 24) >= 255u) ? 0x8000u : 0u);
+        v &= vmask;
+        if (pc.nbits >= 32u)
+        {
+            vram[word] = v;
+            own[word] = 0xFFFFFFFFu;
+        }
+        else
+        {
+            uint m = vmask << sh;
+            atomicAnd(vram[word], ~m);
+            atomicOr(vram[word], (v << sh) & m);
+            atomicOr(own[word], m);
+        }
+    }
+    else
+    {
+        uint v = (vram[word] >> sh) & vmask;
+        if (pc.mode == 5u) // target seed: GS pixel -> RGBA8 with alpha normalised to a/128
+        {
+            if (pc.nbits == 16u)
+                v = ((v & 31u) << 3) | (((v >> 5) & 31u) << 11) | (((v >> 10) & 31u) << 19) | (((v & 0x8000u) != 0u) ? 0xFF000000u : 0u);
+            else if (pc.nbits == 24u)
+                v |= 0xFF000000u;
+            else
+                v = (v & 0x00FFFFFFu) | (min(255u, ((v >> 24) * 255u + 64u) / 128u) << 24);
+        }
+        io[pc.ioBitBase + i] = v;
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_vk_font.inl b/ps2xRuntime/src/lib/gs/gs_vk_font.inl
new file mode 100644
index 0000000000000000000000000000000000000000..4f0f41808c086852a54442839fe68f93919beb7c
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_vk_font.inl
@@ -0,0 +1,316 @@
+// vk21: vector replacement for the game's front-end menu font (Vulkan renderer). #included inside class VkVramMirror.
+// PS2X_VK_FONT=imfell|off (default off; launcher Remaster row "Original font / IM FELL", config menu_font).
+// Asset: assets/fonts/<name>_menu.p2f, made by tools/gen_menu_font.py from an OFL TrueType font and the game's FNTS
+// glyph table: an RG8 atlas pre-rendered at K x (R = fill, G = fill + outline) plus, per glyph, the original atlas
+// rect (u, v, w, h, xoff, yoff) and the replacement quad relative to the pen / line top.
+// Detection: the 512x512 PSMT4 atlas upload is hashed (ps2x_texrep::hash64 of the upload bytes) and must match the
+// asset; any later upload, local copy or draw over that memory turns the replacement off until the next matching
+// upload. Draws: textured triangles with that TEX0 (TBP, PSMT4 512x512, CBP = TBP + asset offset) whose two-triangle
+// glyph quads map to a table entry are redrawn at the new glyph's quad, sampling the hi-res atlas (trilinear, any
+// internal scale). The CLUT outline / fill colours, the vertex gradient (affine, extended over the new quad) and the
+// game's +3,+3 shadow pass are kept; anything that does not map draws as before. Shader: flags bit 17, pc[21],
+// binding 5. Missing / bad asset or no hash match: the original font, logged once as [gs:vk:font].
+private:
+    struct FontGlyph { uint16_t code, ou, ov, ow, oh; int16_t xo, yo, adv; float nx0, ny0, nw, nh; uint16_t ax, ay, aw, ah; };
+    struct FontAsset
+    {
+        bool ok = false;
+        std::string path;
+        uint32_t aw = 0, ah = 0, tw = 512, th = 512, idx = 0, cbpOff = 0, mips = 1;
+        uint64_t hash = 0;
+        std::vector<FontGlyph> g;
+        std::unordered_map<uint32_t, uint32_t> byUv; // (u << 16 | v) of the original quad -> glyph
+        std::vector<uint8_t> pix;                    // all mip levels, RG8
+        std::vector<uint32_t> mipOff;
+    };
+    FontAsset m_font;
+    VkImage m_fontImg = VK_NULL_HANDLE; VkDeviceMemory m_fontMem = VK_NULL_HANDLE; VkImageView m_fontView = VK_NULL_HANDLE; VkSampler m_fontSmp = VK_NULL_HANDLE;
+    bool m_fontValid = false, m_fontTx = false;
+    uint32_t m_fontTbp = 0, m_fontTxDbp = 0, m_fontTxN = 0, m_fontTailN = 0;
+    uint64_t m_fontH = 0, m_fontHits = 0, m_fontMiss = 0, m_fontPendB = 0, m_fontPendE = 0;
+    uint8_t m_fontTail[8]{};
+
+    static std::string fontFind()
+    {
+        const char *e = std::getenv("PS2X_VK_FONT");
+        if (!e || !e[0]) return {};
+        std::string v(e);
+        if (v == "off" || v == "0" || v == "original") return {};
+        if (v == "1" || v == "on" || v == "hd" || v == "vector" || v == "original_hd") v = "imfell";
+        const std::string file = v + "_menu.p2f";
+        namespace fs = std::filesystem;
+        std::error_code ec;
+        std::vector<fs::path> dirs;
+        if (const char *d = std::getenv("PS2X_VK_FONT_DIR")) dirs.emplace_back(d);
+        fs::path exe = fs::read_symlink("/proc/self/exe", ec);
+        if (!ec)
+            for (fs::path d = exe.parent_path(); !d.empty() && dirs.size() < 8; d = d.parent_path())
+            {
+                dirs.push_back(d / "assets" / "fonts");
+                if (d == d.root_path()) break;
+            }
+        dirs.push_back(fs::current_path(ec) / "assets" / "fonts");
+        for (const fs::path &d : dirs)
+            if (fs::is_regular_file(d / file, ec)) return (d / file).string();
+        std::fprintf(stderr, "[gs:vk:font] PS2X_VK_FONT=%s: %s not found (assets/fonts next to the executable's parents, the cwd, or PS2X_VK_FONT_DIR); original font\n", e, file.c_str());
+        return {};
+    }
+
+    bool fontLoad()
+    {
+        const std::string path = fontFind();
+        if (path.empty()) return false;
+        std::ifstream f(path, std::ios::binary);
+        std::vector<uint8_t> d((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+        auto bad = [&](const char *why) { std::fprintf(stderr, "[gs:vk:font] %s: %s; original font\n", path.c_str(), why); m_font = FontAsset{}; return false; };
+        size_t at = 0;
+        auto rd = [&](void *dst, size_t n) { if (at + n > d.size()) return false; std::memcpy(dst, d.data() + at, n); at += n; return true; };
+        char magic[8]; uint32_t ver = 0, n = 0; float k = 0, base = 0;
+        if (!rd(magic, 8) || std::memcmp(magic, "P2XFONT1", 8) != 0 || !rd(&ver, 4) || ver != 1u) return bad("not a P2XFONT1 v1 file");
+        FontAsset &A = m_font;
+        if (!rd(&A.aw, 4) || !rd(&A.ah, 4) || !rd(&n, 4) || !rd(&A.hash, 8) || !rd(&A.tw, 4) || !rd(&A.th, 4) || !rd(&A.idx, 4) || !rd(&A.cbpOff, 4) || !rd(&k, 4) || !rd(&base, 4))
+            return bad("short header");
+        if (A.aw == 0 || A.ah == 0 || A.aw > 8192 || A.ah > 8192 || n == 0 || n > 4096 || A.tw != 512 || A.th != 512) return bad("bad header");
+        A.g.resize(n);
+        for (uint32_t i = 0; i < n; ++i)
+        {
+            FontGlyph &g = A.g[i];
+            if (!rd(&g.code, 2) || !rd(&g.ou, 2) || !rd(&g.ov, 2) || !rd(&g.ow, 2) || !rd(&g.oh, 2) || !rd(&g.xo, 2) || !rd(&g.yo, 2) || !rd(&g.adv, 2) ||
+                !rd(&g.nx0, 4) || !rd(&g.ny0, 4) || !rd(&g.nw, 4) || !rd(&g.nh, 4) || !rd(&g.ax, 2) || !rd(&g.ay, 2) || !rd(&g.aw, 2) || !rd(&g.ah, 2))
+                return bad("short glyph table");
+            if (static_cast<uint32_t>(g.ax) + g.aw > A.aw || static_cast<uint32_t>(g.ay) + g.ah > A.ah) return bad("glyph outside the atlas");
+            A.byUv[(static_cast<uint32_t>(g.ou) << 16) | g.ov] = i;
+        }
+        uint32_t clen = 0;
+        if (!rd(&clen, 4) || at + clen > d.size()) return bad("short pixel data");
+        const size_t L0 = static_cast<size_t>(A.aw) * A.ah * 2u;
+        A.pix.reserve(L0 + L0 / 3u + 64u);
+        A.pix.resize(L0);
+        size_t o = 0; const uint8_t *p = d.data() + at, *pe = p + clen;
+        while (p < pe && o < L0)
+        {   // PackBits: 0..127 = copy n+1 bytes, 128..255 = repeat the next byte n-126 times
+            const uint8_t c = *p++;
+            if (c < 128u) { const size_t m = std::min<size_t>(c + 1u, std::min<size_t>(pe - p, L0 - o)); std::memcpy(&A.pix[o], p, m); p += m; o += m; }
+            else if (p < pe) { const size_t m = std::min<size_t>(c - 126u, L0 - o); std::memset(&A.pix[o], *p++, m); o += m; }
+        }
+        if (o != L0) return bad("pixel data does not decode to the atlas size");
+        // mip chain (2x2 box), down to 1/16 of K x (enough below 1x internal scale)
+        A.mipOff.push_back(0);
+        uint32_t w = A.aw, h = A.ah;
+        while (A.mips < 5u && w > 1u && h > 1u)
+        {
+            const uint32_t nw = std::max(1u, w / 2u), nh = std::max(1u, h / 2u);
+            const size_t src = A.mipOff.back(), dst = A.pix.size();
+            A.pix.resize(dst + static_cast<size_t>(nw) * nh * 2u);
+            for (uint32_t y = 0; y < nh; ++y)
+                for (uint32_t x = 0; x < nw; ++x)
+                    for (uint32_t ch = 0; ch < 2; ++ch)
+                    {
+                        auto at2 = [&](uint32_t xx, uint32_t yy) { return (uint32_t)A.pix[src + (static_cast<size_t>(std::min(yy, h - 1u)) * w + std::min(xx, w - 1u)) * 2u + ch]; };
+                        A.pix[dst + (static_cast<size_t>(y) * nw + x) * 2u + ch] = static_cast<uint8_t>((at2(2 * x, 2 * y) + at2(2 * x + 1, 2 * y) + at2(2 * x, 2 * y + 1) + at2(2 * x + 1, 2 * y + 1) + 2u) / 4u);
+                    }
+            A.mipOff.push_back(static_cast<uint32_t>(dst));
+            w = nw; h = nh; ++A.mips;
+        }
+        if (A.pix.size() > kStaging) return bad("atlas larger than the staging buffer");
+        A.ok = true; A.path = path;
+        std::fprintf(stderr, "[gs:vk:font] %s: %u glyphs, atlas %ux%u at %.0fx (%u mips), waiting for the menu atlas upload (hash %016llx)\n",
+                     path.c_str(), n, A.aw, A.ah, (double)k, A.mips, (unsigned long long)A.hash);
+        return true;
+    }
+
+    // Image + view + sampler (a 1x1 dummy without an asset, so binding 5 is always valid). Before the descriptor writes.
+    bool fontCreate()
+    {
+        fontLoad();
+        const uint32_t w = m_font.ok ? m_font.aw : 1u, h = m_font.ok ? m_font.ah : 1u, mips = m_font.ok ? m_font.mips : 1u;
+        VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ii.imageType = VK_IMAGE_TYPE_2D; ii.format = VK_FORMAT_R8G8_UNORM; ii.extent = {w, h, 1};
+        ii.mipLevels = mips; ii.arrayLayers = 1; ii.samples = VK_SAMPLE_COUNT_1_BIT; ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ii.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        if (vkCreateImage(m_dev, &ii, nullptr, &m_fontImg) != VK_SUCCESS) return false;
+        VkMemoryRequirements mr;
+        vkGetImageMemoryRequirements(m_dev, m_fontImg, &mr);
+        VkPhysicalDeviceMemoryProperties mp;
+        vkGetPhysicalDeviceMemoryProperties(m_phys, &mp);
+        uint32_t idx = UINT32_MAX;
+        for (uint32_t i = 0; i < mp.memoryTypeCount; ++i)
+            if ((mr.memoryTypeBits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) { idx = i; break; }
+        VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        ai.allocationSize = mr.size; ai.memoryTypeIndex = idx;
+        if (idx == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &m_fontMem) != VK_SUCCESS) return false;
+        vkBindImageMemory(m_dev, m_fontImg, m_fontMem, 0);
+        VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vi.image = m_fontImg; vi.viewType = VK_IMAGE_VIEW_TYPE_2D; vi.format = VK_FORMAT_R8G8_UNORM;
+        vi.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, mips, 0, 1};
+        if (vkCreateImageView(m_dev, &vi, nullptr, &m_fontView) != VK_SUCCESS) return false;
+        VkSamplerCreateInfo sci{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+        sci.magFilter = sci.minFilter = VK_FILTER_LINEAR;
+        sci.mipmapMode = VK_SAMPLER_MIPMAP_MODE_LINEAR;
+        sci.addressModeU = sci.addressModeV = sci.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        sci.maxLod = static_cast<float>(mips);
+        return vkCreateSampler(m_dev, &sci, nullptr, &m_fontSmp) == VK_SUCCESS;
+    }
+    // Recorded into the init command buffer (staging is unused then): pixels -> image, then SHADER_READ_ONLY.
+    void fontRecordUpload()
+    {
+        if (!m_fontImg) return;
+        const uint32_t mips = m_font.ok ? m_font.mips : 1u;
+        VkImageMemoryBarrier ib{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+        ib.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        ib.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED; ib.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+        ib.srcQueueFamilyIndex = ib.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        ib.image = m_fontImg; ib.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, mips, 0, 1};
