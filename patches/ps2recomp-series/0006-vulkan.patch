+public:
+    // vk17: GS -> host transfer (TRXDIR 1) served from the mirror. Drawn targets over the source are written back,
+    // the rect is unswizzled into staging (compute mode 1, as for local -> local) and read after a wait. out gets one
+    // 32-bit word per pixel, the raw value ReadVram would return. Call after beginTransfer(c).
+    bool readRect(const GSTransferCommand &c, std::vector<uint32_t> &out)
+    {
+        if (!m_ok || !m_rOn) return false;
