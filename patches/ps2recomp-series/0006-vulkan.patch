+        if (st.prim.tme && c.tex0.tbp0 == 0x8c0u && (c.frame.psm == GS_PSM_CT16 || c.frame.psm == GS_PSM_CT16S)) spriteDumpLocked();
+        const uint32_t fbw = std::max<uint32_t>(c.frame.fbw, 1u);
