diff --git a/ps2xRuntime/include/runtime/gs/gs_backend.h b/ps2xRuntime/include/runtime/gs/gs_backend.h
index 3f00d01b5f4c6ba0cf2c2dd4bfab1cdc46391480..d8f14a1b6bfe37613fc73d5c5ff52b3fbf318238 100644
--- a/ps2xRuntime/include/runtime/gs/gs_backend.h
+++ b/ps2xRuntime/include/runtime/gs/gs_backend.h
@@ -3,8 +3,105 @@
 #include "runtime/gs/gs_types.h"
 
 #include <cstdint>
+#include <memory>
 #include <vector>
 
+// ---- Phase 2 draw list -------------------------------------------------------------------------------------
+// A run of primitives in GIF chain order that share one complete GSDrawState (the frontend opens a new batch on
+// ANY state difference, so replaying it through Submit() is bit-identical to per-primitive submission).
+// Non-draw backend calls (LoadClut, BeginTransfer, UploadImage, Flush, Sync, Present, ClearFramebuffer, ReadVram,
+// ...) are ordering points: the frontend submits the pending list before making any of them.
+struct GSDrawListBatch
+{
+    GSDrawState state{};
+    uint32_t firstVertex = 0;  // into GSDrawList::vertices
+    uint32_t primCount = 0;
+    uint8_t vertsPerPrim = 3;  // 1 point, 2 line/sprite, 3 triangle (strips/fans are already expanded)
+    uint8_t path = 0;          // GIF path (g_ps2xGifCurPath)
+    uint8_t flags = 0;         // GSDrawListBatchFlags
+    uint8_t reserved = 0;
+    uint32_t tag = 0;          // Phase 0a draw tag (bit31 tagged, prog = tag & 0x7FF, em = (tag >> 11) & 0xFF)
+    uint32_t clutGen = 0;      // bumped by every CLUT load; part of the texture identity
+    int32_t bbox[4] = {0, 0, 0, 0}; // x0, y0, x1, y1 in frame pixels (after XYOFFSET), inclusive
+};
+
+enum GSDrawListBatchFlags : uint8_t
+{
+    kGSBatchSamplesTarget = 1u << 0, // texture pages overlap a target written since the last present (RTT)
+    kGSBatchFeedback = 1u << 1,      // texture pages overlap this batch's own FRAME/ZBUF (needs barrier/copy)
+    kGSBatchHud = 1u << 2,           // marked by the wshud rules
+};
+
+enum class GSDrawListCut : uint8_t
+{
+    None,
+    Full,      // vertex arena limit
+    Transfer,  // host->local upload / FMV
+    Readback,  // local->host
+    LocalCopy, // local->local
+    Clut,
+    TexFlush,
+    Finish,
+    Present,
+    Clear,
+    Sync,
+    Reset,
+};
+
+struct GSDrawList
+{
+    std::vector<GSVertex> vertices;
+    std::vector<GSDrawListBatch> batches;
+    uint64_t listId = 0;  // monotonically increasing
+    uint64_t frameId = 0; // present interval the list belongs to
+    GSDrawListCut cut = GSDrawListCut::None; // why the list was submitted
+
+    bool empty() const { return batches.empty(); }
+    void clear()
+    {
+        vertices.clear();
+        batches.clear();
+        cut = GSDrawListCut::None;
+    }
+};
+
+// ---- backend identity / host presentation -------------------------------------------------------------------
+enum class GSBackendKind : uint8_t
+{
+    Cpu,
+    CpuThreaded,
+    OpenGL,
+    Vulkan,
+};
+
+enum GSBackendCaps : uint32_t
+{
+    kGSCapDrawList = 1u << 0,      // SubmitList is native (not the per-primitive replay)
+    kGSCapGpu = 1u << 1,           // renders on the GPU (VRAM mirror kept in sync on readback)
+    kGSCapNativePresent = 1u << 2, // can present to a host window itself (AttachHostPresentTarget/PresentNative)
+    kGSCapUpscale = 1u << 3,       // honours SetResolutionScale
+    kGSCapAsyncReadback = 1u << 4, // local->host readbacks do not stall the producer
+};
+
+// Native window the host presenter owns; filled by the host layer for backends with kGSCapNativePresent.
+struct GSHostPresentTarget
+{
+    enum Platform : uint32_t
+    {
+        None = 0,
+        X11 = 1,     // display = Display*, window = Window (as uintptr)
+        Wayland = 2, // display = wl_display*, window = wl_surface*
+        Win32 = 3,   // display = HINSTANCE, window = HWND
+        Android = 4, // window = ANativeWindow*
+    };
+    uint32_t platform = None;
+    void *display = nullptr;
+    void *window = nullptr;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    bool vsync = true;
+};
+
 class GSRasterBackend
 {
 public:
@@ -31,4 +128,46 @@ public:
     virtual void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) = 0;
     virtual void SnapshotVram(std::vector<uint8_t> &out) const = 0;
     virtual GSTransferSnapshot GetTransferSnapshot() const = 0;
+
+    // ---- Phase 2/3 extensions (all have defaults, so existing backends are unchanged) ------------------------
+    // Draw list: default replays every primitive through Submit() in order.
+    virtual void SubmitList(const GSDrawList &list)
+    {
+        for (const GSDrawListBatch &b : list.batches)
+        {
+            GSPrimitiveBatch prim{};
+            prim.state = b.state;
+            prim.vertexCount = b.vertsPerPrim;
+            const uint32_t n = b.vertsPerPrim > 3u ? 3u : b.vertsPerPrim;
+            for (uint32_t p = 0; p < b.primCount; ++p)
+            {
+                const size_t base = static_cast<size_t>(b.firstVertex) + static_cast<size_t>(p) * b.vertsPerPrim;
+                if (base + n > list.vertices.size())
+                    break;
+                for (uint32_t v = 0; v < n; ++v)
+                    prim.vertices[v] = list.vertices[base + v];
+                Submit(prim);
+            }
+        }
+    }
+    virtual GSBackendKind Kind() const { return GSBackendKind::Cpu; }
+    virtual const char *Name() const { return "cpu"; }
+    virtual uint32_t Capabilities() const { return 0u; }
+    // Native presentation (swapchain on the host window). Return false = not supported, host keeps using pixels.
+    virtual bool AttachHostPresentTarget(const GSHostPresentTarget &target) { (void)target; return false; }
+    virtual void DetachHostPresentTarget() {}
+    virtual void ResizeHostPresentTarget(uint32_t width, uint32_t height) { (void)width; (void)height; }
+    // Internal resolution multiplier for GPU backends (1 = native PS2 resolution).
+    virtual void SetResolutionScale(uint32_t scale) { (void)scale; }
+    // Called once per host frame after presentation (stats, deferred deletion, pipeline-cache saves).
+    virtual void OnHostFrameEnd(uint64_t frameId) { (void)frameId; }
+    // Free-form debug/diagnostic hook (e.g. "stats", "capture"); returns true if handled.
+    virtual bool DebugCommand(const char *command) { (void)command; return false; }
 };
+
+// Backend selection: PS2X_GS_BACKEND=cpu|gl|vulkan (PS2X_GS_GPU=1 still means gl). Vulkan factory is defined in
+// gs_vk_backend.cpp; it returns nullptr (and leaves `inner` untouched) when Vulkan is unavailable or fails.
+// On success it takes ownership of `inner` (used as the VRAM-accurate reference until the Vulkan renderer is
+// complete).
+std::unique_ptr<GSRasterBackend> gsCreateVulkanBackend(std::unique_ptr<GSRasterBackend> &inner);
+bool gsVulkanCompiledIn();
