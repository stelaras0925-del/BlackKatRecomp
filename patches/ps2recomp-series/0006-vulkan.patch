+        const float ex = v[1].x - v[0].x, ey = v[1].y - v[0].y, fx = v[2].x - v[0].x, fy = v[2].y - v[0].y, det = ex * fy - fx * ey;
+        for (int i = 0; i < 3; ++i)
+        {
+            nv[i] = v[i];
+            nv[i].x = cx[i] ? X1 : X0; nv[i].y = cy[i] ? Y1 : Y0;
+            ns[i] = (cx[i] ? static_cast<float>(g.ax + g.aw) : static_cast<float>(g.ax)) / m_font.aw;
+            nt[i] = (cy[i] ? static_cast<float>(g.ay + g.ah) : static_cast<float>(g.ay)) / m_font.ah;
+            if (iip && std::fabs(det) > 1e-6f)
+            {
+                const float px = nv[i].x - v[0].x, py = nv[i].y - v[0].y;
+                uint8_t GSVertex::*const ch[4] = {&GSVertex::r, &GSVertex::g, &GSVertex::b, &GSVertex::a};
+                for (auto m : ch)
+                {
+                    const float c0 = v[0].*m, d1 = v[1].*m - c0, d2 = v[2].*m - c0;
+                    const float a = (d1 * fy - d2 * ey) / det, b = (ex * d2 - fx * d1) / det;
+                    nv[i].*m = static_cast<uint8_t>(std::clamp(std::lround(c0 + a * px + b * py), 0L, 255L));
+                }
+            }
+        }
+        return true;
+    }
