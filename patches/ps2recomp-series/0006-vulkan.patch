+                         c.bitbltbuf.sbp, c.bitbltbuf.sbw, c.bitbltbuf.spsm, c.trxpos.ssax, c.trxpos.ssay, c.bitbltbuf.dbp, c.bitbltbuf.dbw, c.bitbltbuf.dpsm,
+                         c.trxpos.dsax, c.trxpos.dsay, c.trxreg.rrw, c.trxreg.rrh);
