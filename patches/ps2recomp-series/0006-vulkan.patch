diff --git a/ps2xRuntime/src/lib/gs/gs_drawlist.inl b/ps2xRuntime/src/lib/gs/gs_drawlist.inl
new file mode 100644
index 0000000000000000000000000000000000000000..42fa046e8150a270837769e6eaa68566058cd985
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_drawlist.inl
@@ -0,0 +1,175 @@
+// Phase 2 draw list, record-only (PS2X_DRAWLIST=1; diagnostic, default off). #included at the end of gs_frontend.cpp.
+// Builds the batched draw list the frontend would hand a backend (one batch = consecutive primitives with the same
+// full GS state key, the same key the GL backend batches on) and counts per 5 s: batches, prims per batch, why each
+// batch ended (state change by field group, or a hard event: transfer, CLUT load, TEXFLUSH, FINISH, present,
+// render-to-texture), and an ideal bound: distinct keys per target segment (batches left if primitives could be
+// regrouped freely between hard events). Rendering is not changed.
+#include <array>
+#include <unordered_set>
+extern uint32_t g_ps2xDrawTag;
+namespace ps2x_drawlist
+{
+    namespace
+    {
+        enum Why { kTarget, kTexture, kBlend, kZTest, kScissor, kPrim, kUpload, kReadback, kLocalCopy, kClut, kTexFlush,
+                   kFinish, kPresent, kRtt, kFull, kWhyN };
+        const char *const kWhyName[kWhyN] = {"target", "texture", "blend", "ztest", "scissor", "prim", "upload", "readback",
+                                             "l2l", "clut", "texflush", "finish", "present", "rtt", "full"};
+        struct Key
+        {
+            uint64_t g[6]; // target, texture, blend, ztest, scissor, prim
+            bool operator==(const Key &o) const { return std::memcmp(g, o.g, sizeof(g)) == 0; }
+        };
+        struct KeyHash
+        {
+            size_t operator()(const Key &k) const
+            {
+                uint64_t h = 0x9E3779B97F4A7C15ull;
+                for (uint64_t v : k.g) h = (h ^ v) * 0xFF51AFD7ED558CCDull;
+                return static_cast<size_t>(h ^ (h >> 29));
+            }
+        };
+        std::mutex g_m;
+        bool g_open = false;
+        Key g_key{};
+        uint32_t g_tag = 0;
+        uint64_t g_batchPrims = 0;
+        std::unordered_set<Key, KeyHash> g_segKeys; // distinct keys since the last hard event / target change
+        std::unordered_set<uint32_t> g_targetsThisPresent; // FRAME.FBP (in 2048-byte pages -> block address *32)
+        struct Acc
+        {
+            uint64_t prims = 0, batches = 0, presents = 0, idealBatches = 0, tagChanges = 0, keyOnlyTag = 0;
+            uint64_t why[kWhyN] = {};
+            uint64_t hist[6] = {}; // prims per batch: 1, 2-3, 4-15, 16-63, 64-255, 256+
+        } g_acc;
+        std::chrono::steady_clock::time_point g_last = std::chrono::steady_clock::now();
+
+        Key makeKey(const GSPrimitiveBatch &b)
+        {
+            const GSDrawState &st = b.state;
+            const auto &c = st.context;
+            const auto &p = st.prim;
+            const uint8_t cls = (p.type == GS_PRIM_POINT) ? 0 : (p.type == GS_PRIM_LINE || p.type == GS_PRIM_LINESTRIP) ? 1 : 2;
+            Key k{};
+            k.g[0] = (uint64_t)c.frame.fbp | ((uint64_t)c.frame.fbw << 9) | ((uint64_t)c.frame.psm << 15) | ((uint64_t)c.zbuf.zbp << 21) |
+                     ((uint64_t)c.zbuf.psm << 30) | ((uint64_t)c.zbuf.zmask << 36) | ((uint64_t)c.frame.fbmsk << 37 ^ ((uint64_t)c.frame.fbmsk >> 27));
+            if (p.tme)
+            {
+                const auto &t = c.tex0;
+                k.g[1] = (uint64_t)t.tbp0 | ((uint64_t)t.tbw << 14) | ((uint64_t)t.psm << 20) | ((uint64_t)t.tw << 26) | ((uint64_t)t.th << 30) |
+                         ((uint64_t)t.tcc << 34) | ((uint64_t)t.tfx << 35) | ((uint64_t)t.cbp << 37) | ((uint64_t)t.cpsm << 51) |
+                         ((uint64_t)t.csm << 55) | ((uint64_t)t.csa << 56) | (1ull << 63);
+                k.g[1] ^= (uint64_t)c.clamp * 0x9E3779B97F4A7C15ull;
+                k.g[1] ^= ((uint64_t)st.texa.ta0 | ((uint64_t)st.texa.aem << 8) | ((uint64_t)st.texa.ta1 << 16) | ((uint64_t)st.linearFilter << 24)) << 3;
+            }
+            k.g[2] = (p.abe ? ((uint64_t)c.alpha | 1ull << 63) : 0ull) ^ ((uint64_t)c.fba << 62) ^ ((uint64_t)st.colclamp << 61) ^ ((uint64_t)st.pabe << 60);
+            k.g[3] = (uint64_t)c.test;
+            k.g[4] = (uint64_t)c.scissor.x0 | ((uint64_t)c.scissor.x1 << 16) | ((uint64_t)c.scissor.y0 << 32) | ((uint64_t)c.scissor.y1 << 48);
+            k.g[5] = (uint64_t)cls | ((uint64_t)((cls == 2 && p.type != GS_PRIM_SPRITE) ? p.iip : 0) << 2) | ((uint64_t)p.fge << 3) |
+                     (p.fge ? ((uint64_t)st.fogR << 8 | (uint64_t)st.fogG << 16 | (uint64_t)st.fogB << 24) : 0ull);
+            return k;
+        }
+        void closeLocked(Why why)
+        {
+            if (!g_open)
+                return;
+            g_open = false;
+            ++g_acc.batches;
+            ++g_acc.why[why];
+            const uint64_t n = g_batchPrims;
+            ++g_acc.hist[n <= 1 ? 0 : n <= 3 ? 1 : n <= 15 ? 2 : n <= 63 ? 3 : n <= 255 ? 4 : 5];
+            g_batchPrims = 0;
+        }
+        void segmentEndLocked()
+        {
+            g_acc.idealBatches += g_segKeys.size();
+            g_segKeys.clear();
+        }
+        void maybePrintLocked()
+        {
+            const auto now = std::chrono::steady_clock::now();
+            const double span = std::chrono::duration<double>(now - g_last).count();
+            if (span < 5.0)
+                return;
+            g_last = now;
+            Acc &a = g_acc;
+            const double pres = a.presents ? (double)a.presents : 1.0, bat = a.batches ? (double)a.batches : 1.0;
+            std::string why;
+            char buf[64];
+            for (int i = 0; i < kWhyN; ++i)
+                if (a.why[i])
+                {
+                    std::snprintf(buf, sizeof buf, " %s=%.1f", kWhyName[i], a.why[i] / pres);
+                    why += buf;
+                }
+            std::fprintf(stderr,
+                         "[drawlist] %.1fs presents=%llu | per present: prims=%.0f batches=%.1f ideal=%.1f tagChanges=%.1f | prims/batch=%.1f | "
+                         "batch size 1:%llu 2-3:%llu 4-15:%llu 16-63:%llu 64-255:%llu 256+:%llu | batch ends per present:%s\n",
+                         span, (unsigned long long)a.presents, a.prims / pres, a.batches / pres, a.idealBatches / pres, a.tagChanges / pres,
+                         a.prims / bat, (unsigned long long)a.hist[0], (unsigned long long)a.hist[1], (unsigned long long)a.hist[2],
+                         (unsigned long long)a.hist[3], (unsigned long long)a.hist[4], (unsigned long long)a.hist[5], why.c_str());
+            a = Acc{};
+        }
+    }
+
+    bool on()
+    {
+        static const bool v = []() { const char *e = std::getenv("PS2X_DRAWLIST"); return e && e[0] == '1'; }();
+        return v;
+    }
+
+    void onPrim(const GSPrimitiveBatch &batch)
+    {
+        const Key k = makeKey(batch);
+        const auto &c = batch.state.context;
+        std::lock_guard<std::mutex> lk(g_m);
+        ++g_acc.prims;
+        // render-to-texture: sampling a buffer that was a render target since the last present
+        const bool rtt = batch.state.prim.tme && g_targetsThisPresent.count(c.tex0.tbp0) != 0u;
+        if (g_open && !(k == g_key))
+        {
+            Why why = kPrim;
+            for (int gi = 0; gi < 6; ++gi)
+                if (k.g[gi] != g_key.g[gi]) { why = static_cast<Why>(gi); break; }
+            if (rtt && why == kTexture)
+                why = kRtt;
+            closeLocked(why);
+            if (why == kTarget || why == kRtt)
+                segmentEndLocked();
+        }
+        if (!g_open)
+        {
+            g_open = true;
+            g_key = k;
+            if (g_tag != g_ps2xDrawTag)
+                ++g_acc.tagChanges;
+            g_tag = g_ps2xDrawTag;
+        }
+        g_segKeys.insert(k);
+        g_targetsThisPresent.insert(c.frame.fbp * 32u);
+        if (++g_batchPrims >= 65536u) // the GL backend splits at kMaxBatchFloats
+            closeLocked(kFull);
+    }
+
+    // Hard events: the open batch must be drawn before them.
+    void onEvent(int why)
+    {
+        std::lock_guard<std::mutex> lk(g_m);
+        closeLocked(static_cast<Why>(why));
+        if (why != kClut && why != kTexFlush)
+            segmentEndLocked();
+    }
+    void onTransfer(uint32_t dir) { onEvent(dir == 0 ? kUpload : dir == 1 ? kReadback : kLocalCopy); }
+    void onClut() { onEvent(kClut); }
+    void onTexFlush() { onEvent(kTexFlush); }
+    void onFinish() { onEvent(kFinish); }
+    void onPresent()
+    {
+        std::lock_guard<std::mutex> lk(g_m);
+        closeLocked(kPresent);
+        segmentEndLocked();
+        g_targetsThisPresent.clear();
+        ++g_acc.presents;
+        maybePrintLocked();
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_vk_backend.cpp b/ps2xRuntime/src/lib/gs/gs_vk_backend.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5897b19e75698a41c73aa67a873397d0cf7e6c91
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_vk_backend.cpp
@@ -0,0 +1,496 @@
+// Vulkan GS backend, Phase 3 skeleton (PS2X_GS_BACKEND=vulkan; default renderer stays GL/CPU).
+//
+// Stage 0 (this file): instance (+ VK_LAYER_KHRONOS_validation and a debug messenger when PS2X_VK_VALIDATE=1),
+// physical-device pick (prefers RADV / discrete), one graphics queue, an offscreen colour target, and per present:
+// clear -> copy to a host-visible buffer -> PresentationFrame pixels. The host presenter (raylib/GL window) shows
+// those pixels like any other backend, so this works with PS2X_TEST_WINDOW=hidden and needs no swapchain. All GS
+// work is forwarded to the wrapped reference backend so the game keeps running correctly.
+//   PS2X_VK_CLEAR=RRGGBB   clear colour (default 2050a0)
+//   PS2X_VK_PASSTHRU=1     return the reference renderer's frame instead of the Vulkan clear (still clears/reads)
+//   PS2X_VK_DEVICE=N       force physical device index
+#include "runtime/gs/gs_backend.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <chrono>
+#include <array>
+#include <cmath>
+#include <unordered_map>
+
+#if defined(PS2X_HAVE_VULKAN) && PS2X_HAVE_VULKAN
+#include <vulkan/vulkan.h>
+#include "runtime/gs/gs_cpu_backend.h"
+#if defined(PS2X_HAVE_VK_SHADERS)
+#include "gs_vk_swizzle.spv.h"
+#include "gs_vk_draw_vert.spv.h"
+#include "gs_vk_draw_frag.spv.h"
+#endif
+
+namespace
+{
+    bool envOn(const char *n)
+    {
+        const char *e = std::getenv(n);
+        return e && e[0] == '1';
+    }
+
+    std::mutex g_vkLogMutex;
+    uint64_t g_vkValErrors = 0, g_vkValWarnings = 0;
+
+    VKAPI_ATTR VkBool32 VKAPI_CALL vkDebugCb(VkDebugUtilsMessageSeverityFlagBitsEXT sev, VkDebugUtilsMessageTypeFlagsEXT,
+                                             const VkDebugUtilsMessengerCallbackDataEXT *data, void *)
+    {
+        std::lock_guard<std::mutex> lk(g_vkLogMutex);
+        const bool err = (sev & VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT) != 0;
+        if (err) ++g_vkValErrors; else ++g_vkValWarnings;
+        if (g_vkValErrors + g_vkValWarnings <= 200)
+            std::fprintf(stderr, "[gs:vk] validation %s: %s\n", err ? "ERROR" : "warning", data && data->pMessage ? data->pMessage : "?");
+        return VK_FALSE;
+    }
+
+#include "gs_vk_vram.inl"
+
+    class GSVulkanBackend final : public GSRasterBackend
+    {
+    public:
+        explicit GSVulkanBackend(std::unique_ptr<GSRasterBackend> ref) : m_ref(std::move(ref)) {}
+        ~GSVulkanBackend() override { destroy(); }
+        void setRef(std::unique_ptr<GSRasterBackend> ref) { m_ref = std::move(ref); }
+
+        bool init()
+        {
+            m_validate = envOn("PS2X_VK_VALIDATE");
+            if (const char *c = std::getenv("PS2X_VK_CLEAR"))
+                m_clear = static_cast<uint32_t>(std::strtoul(c, nullptr, 16));
+            m_passthru = envOn("PS2X_VK_PASSTHRU");
+
+            VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+            app.pApplicationName = "ps2xRuntime";
+            app.pEngineName = "ps2x-gs-vk";
+            app.apiVersion = VK_API_VERSION_1_3;
+            std::vector<const char *> layers, exts;
+            if (m_validate)
+            {
+                uint32_t n = 0;
+                vkEnumerateInstanceLayerProperties(&n, nullptr);
+                std::vector<VkLayerProperties> lp(n);
+                vkEnumerateInstanceLayerProperties(&n, lp.data());
+                bool have = false;
+                for (auto &l : lp) have |= std::strcmp(l.layerName, "VK_LAYER_KHRONOS_validation") == 0;
+                if (have) { layers.push_back("VK_LAYER_KHRONOS_validation"); exts.push_back(VK_EXT_DEBUG_UTILS_EXTENSION_NAME); }
+                else std::fprintf(stderr, "[gs:vk] PS2X_VK_VALIDATE=1 but VK_LAYER_KHRONOS_validation is not installed\n");
+            }
+            VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+            ici.pApplicationInfo = &app;
+            ici.enabledLayerCount = static_cast<uint32_t>(layers.size());
+            ici.ppEnabledLayerNames = layers.data();
+            ici.enabledExtensionCount = static_cast<uint32_t>(exts.size());
+            ici.ppEnabledExtensionNames = exts.data();
+            VkDebugUtilsMessengerCreateInfoEXT dci{VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT};
+            dci.messageSeverity = VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT | VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT;
+            dci.messageType = VK_DEBUG_UTILS_MESSAGE_TYPE_GENERAL_BIT_EXT | VK_DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT |
+                              VK_DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT;
+            dci.pfnUserCallback = vkDebugCb;
+            if (!layers.empty())
+                ici.pNext = &dci; // also covers instance create/destroy
+            if (VkResult r = vkCreateInstance(&ici, nullptr, &m_inst); r != VK_SUCCESS)
+                return fail("vkCreateInstance", r);
+            if (!layers.empty())
+            {
+                auto mk = reinterpret_cast<PFN_vkCreateDebugUtilsMessengerEXT>(vkGetInstanceProcAddr(m_inst, "vkCreateDebugUtilsMessengerEXT"));
+                if (mk) mk(m_inst, &dci, nullptr, &m_msg);
+            }
+
+            uint32_t nd = 0;
+            vkEnumeratePhysicalDevices(m_inst, &nd, nullptr);
+            if (nd == 0)
+                return fail("no Vulkan devices", VK_ERROR_INITIALIZATION_FAILED);
+            std::vector<VkPhysicalDevice> devs(nd);
+            vkEnumeratePhysicalDevices(m_inst, &nd, devs.data());
+            int best = -1, bestScore = -1;
+            const char *force = std::getenv("PS2X_VK_DEVICE");
+            for (uint32_t i = 0; i < nd; ++i)
+            {
+                VkPhysicalDeviceDriverProperties drv{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+                VkPhysicalDeviceProperties2 p2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+                p2.pNext = &drv;
+                vkGetPhysicalDeviceProperties2(devs[i], &p2);
+                int score = 0;
+                if (p2.properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) score += 100;
+                else if (p2.properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU) score += 50;
+                if (drv.driverID == VK_DRIVER_ID_MESA_RADV) score += 20;
+                if (p2.properties.apiVersion < VK_API_VERSION_1_3) score = -1;
+                std::fprintf(stderr, "[gs:vk] device %u: %s (%s %s) api %u.%u score %d\n", i, p2.properties.deviceName, drv.driverName,
+                             drv.driverInfo, VK_API_VERSION_MAJOR(p2.properties.apiVersion), VK_API_VERSION_MINOR(p2.properties.apiVersion), score);
+                if (force ? (static_cast<uint32_t>(std::atoi(force)) == i) : (score > bestScore)) { best = static_cast<int>(i); bestScore = score; }
+            }
+            if (best < 0 || bestScore < 0)
+                return fail("no Vulkan 1.3 device", VK_ERROR_INCOMPATIBLE_DRIVER);
+            m_phys = devs[static_cast<size_t>(best)];
+
+            uint32_t nq = 0;
+            vkGetPhysicalDeviceQueueFamilyProperties(m_phys, &nq, nullptr);
+            std::vector<VkQueueFamilyProperties> qf(nq);
+            vkGetPhysicalDeviceQueueFamilyProperties(m_phys, &nq, qf.data());
+            m_qfam = UINT32_MAX;
+            for (uint32_t i = 0; i < nq; ++i)
+                if (qf[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) { m_qfam = i; break; }
+            if (m_qfam == UINT32_MAX)
+                return fail("no graphics queue", VK_ERROR_INITIALIZATION_FAILED);
+            const float prio = 1.0f;
+            VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+            qci.queueFamilyIndex = m_qfam;
+            qci.queueCount = 1;
+            qci.pQueuePriorities = &prio;
+            VkPhysicalDeviceVulkan13Features f13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+            f13.dynamicRendering = VK_TRUE; f13.shaderDemoteToHelperInvocation = VK_TRUE;
+            f13.synchronization2 = VK_TRUE;
+            VkDeviceCreateInfo dvci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+            dvci.pNext = &f13;
+            dvci.queueCreateInfoCount = 1;
+            dvci.pQueueCreateInfos = &qci;
+            if (VkResult r = vkCreateDevice(m_phys, &dvci, nullptr, &m_dev); r != VK_SUCCESS)
+                return fail("vkCreateDevice", r);
+            vkGetDeviceQueue(m_dev, m_qfam, 0, &m_queue);
+
+            VkCommandPoolCreateInfo pci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+            pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+            pci.queueFamilyIndex = m_qfam;
+            if (VkResult r = vkCreateCommandPool(m_dev, &pci, nullptr, &m_pool); r != VK_SUCCESS)
+                return fail("vkCreateCommandPool", r);
+            VkCommandBufferAllocateInfo cai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+            cai.commandPool = m_pool;
+            cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+            cai.commandBufferCount = 1;
+            if (VkResult r = vkAllocateCommandBuffers(m_dev, &cai, &m_cmd); r != VK_SUCCESS)
+                return fail("vkAllocateCommandBuffers", r);
+            VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            if (VkResult r = vkCreateFence(m_dev, &fci, nullptr, &m_fence); r != VK_SUCCESS)
+                return fail("vkCreateFence", r);
+            std::fprintf(stderr, "[gs:vk] initialized: device %d, queue family %u, validation %s\n", best, m_qfam,
+                         m_msg ? "on" : "off");
+            if (std::getenv("PS2X_VK_VRAM") == nullptr || envOn("PS2X_VK_VRAM"))
+                m_vramOn = m_vram.init(m_phys, m_dev, m_queue, m_qfam);
+            return true;
+        }
+
+        // ---- forwarded GS work -----------------------------------------------------------------------------
+        void Initialize(uint8_t *vram, uint32_t vramSize) override { m_ref->Initialize(vram, vramSize); }
+        void Reset() override { m_ref->Reset(); }
+        void Submit(const GSPrimitiveBatch &b) override
+        {
+            if (m_vramOn) { m_vram.draw(b.state.context); m_vram.drawPrim(b); }
+            if (!skipRef()) m_ref->Submit(b);
+        }
+        void SubmitList(const GSDrawList &l) override
+        {
+            const auto t0 = std::chrono::steady_clock::now();
+            if (m_vramOn)
+            {
+                for (const GSDrawListBatch &b : l.batches)
+                    m_vram.draw(b.state.context);
+                m_vram.drawList(l);
+            }
+            const auto t1 = std::chrono::steady_clock::now();
+            if (!skipRef()) m_ref->SubmitList(l);
+            m_pVk += std::chrono::duration<double, std::milli>(t1 - t0).count();
+            m_pRef += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t1).count();
+        }
+        void LoadClut(const GSTex0Reg &t, const GSTexClutReg &c) override { if (m_vramOn) m_vram.loadClut(t, c); m_ref->LoadClut(t, c); }
+        void BeginTransfer(const GSTransferCommand &c) override { if (m_vramOn) m_vram.beginTransfer(c); m_ref->BeginTransfer(c); }
+        void UploadImage(const uint8_t *d, uint32_t n) override { if (m_vramOn) m_vram.upload(d, n); m_ref->UploadImage(d, n); }
+        void Flush() override { m_ref->Flush(); }
+        void TextureFlush() override { m_ref->TextureFlush(); }
+        void Sync(GSSyncReason r) override { m_ref->Sync(r); }
+        bool ClearFramebuffer(const GSContext &c, uint32_t rgba) override { if (m_vramOn) m_vram.draw(c); return m_ref->ClearFramebuffer(c, rgba); }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *d, uint32_t n) override { if (n) ++m_pL2h; return m_ref->ConsumeLocalToHostBytes(d, n); }
+        uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override { ++m_pRv; return m_ref->ReadVram(psm, base, bw, x, y); }
+        void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t v) override { if (m_vramOn) m_vram.disownAll(); m_ref->WriteVram(psm, base, bw, x, y, v); }
+        void SnapshotVram(std::vector<uint8_t> &out) const override { ++m_pSnap; m_ref->SnapshotVram(out); }
+        GSTransferSnapshot GetTransferSnapshot() const override { return m_ref->GetTransferSnapshot(); }
+
+        GSBackendKind Kind() const override { return GSBackendKind::Vulkan; }
+        const char *Name() const override { return "vulkan"; }
+        uint32_t Capabilities() const override { return kGSCapGpu; }
+
+        PresentationFrame Present(const GSPresentationRequest &req) override
+        {
+            const auto t0 = std::chrono::steady_clock::now();
+            PresentationFrame frame;
+            // Without a comparison the reference frame only supplies metadata (size, source fbp); its present (a GL
+            // draw + readback) is refreshed every 30 presents and cached in between. PS2X_VK_REFPRES=1: every present.
+            const bool fast = m_vramOn && m_vram.renderOn() && !m_vram.comparing() && !m_refPresAll;
+            // The cached source fbp goes stale when the game flips buffers between refreshes (menus flickered: every
+            // other frame showed the buffer being drawn), so shift it by how far DISPFB's fbp has moved since.
+            const auto dfbpOf = [](const GSPresentationRequest &r) { return static_cast<uint32_t>(((r.pmode & 1u) ? r.dispfb1 : r.dispfb2) & 0x1FFu); };
+            if (!fast || m_pN % 30u == 0u || !m_haveMeta) { if (!skipRef() || !m_haveMeta) { frame = m_ref->Present(req); m_meta = frame; m_meta.pixels.clear(); m_haveMeta = true; m_metaDfbp = dfbpOf(req); } }
+            if (fast && frame.pixels.empty() && m_haveMeta)
+            {
+                std::vector<uint8_t> keep; keep.swap(frame.pixels); frame = m_meta;
+                if (!m_staleMeta && frame) frame.sourceFbp = static_cast<decltype(frame.sourceFbp)>((frame.sourceFbp + dfbpOf(req) - m_metaDfbp) & 0x1FFu);
+            }
+            const auto t1 = std::chrono::steady_clock::now();
+            if (m_vramOn)
+            {
+                std::vector<uint8_t> vk;
+                uint32_t vw = 0, vh = 0;
+                m_vram.endFrame(m_ref.get(), &req, &frame, &vk, &vw, &vh);
+                if (fast && vk.empty()) frame = m_ref->Present(req); // nothing from Vulkan: fall back
+                if (m_presDump && !vk.empty() && m_pN % 60u == 0u && m_pN >= 600u)
+                {   // debug (PS2X_VK_PRESDUMP=prefix): the presented Vulkan frame as PPM every 60 presents
+                    char path[512]; std::snprintf(path, sizeof(path), "%s_%llu.ppm", m_presDump, (unsigned long long)m_pN);
+                    if (FILE *fp = std::fopen(path, "wb"))
+                    {
+                        std::fprintf(fp, "P6\n%u %u\n255\n", vw, vh);
+                        for (size_t i = 0; i + 3 < vk.size(); i += 4) std::fwrite(&vk[i], 1, 3, fp);
+                        std::fclose(fp);
+                    }
+                }
+                const auto t2 = std::chrono::steady_clock::now();
+                m_pRefP += std::chrono::duration<double, std::milli>(t1 - t0).count();
+                m_pVkP += std::chrono::duration<double, std::milli>(t2 - t1).count();
+                if (++m_pN % 300u == 0u && m_prof)
+                {
+                    const double now = std::chrono::duration<double, std::milli>(t2.time_since_epoch()).count();
+                    std::fprintf(stderr, "[gs:vk:prof] per present over 300: wall %.2f ms | vk draws %.2f ref draws %.2f | ref present %.2f vk endFrame %.2f | l2h %llu readvram %llu snap %llu noref %d\n",
+                                 m_pWall0 ? (now - m_pWall0) / 300.0 : 0.0, m_pVk / 300.0, m_pRef / 300.0, m_pRefP / 300.0, m_pVkP / 300.0,
+                                 (unsigned long long)m_pL2h, (unsigned long long)m_pRv, (unsigned long long)m_pSnap, skipRef() ? 1 : 0);
+                    m_pWall0 = now; m_pVk = m_pRef = m_pRefP = m_pVkP = 0; m_pL2h = m_pRv = m_pSnap = 0;
+                }
+                if (m_vram.renderOn())
+                {
+                    if (!m_passthru && !vk.empty())
+                    {
+                        frame.pixels = std::move(vk);
+                        frame.width = vw;
+                        frame.height = vh;
+                    }
+                    return frame;
+                }
+            }
+            const uint32_t w = frame.width ? frame.width : 640u, h = frame.height ? frame.height : 448u;
+            std::vector<uint8_t> px;
+            if (!clearAndRead(w, h, px))
+                return frame;
+            if (++m_presents % 600u == 1u)
+                std::fprintf(stderr, "[gs:vk] presents=%llu (%ux%u clear %06x) validation errors=%llu warnings=%llu\n",
+                             static_cast<unsigned long long>(m_presents), w, h, m_clear,
+                             static_cast<unsigned long long>(g_vkValErrors), static_cast<unsigned long long>(g_vkValWarnings));
+            if (!m_passthru)
+            {
+                frame.pixels = std::move(px);
+                frame.width = w;
+                frame.height = h;
+            }
+            return frame;
+        }
+
+    private:
+        bool fail(const char *what, VkResult r)
+        {
+            std::fprintf(stderr, "[gs:vk] %s failed (VkResult %d)\n", what, static_cast<int>(r));
+            return false;
+        }
+
+        uint32_t memType(uint32_t bits, VkMemoryPropertyFlags want)
+        {
+            VkPhysicalDeviceMemoryProperties mp;
+            vkGetPhysicalDeviceMemoryProperties(m_phys, &mp);
+            for (uint32_t i = 0; i < mp.memoryTypeCount; ++i)
+                if ((bits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & want) == want)
+                    return i;
+            return UINT32_MAX;
+        }
+
+        void freeTarget()
+        {
+            if (!m_dev) return;
+            if (m_mapped) { vkUnmapMemory(m_dev, m_bufMem); m_mapped = nullptr; }
+            if (m_buf) vkDestroyBuffer(m_dev, m_buf, nullptr);
+            if (m_bufMem) vkFreeMemory(m_dev, m_bufMem, nullptr);
+            if (m_img) vkDestroyImage(m_dev, m_img, nullptr);
+            if (m_imgMem) vkFreeMemory(m_dev, m_imgMem, nullptr);
+            m_buf = VK_NULL_HANDLE; m_bufMem = VK_NULL_HANDLE; m_img = VK_NULL_HANDLE; m_imgMem = VK_NULL_HANDLE;
+            m_w = m_h = 0;
+        }
+
+        bool makeTarget(uint32_t w, uint32_t h)
+        {
+            freeTarget();
+            VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+            ii.imageType = VK_IMAGE_TYPE_2D;
+            ii.format = VK_FORMAT_R8G8B8A8_UNORM;
+            ii.extent = {w, h, 1};
+            ii.mipLevels = 1;
+            ii.arrayLayers = 1;
+            ii.samples = VK_SAMPLE_COUNT_1_BIT;
+            ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+            ii.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+            ii.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            if (vkCreateImage(m_dev, &ii, nullptr, &m_img) != VK_SUCCESS) return false;
+            VkMemoryRequirements mr;
+            vkGetImageMemoryRequirements(m_dev, m_img, &mr);
+            VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+            ai.allocationSize = mr.size;
+            ai.memoryTypeIndex = memType(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+            if (ai.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &m_imgMem) != VK_SUCCESS) return false;
+            vkBindImageMemory(m_dev, m_img, m_imgMem, 0);
+
+            VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+            bi.size = static_cast<VkDeviceSize>(w) * h * 4u;
+            bi.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+            bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+            if (vkCreateBuffer(m_dev, &bi, nullptr, &m_buf) != VK_SUCCESS) return false;
+            vkGetBufferMemoryRequirements(m_dev, m_buf, &mr);
+            ai.allocationSize = mr.size;
+            ai.memoryTypeIndex = memType(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+            if (ai.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(m_dev, &ai, nullptr, &m_bufMem) != VK_SUCCESS) return false;
+            vkBindBufferMemory(m_dev, m_buf, m_bufMem, 0);
+            if (vkMapMemory(m_dev, m_bufMem, 0, VK_WHOLE_SIZE, 0, &m_mapped) != VK_SUCCESS) return false;
+            m_w = w; m_h = h;
+            return true;
+        }
+
+        bool clearAndRead(uint32_t w, uint32_t h, std::vector<uint8_t> &out)
+        {
+            std::lock_guard<std::mutex> lk(m_mutex);
+            if (!m_dev || m_broken) return false;
+            if ((w != m_w || h != m_h) && !makeTarget(w, h)) { m_broken = true; fail("target allocation", VK_ERROR_OUT_OF_DEVICE_MEMORY); return false; }
+            vkResetCommandBuffer(m_cmd, 0);
+            VkCommandBufferBeginInfo bb{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+            bb.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+            vkBeginCommandBuffer(m_cmd, &bb);
+            VkImageSubresourceRange rng{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+            VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+            b.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+            b.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            b.image = m_img;
+            b.subresourceRange = rng;
+            vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+            VkClearColorValue cc{};
+            cc.float32[0] = ((m_clear >> 16) & 0xFF) / 255.0f;
+            cc.float32[1] = ((m_clear >> 8) & 0xFF) / 255.0f;
+            cc.float32[2] = (m_clear & 0xFF) / 255.0f;
+            cc.float32[3] = 1.0f;
+            vkCmdClearColorImage(m_cmd, m_img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &cc, 1, &rng);
+            b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            b.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+            b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+            vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+            VkBufferImageCopy cp{};
+            cp.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+            cp.imageExtent = {w, h, 1};
+            vkCmdCopyImageToBuffer(m_cmd, m_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, m_buf, 1, &cp);
+            VkBufferMemoryBarrier hb{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+            hb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            hb.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+            hb.srcQueueFamilyIndex = hb.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            hb.buffer = m_buf;
+            hb.size = VK_WHOLE_SIZE;
+            vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1, &hb, 0, nullptr);
+            vkEndCommandBuffer(m_cmd);
+            VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+            si.commandBufferCount = 1;
+            si.pCommandBuffers = &m_cmd;
+            if (VkResult r = vkQueueSubmit(m_queue, 1, &si, m_fence); r != VK_SUCCESS) { m_broken = true; return fail("vkQueueSubmit", r); }
+            vkWaitForFences(m_dev, 1, &m_fence, VK_TRUE, UINT64_MAX);
+            vkResetFences(m_dev, 1, &m_fence);
+            const uint8_t *src = static_cast<const uint8_t *>(m_mapped);
+            out.assign(src, src + static_cast<size_t>(w) * h * 4u);
+            return true;
+        }
+
+        void destroy()
+        {
+            if (m_dev)
+            {
+                vkDeviceWaitIdle(m_dev);
+                m_vram.destroy();
+                freeTarget();
+                if (m_fence) vkDestroyFence(m_dev, m_fence, nullptr);
+                if (m_pool) vkDestroyCommandPool(m_dev, m_pool, nullptr);
+                vkDestroyDevice(m_dev, nullptr);
+                m_dev = VK_NULL_HANDLE;
+            }
+            if (m_inst)
+            {
+                if (m_msg)
+                {
+                    std::fprintf(stderr, "[gs:vk] shutdown: presents=%llu validation errors=%llu warnings=%llu\n",
+                                 static_cast<unsigned long long>(m_presents), static_cast<unsigned long long>(g_vkValErrors),
+                                 static_cast<unsigned long long>(g_vkValWarnings));
+                    auto d = reinterpret_cast<PFN_vkDestroyDebugUtilsMessengerEXT>(vkGetInstanceProcAddr(m_inst, "vkDestroyDebugUtilsMessengerEXT"));
+                    if (d) d(m_inst, m_msg, nullptr);
+                    m_msg = VK_NULL_HANDLE;
+                }
+                vkDestroyInstance(m_inst, nullptr);
+                m_inst = VK_NULL_HANDLE;
+            }
+        }
+
+        std::unique_ptr<GSRasterBackend> m_ref;
+        // profiling (PS2X_VK_PROF=1) and PS2X_VK_NOREF=1: Vulkan alone, the wrapped reference renderer only gets
+        // transfers/CLUT (no draws, no present), so its VRAM lacks drawn pixels (counters show if the game reads it back)
+        bool skipRef() const { return m_noRef && m_vramOn && m_vram.renderOn() && !m_vram.comparing(); }
+        uint32_t m_metaDfbp = 0;
+        bool m_staleMeta = std::getenv("PS2X_VK_STALEMETA") != nullptr; // debug: old behaviour (cached source fbp)
+        bool m_prof = std::getenv("PS2X_VK_PROF") != nullptr, m_noRef = std::getenv("PS2X_VK_NOREF") != nullptr;
+        double m_pVk = 0, m_pRef = 0, m_pRefP = 0, m_pVkP = 0, m_pWall0 = 0;
+        uint64_t m_pN = 0;
+        bool m_refPresAll = std::getenv("PS2X_VK_REFPRES") && std::getenv("PS2X_VK_REFPRES")[0] == '1', m_haveMeta = false;
+        const char *m_presDump = std::getenv("PS2X_VK_PRESDUMP");
+        PresentationFrame m_meta;
+        mutable uint64_t m_pL2h = 0, m_pRv = 0, m_pSnap = 0;
+        VkVramMirror m_vram;
+        bool m_vramOn = false;
+        std::mutex m_mutex;
+        bool m_validate = false, m_passthru = false, m_broken = false;
+        uint32_t m_clear = 0x2050a0u;
+        uint64_t m_presents = 0;
+        VkInstance m_inst = VK_NULL_HANDLE;
+        VkDebugUtilsMessengerEXT m_msg = VK_NULL_HANDLE;
+        VkPhysicalDevice m_phys = VK_NULL_HANDLE;
+        VkDevice m_dev = VK_NULL_HANDLE;
+        VkQueue m_queue = VK_NULL_HANDLE;
+        uint32_t m_qfam = 0;
+        VkCommandPool m_pool = VK_NULL_HANDLE;
+        VkCommandBuffer m_cmd = VK_NULL_HANDLE;
+        VkFence m_fence = VK_NULL_HANDLE;
+        VkImage m_img = VK_NULL_HANDLE;
+        VkDeviceMemory m_imgMem = VK_NULL_HANDLE;
+        VkBuffer m_buf = VK_NULL_HANDLE;
+        VkDeviceMemory m_bufMem = VK_NULL_HANDLE;
+        void *m_mapped = nullptr;
+        uint32_t m_w = 0, m_h = 0;
+    };
+}
+
+std::unique_ptr<GSRasterBackend> gsCreateVulkanBackend(std::unique_ptr<GSRasterBackend> &inner)
+{
+    if (!inner)
+        return nullptr;
+    auto vk = std::make_unique<GSVulkanBackend>(nullptr);
+    if (!vk->init())
+        return nullptr; // `inner` untouched
+    vk->setRef(std::move(inner));
+    return vk;
+}
+
+bool gsVulkanCompiledIn() { return true; }
+
+#else // !PS2X_HAVE_VULKAN
+
+std::unique_ptr<GSRasterBackend> gsCreateVulkanBackend(std::unique_ptr<GSRasterBackend> &) { return nullptr; }
+bool gsVulkanCompiledIn() { return false; }
+
+#endif
diff --git a/ps2xRuntime/src/lib/gs/gs_vk_render.inl b/ps2xRuntime/src/lib/gs/gs_vk_render.inl
