+    static bool s_vkNearest() { static const bool v = std::getenv("PS2X_VK_NEAREST") != nullptr; return v; } // debug: no bilinear
+    void drawBatchLocked(const GSDrawListBatch &b, const GSVertex *verts, size_t nverts)
+    {
+        const GSDrawState &st = b.state;
+        const GSContext &c = st.context;
+        const GSPrimType type = st.prim.type;
+        const uint32_t cls = (type == GS_PRIM_POINT) ? 0u : (type == GS_PRIM_LINE || type == GS_PRIM_LINESTRIP) ? 1u : (type == GS_PRIM_SPRITE ? 3u : 2u);
