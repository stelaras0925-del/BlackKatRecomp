+int rtWrap(int h, uint mode, uint size, uint mn, uint mx, int S)
+{   // vk19: CLAMP_0 addressing on the scaled copy: wrap the texel index, keep the sub-texel offset
+    int t = (h >= 0) ? h / S : -((S - 1 - h) / S);
+    int sub = h - t * S;
