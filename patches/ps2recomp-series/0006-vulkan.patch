+        const uint32_t rrw = c.trxreg.rrw, rrh = c.trxreg.rrh;
+        if (!fs.ok || !fd.ok || rrw == 0 || rrh == 0) return false;
+        const uint64_t n = static_cast<uint64_t>(rrw) * rrh, alloc = (n * 4u + 255u) & ~255ull;
