+    void ensureBegun() { if (!m_begun) begin(); }
+    void ensureCompute() { endRenderingLocked(); ensureBegun(); }
+    // async present (default when rendering and not comparing; PS2X_VK_SYNCPRES=1 turns it off): the frame's command
+    // buffer is submitted without waiting; the next locked call (or begin/submitWait) waits for the fence first.
+    bool m_inFlight = false;
+    void waitInFlight()
+    {
+        if (!m_inFlight) return;
+        const auto pt0 = std::chrono::steady_clock::now();
+        vkWaitForFences(m_dev, 1, &m_fence, VK_TRUE, UINT64_MAX);
+        m_pWaitMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - pt0).count();
+        vkResetFences(m_dev, 1, &m_fence);
+        m_inFlight = false;
+        probePrint();
+    }
+    void submitAsync()
+    {
+        if (!m_begun) return;
+        endRenderingLocked();
+        vkEndCommandBuffer(m_cmd);
+        VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        si.commandBufferCount = 1;
+        si.pCommandBuffers = &m_cmd;
+        ++m_pSubs;
+        if (vkQueueSubmit(m_q, 1, &si, m_fence) == VK_SUCCESS) m_inFlight = true;
+        m_begun = false;
+        m_clutPending = 0;
+    }
+    void begin()
+    {
+        waitInFlight();
+        vkResetCommandBuffer(m_cmd, 0);
+        VkCommandBufferBeginInfo bb{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        bb.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        vkBeginCommandBuffer(m_cmd, &bb);
+        m_begun = true;
+    }
+    void barrier(bool toHost = false)
+    {
+        VkMemoryBarrier mb{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT | (toHost ? VK_ACCESS_HOST_READ_BIT : 0u);
+        vkCmdPipelineBarrier(m_cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                             VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | (toHost ? VK_PIPELINE_STAGE_HOST_BIT : 0u),
+                             0, 1, &mb, 0, nullptr, 0, nullptr);
+    }
+    void submitWait()
+    {
+        waitInFlight();
+        if (!m_begun) return;
+        endRenderingLocked();
+        vkEndCommandBuffer(m_cmd);
+        VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        si.commandBufferCount = 1;
+        si.pCommandBuffers = &m_cmd;
+        const auto pt0 = std::chrono::steady_clock::now();
+        ++m_pSubs;
+        if (vkQueueSubmit(m_q, 1, &si, m_fence) == VK_SUCCESS)
+        {
+            vkWaitForFences(m_dev, 1, &m_fence, VK_TRUE, UINT64_MAX);
+            m_pWaitMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - pt0).count();
+            vkResetFences(m_dev, 1, &m_fence);
+            probePrint();
+        }
+        m_begun = false;
+        m_clutPending = 0;
+    }
