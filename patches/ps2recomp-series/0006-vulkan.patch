+                             (unsigned long long)st.dthe, (unsigned long long)st.colclamp, (unsigned)st.pabe, (unsigned)st.prim.iip, (unsigned)st.prim.fge, st.textureWidth, st.textureHeight);
+            if ((sa >= 0 && (long long)c.alpha == sa) || (stb >= 0 && st.prim.tme && (long long)c.tex0.tbp0 == stb)) { ++m_rs.skipped; return; }
