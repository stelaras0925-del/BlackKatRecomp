+// PS2X_IPU_TRACE=<file>: one line per completed VDEC/BDEC/IDEC (decode results and output hash),
+// for comparing the game's command stream against an offline driver.
+inline void traceCommand(const State &s, size_t out0)
+{
+    static FILE *f = [] { const char *p = std::getenv("PS2X_IPU_TRACE"); return (p && *p) ? std::fopen(p, "w") : nullptr; }();
+    if (!f) return;
+    const uint32_t op = s.cmd >> 28;
+    if (op == 0x3)
+        std::fprintf(f, "V%u %d len=%u\n", (s.cmd >> 26) & 3u, (int)(int16_t)(s.result & 0xFFFF), s.result >> 16);
+    else if (op == 0x2 || op == 0x1)
+    {
+        uint64_t h = 1469598103934665603ull;
+        for (size_t i = out0; i < s.out.size(); ++i) h = (h ^ s.out[i]) * 1099511628211ull;
+        std::fprintf(f, "%c q=%u mbi=%u dcr=%u dt=%u cbp=%02x ctrl=%08x h=%016llx\n", op == 2 ? 'B' : 'I', (s.cmd >> 16) & 31u,
+                     (s.cmd >> 27) & 1u, (s.cmd >> 26) & 1u, (s.cmd >> 25) & 1u, (s.ctrl >> 8) & 63u, s.ctrl & 0x07F30000u,
+                     (unsigned long long)h);
+    }
