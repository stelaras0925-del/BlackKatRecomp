+// ps2_ipu.inl -- clean-room model of the PS2 IPU (MPEG-1/2 macroblock decoder), included by
+// ps2_memory.cpp. Written from the public register/command descriptions (PS2Tek "IPU I/O Registers"
+// and "IPU Commands") and the variable-length-code tables, scan orders, inverse quantisation and
+// IDCT definitions of ISO/IEC 13818-2 (MPEG-2 video, Annex B / clause 7) and ISO/IEC 11172-2.
+// No code from other emulators.
+//
+// PS2X_IPU=1 enables it (default off: the old fromIPU fill workaround stays in place).
+// PS2X_IPU_LOG=1 logs commands / IPU DMA starts (first few hundred), =2 logs every command.
+// PS2X_IPU_DUMP=<dir> dumps every IDEC picture output as a raw file (for PNG conversion).
+//
+// Model: the input FIFO is a byte buffer filled on demand from the toIPU DMA (ch4, normal or
+// source-chain mode) and by EE writes to IPU_in_FIFO; the output FIFO is a byte buffer drained by
+// the fromIPU DMA (ch3, normal mode) and EE reads of IPU_out_FIFO. Commands run synchronously when
+// written; a command that runs out of input data is rolled back and retried when more data
+// arrives (BUSY stays set meanwhile), so the decoder itself never has to be resumable.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <chrono>
+
+namespace ps2x_ipu
+{
+inline bool enabled()
+{
+    static const bool e = [] { const char *v = std::getenv("PS2X_IPU"); return v && v[0] == '1'; }();
+    return e;
+}
+inline int logLevel()
+{
+    static const int l = [] { const char *v = std::getenv("PS2X_IPU_LOG"); return v ? std::atoi(v) : 0; }();
+    return l;
+}
+
+struct Starved {};
+struct BadCode {};
+
+// ---------------------------------------------------------------- VLC tables (ISO/IEC 13818-2 Annex B)
+struct VlcEntry { int16_t value; uint8_t len; };
+struct VlcTable
+{
+    int maxLen = 0;
+    std::vector<VlcEntry> lut; // indexed by the next maxLen bits
+};
+struct VlcSrc { const char *code; int value; };
+
+inline VlcTable buildVlc(const VlcSrc *src, size_t n)
+{
+    VlcTable t;
+    std::vector<std::pair<uint32_t, int>> codes;
+    for (size_t i = 0; i < n; ++i)
+    {
+        uint32_t c = 0; int len = 0;
+        for (const char *p = src[i].code; *p; ++p)
+            if (*p == '0' || *p == '1') { c = (c << 1) | (uint32_t)(*p - '0'); ++len; }
+        codes.push_back({c, len});
+        if (len > t.maxLen) t.maxLen = len;
+    }
+    t.lut.assign((size_t)1 << t.maxLen, VlcEntry{0, 0});
+    for (size_t i = 0; i < n; ++i)
+    {
+        const int len = codes[i].second;
+        const uint32_t base = codes[i].first << (t.maxLen - len);
+        const uint32_t span = 1u << (t.maxLen - len);
+        for (uint32_t k = 0; k < span; ++k)
+        {
+            VlcEntry &e = t.lut[base + k];
+            if (e.len) std::fprintf(stderr, "[ipu] VLC table conflict at code %s\n", src[i].code);
+            e.value = (int16_t)src[i].value; e.len = (uint8_t)len;
+        }
+    }
+    return t;
+}
