+// ---------------------------------------------------------------- IPU state
+struct State
+{
+    // input
+    std::vector<uint8_t> in; // bytes pulled from the FIFO sources, not yet discarded
+    uint64_t bit = 0;        // bit position of the decoder inside `in`
+    // output
+    std::vector<uint8_t> out;
+    size_t outRd = 0;
+    // registers
+    uint32_t ctrl = 0; // only the writable/control fields + ECD/SCD/CBP are kept here
+    uint32_t result = 0;
+    bool busy = false;
+    uint32_t cmd = 0;
+    bool resultIsPeek = true; // IPU_CMD shows the next 32 bits until the first FDEC/VDEC
+    // tables
+    uint8_t iqIntra[64];  // raster order
+    uint8_t iqNon[64];
+    uint16_t vqclut[16] = {};
+    uint32_t th0 = 0, th1 = 0;
+    int16_t dcPred[3] = {128, 128, 128};
+    // CSC/PACK remaining macroblock count (commands that complete per macroblock)
+    uint32_t mbLeft = 0;
+    // stats
+    uint64_t cmds = 0, idecPics = 0, bdecMbs = 0, cscMbs = 0;
+    double usTotal = 0.0;
+    State()
+    {
+        // power-on: MPEG default intra matrix (13818-2 6.3.11), flat 16 non-intra matrix.
+        static const uint8_t defIntraZz[64] = {8, 16, 16, 19, 16, 19, 22, 22, 22, 22, 22, 22, 26, 24, 26, 27,
+                                               27, 27, 26, 26, 26, 26, 27, 27, 27, 29, 29, 29, 34, 34, 34, 29,
+                                               29, 29, 27, 27, 29, 29, 32, 32, 34, 34, 37, 38, 37, 35, 35, 34,
+                                               35, 38, 38, 40, 40, 40, 48, 48, 46, 46, 56, 56, 58, 69, 69, 83};
+        for (int i = 0; i < 64; ++i)
+        {
+            iqIntra[tables().zigzag[i]] = defIntraZz[i];
+            iqNon[i] = 16;
+        }
+    }
+};
+
+inline State &st()
+{
+    static State s;
+    return s;
+}
