+    // FMAC flag liveness: an FMAC whose MAC/status flag-pipeline entry is provably never
+    // observed (the next flag-writing FMAC on the straight-line path overwrites MAC and the
+    // current status bits before any FSxx/FMxx reader or FSSET could run) does not queue an
+    // entry; its sticky bits are carried into that next entry, which commits them at a point
+    // where nothing can tell the difference. PS2X_VU1_BLOCKCACHE=0 disables it,
+    // PS2X_VU1_BC_CHECK=1 runs every VU1 program twice (reference path vs block cache) and
+    // compares registers, flags, cycles, VU data memory and the XGKICK packets.
+    bool vu1BlockCacheOn()
+    {
+        static const bool on = []() { const char *e = std::getenv("PS2X_VU1_BLOCKCACHE"); return !(e && e[0] == '0') && vu1JitOn(); }();
+        return on;
+    }
+    bool vu1BcCheck()
+    {
+        static const bool on = []() { const char *e = std::getenv("PS2X_VU1_BC_CHECK"); return e && e[0] == '1'; }();
+        return on;
+    }
+    bool vu1BcStats()
+    {
+        static const bool on = []() { const char *e = std::getenv("PS2X_VU1_BC_STATS"); return (e && e[0] == '1') || vu1BcCheck(); }();
+        return on;
+    }
