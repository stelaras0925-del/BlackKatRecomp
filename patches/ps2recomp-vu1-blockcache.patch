+            GsStage &g = gsStage();
+            tlsIsWorker = true; // GS code run here must not drain the worker (it waits for us)
+            tlsIsGsStage = true;
+            pthread_setname_np(pthread_self(), "GSStage");
+            std::vector<GsOp> batch;
+            for (;;)
+            {
+                PS2Memory *mem = nullptr;
+                {
+                    std::unique_lock<std::mutex> lk(g.m);
+                    g.workCv.wait(lk, [&]() { return !g.queue.empty(); });
+                    batch.clear();
+                    while (!g.queue.empty())
+                    {
+                        batch.push_back(std::move(g.queue.front()));
+                        g.queue.pop_front();
+                    }
+                    mem = g.mem;
+                }
+                const uint64_t t0 = nowNs();
+                for (GsOp &op : batch)
+                {
+                    try
