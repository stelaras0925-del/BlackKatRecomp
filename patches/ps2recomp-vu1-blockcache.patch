+    inline uint64_t vu1Fnv(const uint8_t *p, size_t n, uint64_t h = 1469598103934665603ull)
+    {
+        for (size_t k = 0; k < n; ++k)
+            h = (h ^ p[k]) * 1099511628211ull;
+        return h;
+    }
+    // Upper instructions that queue an FMAC MAC/status entry (applyFmacDest/applyFmacDestAcc with dest != 0).
+    inline bool vu1UpperWritesFmacFlags(uint32_t upper)
+    {
+        if (DEST(upper) == 0u)
+            return false;
+        const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+        if (op <= 0x2Fu)
+            return !((op >= 0x10u && op <= 0x17u) || op == 0x1Du || op == 0x1Fu || op == 0x2Bu || op == 0x2Fu);
+        if (op >= 0x3Cu)
+        {
+            const uint8_t sp = static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu));
+            return sp <= 0x0Fu || (sp >= 0x18u && sp <= 0x1Cu) || sp == 0x1Eu ||
+                   (sp >= 0x20u && sp <= 0x2Au) || (sp >= 0x2Cu && sp <= 0x2Eu);
+        }
+        return false;
+    }
+    // Lower instructions that read MAC/status (FSEQ/FSAND/FSOR/FMEQ/FMAND/FMOR) or write it (FSSET).
+    inline bool vu1LowerTouchesFmacFlags(uint32_t lower)
+    {
+        const uint32_t opHi = (lower >> 25) & 0x7Fu;
+        return opHi == 0x14u || opHi == 0x15u || opHi == 0x16u || opHi == 0x17u ||
+               opHi == 0x18u || opHi == 0x1Au || opHi == 0x1Bu;
+    }
