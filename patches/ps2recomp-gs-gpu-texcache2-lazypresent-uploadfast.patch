+    static bool presentAllBlack(const PresentationFrame &f)
+    {
+        // same test as countNonBlackPixels() (RGB != 0), over the whole host frame
+        const uint8_t *p = f.pixels.data();
+        const size_t n = f.pixels.size() / 4u;
+        for (size_t i = 0; i < n; ++i)
+            if (p[i * 4u] | p[i * 4u + 1u] | p[i * 4u + 2u])
+                return false;
+        return true;
+    }
+
+    static bool sameFrameReg(const GSFrameReg &a, const GSFrameReg &b)
+    {
+        return a.fbp == b.fbp && a.fbw == b.fbw && a.psm == b.psm && a.fbmsk == b.fbmsk;
+    }
