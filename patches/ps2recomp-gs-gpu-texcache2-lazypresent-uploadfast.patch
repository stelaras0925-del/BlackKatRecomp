+inline uint64_t tcMum(uint64_t a, uint64_t b)
+{
+    const __uint128_t r = static_cast<__uint128_t>(a) * b;
+    return static_cast<uint64_t>(r) ^ static_cast<uint64_t>(r >> 64);
