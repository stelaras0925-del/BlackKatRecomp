+        std::sort(h.begin(), h.end(), [](auto &a, auto &b) { return a.first > b.first; });
+        uint64_t top = 0;
+        for (size_t k = 0; k < h.size() && k < 64; ++k)
+            top += h[k].first;
+        std::fprintf(stderr, "[vu1:prof]   %zu distinct pairs, top-64 pairs = %.1f%%\n", h.size(),
