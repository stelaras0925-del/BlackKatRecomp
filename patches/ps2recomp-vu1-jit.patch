+// Same as VU1Interpreter::normalizeOperand (denormal -> signed 0, Inf/NaN -> signed max), inline so
+// execUpper/execLower in other translation units do not pay a call per operand lane.
+static inline float vuNormOperand(float value)
+{
+    uint32_t bits;
