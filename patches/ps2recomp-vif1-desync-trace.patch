+// ---- VIF1 desync trace (PS2X_VIF1_TRACE=0 disables) ----------------------------
+// Ring buffer of the last 32 VIFcodes with the DMA transfer they came from. Dumped
+// once per anomaly kind (reserved UNPACK, MPG addr upper bits, huge carry, unknown
+// VIFcode, XGKICK overflow) so a run pinpoints where the stream first desyncs.
+namespace
+{
+    struct Vif1TraceEntry
+    {
+        uint32_t cmd, pos, size, serial, src, qwc, chain;
+    };
+    Vif1TraceEntry g_vif1Ring[32] = {};
+    uint32_t g_vif1RingN = 0;
+    uint32_t g_vif1XferSerial = 0, g_vif1XferSrc = 0, g_vif1XferQwc = 0, g_vif1XferChain = 0;
+    const uint8_t *g_vif1CurData = nullptr;
+    uint32_t g_vif1CurSize = 0;
+    std::atomic<uint32_t> g_vif1DumpedMask{0};
+
+    bool vif1TraceEnabled()
+    {
+        static const bool on = []() {
+            const char *e = std::getenv("PS2X_VIF1_TRACE");
+            return !(e && e[0] == '0');
+        }();
+        return on;
+    }
+
+    inline void vif1RingPush(uint32_t cmd, uint32_t pos, uint32_t size)
+    {
+        Vif1TraceEntry &e = g_vif1Ring[g_vif1RingN++ & 31u];
+        e.cmd = cmd; e.pos = pos; e.size = size; e.serial = g_vif1XferSerial;
+        e.src = g_vif1XferSrc; e.qwc = g_vif1XferQwc; e.chain = g_vif1XferChain;
+    }
+}
+
+void ps2xVif1NoteTransfer(uint32_t src, uint32_t qwc, uint32_t chainBytes)
+{
+    ++g_vif1XferSerial;
+    g_vif1XferSrc = src;
+    g_vif1XferQwc = qwc;
+    g_vif1XferChain = chainBytes;
+}
+
+// kind: 0 reserved UNPACK, 1 MPG upper bits, 2 huge carry, 3 unknown VIFcode, 4 XGKICK overflow
+void ps2xVif1AnomalyDump(uint32_t kind, const char *why)
+{
+    if (!vif1TraceEnabled() || kind > 31u)
+        return;
+    const uint32_t bit = 1u << kind;
+    if (g_vif1DumpedMask.fetch_or(bit) & bit)
+        return;
+    std::fprintf(stderr, "[vif1:trace] ===== anomaly kind=%u: %s | last VIFcodes, oldest first =====\n", kind, why);
+    const uint32_t n = std::min<uint32_t>(g_vif1RingN, 32u);
+    for (uint32_t i = 0; i < n; ++i)
+    {
+        const Vif1TraceEntry &e = g_vif1Ring[(g_vif1RingN - n + i) & 31u];
+        std::fprintf(stderr, "[vif1:trace] xfer#%u src=%08x qwc=%u chainBytes=%u size=%u pos=%u cmd=%08x op=%02x num=%u imm=%04x%s\n",
+                     e.serial, e.src, e.qwc, e.chain, e.size, e.pos, e.cmd, (e.cmd >> 24) & 0x7Fu,
+                     (e.cmd >> 16) & 0xFFu, e.cmd & 0xFFFFu, (e.cmd & 0x80000000u) ? " IRQ" : "");
+    }
+    if (g_vif1CurData && n > 0u)
+    {
+        const Vif1TraceEntry &last = g_vif1Ring[(g_vif1RingN - 1u) & 31u];
+        if (last.size == g_vif1CurSize)
+        {
+            uint32_t start = last.pos >= 128u ? ((last.pos - 128u) & ~15u) : 0u;
+            uint32_t end = std::min<uint32_t>(g_vif1CurSize, last.pos + 64u);
+            for (uint32_t o = start; o + 16u <= end; o += 16u)
+            {
+                uint32_t w[4];
+                std::memcpy(w, g_vif1CurData + o, 16);
+                std::fprintf(stderr, "[vif1:trace] data+%05x: %08x %08x %08x %08x\n", o, w[0], w[1], w[2], w[3]);
+            }
+        }
+    }
+    std::fprintf(stderr, "[vif1:trace] ===== end =====\n");
+}
