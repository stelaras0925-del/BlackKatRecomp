+            return false;
+        const uint32_t have = sizeBytes - cmdStart;
+        if (have > (4u << 20)) // runaway guard: never hold more than 4 MB
+            return false;
+        g_vif1Carry.assign(data + cmdStart, data + sizeBytes);
+        vif1CarryLog(cmdWord, have, need);
+        return true;
+    };
