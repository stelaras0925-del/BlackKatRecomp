+namespace
+{
+    // VIF1 command carry across transfers. A VIFcode whose payload (MPG code,
+    // UNPACK data, STROW/STCOL/STMASK) does not fit in the current VIF1 DMA
+    // transfer used to be dropped, and the next transfer was then parsed from
+    // the middle of that payload: its data words were decoded as VIFcodes,
+    // giving garbage MPG writes into VU1 micro memory (VU1 then ran
+    // 0xfffffffb "reserved lower" ops) and garbage DIRECT packets into the GS
+    // (DISPFB/DISPLAY/CLAMP overwritten -> magenta screen). Seen on the
+    // teleport circle. The VIF keeps the command open across DMA transfers,
+    // so keep the unfinished command (VIFcode + partial payload) and prepend
+    // it to the next transfer. PS2X_VIF1_CARRY=0 restores the old drop.
+    std::vector<uint8_t> g_vif1Carry;
+    bool g_vif1CarryActive = false;
+
+    bool vif1CarryEnabled()
+    {
+        static const bool on = []() {
+            const char *e = std::getenv("PS2X_VIF1_CARRY");
+            return !(e && e[0] == '0');
+        }();
+        return on;
+    }
+
+    void vif1CarryLog(uint32_t cmd, uint32_t have, uint32_t need)
+    {
+        static uint32_t s_logged = 0;
+        if (s_logged < 20)
+        {
+            ++s_logged;
+            std::fprintf(stderr, "[vif1:carry] cmd=%08x payload %u/%u bytes, continued in next transfer\n",
+                         cmd, have, need);
+        }
+    }
+}
