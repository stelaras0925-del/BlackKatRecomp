+// SSE2 version of the fastUpper per-lane FMAC loop (ADD/SUB/MUL/MADD/MSUB). Same IEEE single
+// operations in the same order per lane (no FMA), so results are bit-identical; the same lanes
+// fall back (return false) as in the scalar loop. Lanes outside dest get flags 0.
+static inline __m128 vu1NormPs(__m128 v)
+{
+    const __m128i b = _mm_castps_si128(v);
+    const __m128i sign = _mm_and_si128(b, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+    const __m128i e = _mm_and_si128(_mm_srli_epi32(b, 23), _mm_set1_epi32(0xFF));
+    const __m128i isZ = _mm_cmpeq_epi32(e, _mm_setzero_si128());
+    const __m128i isM = _mm_cmpeq_epi32(e, _mm_set1_epi32(0xFF));
+    const __m128i maxv = _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF));
+    __m128i r = _mm_or_si128(_mm_andnot_si128(_mm_or_si128(isZ, isM), b), _mm_and_si128(isZ, sign));
+    r = _mm_or_si128(r, _mm_and_si128(isM, maxv));
+    return _mm_castsi128_ps(r);
+}
+static inline __m128i vu1ExpOut(__m128 r) // lanes with exponent < 3 or > 252
+{
+    const __m128i e = _mm_and_si128(_mm_srli_epi32(_mm_castps_si128(r), 23), _mm_set1_epi32(0xFF));
+    return _mm_or_si128(_mm_cmplt_epi32(e, _mm_set1_epi32(3)), _mm_cmpgt_epi32(e, _mm_set1_epi32(252)));
